---
import Header from "@/components/sections/landing-page/Header.astro";
import Footer from "@/components/sections/landing-page/Footer.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const stories = [
  {
    name: "Denis Lim Setiawan",
    location: "Da'i",
    category: "Pendidikan",
    quote:
      "Dengan Beramalbersama.com, kita bisa menyalurakan Al-Quran, Bahkan sampai ke seluruh pelosok nusantara kepada santri penghafal quran dimanapun. Yuk kita wakaf Quran bagi para penghafal Quran di pelosok nusantara.",
    image: "/assets/story/1.jpeg",
    impact: "Penyaluran Mushaf Al-Qur'an untuk Santri & Penghafal Qur'an",
  },
  {
    name: "Ust. Luqmanulhakim",
    location: "Da'i Nasional",
    category: "Kemanusiaan",
    quote:
      "Ayo Abang kaka ayah bunda, dukung dan support ikut berkontribusi di beramalbersama.com. Ada program kemanusiaan, ada program kepedulian, program pendidikan, program kesehatan dan program kebaikan serta kemaslahatan, berkah selalu.",
    image: "/assets/story/2.jpeg",
    impact: "Dukungan Program Kebaikan & Kemaslahatan Ummat",
    videoUrl:
      "https://drive.google.com/drive/folders/1i-6fs08bFmyYcQ6KMlFrXZAZGQ-S159t?usp=sharing",
  },
  {
    name: "Ustadz Salim A. Fillah",
    location: "Da'i Nasional & Penulis",
    category: "Pemberdayaan",
    quote:
      "Beramalbersama.com bisa memfasilitasi agar amal kita sampai kepada yang berhak menjadi amal terbaik, termasuk bagaimana kita mungkin mau mengatasnamakannya orang tua, hadiah untuk ayah ibu kita bersedekah air untuk saudara2 kita yg kekurangan, untuk berwudhu para santri dan penghafal quran. Dengan begitu seluruh kegiatan mereka pahalanya mengalir kepada kita yang bersedekah melalui beramalbersama.com.",
    image: "/assets/story/3.jpeg",
    impact: "Sedekah Air Bersih & Wudhu Santri Penghafal Qur'an",
    videoUrl: "https://youtu.be/sVNCDbqDrxc?si=qJtq-rU0A_QGXIIe",
  },
];

const categoryColors: Record<string, string> = {
  Kesehatan: "bg-rose-100 text-rose-700",
  Pendidikan: "bg-blue-100 text-blue-700",
  Kemanusiaan: "bg-orange-100 text-orange-700",
  Pemberdayaan: "bg-green-100 text-green-700",
};
---

<MainLayout
  title="Cerita Inspirasi — Beramalbersama"
  description="Kisah nyata para penerima manfaat dan tokoh pendukung Beramalbersama. Setiap donasi yang kamu berikan meninggalkan jejak perubahan yang berarti."
>
  <Header />
  <main>
    <!-- Hero -->
    <section class="pt-14 pb-16 bg-white relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute -top-16 -right-16 w-80 h-80 rounded-full bg-primary-100/50 blur-3xl"></div>
        <div class="absolute top-32 -left-16 w-64 h-64 rounded-full bg-primary-50/70 blur-3xl"></div>
      </div>
      <div class="container-custom relative text-center max-w-3xl mx-auto" data-reveal>
        <span class="section-label">Cerita Inspirasi</span>
        <h1 class="font-display text-4xl md:text-5xl font-semibold text-primary-900 leading-tight mt-3 mb-5">
          Setiap Donasi adalah
          <span class="text-primary-600">Cerita Nyata</span>
        </h1>
        <p class="text-primary-700/80 text-base md:text-lg leading-relaxed">
          Di balik setiap angka ada wajah, ada harapan, ada kehidupan yang
          berubah. Inilah kisah dan ajakan kebaikan dari para tokoh serta da'i yang menjadi alasan kami terus bergerak.
        </p>
      </div>
    </section>

    <!-- Stats bar -->
    <section class="bg-primary-700 py-8">
      <div class="container-custom">
        <div class="grid grid-cols-3 gap-4 text-center text-white" data-reveal>
          {[
            { num: "50.000+", label: "Donatur Aktif" },
            { num: "200+", label: "Program Selesai" },
            { num: "10M+ Jiwa", label: "Penerima Manfaat" },
          ].map((s) => (
            <div>
              <p class="font-display text-2xl md:text-3xl font-bold">{s.num}</p>
              <p class="text-primary-200 text-xs mt-1">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stories Grid -->
    <section class="py-20 bg-cream">
      <div class="container-custom">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {stories.map((story, i) => (
            <article
              class="bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-lg transition-all duration-300 hover:-translate-y-1 flex flex-col"
              data-reveal
              style={`transition-delay:${i * 0.08}s`}
            >
              <!-- Image -->
              <div class="relative aspect-square overflow-hidden bg-primary-50">
                <img
                  src={story.image}
                  alt={story.name}
                  class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                  loading={i < 3 ? "eager" : "lazy"}
                />
                <div class="absolute inset-0 bg-linear-to-t from-primary-950/70 via-transparent to-transparent"></div>
                <span
                  class={`absolute top-3 left-3 text-xs font-semibold px-3 py-1 rounded-full ${categoryColors[story.category] ?? "bg-primary-100 text-primary-700"}`}
                >
                  {story.category}
                </span>
                <div class="absolute bottom-3 left-3 right-3">
                  <p class="text-white font-semibold text-base leading-snug">{story.name}</p>
                  <p class="text-white/80 text-xs mt-0.5">{story.location}</p>
                </div>
              </div>

              <!-- Content -->
              <div class="p-5 flex flex-col flex-1">
                <blockquote class="text-sm text-primary-800 italic leading-relaxed flex-1 mb-4">
                  <span class="text-primary-400 text-2xl leading-none font-display not-italic">"</span>
                  {story.quote}
                </blockquote>

                {story.videoUrl && (
                  <a
                    href={story.videoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-primary-100/80 text-primary-800 hover:bg-primary-600 hover:text-white transition-all duration-200"
                  >
                    <svg class="w-4 h-4 text-red-600 fill-current" viewBox="0 0 24 24">
                      <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                    </svg>
                    Lihat Video / Dokumentasi
                    <svg class="w-3.5 h-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 bg-white">
      <div class="container-custom text-center max-w-2xl mx-auto" data-reveal>
        <h2 class="font-display text-3xl md:text-4xl font-semibold text-primary-900 mb-4">
          Jadilah Bagian dari Cerita Kebaikan
        </h2>
        <p class="text-primary-700/80 text-sm md:text-base leading-relaxed mb-8">
          Cerita-cerita di atas hanya bisa ada karena ada hati yang tergerak untuk
          berbagi. Giliran kamu untuk menulis cerita kebaikanmu.
        </p>
        <a href="/donasi" class="btn-primary">
          Mulai Berdonasi Sekarang
        </a>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("revealed");
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
</script>
