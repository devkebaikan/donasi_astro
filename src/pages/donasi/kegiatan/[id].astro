---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import {
  getKegiatanDetailById,
  getProjectById,
  getMitraById,
} from "@/lib/FetchData";
import { formatDate } from "@/lib/formatter";

const { id } = Astro.params;
if (!id || isNaN(Number(id))) return Astro.redirect("/404");

const kegiatan = await getKegiatanDetailById(Number(id));

if (!kegiatan) return Astro.redirect("/404");

// Fetch associated project and mitra info in parallel jika ID ada
let project: any = null;
let mitraDetail: any = null;

const [projectRes, mitraRes] = await Promise.allSettled([
  kegiatan.project_id
    ? getProjectById(Number(kegiatan.project_id))
    : Promise.resolve(null),
  kegiatan.mitra_id
    ? getMitraById(Number(kegiatan.mitra_id))
    : Promise.resolve(null),
]);

if (projectRes.status === "fulfilled" && projectRes.value) {
  project = projectRes.value;
}
if (mitraRes.status === "fulfilled" && mitraRes.value) {
  mitraDetail = mitraRes.value;
}

const mitraName =
  kegiatan.mitra_name || mitraDetail?.nama || mitraDetail?.name || null;
const mitraImage = mitraDetail?.image_url || null;
const mitraId = kegiatan.mitra_id || mitraDetail?.id || null;

const displayImage = kegiatan.thumbnail_url || kegiatan.thumbnail || null;
const title = kegiatan.judul || null;
const htmlContent = kegiatan.deskripsi || null;
const statusLabel =
  kegiatan.type === "Final"
    ? "Selesai"
    : kegiatan.type === "Progress"
      ? "Proses Salur"
      : kegiatan.type || null;

const dateFormatted = kegiatan.date ? formatDate(kegiatan.date) : null;

const programLink =
  project?.programs?.[0]?.slug ||
  project?.programs?.[0]?.link ||
  kegiatan.program?.link ||
  null;
---

<MainLayout
  title={title ? `Detail Kegiatan - ${title}` : "Detail Kegiatan"}
  description="Informasi lengkap tentang kegiatan penyaluran donasi dan realisasi program."
>
  <Header type="title" text="Detail Kegiatan" />

  <div class="container min-h-screen pb-28">
    <!-- Main Detail Card -->
    <article class="bg-white overflow-hidden">
      <!-- Image / Thumbnail -->
      {
        displayImage && (
          <div class="w-full bg-gray-100 overflow-hidden">
            <img
              src={displayImage}
              alt={title || "Kegiatan"}
              class="w-full h-auto object-cover"
            />
          </div>
        )
      }

      <div class="p-4 sm:p-6 space-y-4">
        <!-- META (Mitra Info, Date & Status) -->
        {
          (mitraName || dateFormatted || statusLabel) && (
            <div class="flex items-center justify-between gap-3 pb-3 border-b border-gray-100">
              {mitraName ? (
                mitraId ? (
                  <a
                    href={`/mitra/${mitraId}`}
                    class="flex items-center gap-3 min-w-0 group hover:opacity-80 transition-opacity"
                  >
                    {mitraImage ? (
                      <img
                        src={mitraImage}
                        alt={mitraName}
                        class="w-10 h-10 rounded-full object-contain border border-gray-200 bg-white shrink-0"
                      />
                    ) : (
                      <div class="w-10 h-10 rounded-full bg-primary-500 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                        {mitraName.charAt(0).toUpperCase()}
                      </div>
                    )}

                    <div class="min-w-0">
                      <p class="text-xs sm:text-sm font-bold text-gray-900 group-hover:text-primary-600 transition-colors truncate">
                        {mitraName}
                      </p>
                      {dateFormatted && (
                        <p class="text-[11px] text-gray-400">{dateFormatted}</p>
                      )}
                    </div>
                  </a>
                ) : (
                  <div class="flex items-center gap-3 min-w-0">
                    {mitraImage ? (
                      <img
                        src={mitraImage}
                        alt={mitraName}
                        class="w-10 h-10 rounded-full object-contain border border-gray-200 bg-white shrink-0"
                      />
                    ) : (
                      <div class="w-10 h-10 rounded-full bg-primary-500 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                        {mitraName.charAt(0).toUpperCase()}
                      </div>
                    )}

                    <div class="min-w-0">
                      <p class="text-xs sm:text-sm font-bold text-gray-900 truncate">
                        {mitraName}
                      </p>
                      {dateFormatted && (
                        <p class="text-[11px] text-gray-400">{dateFormatted}</p>
                      )}
                    </div>
                  </div>
                )
              ) : dateFormatted ? (
                <p class="text-xs text-gray-400">{dateFormatted}</p>
              ) : (
                <div />
              )}

              {statusLabel && (
                <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100 shrink-0">
                  {statusLabel}
                </span>
              )}
            </div>
          )
        }

        <!-- Project Badge & Location -->
        {
          project && (
            <div class="p-3 bg-primary-50/70 rounded-xl space-y-1">
              <p class="text-[11px] font-semibold text-primary-800">
                Proyek Terkait:
              </p>
              {project.id ? (
                <a
                  href={`/project/${project.id}`}
                  class="text-xs text-primary-900 font-medium hover:underline block"
                >
                  {project.judul || project.title}
                </a>
              ) : (
                <p class="text-xs text-primary-900 font-medium">
                  {project.judul || project.title}
                </p>
              )}
              {project.location && project.location.trim() !== "" && (
                <p class="text-[11px] text-gray-500 flex items-center gap-1 pt-1">
                  <svg
                    class="w-3.5 h-3.5 text-rose-500 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"
                    />
                  </svg>
                  {project.location}
                </p>
              )}
            </div>
          )
        }

        <!-- Judul Kegiatan -->
        {
          title && (
            <h1 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">
              {title}
            </h1>
          )
        }

        <!-- Deskripsi Kegiatan -->
        {
          htmlContent && (
            <div
              class="prose prose-sm max-w-none text-gray-700 leading-relaxed text-xs sm:text-sm space-y-3 [&_p]:mb-3 [&_p]:leading-relaxed [&_a]:text-primary-600 [&_a]:underline"
              set:html={htmlContent}
            />
          )
        }
      </div>
    </article>
  </div>

  <!-- Bottom CTA -->
  {
    programLink && (
      <div class="fixed container bottom-0 left-0 right-0 bg-white border-t border-gray-100 px-4 py-3 z-40">
        <a
          href={`/${programLink}`}
          class="block w-full py-3.5 bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white text-sm font-bold text-center rounded-xl transition-all duration-150 shadow-md shadow-primary-500/20"
        >
          Donasi Sekarang
        </a>
      </div>
    )
  }
</MainLayout>
