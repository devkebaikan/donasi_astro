---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getAllReportByLink } from "@/lib/FetchData";
import { formatDate } from "@/lib/formatter";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const [dataReport] = await Promise.all([getAllReportByLink(slug)]);

const reports = Array.isArray(dataReport)
  ? dataReport
  : Array.isArray(dataReport?.data)
    ? dataReport.data
    : [];

const report = reports[0] || null;
if (!report) return Astro.redirect(`/donasi/report/${slug}`);

const mitra = report.mitra?.[0];
const mitraName = mitra?.name || "Aksiberbagi";
const mitraImage = mitra?.image_url;
const displayImage =
  report.wa_image ||
  report.kegiatan?.image ||
  report.image ||
  report.program?.image;
const title =
  report.title ||
  report.kegiatan?.title ||
  report.project?.title ||
  "Detail Penyaluran";
const htmlContent =
  report.content ||
  report.kegiatan?.deskripsi ||
  (report.wa_caption
    ? `<p>${report.wa_caption.replace(/\r\n/g, "<br/>").replace(/\n/g, "<br/>")}</p>`
    : "");
const statusLabel =
  report.type === "Final" ? "Selesai" : report.type || "Penyaluran";
---

<MainLayout
  title={`Detail Laporan - ${title}`}
  description="Informasi lengkap tentang penyaluran donasi dan realisasi program."
>
  <Header type="title" text="Detail Laporan" />

  <div class="container min-h-screen pb-28">
    <!-- Main Detail Card -->
    <article class="bg-white overflow-hidden">
      <!-- Image -->
      {
        displayImage && (
          <div class="w-full bg-gray-100 overflow-hidden max-h-96">
            <img
              src={displayImage}
              alt={title}
              class="w-full h-auto object-cover max-h-96"
            />
          </div>
        )
      }

      <div class="p-4 sm:p-6 space-y-4">
        <!-- META -->
        <div
          class="flex items-center justify-between gap-3 pb-3 border-b border-gray-100"
        >
          <div class="flex items-center gap-3 min-w-0">
            {
              mitraImage ? (
                <img
                  src={mitraImage}
                  alt={mitraName}
                  class="w-10 h-10 rounded-full object-contain border border-gray-200 bg-white shrink-0"
                />
              ) : (
                <div class="w-10 h-10 rounded-full bg-primary-500 text-white flex items-center justify-center font-bold text-sm shrink-0 shadow-xs">
                  {mitraName.charAt(0).toUpperCase()}
                </div>
              )
            }

            <div class="min-w-0">
              <p class="text-xs sm:text-sm font-bold text-gray-900 truncate">
                {mitraName}
              </p>
              <p class="text-[11px] text-gray-400">
                {report.date ? formatDate(report.date) : "-"}
              </p>
            </div>
          </div>

          <span
            class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-100 shrink-0"
          >
            {statusLabel}
          </span>
        </div>

        <!-- Project Badge & Location -->
        {
          report.project?.title && (
            <div class="p-3 bg-primary-50/70 rounded-xl space-y-1">
              <p class="text-[11px] font-semibold text-primary-800">
                Proyek Penyaluran:
              </p>
              <p class="text-xs text-primary-900 font-medium">
                {report.project.title}
              </p>
              {report.project?.location &&
                report.project.location.trim() !== "" && (
                  <p class="text-[11px] text-gray-500 flex items-center gap-1 pt-1">
                    <svg
                      class="w-3.5 h-3.5 text-rose-500 shrink-0"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z"
                      />
                    </svg>
                    {report.project.location}
                  </p>
                )}
            </div>
          )
        }

        <!-- Title -->
        <h1 class="text-base sm:text-lg font-bold text-gray-900 leading-snug">
          {title}
        </h1>

        <!-- Content -->
        <div
          class="prose prose-sm max-w-none text-gray-700 leading-relaxed text-xs sm:text-sm space-y-3 [&_p]:mb-3 [&_p]:leading-relaxed [&_a]:text-primary-600 [&_a]:underline"
          set:html={htmlContent}
        />

        <!-- Instagram Action -->
        {
          report.ig_link && (
            <div class="pt-3 border-t border-gray-100">
              <a
                href={report.ig_link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-pink-50 text-pink-600 border border-pink-100 text-xs font-semibold hover:bg-pink-100 transition-colors"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
                Lihat Dokumentasi di Instagram
              </a>
            </div>
          )
        }
      </div>
    </article>
  </div>

  <!-- Bottom CTA -->
  <div
    class="fixed container bottom-0 left-0 right-0 bg-white border-t border-gray-100 px-4 py-3 z-40"
  >
    <a
      href={`/donasi/${slug}`}
      class="block w-full py-3.5 bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white text-sm font-bold text-center rounded-xl transition-all duration-150 shadow-md shadow-primary-500/20"
    >
      Donasi Sekarang
    </a>
  </div>
</MainLayout>
