---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getProjectById } from "@/lib/FetchData";
import { formatDate, formatRupiah, progressPercent } from "@/lib/formatter";

const { slug } = Astro.params;

// DEFAULT PROJECT
interface Mitra {
  nama?: string;
  image_url?: string;
}

interface Project {
  id: number;
  pengaju: string;
  image_url: string;
  deskripsi: string;
  nominal_ajuan: number;
  nominal_acc: number;
  waktu_pelaksanaan: string;
  jumlah_pm: number;
  judul: string;
  activity: string;
  location: string;
  claimed_donasi: number;
  total_alokasi: number;
  mitra_utama: Mitra | null;
  mitras: Mitra[];
  programs: [];
}

// AMBIL PROJECT ID
const projectIdParam = Astro.url.searchParams.get("project_id");

const emptyProject: Project = {
  id: 0,
  pengaju: "",
  image_url: "",
  deskripsi: "",
  nominal_ajuan: 0,
  nominal_acc: 0,
  waktu_pelaksanaan: "",
  jumlah_pm: 0,
  judul: "",
  activity: "",
  location: "",
  claimed_donasi: 0,
  total_alokasi: 0,
  mitra_utama: null,
  mitras: [],
  programs: [],
};

let project: Project = emptyProject;

try {
  const result = await getProjectById(Number(projectIdParam));

  if (result) {
    project = result;
  }
} catch (error) {
  console.error("Gagal mengambil project:", error);
}

// DATA TURUNAN
const nominalAchieved = Number(project.claimed_donasi ?? 0);

const nominalTarget = Number(
  project.total_alokasi ?? project.nominal_acc ?? project.nominal_ajuan ?? 0,
);

const pct = progressPercent(nominalAchieved, nominalTarget);

const mitra = project.mitra_utama ?? project.mitras?.[0] ?? null;

const mitraName = mitra?.nama ?? project.pengaju ?? "Mitra";

const mitraImage = mitra?.image_url ?? null;

const description =
  project.deskripsi
    ?.replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim() ?? "";

const beneficiary = Number(project.jumlah_pm ?? 0);

// ACTIVITY
function activityLabel(activity?: string): string {
  const map: Record<string, string> = {
    "active open": "Sedang Tergalang",
    "active close": "Segera Salur",
    done: "Selesai",
  };

  return map[activity?.toLowerCase() ?? ""] ?? activity ?? "-";
}

function activityBadgeClass(activity?: string): string {
  const a = activity?.toLowerCase();

  if (a === "active open") {
    return "bg-primary-100 text-primary-700";
  }

  if (a === "active close") {
    return "bg-amber-100 text-amber-700";
  }

  if (a === "done") {
    return "bg-blue-100 text-blue-700";
  }

  return "bg-gray-100 text-gray-600";
}
---

<MainLayout
  title={project.judul || "Proyek Salur"}
  description={description ||
    "Informasi lengkap tentang proyek penyaluran donasi."}
>
  <Header type="title" text="Proyek Salur" />
  <div class="container bg-white pb-24 pt-12">
    <section class="mx-4 mt-5">
      <h2 class="mb-3 text-sm font-bold text-gray-700">Detail Proyek Salur</h2>

      <div
        class="relative flex flex-col gap-4 border-l-2 border-primary-100 pl-5"
      >
        <div class="relative">
          <div
            class="absolute -left-[25px] top-4 h-3 w-3 rounded-full border-2 border-white bg-primary-500 ring-2 ring-primary-200"
          >
          </div>

          <div
            class="overflow-hidden rounded-xl border border-gray-100 bg-primary-50"
          >
            <!-- MITRA -->
            <div class="flex items-center justify-between gap-2 px-3 pb-2 pt-3">
              <div class="flex min-w-0 items-center gap-2">
                {
                  mitraImage ? (
                    <img
                      src={mitraImage}
                      alt={mitraName}
                      width="32"
                      height="32"
                      class="h-8 w-8 flex-shrink-0 rounded-full border border-gray-100 object-contain"
                    />
                  ) : (
                    <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary-100 text-sm font-bold text-primary-600">
                      {mitraName.charAt(0).toUpperCase()}
                    </div>
                  )
                }

                <div class="min-w-0">
                  <p class="truncate text-sm font-semibold text-gray-800">
                    {mitraName}
                  </p>

                  {
                    project.waktu_pelaksanaan && (
                      <p class="text-xs text-gray-400">
                        {formatDate(project.waktu_pelaksanaan)}
                      </p>
                    )
                  }
                </div>
              </div>

              <span
                class={`flex-shrink-0 rounded-full px-2.5 py-1 text-xs font-medium ${activityBadgeClass(project.activity)}`}
              >
                {activityLabel(project.activity)}
              </span>
            </div>

            <!-- IMAGE -->
            {
              project.image_url && (
                <div class="w-full overflow-hidden bg-gray-100">
                  <img
                    src={project.image_url}
                    alt={project.judul || "Project"}
                    width="1200"
                    height="600"
                    class="h-auto max-h-[400px] w-full object-cover"
                    loading="lazy"
                  />
                </div>
              )
            }

            <!-- BODY -->
            <div class="px-3 pb-4 pt-3">
              <h3 class="mb-1 text-sm font-bold leading-snug text-gray-900">
                {project.judul || "Data proyek tidak tersedia"}
              </h3>

              <!-- PROGRESS -->
              <div class="mb-3">
                <div
                  class="mb-1.5 h-1.5 w-full overflow-hidden rounded-full bg-gray-100"
                >
                  <div
                    class="h-full rounded-full bg-primary-500"
                    style={`width:${pct}%`}
                  >
                  </div>
                </div>

                <div class="flex items-center justify-between">
                  <span class="text-xs font-semibold text-primary-600">
                    {formatRupiah(nominalAchieved)}
                  </span>

                  <span class="text-xs text-gray-400">
                    dari {formatRupiah(nominalTarget)}
                  </span>
                </div>
              </div>

              <!-- TAGS -->
              <div class="mb-3 flex flex-wrap gap-2">
                {
                  beneficiary > 0 && (
                    <span class="inline-flex items-center gap-1 rounded-full border border-gray-100 bg-gray-50 px-2.5 py-1 text-xs text-gray-500">
                      {beneficiary} penerima
                    </span>
                  )
                }

                <span
                  class="inline-flex items-center gap-1 rounded-full border border-gray-100 bg-gray-50 px-2.5 py-1 text-xs text-gray-500"
                >
                  {pct}% terkumpul
                </span>
              </div>

              <!-- DESCRIPTION -->
              {
                description && (
                  <p class="mb-4 text-xs leading-relaxed text-gray-500">
                    {description}
                  </p>
                )
              }

              <!-- CTA -->
              {
                project.id > 0 && slug ? (
                  <a
                    href={`/donasi/${slug}?project=${project.id}`}
                    class="block w-full rounded-lg bg-primary-500 py-3 text-center text-sm font-semibold text-white transition-all duration-150 hover:bg-primary-600 active:scale-[0.98]"
                  >
                    Donasi Untuk Proyek Ini
                  </a>
                ) : (
                  <div class="rounded-lg bg-gray-100 py-3 text-center text-sm font-medium text-gray-400">
                    Data proyek belum tersedia
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
