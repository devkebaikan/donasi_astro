---
export const prerender = false;

import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";

import { getAllCampaigns, getCampaignCategories } from "@/lib/FetchData";
import CampaignList from "@/components/ui/CampaignList.astro";

const searchQuery = Astro.url.searchParams.get("q") ?? null;
const categoryId = Astro.url.searchParams.get("category") ?? null;

// Fetch data pertama & kategori secara paralel (server-side)
const [programRes, categoryList] = await Promise.all([
  getAllCampaigns({
    limit: 5,
    mode: "pagination",
    page: 1,
    category: categoryId ?? undefined,
    search: searchQuery ?? undefined,
  }),
  getCampaignCategories(),
]);

const programList = programRes?.data ?? [];
const hasNextPage = Boolean(
  programRes?.meta && programRes.meta.current_page < programRes.meta.last_page,
);
---

<MainLayout
  title={searchQuery ? `Hasil pencarian: ${searchQuery}` : "Program Donasi"}
  description="Temukan program donasi terpercaya dan salurkan kebaikanmu bersama Aksiberbagi."
>
  <Header type="search" text={searchQuery ?? ""} />

  <section
    id="campaign-page"
    data-api-url={import.meta.env.PUBLIC_API_URL}
    data-category-id={categoryId}
    data-search={searchQuery}
    data-has-next={String(hasNextPage)}
    class="min-h-screen bg-gray-50"
  >
    <div class="container min-h-screen pb-24 pt-[64px] bg-white">
      {/* ── Filter Bar (Hybrid: Action Button + Quick Scrollable Pills) ── */}
      <div
        class="sticky top-0 z-20 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-xs"
      >
        <div class="flex items-center px-3 py-2.5 gap-2">
          {/* Tombol Buka Modal / Bottom Sheet Semua Kategori */}
          <!-- <button
            id="btn-open-category-modal"
            type="button"
            class={`shrink-0 flex hidden items-center gap-1.5 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer ${
              categoryId
                ? "border border-primary-500 bg-primary-50 text-primary-700 font-semibold shadow-xs"
                : "border border-gray-200 bg-white text-gray-700 hover:border-primary-400 hover:text-primary-600 font-medium"
            }`}
            aria-label="Pilih Kategori"
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"
              ></path>
            </svg>
            <span>Kategori</span>
          </button> -->

          {/* Divider */}
          <!-- <div class="w-[1px] h-5 bg-gray-200 shrink-0"></div> -->

          {/* Quick Horizontal Scrollable Pills */}
          <div
            id="quick-pills-container"
            class="flex items-center gap-1.5 overflow-x-auto scroll-smooth scrollbar-none [-ms-overflow-style:none] [scrollbar-width:none] flex-1 min-w-0"
          >
            {/* Pill Semua */}
            <button
              type="button"
              class={`category-pill shrink-0 flex items-center gap-1 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer ${
                !categoryId
                  ? "bg-primary-600 text-white font-semibold shadow-xs"
                  : "bg-gray-100/90 text-gray-600 hover:bg-gray-200 hover:text-gray-900 font-medium"
              }`}
              data-id=""
              data-name="Semua"
            >
              <span>Semua</span>
            </button>

            {/* Quick Categories */}
            {
              categoryList?.slice(0, 3).map((item: any) => {
                const isSelected = String(item.id) === categoryId;
                return (
                  <button
                    type="button"
                    class={`category-pill shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer ${
                      isSelected
                        ? "bg-primary-600 text-white font-semibold shadow-xs"
                        : "bg-gray-100/90 text-gray-600 hover:bg-gray-200 hover:text-gray-900 font-medium"
                    }`}
                    data-id={item.id}
                    data-name={item.name}
                  >
                    {item.image_url && (
                      <img
                        src={item.image_url}
                        alt={item.name}
                        class="w-3.5 h-3.5 rounded-full object-cover shrink-0"
                        loading="lazy"
                      />
                    )}
                    <span>{item.name}</span>
                  </button>
                );
              })
            }

            {/* Tombol + Lainnya */}
            <button
              id="btn-more-categories"
              type="button"
              class="shrink-0 flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs bg-gray-100/80 hover:bg-gray-200 text-gray-600 transition-colors font-medium cursor-pointer"
            >
              <svg
                class="w-3.5 h-3.5 text-gray-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Lainnya</span>
            </button>
          </div>
        </div>
      </div>

      {/* ── Category Bottom Sheet Modal ── */}
      <div
        id="category-modal-backdrop"
        class="fixed inset-0 z-50 bg-black/40 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300"
      >
      </div>

      <div
        id="category-modal-sheet"
        class="fixed inset-x-0 bottom-0 z-50 max-w-[480px] mx-auto bg-white rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-300 ease-out max-h-[82vh] flex flex-col pointer-events-none"
      >
        {/* Handle bar & Header */}
        <div class="px-5 pt-3 pb-3 border-b border-gray-100 shrink-0">
          <div class="w-10 h-1 bg-gray-300 rounded-full mx-auto mb-3"></div>
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-base font-bold text-gray-800">Kategori Donasi</h3>
              <p class="text-xs text-gray-400">
                Pilih kategori program yang ingin Anda bantu
              </p>
            </div>
            <button
              id="btn-close-category-modal"
              type="button"
              class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-200 transition-colors cursor-pointer"
              aria-label="Tutup"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L10 11.414l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                  clip-rule="evenodd"></path>
              </svg>
            </button>
          </div>
        </div>

        {/* Modal List Kategori */}
        <div class="overflow-y-auto px-4 py-3 space-y-2 flex-1">
          {/* Opsi Semua Program */}
          <button
            type="button"
            class={`category-modal-item w-full flex items-center justify-between p-3 rounded-2xl border transition-all duration-200 cursor-pointer text-left ${
              !categoryId
                ? "border-primary-500 bg-primary-50/70 text-primary-800 font-semibold"
                : "border-gray-100 bg-gray-50/70 hover:bg-gray-100 text-gray-700"
            }`}
            data-id=""
            data-name="Semua"
          >
            <div class="flex items-center gap-3 min-w-0">
              <div
                class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center text-primary-600 font-bold text-sm shrink-0"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <div class="text-sm font-semibold truncate">Semua Program</div>
                <div class="text-[11px] text-gray-400 font-normal">
                  Tampilkan seluruh program donasi
                </div>
              </div>
            </div>
            <div
              class={`modal-check-icon w-5 h-5 rounded-full border flex items-center justify-center shrink-0 ${
                !categoryId
                  ? "border-primary-600 bg-primary-600 text-white"
                  : "border-gray-300 bg-white"
              }`}
            >
              <svg
                class={`w-3 h-3 ${!categoryId ? "block" : "hidden"}`}
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
          </button>

          {/* Tiap Kategori */}
          {
            categoryList?.map((item: any) => {
              const isSelected = String(item.id) === categoryId;
              return (
                <button
                  type="button"
                  class={`category-modal-item w-full flex items-center justify-between p-3 rounded-2xl border transition-all duration-200 cursor-pointer text-left ${
                    isSelected
                      ? "border-primary-500 bg-primary-50/70 text-primary-800 font-semibold"
                      : "border-gray-100 bg-gray-50/70 hover:bg-gray-100 text-gray-700"
                  }`}
                  data-id={item.id}
                  data-name={item.name}
                >
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-10 h-10 rounded-xl overflow-hidden bg-gray-200 shrink-0 border border-gray-100">
                      {item.image_url ? (
                        <img
                          src={item.image_url}
                          alt={item.name}
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-gray-400 text-xs font-semibold">
                          {item.name.charAt(0)}
                        </div>
                      )}
                    </div>
                    <div class="min-w-0">
                      <div class="text-sm font-semibold truncate">
                        {item.name}
                      </div>
                      <div class="text-[11px] text-gray-400 font-normal">
                        Kategori {item.name}
                      </div>
                    </div>
                  </div>
                  <div
                    class={`modal-check-icon w-5 h-5 rounded-full border flex items-center justify-center shrink-0 ${
                      isSelected
                        ? "border-primary-600 bg-primary-600 text-white"
                        : "border-gray-300 bg-white"
                    }`}
                  >
                    <svg
                      class={`w-3 h-3 ${isSelected ? "block" : "hidden"}`}
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </div>
                </button>
              );
            })
          }
        </div>
      </div>

      {/* ── Campaign List ── */}
      <div class="py-4 px-2.5 space-y-3">
        {/* Skeleton loading awal */}
        <div id="campaign-skeleton" class="space-y-3 hidden">
          {
            Array.from({ length: 3 }).map(() => (
              <div
                class="flex flex-row items-stretch bg-white rounded border border-gray-100
           overflow-hidden w-full animate-pulse"
              >
                {/* Image Skeleton */}
                <div class="relative flex-shrink-0 w-[160px] md:w-[180px] m-2.5 rounded-lg overflow-hidden bg-gray-200" />

                {/* Content */}
                <div class="flex flex-col justify-between flex-1 min-w-0 py-3 pr-3 pl-1">
                  {/* Title */}
                  <div class="space-y-1 mb-2">
                    <div class="h-3 bg-gray-200 rounded w-3/4" />
                    <div class="h-3 bg-gray-200 rounded w-2/3" />
                  </div>

                  {/* Mitra + Category */}
                  <div class="flex items-center gap-2 mb-2.5">
                    <div class="w-3 h-3 bg-gray-200 rounded-full" />
                    <div class="h-3 bg-gray-200 rounded w-[80px]" />
                    <div class="h-3 bg-gray-100 rounded-full w-[60px]" />
                  </div>

                  {/* Progress bar */}
                  <div class="w-full bg-gray-100 rounded-full h-[5px] mb-2.5 overflow-hidden">
                    <div class="bg-gray-200 h-full rounded-full w-1/2" />
                  </div>

                  {/* Stats */}
                  <div class="flex justify-between items-end">
                    <div class="space-y-1">
                      <div class="h-2 bg-gray-100 rounded w-12" />
                      <div class="h-3 bg-gray-200 rounded w-16" />
                    </div>
                    <div class="space-y-1 text-right">
                      <div class="h-2 bg-gray-100 rounded w-10 ml-auto" />
                      <div class="h-3 bg-gray-200 rounded w-12 ml-auto" />
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        {/* Hasil list */}
        <div id="campaign-list" class="space-y-3">
          {
            programList.map((item: any) => (
              <CampaignList
                link={`/donasi/${item.link}`}
                title={item.title}
                image={item.image}
                mitra={item.mitra.name}
                category={item.category.name}
                progress_achieved={item.progress_achieved}
                collected_amount={item.nominal_achieved}
                days_left={item.time_target}
              />
            ))
          }
        </div>

        {/* Empty state */}
        <div
          id="campaign-empty"
          class="hidden flex flex-col items-center py-16 text-center"
        >
          <div
            class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-4"
          >
            <svg
              class="w-8 h-8 text-gray-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
          </div>
          <p class="text-sm font-semibold text-gray-700">
            Tidak ada program ditemukan
          </p>
          <p class="text-xs text-gray-400 mt-1">
            Coba ubah filter atau kata kunci pencarian
          </p>
        </div>

        {/* Infinite scroll sentinel */}
        <div id="scroll-sentinel" class="h-4"></div>

        {/* Loading spinner */}
        <div id="loadmore-spinner" class="hidden py-4">
          <div
            class="flex justify-center items-center gap-2 text-sm text-gray-400"
          >
            <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none">
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span>Memuat...</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <BottomNav active="program" />
</MainLayout>

<script>
  import { formatRupiah, getRemainingDays } from "@/lib/formatter";

  document.addEventListener("DOMContentLoaded", () => {
    const page = document.getElementById("campaign-page") as HTMLElement;

    // ── State ──────────────────────────────────────────────────────────────
    const API_URL = page.dataset.apiUrl ?? "";
    let currentCategory: string | null = page.dataset.categoryId || null;
    let currentSearch: string | null = page.dataset.search || null;
    let currentPage = 2;
    let hasMore = page.dataset.hasNext === "true";
    let isLoadingMore = false;
    let observer: IntersectionObserver | null = null;

    // ── Elements ───────────────────────────────────────────────────────────
    const btnOpenCategoryModal = document.getElementById(
      "btn-open-category-modal",
    ) as HTMLButtonElement | null;
    const btnMoreCategories = document.getElementById(
      "btn-more-categories",
    ) as HTMLButtonElement | null;
    const btnCloseCategoryModal = document.getElementById(
      "btn-close-category-modal",
    ) as HTMLButtonElement | null;
    const categoryModalBackdrop = document.getElementById(
      "category-modal-backdrop",
    ) as HTMLElement | null;
    const categoryModalSheet = document.getElementById(
      "category-modal-sheet",
    ) as HTMLElement | null;

    const categoryPills =
      document.querySelectorAll<HTMLButtonElement>(".category-pill");
    const categoryModalItems = document.querySelectorAll<HTMLButtonElement>(
      ".category-modal-item",
    );

    const campaignList = document.getElementById(
      "campaign-list",
    ) as HTMLElement;
    const campaignSkeleton = document.getElementById(
      "campaign-skeleton",
    ) as HTMLElement;
    const campaignEmpty = document.getElementById(
      "campaign-empty",
    ) as HTMLElement;
    const scrollSentinel = document.getElementById(
      "scroll-sentinel",
    ) as HTMLElement;
    const loadmoreSpinner = document.getElementById(
      "loadmore-spinner",
    ) as HTMLElement;

    // ── Helpers ────────────────────────────────────────────────────────────
    function buildCampaignCard(item: any): string {
      const progress = Math.min(Math.max(item.progress_achieved ?? 0, 0), 100);
      const mitra = item.mitra?.name ?? "";
      const category = item.category?.name ?? "";
      const collected = formatRupiah(item.nominal_achieved ?? 0);
      const daysLeft = item.time_target ?? "-";

      return `
        <a href="/donasi/${item.link}/" class="group flex flex-row items-stretch bg-white rounded border border-gray-100 overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200 w-full">
          <div class="relative flex-shrink-0 w-[160px] md:w-[180px] m-2.5 rounded-lg overflow-hidden bg-gray-100">
            <img src="${item.image}" alt="${item.title}" width="140" height="140" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]" />
          </div>
          <div class="flex flex-col justify-between flex-1 min-w-0 py-3 pr-3 pl-1">
            <h2 class="text-[12px] truncate font-semibold text-gray-800 leading-snug line-clamp-2 mb-2 group-hover:text-primary-600 transition-colors duration-150">${item.title}</h2>
            <div class="flex items-center gap-1.5 mb-2.5">
              <img src="/images/icons/verif/Verifikasi II.png" alt="verified" width="12" height="12" loading="lazy" decoding="async" class="w-3 h-3 flex-shrink-0 object-contain" />
              <span class="text-[11px] text-gray-500 font-medium truncate max-w-[90px]" title="${mitra}">${mitra}</span>
              <span class="text-[10px] font-medium bg-orange-50 text-orange-700 rounded-full px-2 py-0.5 truncate max-w-[80px] md:max-w-[110px] flex-shrink-0" title="${category}"> ${category} </span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-[5px] mb-2.5 overflow-hidden">
              <div class="bg-primary-500 h-full rounded-full" style="width:${progress}%" role="progressbar" aria-valuenow="${progress}" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div class="flex justify-between items-end">
              <div>
                <p class="text-[10px] text-gray-400 mb-0.5 leading-none">Terkumpul</p>
                <p class="text-[12px] font-semibold text-primary-700 leading-none">${collected}</p>
              </div>
              <div class="text-right">
                <p class="text-[10px] text-gray-400 mb-0.5 leading-none">Sisa hari</p>
                <p class="text-[12px] font-semibold text-gray-700 leading-none">${getRemainingDays(daysLeft)}</p>
              </div>
            </div>
          </div>
        </a>`;
    }

    // ── Modal Handlers ─────────────────────────────────────────────────────
    function openModal() {
      if (!categoryModalBackdrop || !categoryModalSheet) return;
      categoryModalBackdrop.classList.remove(
        "opacity-0",
        "pointer-events-none",
      );
      categoryModalSheet.classList.remove(
        "translate-y-full",
        "pointer-events-none",
      );
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!categoryModalBackdrop || !categoryModalSheet) return;
      categoryModalBackdrop.classList.add("opacity-0", "pointer-events-none");
      categoryModalSheet.classList.add(
        "translate-y-full",
        "pointer-events-none",
      );
      document.body.style.overflow = "";
    }

    btnOpenCategoryModal?.addEventListener("click", openModal);
    btnMoreCategories?.addEventListener("click", openModal);
    btnCloseCategoryModal?.addEventListener("click", closeModal);
    categoryModalBackdrop?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });

    // ── Category Change / Selection ────────────────────────────────────────
    function selectCategory(id: string | null) {
      if (currentCategory === id) {
        closeModal();
        return;
      }

      currentCategory = id;

      // 1. Update UI Filter Button
      if (btnOpenCategoryModal) {
        if (currentCategory) {
          btnOpenCategoryModal.className =
            "shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer border border-primary-500 bg-primary-50 text-primary-700 font-semibold shadow-xs";
        } else {
          btnOpenCategoryModal.className =
            "shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer border border-gray-200 bg-white text-gray-700 hover:border-primary-400 hover:text-primary-600 font-medium";
        }
      }

      // 2. Update UI Horizontal Pills
      let matchedPill: HTMLButtonElement | null = null;
      categoryPills.forEach((pill) => {
        const isSelected = (pill.dataset.id || null) === currentCategory;
        if (isSelected) {
          matchedPill = pill;
          pill.className =
            "category-pill shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer bg-primary-600 text-white font-semibold shadow-xs";
        } else {
          pill.className =
            "category-pill shrink-0 flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs transition-all duration-200 cursor-pointer bg-gray-100/90 text-gray-600 hover:bg-gray-200 hover:text-gray-900 font-medium";
        }
      });

      if (matchedPill) {
        (matchedPill as HTMLButtonElement).scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center",
        });
      }

      // 3. Update UI Modal Items
      categoryModalItems.forEach((item) => {
        const isSelected = (item.dataset.id || null) === currentCategory;
        const checkIcon = item.querySelector(".modal-check-icon");
        const svg = checkIcon?.querySelector("svg");

        if (isSelected) {
          item.className =
            "category-modal-item w-full flex items-center justify-between p-3 rounded-2xl border transition-all duration-200 cursor-pointer text-left border-primary-500 bg-primary-50/70 text-primary-800 font-semibold";
          if (checkIcon) {
            checkIcon.className =
              "modal-check-icon w-5 h-5 rounded-full border flex items-center justify-center shrink-0 border-primary-600 bg-primary-600 text-white";
          }
          if (svg) svg.classList.remove("hidden");
        } else {
          item.className =
            "category-modal-item w-full flex items-center justify-between p-3 rounded-2xl border transition-all duration-200 cursor-pointer text-left border-gray-100 bg-gray-50/70 hover:bg-gray-100 text-gray-700";
          if (checkIcon) {
            checkIcon.className =
              "modal-check-icon w-5 h-5 rounded-full border flex items-center justify-center shrink-0 border-gray-300 bg-white";
          }
          if (svg) svg.classList.add("hidden");
        }
      });

      // 4. Update URL params
      const url = new URL(window.location.href);
      if (currentCategory) {
        url.searchParams.set("category", currentCategory);
      } else {
        url.searchParams.delete("category");
      }
      window.history.replaceState({}, "", url.toString());

      closeModal();
      fetchCampaigns(true);
    }

    // Pill click listeners
    categoryPills.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectCategory(btn.dataset.id || null);
      });
    });

    // Modal item click listeners
    categoryModalItems.forEach((btn) => {
      btn.addEventListener("click", () => {
        selectCategory(btn.dataset.id || null);
      });
    });

    // ── Infinite scroll observer ───────────────────────────────────────────
    function setupObserver() {
      if (observer) observer.disconnect();
      if (!hasMore) return;

      observer = new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting && hasMore && !isLoadingMore) {
            loadNextPage();
          }
        },
        { rootMargin: "0px 0px 200px 0px" },
      );
      observer.observe(scrollSentinel);
    }

    async function loadNextPage() {
      isLoadingMore = true;
      loadmoreSpinner.classList.remove("hidden");

      try {
        const params = new URLSearchParams({
          limit: "5",
          mode: "pagination",
          page: String(currentPage),
        });
        if (currentCategory) params.set("category", currentCategory);
        if (currentSearch) params.set("search", currentSearch);

        const res = await fetch(`${API_URL}/programs?${params}`);
        const json = await res.json();
        const payload = json?.data;
        const items: any[] = payload?.data ?? [];
        const meta = payload?.meta;
        hasMore = Boolean(meta && meta.current_page < meta.last_page);

        items.forEach((item) => {
          campaignList.insertAdjacentHTML("beforeend", buildCampaignCard(item));
        });

        currentPage++;
        if (!hasMore) observer?.disconnect();
      } catch {
        // silent fail — observer tetap aktif agar bisa retry saat scroll
      } finally {
        isLoadingMore = false;
        loadmoreSpinner.classList.add("hidden");
      }
    }

    // ── Fetch & render ulang campaign ──────────────────────────────────────
    async function fetchCampaigns(resetList = true) {
      if (resetList) {
        campaignList.innerHTML = "";
        campaignSkeleton.classList.remove("hidden");
        campaignEmpty.classList.add("hidden");
        observer?.disconnect();
        currentPage = 2;
        hasMore = false;
      }

      try {
        const params = new URLSearchParams({
          limit: "5",
          mode: "pagination",
          page: "1",
        });
        if (currentCategory) params.set("category", currentCategory);
        if (currentSearch) params.set("search", currentSearch);

        const res = await fetch(`${API_URL}/programs?${params}`);
        const json = await res.json();
        const payload = json?.data;
        const items: any[] = payload?.data ?? [];
        const meta = payload?.meta;
        hasMore = Boolean(meta && meta.current_page < meta.last_page);

        campaignSkeleton.classList.add("hidden");

        if (items.length === 0) {
          campaignEmpty.classList.remove("hidden");
          return;
        }

        items.forEach((item) => {
          campaignList.insertAdjacentHTML("beforeend", buildCampaignCard(item));
        });

        setupObserver();
      } catch {
        campaignSkeleton.classList.add("hidden");
        campaignEmpty.classList.remove("hidden");
      }
    }

    // ── Init infinite scroll untuk data SSR pertama ────────────────────────
    setupObserver();
  });
</script>
