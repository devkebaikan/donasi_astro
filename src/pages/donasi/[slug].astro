---
export const prerender = false;

import Banner from "@/components/sections/donasi/Banner.astro";
import BoxGuaratee from "@/components/sections/donasi/BoxGuaratee.astro";
import ProfileMitra from "@/components/sections/donasi/ProfileMitra.astro";
import TabSection from "@/components/sections/donasi/TabSection.astro";
import StickyDonateBar from "@/components/sections/donasi/StickyDonateBar.astro";
import DonatePanel from "@/components/sections/donasi/DonatePanel.astro";
import {
  getCampaignByLink,
  getDonorsByLink,
  getNominalOptions,
} from "@/lib/FetchData";
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import ShowJsonData from "@/components/ui/ShowJsonData.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/");
}

const projectId = Astro.url.searchParams.get("project");

const utm = Astro.url.searchParams.toString();
if (Astro.url.searchParams.has("utm_source")) {
  Astro.cookies.set("utm_params", utm, {
    path: "/",
    maxAge: 60 * 60 * 24,
  });
}

let dataDetailCampaign, dataDonors, nominalOptions;
try {
  [dataDetailCampaign, dataDonors, nominalOptions] = await Promise.all([
    getCampaignByLink(slug),
    getDonorsByLink(slug),
    getNominalOptions(slug),
  ]);
} catch (err: any) {
  const status = err?.response?.status ?? err?.status ?? null;
  if (status === 404 || String(err?.message ?? "").includes("404")) {
    return Astro.redirect("/404");
  }
  // For other errors, fallback to 404 to avoid exposing internal error to users
  return Astro.redirect("/404");
}

const detailCampaign = dataDetailCampaign?.data ?? {};
const donors = dataDonors?.data ?? [];

// Jika data campaign tidak ditemukan atau kosong, lempar ke halaman 404
if (!detailCampaign || Object.keys(detailCampaign).length === 0) {
  return Astro.redirect("/404");
}

const isRutin = detailCampaign?.is_rutin === true;
const isActive = detailCampaign?.status === "PUBLISH";

// SEO
const campaignTitle = detailCampaign?.title ?? "Detail Donasi";
const campaignImage = detailCampaign?.image ?? null;

const lastProjectId =
  detailCampaign?.last_two_projects &&
  detailCampaign?.last_two_projects.length > 0
    ? detailCampaign?.last_two_projects[0].id
    : null;

const campaignJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Beranda",
          item: Astro.url.origin + "/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Donasi",
          item: Astro.url.origin + "/donasi",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: campaignTitle,
          item: Astro.url.href,
        },
      ],
    },
    {
      "@type": "DonateAction",
      name: `Donasi — ${campaignTitle}`,
      url: Astro.url.href,
      recipient: {
        "@type": "Organization",
        name: detailCampaign?.mitra?.name ?? "Aksiberbagi.com",
      },
    },
  ],
});
---

<MainLayout
  title={campaignTitle}
  description={detailCampaign?.short_description ??
    "Detail kampanye donasi di Aksiberbagi.com"}
  image={campaignImage ?? undefined}
  imageAlt={campaignTitle}
  type="article"
  publishedTime={detailCampaign?.created_at}
  modifiedTime={detailCampaign?.updated_at}
  robots={isActive ? "index, follow" : "noindex, follow"}
>
  <Header
    type="title"
    text={detailCampaign ? detailCampaign.title : "Detail Donasi"}
    link="/home"
  />

  <script is:inline type="application/ld+json" set:html={campaignJsonLd} />

  <div class="bg-white min-h-screen container">
    <div class="mx-auto mb-24 max-w-120">
      <Banner
        link={slug}
        detailCampaign={detailCampaign}
        donors={donors}
        projectId={lastProjectId ?? null}
      />
      <BoxGuaratee />
      <ProfileMitra
        programLink={detailCampaign?.link}
        programId={detailCampaign?.id}
        projekSalur={detailCampaign?.last_two_projects}
      />
      <!-- <ShowJsonData data={detailCampaign?.last_two_projects[0].id} /> -->
      <TabSection slug={slug} detailCampaign={detailCampaign} />
    </div>

    <StickyDonateBar isRutin={isRutin} link={slug} isActive={isActive} />
    <DonatePanel
      nominalOptions={nominalOptions}
      programId={detailCampaign?.id}
      programLink={detailCampaign?.link}
      projectId={projectId ? Number(projectId) : null}
    />
  </div>
</MainLayout>
