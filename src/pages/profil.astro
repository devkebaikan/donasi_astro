---
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import { getServerToken } from "@/lib/auth";
import { getInitialName } from "@/lib/formatter";

export const prerender = false;

const token = getServerToken(Astro.cookies);
if (!token) return Astro.redirect("/login");

const apiUrl = import.meta.env.PUBLIC_API_URL;

type User = {
  name: string;
  phone: string;
  email: string;
  reff_code: string;
};

async function fetchUser(): Promise<User | null> {
  try {
    const res = await fetch(`${apiUrl}/auth/me`, {
      headers: {
        Accept: "application/json",
        Authorization: `Bearer ${token}`,
      },
    });
    if (!res.ok) return null;
    const json = await res.json();
    return json?.data ?? null;
  } catch {
    return null;
  }
}

const user = await fetchUser();
---

<MainLayout title="Ubah Profil" description="Ubah profil akun Anda">
  <Header type="title" text="Ubah Profil" link="/akun" />

  <main class="min-h-screen">
    <div class="container px-2.5 bg-neutral-50 pt-16 pb-32">
      <!-- Avatar card -->
      <div
        class="bg-white rounded-lg border border-gray-100 shadow-sm p-4 mt-4"
      >
        <div class="flex items-center gap-3.5">
          <div class="flex items-center gap-3">
            <div
              id="user-avatar-initials"
              class="w-[54px] h-[54px] rounded-full bg-gradient-to-br from-primary-600 via-primary-500 to-emerald-500 border-2 border-white/30 flex items-center justify-center text-base font-bold text-white shrink-0 shadow-md"
            >
              <span id="user-initials-text">
                <!-- skeleton -->
                {getInitialName(user?.name || "H")}
              </span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-base font-semibold text-gray-900 truncate">
                {user?.name || "..."}
              </div>
              <div class="text-xs text-gray-400 truncate">
                {user?.phone || "-"}
              </div>
              <div class="text-xs text-gray-400 truncate">
                {user?.email || "-"}
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Profile form -->
      <form id="form-profile" class="mt-6" novalidate>
        <p class="text-xs font-semibold text-gray-500 mb-3 uppercase">
          Data Pribadi
        </p>
        <div
          class="bg-white rounded-lg border border-gray-100 shadow-sm p-4 space-y-3"
        >
          <div>
            <label for="name" class="text-[11px] text-gray-400 mb-1.5 block"
              >Nama Pengguna</label
            >
            <input
              id="name"
              name="name"
              type="text"
              value={user?.name || ""}
              placeholder="Nama lengkap"
              class="w-full border border-gray-200 rounded-xl py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
            />
          </div>
          <div>
            <label for="phone" class="text-[11px] text-gray-400 mb-1.5 block"
              >Nomor Whatsapp</label
            >
            <input
              id="phone"
              name="phone"
              type="tel"
              inputmode="numeric"
              value={user?.phone || ""}
              placeholder="08xxxxxxxxxx"
              class="w-full border border-gray-200 rounded-xl py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
            />
          </div>
          <div>
            <label for="email" class="text-[11px] text-gray-400 mb-1.5 block"
              >Email</label
            >
            <input
              id="email"
              name="email"
              type="email"
              value={user?.email || ""}
              placeholder="email@domain.com"
              class="w-full border border-gray-200 rounded-xl py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
            />
          </div>
          <div>
            <label
              for="reff_code"
              class="text-[11px] text-gray-400 mb-1.5 block"
              >Kode Referral</label
            >
            <input
              id="reff_code"
              name="reff_code"
              type="text"
              value={user?.reff_code || ""}
              placeholder="Kode referral"
              class="w-full border border-gray-200 rounded-xl py-2.5 px-3 text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
            />
          </div>
        </div>
        <button
          id="btn-profile"
          type="submit"
          class="mt-4 w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white font-semibold py-3.5 rounded-lg transition-all duration-150 disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed"
        >
          Simpan Perubahan
        </button>
      </form>

      <!-- Password form -->
      <form id="form-password" class="mt-8" novalidate>
        <p class="text-xs font-semibold text-gray-500 mb-3 uppercase">
          Ubah Password
        </p>
        <div
          class="bg-white rounded-lg border border-gray-100 shadow-sm p-4 space-y-3"
        >
          <div>
            <label for="password" class="text-[11px] text-gray-400 mb-1.5 block"
              >Password Baru</label
            >
            <div class="relative">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                placeholder="Masukan password baru"
                class="w-full border border-gray-200 rounded-xl py-2.5 px-3 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
              />
              <button
                type="button"
                data-toggle-password="password"
                aria-label="Tampilkan password"
                class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600"
              >
                <svg
                  class="w-5 h-5 toggle-eye"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  ></path>
                </svg>
                <svg
                  class="w-5 h-5 toggle-eye-slash hidden"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                  ></path>
                </svg>
              </button>
            </div>
          </div>
          <div>
            <label
              for="password_confirmation"
              class="text-[11px] text-gray-400 mb-1.5 block"
              >Konfirmasi Password</label
            >
            <div class="relative">
              <input
                id="password_confirmation"
                name="password_confirmation"
                type="password"
                autocomplete="new-password"
                placeholder="Ulangi password"
                class="w-full border border-gray-200 rounded-xl py-2.5 px-3 pr-10 text-sm focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
              />
              <button
                type="button"
                data-toggle-password="password_confirmation"
                aria-label="Tampilkan password"
                class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600"
              >
                <svg
                  class="w-5 h-5 toggle-eye"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  ></path>
                </svg>
                <svg
                  class="w-5 h-5 toggle-eye-slash hidden"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.477 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                  ></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
        <button
          id="btn-password"
          type="submit"
          class="mt-4 w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white font-semibold py-3.5 rounded-lg transition-all duration-150 disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed"
        >
          Ubah Password
        </button>
      </form>

      <div class="hidden" data-config data-api-url={apiUrl}></div>

      <script>
        import { showToast } from "@/lib/toast";
        import { getToken } from "@/lib/auth";

        const config = document.querySelector("[data-config]") as HTMLElement;
        const apiUrl = config.dataset.apiUrl as string;
        const token = getToken();

        // Toggle password visibility
        document
          .querySelectorAll<HTMLButtonElement>("[data-toggle-password]")
          .forEach((btn) => {
            btn.addEventListener("click", () => {
              const targetId = btn.dataset.togglePassword as string;
              const input = document.getElementById(
                targetId,
              ) as HTMLInputElement | null;
              if (!input) return;
              const eye = btn.querySelector(".toggle-eye");
              const eyeSlash = btn.querySelector(".toggle-eye-slash");
              const visible = input.type === "text";
              input.type = visible ? "password" : "text";
              eye?.classList.toggle("hidden", !visible);
              eyeSlash?.classList.toggle("hidden", visible);
            });
          });

        // Profile form submit
        const formProfile = document.getElementById(
          "form-profile",
        ) as HTMLFormElement | null;
        const btnProfile = document.getElementById(
          "btn-profile",
        ) as HTMLButtonElement | null;
        const avatarName = document.querySelector(
          ".truncate.text-base",
        ) as HTMLElement | null;

        formProfile?.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!btnProfile) return;

          const fd = new FormData(formProfile);
          const raw = {
            name: ((fd.get("name") as string) ?? "").trim(),
            phone: ((fd.get("phone") as string) ?? "").trim(),
            email: ((fd.get("email") as string) ?? "").trim(),
            reff_code: ((fd.get("reff_code") as string) ?? "").trim(),
          };
          const payload = Object.fromEntries(
            Object.entries(raw).filter(
              ([_, v]) => v !== "" && v !== null && v !== undefined,
            ),
          );

          btnProfile.disabled = true;
          btnProfile.textContent = "Processing...";

          try {
            const res = await fetch(
              `${apiUrl}/dashboard/change-personal-data`,
              {
                method: "POST",
                headers: {
                  Accept: "application/json",
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify(payload),
              },
            );
            if (!res.ok) throw new Error("failed");
            const json = await res.json().catch(() => null);
            const updated = json?.data;
            if (updated) {
              (document.getElementById("name") as HTMLInputElement).value =
                updated.name ?? "";
              (document.getElementById("phone") as HTMLInputElement).value =
                updated.phone ?? "";
              (document.getElementById("email") as HTMLInputElement).value =
                updated.email ?? "";
              (document.getElementById("reff_code") as HTMLInputElement).value =
                updated.reff_code ?? "";
              if (avatarName) avatarName.textContent = updated.name ?? "...";
            }
            showToast("Profil berhasil diubah", "success");
          } catch {
            showToast("Gagal mengubah profil. Silakan coba lagi.", "error");
          } finally {
            btnProfile.disabled = false;
            btnProfile.textContent = "Simpan Perubahan";
          }
        });

        // Password form submit
        const formPassword = document.getElementById(
          "form-password",
        ) as HTMLFormElement | null;
        const btnPassword = document.getElementById(
          "btn-password",
        ) as HTMLButtonElement | null;

        formPassword?.addEventListener("submit", async (e) => {
          e.preventDefault();
          if (!btnPassword) return;

          const fd = new FormData(formPassword);
          const password = (fd.get("password") as string) ?? "";
          const password_confirmation =
            (fd.get("password_confirmation") as string) ?? "";

          if (!password || !password_confirmation) {
            showToast("Password tidak boleh kosong.", "error");
            return;
          }
          if (password !== password_confirmation) {
            showToast("Password dan konfirmasi password tidak cocok.", "error");
            return;
          }

          btnPassword.disabled = true;
          btnPassword.textContent = "Processing...";

          try {
            const res = await fetch(`${apiUrl}/dashboard/change-password`, {
              method: "POST",
              headers: {
                Accept: "application/json",
                "Content-Type": "application/json",
                Authorization: `Bearer ${token}`,
              },
              body: JSON.stringify({ password, password_confirmation }),
            });
            if (!res.ok) throw new Error("failed");
            showToast("Password berhasil diubah!", "success");
            formPassword.reset();
          } catch {
            showToast("Gagal mengubah password. Silakan coba lagi.", "error");
          } finally {
            btnPassword.disabled = false;
            btnPassword.textContent = "Ubah Password";
          }
        });
      </script>
    </div>
  </main></MainLayout
>
