---
export const prerender = false;

import MainLayout from "@/layouts/MainLayout.astro";
import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";
import { getServerToken } from "@/lib/auth";

const isAuthenticated = getServerToken(Astro.cookies) !== null;
---

<MainLayout
  title="Donasi Rutin"
  description="Wujudkan pahala yang mengalir terus menerus dengan donasi rutin otomatis."
>
  <Header type="title" text="Donasi Rutin" />

  <div id="rutin-page"
   data-api-url={import.meta.env.PUBLIC_API_URL} 
   class="container min-h-screen pb-24 bg-gray-50">

    <!-- ── Hero Banner ─────────────────────────────────────────────────────── -->
    <div class="relative overflow-hidden">

      <!-- Gradient Background -->
      <div class="relative bg-gradient-to-tr from-primary-100 to-primary-300 px-5 py-9 overflow-hidden  pt-18">

        <!-- Dekorasi lingkaran background -->
        <div class="absolute -top-8 -right-8 w-40 h-40 bg-primary-300/30 rounded-full"></div>
        <div class="absolute -bottom-6 right-10 w-24 h-24 bg-primary-400/20 rounded-full"></div>

        <!-- Content -->
        <div class="relative z-10 w-11/12">

          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full mb-3 shadow-sm">
            <!-- Heart icon -->
            <svg class="w-3 h-3 text-rose-500 fill-current" viewBox="0 0 24 24">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span class="text-[10px] font-semibold text-gray-700 tracking-wide">
              DONASI RUTIN
            </span>
          </div>

          <!-- Title -->
          <h2 class="text-[18px] font-bold text-gray-800 leading-tight mb-2">
            Berbagi Kebaikan<br />
            <span class="text-primary-600">Setiap Hari, Tanpa Putus</span>
          </h2>

          <!-- Description -->
          <p class="text-[13px] text-gray-700/80 leading-relaxed mb-4 font-medium">
            Wujudkan pahala yang mengalir terus menerus dengan donasi rutin
            otomatis dari Saku Berbagimu
          </p>

          <!-- CTA Button — hanya tampil jika sudah login (server-side) -->
          {isAuthenticated && (
            
          <a href="/donasi-rutin/opsi"
              class="inline-flex mb-4 items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-md shadow-orange-200 active:scale-95"
            >
              <span>Mulai Donasi Rutin</span>
              <!-- Arrow right icon -->
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          )}

          <!-- CTA login prompt — hanya tampil jika belum login -->
          {!isAuthenticated && (
            
            <a href="/auth/login"
              class="inline-flex items-center gap-2 border border-secondary-500 text-secondary-600 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-secondary-50 transition-all active:scale-95"
            >
              <span>Masuk untuk Mulai</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Feature Cards — menimpa banner dengan -mt -->
      <div class="px-4 -mt-6 relative z-20 mb-4">
        <div class="bg-white rounded-2xl shadow-sm p-4 border border-gray-100">
          <div class="grid grid-cols-3 gap-3">

            <!-- Atur Jadwal -->
            <div class="text-center">
              <div class="w-12 h-12 mx-auto bg-linear-to-br from-blue-50 to-blue-100 rounded-xl flex items-center justify-center mb-2 shadow-sm">
                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <p class="text-xs font-semibold text-gray-700 leading-tight">Atur Jadwal</p>
              <p class="text-[11px] text-gray-400 mt-0.5">Fleksibel</p>
            </div>

            <!-- Auto Debit -->
            <div class="text-center">
              <div class="w-12 h-12 mx-auto bg-linear-to-br from-green-50 to-green-100 rounded-xl flex items-center justify-center mb-2 shadow-sm">
                <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
              </div>
              <p class="text-xs font-semibold text-gray-700 leading-tight">Auto Debit</p>
              <p class="text-[11px] text-gray-400 mt-0.5">Mudah</p>
            </div>

            <!-- Pahala Rutin -->
            <div class="text-center">
              <div class="w-12 h-12 mx-auto bg-linear-to-br from-rose-50 to-rose-100 rounded-xl flex items-center justify-center mb-2 shadow-sm">
                <svg class="w-5 h-5 text-rose-600 fill-current" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </div>
              <p class="text-xs font-semibold text-gray-700 leading-tight">Pahala Rutin</p>
              <p class="text-[11px] text-gray-400 mt-0.5">Berkah</p>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- ── List Donasi Rutin ────────────────────────────────────────────────── -->
    <div class="mt-6 px-4 space-y-3">

      <!-- Section Header -->
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
          <span class="w-1 h-5 bg-primary-500 rounded-full"></span>
          <span class="text-sm font-semibold text-gray-700">Donasi Rutin Saya</span>
        </div>

        <!-- State: belum login -->
        {!isAuthenticated && (
          <div class="flex flex-col items-center py-10 text-center px-4">
            <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mb-3">
              <svg class="w-7 h-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-gray-700">Masuk untuk melihat donasi rutin</p>
            <p class="text-xs text-gray-400 mt-1 mb-4">Kelola jadwal donasi otomatis kamu</p>
            
            <a  href="/auth/login"
              class="inline-flex items-center gap-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all"
            >
              Masuk Sekarang
            </a>
          </div>
        )}

        <!-- State: sudah login — list di-render client-side -->
        {isAuthenticated && (
          <div>
            <!-- Skeleton loading -->
            <div id="donasi-rutin-skeleton" class="divide-y divide-gray-50">
              {[1, 2, 3,4 ].map(() => (
                <div class="px-4 py-4 flex items-center gap-3">
                  <div class="w-[160px] bg-gray-200 rounded-xl animate-pulse shrink-0"></div>
                  <div class="flex-1 space-y-2">
                    <div class="h-3.5 bg-gray-200 rounded w-3/4 animate-pulse"></div>
                    <div class="h-3 bg-gray-200 rounded w-1/2 animate-pulse"></div>
                  </div>
                  <div class="h-3 bg-gray-200 rounded w-16 animate-pulse"></div>
                </div>
              ))}
            </div>

            <!-- List container -->
            <div id="donasi-rutin-list" class="hidden divide-y divide-gray-50"></div>

            <!-- Empty state -->
            <div id="donasi-rutin-empty" class="hidden flex-col items-center py-10 text-center px-4">
              <div class="w-14 h-14 bg-primary-50 rounded-full flex items-center justify-center mb-3">
                <svg class="w-7 h-7 text-primary-400 fill-current" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
              </div>
              <p class="text-sm font-medium text-gray-700">Belum ada donasi rutin</p>
              <p class="text-xs text-gray-400 mt-1 mb-4">Mulai jadwalkan kebaikanmu sekarang</p>
              
               <a href="/donasi-rutin/opsi"
                class="inline-flex items-center gap-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all"
              >
                Buat Donasi Rutin
              </a>
            </div>

            <!-- Error state -->
            <div id="donasi-rutin-error" class="hidden flex-col items-center py-10 text-center px-4">
              <p class="text-sm font-medium text-gray-700">Gagal memuat data</p>
              <p class="text-xs text-gray-400 mt-1">Periksa koneksi dan coba lagi</p>
            </div>
          </div>
        )}
      </div>

      <!-- Load more -->
      <div id="donasi-rutin-loadmore" class="hidden">
        <button
          id="btn-loadmore"
          data-page="2"
          class="w-full border border-primary-400 text-primary-600 text-sm font-semibold py-2.5 rounded-xl hover:bg-primary-50 transition-colors"
        >
          Lihat lebih banyak
        </button>
      </div>

    </div>
  </div>

  <BottomNav active="rutin" />
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";
  import { formatRupiah } from "@/lib/formatter";
  import { getToken } from "@/lib/auth";

  const page = document.getElementById("rutin-page") as HTMLElement;
  const API_URL = page?.dataset.apiUrl ?? "";

  document.addEventListener("DOMContentLoaded", () => {
    const skeleton = document.getElementById("donasi-rutin-skeleton") as HTMLElement;
    const list     = document.getElementById("donasi-rutin-list")     as HTMLElement;
    const empty    = document.getElementById("donasi-rutin-empty")    as HTMLElement;
    const errorEl  = document.getElementById("donasi-rutin-error")   as HTMLElement;
    const loadmore = document.getElementById("donasi-rutin-loadmore") as HTMLElement;
    const btnMore  = document.getElementById("btn-loadmore")          as HTMLButtonElement;

    // Elemen hanya ada jika user sudah login (server-side render)
    if (!skeleton) return;

    const token = getToken();

    // ── Render item ──────────────────────────────────────────────────────────
   function renderItem(item: any): string {
  const statusClass =
    item.status === "active"
      ? "bg-primary-50 text-primary-600"
      : "bg-gray-100 text-gray-400";

  const image = item.program?.image
    ? `<img 
         src="${item.program.image}" 
         alt="${item.program?.title ?? ""}" 
         class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]" 
         loading="lazy"
       />`
    : `<div class="flex items-center justify-center w-full h-full bg-gray-100">
         <svg class="w-6 h-6 text-primary-500 fill-current" viewBox="0 0 24 24">
           <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
         </svg>
       </div>`;

  function formatSchedule() {
    if (!item.range_type) return "-";

    switch (item.range_type) {
      case "daily":
        return `Setiap ${item.range} hari • ${item.time ?? "-"}`;
      case "weekly":
        return `Setiap ${item.range} minggu • ${item.time ?? "-"}`;
      case "monthly":
        return `Setiap ${item.range} bulan • ${item.time ?? "-"}`;
      default:
        return "-";
    }
  }

  return `
    <a 
      href="/donasi-rutin/detail/${item.id}" 
      class="group flex flex-row items-stretch bg-white rounded border border-gray-100
             overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200 w-full"
    >

      <!-- Image -->
      <div class="relative flex-shrink-0 w-[160px] m-2.5 rounded-lg overflow-hidden bg-gray-100">
        ${image}
      </div>

      <!-- Content -->
      <div class="flex flex-col justify-between flex-1 min-w-0 py-3 pr-3 pl-1">

        <!-- Title -->
        <p class="text-[13px] font-semibold text-gray-800 leading-snug line-clamp-2 mb-1 group-hover:text-primary-600 transition-colors duration-150">
          ${item.program?.title ?? "-"}
        </p>

        <!-- Schedule -->
        <p class="text-[11px] text-gray-400 mb-2">
          ${formatSchedule()}
        </p>

        <!-- Bottom Section -->
        <div class="flex justify-between items-end">

          <!-- Nominal -->
          <div>
            <p class="text-[10px] text-gray-400 mb-0.5 leading-none">
              Nominal
            </p>
            <p class="text-[13px] font-semibold text-primary-600 leading-none">
              ${formatRupiah(item.nominal ?? 0)}
            </p>
          </div>

          <!-- Status -->
          <span class="inline-block text-[10px] px-2 py-0.5 rounded-full font-medium ${statusClass}">
            ${item.status === "active" ? "Aktif" : "Nonaktif"}
          </span>

        </div>
      </div>
    </a>
  `;
}

    function showEmpty() {
      empty.classList.remove("hidden");
      empty.classList.add("flex");
    }

    function showError() {
      errorEl.classList.remove("hidden");
      errorEl.classList.add("flex");
    }

    // ── Fetch list ───────────────────────────────────────────────────────────
    async function fetchList(pg = 1, append = false) {
      try {
        const headers: Record<string, string> = { Accept: "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const res  = await fetch(`${API_URL}/dashboard/my-rutin?page=${pg}`, { headers });
        const json = await res.json();

        if (!res.ok) throw new Error(json?.message ?? "Gagal memuat data");

        const items: any[]   = json?.data ?? [];
        const hasMore: boolean = (json?.meta?.current_page ?? 1) < (json?.meta?.last_page ?? 1);

        skeleton.classList.add("hidden");

        if (items.length === 0 && !append) {
          showEmpty();
          return;
        }

        list.classList.remove("hidden");
        if (!append) list.innerHTML = "";
        list.insertAdjacentHTML("beforeend", items.map(renderItem).join(""));

        if (hasMore) {
          loadmore.classList.remove("hidden");
          btnMore.dataset.page = String(pg + 1);
        } else {
          loadmore.classList.add("hidden");
        }
      } catch (err: any) {
        skeleton.classList.add("hidden");
        showError();
        showToast(err.message ?? "Gagal memuat donasi rutin", "error");
      }
    }

    // ── Load more ────────────────────────────────────────────────────────────
    btnMore?.addEventListener("click", async () => {
      const nextPage = Number(btnMore.dataset.page ?? 2);
      btnMore.textContent = "Memuat...";
      btnMore.disabled = true;
      await fetchList(nextPage, true);
      btnMore.textContent = "Lihat lebih banyak";
      btnMore.disabled = false;
    });

    fetchList();
  });
</script>