---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import BottomNav from "@/components/layouts/BottomNav.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";

interface DonationItem {
  href: string;
  title: string;
  description: string;
  image: string;
}

const generalItems: DonationItem[] = [
  {
    image: "/assets/rutin/program-dipilihkan.png",
    href: "/donasi-rutin/form-rutin/dipilihkan",
    title: "Pilih Tujuan Donasi Rutin",
    description:
      "Donasi rutin ke program yang dipilihkan Beramalbersama.com untuk Anda",
  },
  {
    image: "/assets/rutin/pilih-sendiri.png",
    href: "/donasi-rutin/program",
    title: "Pilih Program Sendiri",
    description:
      "Cari program kebaikan yang akan ditambahkan ke dalam donasi rutin",
  },
];

const categoryItems: DonationItem[] = [
  {
    image: "/assets/rutin/pilih-sendiri.png",
    href: "/donasi-rutin/form-rutin/subuh",
    title: "Donasi Tiap Subuh",
    description: "Awali hari anda dengan keberkahan donasi rutin tiap Subuh",
  },
  {
    image: "/assets/rutin/pilih-sendiri.png",
    href: "/donasi-rutin/form-rutin/jumat",
    title: "Donasi Tiap Jum'at",
    description: "Jangan sampai ketinggalan keberkahan donasi di hari terbaik",
  },
];
---

<MainLayout
  title="Pilih Tujuan Donasi Rutin"
  description="Pilih tujuan donasi rutin Anda di Beramalbersama.com."
>
  <Header type="title" text="Pilih tujuan donasi rutin" link="/donasi-rutin" />

  <div class="min-h-screen bg-gray-50">
    <div class="container space-y-5 bg-white/80 min-h-screen">
      <!-- ── Hero Banner ─────────────────────────────────────────────────────── -->
      <div class="relative overflow-hidden">
        <!-- Gradient Background -->
        <div
          class="relative bg-gradient-to-tr from-primary-100 to-primary-300 px-5 py-9 overflow-hidden pt-18"
        >
          <!-- Dekorasi lingkaran background -->
          <div
            class="absolute -top-8 -right-8 w-40 h-40 bg-primary-300/30 rounded-full"
          >
          </div>
          <div
            class="absolute -bottom-6 right-10 w-24 h-24 bg-primary-400/20 rounded-full"
          >
          </div>

          <!-- Content -->
          <div class="relative z-10 w-11/12">
            <!-- Title -->
            <h2 class="text-[18px] font-bold text-gray-800 leading-tight mb-2">
              Berbagi Kebaikan<br />
              <span class="text-primary-600">Setiap Hari, Tanpa Putus</span>
            </h2>

            <!-- Description -->
            <p
              class="text-[13px] text-gray-700/80 leading-relaxed mb-4 font-medium"
            >
              Wujudkan pahala yang mengalir terus menerus dengan donasi rutin
              otomatis dari Saku Berbagimu
            </p>
          </div>
        </div>
      </div>

      <!-- General Section -->
      <div class="px-3">
        <p
          class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mb-2.5 ml-0.5"
        >
          Pilih untuk saya
        </p>
        <div
          class="bg-white rounded-xl border border-gray-100 overflow-hidden divide-y divide-gray-100 shadow-sm"
        >
          {
            generalItems.map(({ href, title, description, image }) => (
              <a
                href={href}
                class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors duration-150"
              >
                <div class="w-13 h-13 rounded-full flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
                  <img
                    src={image}
                    alt={title}
                    loading="lazy"
                    decoding="async"
                    class="object-contain w-8 h-8"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-900 mb-0.5 leading-snug">
                    {title}
                  </p>
                  <p class="text-xs text-gray-500 leading-relaxed">
                    {description}
                  </p>
                </div>
                <svg
                  class="w-4 h-4 text-gray-300 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Category Section -->
      <div class="px-3">
        <p
          class="text-[10px] font-semibold text-gray-500 uppercase tracking-widest mb-2.5 ml-0.5"
        >
          Kategori pilihan
        </p>
        <div
          class="bg-white rounded-xl border border-gray-100 overflow-hidden divide-y divide-gray-100 shadow-sm"
        >
          {
            categoryItems.map(({ href, title, description, image }) => (
              <a
                href={href}
                class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors duration-150"
              >
                <div class="w-13 h-13 rounded-full flex items-center justify-center shrink-0 shadow-sm overflow-hidden">
                  <Image
                    src={image}
                    alt={title}
                    width="44"
                    height="44"
                    loading="lazy"
                    decoding="async"
                    class="w-8 h-8 object-contain"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-900 mb-0.5 leading-snug">
                    {title}
                  </p>
                  <p class="text-xs text-gray-500 leading-relaxed">
                    {description}
                  </p>
                </div>
                <svg
                  class="w-4 h-4 text-gray-300 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <BottomNav active="rutin" />
</MainLayout>
