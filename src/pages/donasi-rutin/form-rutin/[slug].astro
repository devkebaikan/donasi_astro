---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getServerToken } from "@/lib/auth";
import FormRutin from "@/components/sections/rutin/FormRutin.astro";
import {
  getCampaignSetUp,
  getPaymentMethodFilter,
  getUserProfile,
} from "@/lib/FetchData.ts";

const { slug } = Astro.params;
const VALID_SLUGS = [
  "dipilihkan",
  "subuh",
  "jumat",
  "30-hari-temani-bertumbuh",
  "100-hari-menuju-ramadhan",
  "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu",
] as const;
type Slug = (typeof VALID_SLUGS)[number];

if (!slug || !VALID_SLUGS.includes(slug as Slug)) {
  return Astro.redirect("/donasi-rutin/opsi");
}

// Mapping slug ke parameter API getCampaignSetUp
const CAMPAIGN_KEY_MAP: Record<Slug, string> = {
  dipilihkan: "rutin",
  subuh: "subuh",
  jumat: "jumat",
  "30-hari-temani-bertumbuh": "subuh",
  "100-hari-menuju-ramadhan": "subuh",
  "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu": "jumat",
};

const token = getServerToken(Astro.cookies);

const [account, paymentMethods, dataPorgamSetup] = await Promise.all([
  token ? getUserProfile(token) : Promise.resolve(null),
  getPaymentMethodFilter({ status: "true" }),
  getCampaignSetUp("rutin"),
]);

const programId = (dataPorgamSetup?.value ?? "") as string;
const walletBalance = (account?.dompet_kebaikan?.saldo ?? 0) as number;

const BANNER: Record<
  Slug,
  { title: string; description: string; image: string; banner?: string }
> = {
  dipilihkan: {
    title: "Program Donasi Rutin Dipilihkan",
    description: "Donasi rutin ke program yang dipilihkan Beramal Bersama",
    image: "/assets/rutin/program-dipilihkan.png",
  },
  subuh: {
    title: "Donasi Tiap Subuh",
    description: "Awali hari anda dengan keberkahan donasi rutin tiap Subuh",
    image: "/assets/rutin/rutin-subuh.png",
  },
  jumat: {
    title: "Donasi Tiap Jum'at",
    description: "Jangan sampai ketinggalan keberkahan donasi di hari terbaik",
    image: "/assets/rutin/rutin-jumat.png",
    banner: "/assets/rutin/banner-rutin-jumat.jpeg",
  },
  "30-hari-temani-bertumbuh": {
    title: "30 Hari Temani Bertumbuh",
    description: "Rutinkan sedekah subuh selama 30 hari penuh kebaikan",
    image: "/assets/rutin/pilih-sendiri.png",
    banner: "/assets/rutin/banner-rutin-30hari.jpeg",
  },
  "100-hari-menuju-ramadhan": {
    title: "100 Hari Menuju Ramadhan",
    description:
      "Persiapkan hati dan pahala terbaik tiap subuh menyambut Ramadhan",
    image: "/assets/rutin/pilih-sendiri.png",
    banner: "/assets/rutin/banner-rutin-ramadhan.jpeg",
  },
  "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu": {
    title: "52 Kirim Hadiah Tiap Jumat Subuh Atas Nama Ortu",
    description:
      "Kirim hadiah pahala jariyah terbaik tiap Jumat subuh untuk orang tua",
    image: "/assets/rutin/pilih-sendiri.png",
    banner: "/assets/rutin/banner-rutin-orangtua.jpeg",
  },
};

const PAGE_TITLE: Record<Slug, string> = {
  dipilihkan: "Donasi Rutin",
  subuh: "Donasi Tiap Subuh",
  jumat: "Donasi Tiap Jumat",
  "30-hari-temani-bertumbuh": "30 Hari Temani Bertumbuh",
  "100-hari-menuju-ramadhan": "100 Hari Menuju Ramadhan",
  "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu":
    "52 Kirim Hadiah Tiap Jumat Subuh",
};

const banner = BANNER[slug as Slug];
const isSubuh =
  slug === "subuh" ||
  slug === "30-hari-temani-bertumbuh" ||
  slug === "100-hari-menuju-ramadhan" ||
  slug === "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu";
const isJumatWeekly =
  slug === "jumat" ||
  slug === "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu";

const isLocked = slug !== "dipilihkan";
const isCommitmentLocked =
  slug !== "dipilihkan" && slug !== "subuh" && slug !== "jumat";
const defaultHour = isSubuh ? "04" : slug === "jumat" ? "03" : "08";
const defaultMinute = isSubuh ? "33" : "00";
const defaultRangeType = isJumatWeekly ? "weekly" : "daily";
const lockedDay = isJumatWeekly ? "Jumat" : false;

const defaultCommitment =
  slug === "30-hari-temani-bertumbuh"
    ? 30
    : slug === "100-hari-menuju-ramadhan"
      ? 100
      : slug === "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu"
        ? 52
        : 1;

const showAtasNama = slug === "52-kirim-hadiah-tiap-jumat-subuh-atas-nama-ortu";
---

<MainLayout
  title={PAGE_TITLE[slug as Slug]}
  description="Form donasi rutin Beramalbersama.com"
>
  <Header
    type="title"
    text={PAGE_TITLE[slug as Slug]}
    link="/donasi-rutin/opsi"
  />

  <div
    id="rutin-page"
    data-program-id={programId}
    data-wallet={walletBalance}
    data-slug={slug}
    data-is-auth={Boolean(token)}
    class="min-h-screen bg-linear-to-br from-slate-50 to-primary-100 pb-32"
  >
    <div class="container pb-4 md:pb-6 space-y-3">
      <!-- Banner -->
      {
        banner?.banner ? (
          <img
            src={banner.banner}
            alt={banner.title}
            loading="lazy"
            decoding="async"
            class="w-full h-auto object-cover rounded-b-md"
          />
        ) : (
          <div class="relative h-[65px] overflow-hidden rounded-b-md" />
        )
      }
      <div
        class="bg-white rounded-b border border-gray-100 shadow-sm p-4 flex items-center gap-3"
      >
        <div
          class="w-13 h-13 rounded-full flex items-center justify-center shrink-0 shadow-sm overflow-hidden"
        >
          <img
            src={banner.image}
            alt={banner.title}
            loading="lazy"
            decoding="async"
            class="object-contain w-8 h-8"
          />
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-gray-900 mb-0.5 leading-snug">
            {banner.title}
          </p>
          <p class="text-xs text-gray-400 leading-relaxed">
            {banner.description}
          </p>
        </div>
      </div>

      <FormRutin
        paymentMethods={paymentMethods}
        walletBalance={walletBalance}
        isLocked={isLocked}
        isCommitmentLocked={isCommitmentLocked}
        defaultHour={defaultHour}
        defaultMinute={defaultMinute}
        defaultRangeType={defaultRangeType}
        lockedDay={lockedDay}
        defaultCommitment={defaultCommitment}
        showAtasNama={showAtasNama}
        isAuthenticated={Boolean(token)}
      />
    </div>
  </div>
</MainLayout>
