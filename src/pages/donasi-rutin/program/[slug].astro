---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getServerToken } from "@/lib/auth";
import { formatRupiah } from "@/lib/formatter";
import { Image } from "astro:assets";
import FormRutin from "@/components/sections/rutin/FormRutin.astro";
import {
  getCampaignByLink,
  getPaymentMethod,
  getPaymentMethodFilter,
  getUserProfile,
} from "@/lib/FetchData.ts";
import ShowJsonData from "@/components/ui/ShowJsonData.astro";

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/donasi-rutin/opsi");

const token = getServerToken(Astro.cookies);
if (!token)
  return Astro.redirect(`/auth/login?from=/donasi-rutin/program/${slug}`);

const API_URL = import.meta.env.PUBLIC_API_URL;

const [account, campaign, paymentMethods] = await Promise.all([
  getUserProfile(token),
  getCampaignByLink(slug).catch(() => null),
  getPaymentMethodFilter({ status: "true" }),
  ,
]);

const programId = campaign?.data.id;
const walletBalance = (account?.dompet_kebaikan?.saldo ?? 0) as number;

const banner = {
  title: (campaign?.data?.title ?? slug) as string,
  description: (campaign?.data?.short_description ?? "") as string,
  image: (campaign?.data?.image ?? "") as string,
};
---

<MainLayout
  title={banner.title}
  description="Form donasi rutin Aksiberbagi.com"
>
  <Header type="title" text={banner.title} />

  <div
    id="rutin-page"
    data-api-url={API_URL}
    data-program-id={programId}
    data-wallet={walletBalance}
    data-slug={slug}
    class="min-h-screen bg-linear-to-br from-slate-50 to-primary-100 pb-32"
  >
    <div class="container pb-4 md:pb-6 space-y-3">
      <!-- Banner -->
      <div class="bg-linear-to-t from-white to-primary-50 rounded-b shadow-sm">
        {
          banner.image && (
            <Image
              src={banner.image}
              alt={banner.title}
              width="320"
              height="240"
              loading="eager"
              decoding="async"
              class="w-full max-h-[500px] object-cover"
            />
          )
        }
        <div class="flex-1 p-4">
          <h1
            class="text-sm md:text-base font-semibold text-gray-900 mb-4 leading-tight"
          >
            {banner.title}
          </h1>
          <div class="flex items-stretch mb-4 overflow-hidden">
            <div class="flex-1 text-center py-3 px-2">
              <p class="text-xs text-gray-400 mb-1">Donasi Terkumpul</p>
              <p class="text-primary-600 text-sm md:text-base font-semibold">
                {formatRupiah(campaign?.data?.nominal_achieved ?? 0)}
              </p>
            </div>
            <div class="w-px bg-gray-200"></div>
            <div class="flex-1 text-center py-3 px-2">
              <p class="text-xs text-gray-400 mb-1">Orang Bergabung</p>
              <p class="text-primary-600 text-sm md:text-base font-semibold">
                {campaign?.data?.total_donors ?? 0}
              </p>
            </div>
          </div>
        </div>
      </div>

      <FormRutin
        paymentMethods={paymentMethods}
        walletBalance={walletBalance}
      />
    </div>
  </div>
</MainLayout>
