---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import DonatePanel from "@/components/sections/donasi/DonatePanel.astro";
import {
  getProjectById,
  getCampaignByLink,
  getNominalOptions,
} from "@/lib/FetchData";
import { formatDate, formatRupiah, progressPercent } from "@/lib/formatter";

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
  return Astro.redirect("/404");
}

interface Mitra {
  id?: number;
  nama?: string;
  wa?: string;
  image?: string;
  image_url?: string;
}

interface Program {
  id?: number;
  name?: string;
  slug?: string;
  description?: string;
}

interface ProjectData {
  id: number;
  user_id?: number | null;
  mitra_id?: number | null;
  pengaju?: string;
  wa?: string;
  email?: string;
  image?: string;
  image_url?: string;
  deskripsi?: string;
  nominal_ajuan?: number;
  nominal_acc?: number;
  waktu_pelaksanaan?: string;
  reason?: string;
  jumlah_pm?: number | string;
  lat?: string | null;
  lng?: string | null;
  judul?: string;
  kode_wilayah?: string | null;
  kesiapan?: string;
  marketing?: string | null;
  status?: string;
  activity?: string;
  request?: string;
  images?: string | null;
  images_url?: string | null;
  notes?: string;
  created_at?: string;
  updated_at?: string;
  user?: any;
  mitras?: Mitra[];
  mitra_utama?: Mitra | null;
  programs?: Program[];
  total_allocated?: number;
  total_disbursed?: number;
  location?: string;
  claimed_donasi?: number;
  total_alokasi?: number;
  total_tf_ke_mitra?: number;
  total_pakai_mitra?: number;
  total_refund_mitra?: number;
  sisa_dana_mitra?: number;
}

let project: ProjectData | null = null;
let detailCampaign: any = null;
let nominalOptions: any[] = [];

try {
  const result = await getProjectById(Number(id));
  if (result) {
    project = result;
  }
} catch (error) {
  console.error(`[Project Detail] Gagal mengambil project #${id}:`, error);
}

if (!project || !project.id) {
  return Astro.redirect("/404");
}

// PROGRAM & CAMPAIGN DATA
const primaryProgram: Program | undefined = project.programs?.[0];
const programSlug = primaryProgram?.slug ?? "";

if (programSlug) {
  try {
    const [campaignRes, nominalOptionsRes] = await Promise.allSettled([
      getCampaignByLink(programSlug),
      getNominalOptions(programSlug),
    ]);

    if (campaignRes.status === "fulfilled") {
      detailCampaign = campaignRes.value?.data ?? null;
    }
    if (nominalOptionsRes.status === "fulfilled") {
      nominalOptions = nominalOptionsRes.value ?? [];
    }
  } catch (err) {
    console.error(
      `[Project Detail] Error fetching campaign for slug ${programSlug}:`,
      err,
    );
  }
}

const programId = detailCampaign?.id ?? primaryProgram?.id ?? "";

// NOMINAL & PROGRESS
const nominalAchieved = Number(
  project.claimed_donasi ?? project.total_allocated ?? 0,
);
const nominalTarget = Number(
  project.nominal_acc ?? project.nominal_ajuan ?? project.total_alokasi ?? 0,
);
const pct = progressPercent(nominalAchieved, nominalTarget);

// MITRA
const mitra = project.mitra_utama ?? project.mitras?.[0] ?? null;
const mitraName = mitra?.nama ?? project.pengaju ?? "Mitra Beramal";
const mitraImage = mitra?.image_url ?? null;
const mitraId = mitra?.id ?? project.mitra_id ?? null;

// BENEFICIARY & META
const beneficiary = Number(project.jumlah_pm ?? 0);
const rawDescription = project.deskripsi ?? "";
const cleanDescription = rawDescription
  .replace(/<[^>]*>/g, " ")
  .replace(/\s+/g, " ")
  .trim();

const backLink = programSlug ? `/${programSlug}` : "/home";

// ACTIVITY HELPERS
function activityLabel(activity?: string): string {
  const map: Record<string, string> = {
    "active open": "Sedang Tergalang",
    "active close": "Segera Salur",
    done: "Selesai",
    selesai: "Selesai",
    berjalan: "Proses",
    diterima: "Diterima",
  };

  return map[activity?.toLowerCase() ?? ""] ?? activity ?? "Proses";
}

function activityBadgeClass(activity?: string): string {
  const a = activity?.toLowerCase();

  if (a === "active open") {
    return "bg-emerald-50 text-emerald-700 border border-emerald-200";
  }
  if (a === "active close") {
    return "bg-amber-50 text-amber-700 border border-amber-200";
  }
  if (a === "done" || a === "selesai") {
    return "bg-blue-50 text-blue-700 border border-blue-200";
  }

  return "bg-primary-50 text-primary-700 border border-primary-100";
}

const isDonatable =
  project.activity === "active open" || project.status === "diterima";
---

<MainLayout
  title={project.judul || "Detail Proyek Salur"}
  description={cleanDescription.slice(0, 160) ||
    "Informasi lengkap mengenai proyek penyaluran donasi."}
  image={project.image_url}
  type="article"
>
  <Header type="title" text="Detail Proyek" link={backLink} />

  <div class="bg-gray-50 min-h-screen container pb-32 pt-14">
    <div class="max-w-120 mx-auto">
      <!-- HERO IMAGE -->
      {
        project.image_url && (
          <div class="w-full bg-gray-100 overflow-hidden shadow-sm">
            <img
              src={project.image_url}
              alt={project.judul || "Proyek Salur"}
              width="1200"
              height="675"
              class="w-full h-auto max-h-[380px] object-cover"
              loading="eager"
            />
          </div>
        )
      }

      <!-- MITRA INFO BAR -->
      <div
        class="bg-white border-b border-gray-100 px-4 py-3.5 flex items-center justify-between gap-3 shadow-xs"
      >
        {
          mitraId ? (
            <a
              href={`/mitra/${mitraId}`}
              class="flex items-center gap-3 min-w-0 group hover:opacity-90 transition-opacity"
            >
              <div class="relative w-11 h-11 rounded-full border-2 border-primary-500 overflow-hidden shrink-0 bg-white shadow-xs">
                {mitraImage ? (
                  <img
                    src={mitraImage}
                    alt={mitraName}
                    class="w-full h-full object-contain p-0.5"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-primary-100 text-primary-700 font-bold text-base">
                    {mitraName.charAt(0).toUpperCase()}
                  </div>
                )}
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-1.5">
                  <p class="font-semibold text-sm text-gray-900 truncate group-hover:text-primary-600 transition-colors">
                    {mitraName}
                  </p>
                  <svg
                    class="w-4 h-4 text-primary-500 shrink-0"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
                <span class="text-[11px] text-gray-500 font-normal">
                  Lembaga Mitra Salur
                </span>
              </div>
            </a>
          ) : (
            <div class="flex items-center gap-3 min-w-0">
              <div class="w-11 h-11 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-base shrink-0">
                {mitraName.charAt(0).toUpperCase()}
              </div>
              <div class="min-w-0">
                <p class="font-semibold text-sm text-gray-900 truncate">
                  {mitraName}
                </p>
                <span class="text-[11px] text-gray-500 font-normal">
                  Pengaju: {project.pengaju || "Program"}
                </span>
              </div>
            </div>
          )
        }

        <span
          class={`shrink-0 px-2.5 py-1 text-xs font-semibold rounded-full ${activityBadgeClass(project.activity)}`}
        >
          {activityLabel(project.activity)}
        </span>
      </div>

      <!-- MAIN CARD INFO -->
      <div class="bg-white p-4 mb-3 border-b border-gray-100">
        <!-- PROJECT TITLE -->
        <h1 class="text-base font-bold text-gray-900 leading-snug mb-3">
          {project.judul || "Detail Proyek Penyaluran"}
        </h1>

        <!-- PROGRAM RELATION BADGE -->
        {
          programSlug && (
            <a
              href={`/${programSlug}`}
              class="flex items-center gap-2.5 mb-4 bg-primary-50/80 hover:bg-primary-100/80 border border-primary-100 rounded-xl p-3 transition-colors group"
            >
              <div class="w-8 h-8 rounded-lg bg-primary-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                  />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-[10px] uppercase font-bold tracking-wider text-primary-600">
                  Program Induk
                </p>
                <p class="text-xs font-semibold text-gray-800 truncate group-hover:text-primary-700">
                  {primaryProgram?.description ||
                    detailCampaign?.title ||
                    programSlug}
                </p>
              </div>
              <svg
                class="w-4 h-4 text-primary-400 group-hover:text-primary-600 group-hover:translate-x-0.5 transition-all shrink-0"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          )
        }

        <!-- FINANCIAL CARDS -->
        <div class="grid grid-cols-2 gap-2.5 mb-4">
          <div class="bg-gray-50 border border-gray-100 rounded-xl p-3">
            <span class="text-[11px] font-medium text-gray-400 block mb-1">
              Kebutuhan Dana
            </span>
            <span
              class="text-sm sm:text-base font-bold text-gray-800 tracking-tight"
            >
              {formatRupiah(nominalTarget)}
            </span>
          </div>

          <div
            class="bg-primary-50/70 border border-primary-100 rounded-xl p-3"
          >
            <span class="text-[11px] font-medium text-primary-600 block mb-1">
              Terkumpul
            </span>
            <span
              class="text-sm sm:text-base font-bold text-primary-600 tracking-tight"
            >
              {formatRupiah(nominalAchieved)}
            </span>
          </div>
        </div>

        <!-- PROGRESS BAR -->
        <div class="mb-4">
          <div
            class="w-full h-2 bg-gray-100 rounded-full overflow-hidden mb-1.5"
          >
            <div
              class="h-full bg-gradient-to-r from-primary-400 to-primary-600 rounded-full transition-all duration-700"
              style={`width: ${pct}%`}
            >
            </div>
          </div>
          <div class="flex items-center justify-between text-xs text-gray-500">
            <span class="font-semibold text-primary-600">{pct}% terkumpul</span>
            <span>Kebutuhan {formatRupiah(nominalTarget)}</span>
          </div>
        </div>

        <!-- META BADGES (BENEFICIARY, EXECUTION DATE, LOCATION) -->
        <div
          class="flex flex-wrap items-center gap-2 pt-1 border-t border-gray-100"
        >
          {
            beneficiary > 0 && (
              <div class="inline-flex items-center gap-1.5 bg-gray-50 border border-gray-100 text-gray-600 text-xs px-2.5 py-1.5 rounded-lg">
                <svg
                  class="w-3.5 h-3.5 text-primary-500 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <span class="font-medium">
                  {beneficiary.toLocaleString("id-ID")} Penerima Manfaat
                </span>
              </div>
            )
          }

          {
            project.waktu_pelaksanaan && (
              <div class="inline-flex items-center gap-1.5 bg-gray-50 border border-gray-100 text-gray-600 text-xs px-2.5 py-1.5 rounded-lg">
                <svg
                  class="w-3.5 h-3.5 text-primary-500 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  />
                </svg>
                <span>
                  Pelaksanaan:{" "}
                  <strong class="font-medium text-gray-700">
                    {formatDate(project.waktu_pelaksanaan)}
                  </strong>
                </span>
              </div>
            )
          }

          {
            project.lat && project.lng && (
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${project.lat},${project.lng}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 bg-gray-50 hover:bg-gray-100 border border-gray-100 text-primary-600 text-xs px-2.5 py-1.5 rounded-lg transition-colors"
              >
                <svg
                  class="w-3.5 h-3.5 text-primary-500 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                </svg>
                <span>Lihat Lokasi di Peta</span>
              </a>
            )
          }
        </div>
      </div>

      <!-- DESKRIPSI SECTION -->
      <div class="bg-white p-4 mb-3 border-y border-gray-100">
        <div class="flex items-center gap-2 mb-3">
          <h2 class="text-sm font-bold text-gray-800">
            Deskripsi Proyek Penyaluran
          </h2>
        </div>

        {
          rawDescription ? (
            <div
              class="prose prose-sm max-w-none text-gray-700 text-xs leading-relaxed space-y-2.5 [&_.ql-align-justify]:text-justify [&_p]:mb-2.5 [&_strong]:font-semibold [&_strong]:text-gray-900 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:mb-1 [&_img]:rounded-xl [&_img]:w-full [&_img]:my-3"
              set:html={rawDescription}
            />
          ) : (
            <p class="text-xs text-gray-400 italic">
              Belum ada deskripsi detail untuk proyek ini.
            </p>
          )
        }
      </div>

      <!-- INFORMASI TAMBAHAN / PENGAJU -->
      <div class="bg-white p-4 mb-3 border-y border-gray-100">
        <div class="flex items-center gap-2 mb-3">
          <h2 class="text-sm font-bold text-gray-800">
            Informasi Pelaksanaan & Pengajuan
          </h2>
        </div>

        <div class="divide-y divide-gray-100 text-xs">
          <div class="py-2.5 flex justify-between items-center">
            <span class="text-gray-500">Pengaju Proyek</span>
            <span class="font-semibold text-gray-800"
              >{project.pengaju || "Program"}</span
            >
          </div>

          <div class="py-2.5 flex justify-between items-center">
            <span class="text-gray-500">Status Pengajuan</span>
            <span
              class="capitalize font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded"
            >
              {project.status || "Diterima"}
            </span>
          </div>

          {
            project.waktu_pelaksanaan && (
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-gray-500">Target Pelaksanaan</span>
                <span class="font-medium text-gray-800">
                  {formatDate(project.waktu_pelaksanaan)}
                </span>
              </div>
            )
          }

          {
            beneficiary > 0 && (
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-gray-500">Target Penerima Manfaat</span>
                <span class="font-medium text-gray-800">
                  {beneficiary.toLocaleString("id-ID")} Orang / Lembaga
                </span>
              </div>
            )
          }

          {
            project.mitra_utama?.nama && (
              <div class="py-2.5 flex justify-between items-center">
                <span class="text-gray-500">Mitra Penyalur</span>
                <span class="font-semibold text-primary-600">
                  {project.mitra_utama.nama}
                </span>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <!-- STICKY BOTTOM ACTION BAR -->
    <div class="fixed bottom-0 left-0 right-0 z-40">
      <div class="mx-auto max-w-120">
        <div
          class="bg-white/95 backdrop-blur-md shadow-[0_-4px_16px_rgba(0,0,0,0.06)] rounded-t-2xl p-3.5 flex gap-3 border-t border-gray-100"
        >
          <button
            type="button"
            id="btn-share-project"
            class="flex items-center justify-center gap-1.5 w-1/3 py-3 px-3 rounded-xl border border-primary-500 text-primary-600 font-semibold hover:bg-primary-50 active:scale-[0.98] transition-all text-xs sm:text-sm cursor-pointer"
            aria-label="Bagikan Proyek"
          >
            <svg
              class="w-4 h-4 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"
              ></path>
            </svg>
            <span>Bagikan</span>
          </button>

          {
            isDonatable ? (
              <button
                type="button"
                id="btn-donate-project"
                data-project-id={project.id}
                data-program-id={programId}
                data-program-link={programSlug}
                class="flex items-center justify-center w-2/3 py-3 px-4 rounded-xl font-bold bg-secondary-500 hover:bg-secondary-600 active:scale-[0.98] text-white text-xs sm:text-sm shadow-md shadow-secondary-500/20 transition-all duration-200 cursor-pointer"
              >
                DONASI SEKARANG
              </button>
            ) : (
              <button
                type="button"
                disabled
                class="flex items-center justify-center w-2/3 py-3 px-4 rounded-xl font-bold bg-gray-300 text-gray-500 text-xs sm:text-sm cursor-not-allowed"
              >
                PROYEK SELESAI
              </button>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <!-- DONATE PANEL COMPONENT -->
  <DonatePanel
    nominalOptions={nominalOptions}
    programId={programId}
    programLink={programSlug}
    projectId={project.id}
  />
</MainLayout>

<script>
  import { appendReffCodeToUrl } from "@/lib/referral";
  import { showToast } from "@/lib/toast";

  function setupProjectActions() {
    // Share action
    const shareBtn = document.getElementById("btn-share-project");
    shareBtn?.addEventListener("click", async () => {
      const shareUrl = await appendReffCodeToUrl(window.location.href);
      if (navigator.share) {
        navigator
          .share({
            title: document.title,
            url: shareUrl,
          })
          .catch(() => {});
      } else {
        navigator.clipboard
          .writeText(shareUrl)
          .then(() => showToast("Link proyek berhasil disalin!", "success"))
          .catch(() => showToast("Gagal menyalin link", "error"));
      }
    });

    // Donate action
    const donateBtn = document.getElementById("btn-donate-project");
    donateBtn?.addEventListener("click", () => {
      const projectId = donateBtn.getAttribute("data-project-id");
      const programId = donateBtn.getAttribute("data-program-id");
      const programLink = donateBtn.getAttribute("data-program-link");

      document.dispatchEvent(
        new CustomEvent("donate:open", {
          detail: {
            projectId: projectId ? Number(projectId) : null,
            programId,
            programLink,
          },
        }),
      );
    });
  }

  setupProjectActions();
  document.addEventListener("DOMContentLoaded", setupProjectActions);
  document.addEventListener("astro:page-load", setupProjectActions);
</script>
