---
export const prerender = false;

import Footer from "@/components/layouts/Footer.astro";
import Header from "@/components/layouts/Header.astro";
import PaymentMethodModal from "@/components/ui/PaymentMethod.astro";
import OnlineTab from "@/components/sections/infak/OnlineTab.astro";
import QrTab from "@/components/sections/infak/QrTab.astro";
import DonaturTab from "@/components/sections/infak/DonaturTab.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getServerToken } from "@/lib/auth";

const API_URL = import.meta.env.ASTRO_API_URL;
const token = getServerToken(Astro.cookies);

const fetchOpts = (auth = false) => ({
  headers: {
    Accept: "application/json",
    ...(auth && token ? { Authorization: `Bearer ${token}` } : {}),
  },
});

const [bannerRes, qrRes, pmRes, donorRes, accountRes] = await Promise.all([
  fetch(`${API_URL}/image/home-banner`, fetchOpts()),
  fetch(`${API_URL}/qr-code/infaq`, fetchOpts()),
  fetch(`${API_URL}/payment/payment-method?program_link=infaq`, fetchOpts()),
  fetch(`${API_URL}/program/link/infaq/donors?limit=10&page=1`, fetchOpts()),
  token
    ? fetch(`${API_URL}/dashboard/my-account`, fetchOpts(true))
    : Promise.resolve(null),
]);

const banner = bannerRes.ok ? (await bannerRes.json())?.data : null;
const qr = qrRes.ok ? (await qrRes.json())?.data : null;
const pmData = pmRes.ok ? ((await pmRes.json())?.data ?? []) : [];
const donors = donorRes.ok ? ((await donorRes.json())?.data ?? []) : [];
const account = accountRes?.ok ? (await accountRes.json())?.data : null;

const isAuth = !!account;
const userName = account?.name ?? "";
const userPhone = account?.phone ?? "";
const walletBal = account?.dompet_kebaikan?.saldo ?? 0;

const paymentMethods: any[] = (pmData as any[]).filter((m: any) => {
  if (m.type === "wallet") return isAuth;
  return ["VA", "bank", "e_wallet"].includes(m.type);
});

const nominalOptions = [10000, 25000, 50000, 100000];
---

<MainLayout
  title="Infak"
  description="Tunaikan infak Anda secara online di Aksiberbagi.com."
>
  <Header type="onlyicon" />

  <div
    id="infaq-page"
    data-api-url={API_URL}
    data-wallet={walletBal}
    data-is-auth={isAuth}
    data-user-name={userName}
    data-user-phone={userPhone}
    class="min-h-screen bg-linear-to-br from-slate-50 to-primary-100 pt-16"
  >
    <div class="container">
      <!-- Hero Banner -->
      {
        banner && (
          <div class="relative w-full aspect-[16/9] overflow-hidden bg-gray-100">
            <img
              src={banner.image_url}
              alt={banner.name}
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
            <div class="absolute bottom-4 left-4 right-4">
              <p class="text-white text-base font-bold drop-shadow-sm">Infaq Online</p>
              <p class="text-white/75 text-xs mt-0.5">Aksiberbagi.com</p>
            </div>
          </div>
        )
      }

      <!-- Tab Navigation -->
      <div class="bg-white sticky top-16 z-20 border-b border-gray-100 flex shadow-sm">
        {
          [
            { id: "online", label: "Infaq Online" },
            { id: "qr", label: "QR Code" },
            { id: "donatur", label: "Donatur" },
          ].map(({ id, label }) => (
            <button
              type="button"
              data-tab={id}
              class={`tab-btn flex-1 py-3.5 text-xs font-semibold transition-all duration-200 border-b-2 ${
                id === "online"
                  ? "border-primary-500 text-primary-600"
                  : "border-transparent text-gray-400 hover:text-gray-600"
              }`}
            >
              {label}
            </button>
          ))
        }
      </div>

      <OnlineTab
        isAuth={isAuth}
        userName={userName}
        userPhone={userPhone}
        walletBal={walletBal}
        nominalOptions={nominalOptions}
      />
      <QrTab qr={qr} />
      <DonaturTab donors={donors} />

      <Footer />
    </div>
  </div>

  <PaymentMethodModal paymentMethods={paymentMethods} />
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";
  import { getToken } from "@/lib/auth";

  const page = document.getElementById("infaq-page") as HTMLElement;
  const API_URL = page?.dataset.apiUrl ?? "";
  const walletBal = Number(page?.dataset.wallet ?? 0);
  const isAuth = page?.dataset.isAuth === "true";
  const userName = page?.dataset.userName ?? "";
  const userPhone = page?.dataset.userPhone ?? "";
  const token = getToken();

  // ── State ─────────────────────────────────────────────────────────────────
  let amount = 0;
  let paymentMethodId: string | number = "";
  let paymentType = "";
  let paymentSelected = false;
  let isProcessing = false;
  let hideName = false;
  let forOtherPerson = false;

  // ── Element refs ──────────────────────────────────────────────────────────
  const nominalInput = document.getElementById("nominal-input") as HTMLInputElement;
  const inputName = document.getElementById("input-name") as HTMLInputElement | null;
  const inputPhone = document.getElementById("input-phone") as HTMLInputElement | null;
  const hideNameCheck = document.getElementById("hide-name") as HTMLInputElement | null;
  const inputDoa = document.getElementById("input-doa") as HTMLTextAreaElement;
  const paymentImg = document.getElementById("payment-img") as HTMLImageElement;
  const paymentNameEl = document.getElementById("payment-name") as HTMLElement;
  const walletInfo = document.getElementById("wallet-info") as HTMLElement;
  const openModalBtn = document.getElementById("open-payment-modal") as HTMLButtonElement;
  const btnSubmit = document.getElementById("btn-submit") as HTMLButtonElement;
  const bottomBar = document.getElementById("bottom-bar") as HTMLElement;
  const toggleOrangLain = document.getElementById("toggle-orang-lain") as HTMLInputElement;
  const formOrangLain = document.getElementById("form-orang-lain") as HTMLElement;
  const inputAtasNama = document.getElementById("input-atas-nama") as HTMLInputElement;

  // ── localStorage pre-fill ─────────────────────────────────────────────────
  const savedNominal = localStorage.getItem("nominalInfaq");
  if (savedNominal) {
    const n = parseInt(savedNominal, 10);
    if (!isNaN(n)) {
      amount = n;
      nominalInput.value = n.toLocaleString("id-ID");
    }
    localStorage.removeItem("nominalInfaq");
  }

  // ── Tab switching ─────────────────────────────────────────────────────────
  const tabContents: Record<string, HTMLElement | null> = {
    online: document.getElementById("tab-online"),
    qr: document.getElementById("tab-qr"),
    donatur: document.getElementById("tab-donatur"),
  };

  document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.tab ?? "online";

      document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((b) => {
        const active = b.dataset.tab === target;
        b.classList.toggle("border-primary-500", active);
        b.classList.toggle("text-primary-600", active);
        b.classList.toggle("border-transparent", !active);
        b.classList.toggle("text-gray-400", !active);
      });

      Object.entries(tabContents).forEach(([key, el]) => {
        el?.classList.toggle("hidden", key !== target);
      });

      bottomBar.classList.toggle("hidden", target !== "online");
    });
  });

  // ── Nominal ───────────────────────────────────────────────────────────────
  function setChipActive(activeBtn: HTMLButtonElement | null) {
    document.querySelectorAll<HTMLButtonElement>(".nominal-chip").forEach((b) => {
      const on = b === activeBtn;
      b.classList.toggle("border-primary-500", on);
      b.classList.toggle("bg-primary-50", on);
      b.classList.toggle("text-primary-700", on);
      b.classList.toggle("border-gray-200", !on);
      b.classList.toggle("text-gray-500", !on);
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".nominal-chip").forEach((btn) => {
    btn.addEventListener("click", () => {
      amount = Number(btn.dataset.value);
      nominalInput.value = amount.toLocaleString("id-ID");
      setChipActive(btn);
    });
  });

  nominalInput.addEventListener("input", () => {
    const raw = nominalInput.value.replace(/[^0-9]/g, "");
    amount = raw ? parseInt(raw, 10) : 0;
    nominalInput.value = amount > 0 ? amount.toLocaleString("id-ID") : "";
    setChipActive(null);
  });

  // ── Hide name toggle ──────────────────────────────────────────────────────
  hideNameCheck?.addEventListener("change", () => {
    hideName = hideNameCheck.checked;
    if (inputName) {
      inputName.disabled = hideName;
      inputName.classList.toggle("opacity-40", hideName);
    }
  });

  // ── Donasi untuk orang lain ───────────────────────────────────────────────
  toggleOrangLain?.addEventListener("change", () => {
    forOtherPerson = toggleOrangLain.checked;
    formOrangLain?.classList.toggle("hidden", !forOtherPerson);
    if (!forOtherPerson && inputAtasNama) inputAtasNama.value = "";
  });

  // ── Payment modal ─────────────────────────────────────────────────────────
  openModalBtn?.addEventListener("click", () => {
    (window as any).openPaymentModal?.();
  });

  window.addEventListener("payment:selected", (e: Event) => {
    const { id, name, image, type } = (e as CustomEvent).detail;
    paymentMethodId = id;
    paymentType = type ?? "";
    paymentSelected = true;

    walletInfo.classList.toggle("hidden", paymentType !== "wallet");
    paymentImg.src = image ?? "";
    paymentImg.classList.toggle("hidden", !image);
    paymentNameEl.textContent = name ?? "Pilih metode pembayaran";
    paymentNameEl.classList.toggle("text-gray-400", false);
    paymentNameEl.classList.toggle("text-gray-800", true);
  });

  // ── Helpers ───────────────────────────────────────────────────────────────
  function cleanPayload(obj: Record<string, unknown>) {
    return Object.fromEntries(
      Object.entries(obj).filter(
        ([, v]) =>
          v !== "" &&
          v !== null &&
          v !== undefined &&
          !(Array.isArray(v) && (v as unknown[]).length === 0),
      ),
    );
  }

  // ── Submit ────────────────────────────────────────────────────────────────
  btnSubmit.addEventListener("click", async () => {
    if (isProcessing) return;

    const name = isAuth
      ? userName
      : hideName
        ? "Hamba Allah"
        : (inputName?.value.trim() ?? "");

    const rawPhone = inputPhone?.value.trim() ?? "";
    const phone = isAuth
      ? userPhone
      : rawPhone.startsWith("0")
        ? rawPhone
        : rawPhone
          ? `0${rawPhone}`
          : "";

    const doa = inputDoa?.value.trim() ?? "";
    const atasNama = forOtherPerson ? (inputAtasNama?.value.trim() ?? "") : "";

    if (!isAuth && (!name || !phone)) {
      showToast("Nama dan nomor WhatsApp wajib diisi", "error");
      return;
    }
    if (amount < 1000) {
      showToast("Minimal infaq Rp1.000", "error");
      return;
    }
    if (!paymentSelected) {
      showToast("Pilih metode pembayaran terlebih dahulu", "error");
      return;
    }
    if (paymentType === "wallet" && amount > walletBal) {
      showToast("Saldo Saku Berbagi tidak mencukupi", "error");
      return;
    }
    if (forOtherPerson && !atasNama) {
      showToast("Masukkan nama penerima donasi", "error");
      return;
    }

    isProcessing = true;
    btnSubmit.disabled = true;
    btnSubmit.textContent = "Memproses...";

    const raw: Record<string, unknown> = {
      type: "donation",
      program_type: "infaq",
      items: [399],
      total: [amount],
      payment_method_id: paymentMethodId,
      name,
      phone,
      status: "Pending",
      ...(doa ? { doa } : {}),
      ...(atasNama ? { atas_nama: atasNama } : {}),
    };

    try {
      const res = await fetch(`${API_URL}/transactions/store`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        body: JSON.stringify(cleanPayload(raw)),
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data?.message ?? "Transaksi gagal");

      window.location.href = `/invoice/${data?.data?.invoice}`;
    } catch (err: unknown) {
      const msg =
        err instanceof Error ? err.message : "Terjadi kesalahan, coba lagi";
      showToast(msg, "error");
      isProcessing = false;
      btnSubmit.disabled = false;
      btnSubmit.textContent = "Lanjutkan";
    }
  });
</script>
