<script>
  import { showToast } from "@/lib/toast";
  import { formatRupiah } from "@/lib/formatter";
  import { getIncomingReffCode, getIncomingLeads } from "@/lib/referral";

  const page = document.getElementById("jaga-nyala-page") as HTMLElement;
  if (!page) throw new Error("jaga-nyala-page element not found");

  const programId = page.dataset.programId || "3";
  const isAuth = page.dataset.isAuth === "true";

  // Selected State
  let selectedNominal = 5000;
  let commitmentDays = 30;
  let totalAmount = selectedNominal * commitmentDays;
  let selectedPaymentId = "2"; // Default BSI or fallback
  let isCustom = false;
  let isSubmitting = false;

  // DOM Elements
  const packageCards = document.querySelectorAll<HTMLElement>(".package-card");
  const summaryTotalDisplay = document.getElementById("summary-total-display");
  const floatingTotalDisplay = document.getElementById("floating-total-display");
  const btnToggleCustom = document.getElementById("btn-toggle-custom");
  const customNominalWrap = document.getElementById("custom-nominal-wrap");
  const inputCustomNominal = document.getElementById("input-custom-nominal") as HTMLInputElement;
  const customTotalPreview = document.getElementById("custom-total-preview");

  const donorNameInput = document.getElementById("donor-name") as HTMLInputElement;
  const donorPhoneInput = document.getElementById("donor-phone") as HTMLInputElement;
  const donorEmailInput = document.getElementById("donor-email") as HTMLInputElement;
  const donorAtasNamaInput = document.getElementById("donor-atas-nama") as HTMLInputElement;
  const donorDoaInput = document.getElementById("donor-doa") as HTMLTextAreaElement;

  const btnOpenPayment = document.getElementById("btn-open-payment");
  const selectedPaymentCard = document.getElementById("selected-payment-card");
  const selectedPaymentName = document.getElementById("selected-payment-name");
  const selectedPaymentImg = document.getElementById("selected-payment-img") as HTMLImageElement;
  const btnSubmit = document.getElementById("btn-submit-donasi") as HTMLButtonElement;

  // Package Card Selection
  function updateSelection(nominal: number, isCustomOption = false) {
    selectedNominal = nominal;
    isCustom = isCustomOption;
    totalAmount = selectedNominal * commitmentDays;

    packageCards.forEach((card) => {
      const cardNominal = Number(card.dataset.nominal);
      const isCardActive = !isCustom && cardNominal === selectedNominal;
      const dot = card.querySelector(".radio-dot");

      if (isCardActive) {
        card.classList.add("border-primary-500", "ring-2", "ring-primary-500/20", "bg-primary-50/20");
        card.classList.remove("border-neutral-200", "bg-white");
        dot?.classList.remove("hidden");
      } else {
        card.classList.remove("border-primary-500", "ring-2", "ring-primary-500/20", "bg-primary-50/20");
        card.classList.add("border-neutral-200", "bg-white");
        dot?.classList.add("hidden");
      }
    });

    if (summaryTotalDisplay) {
      summaryTotalDisplay.textContent = formatRupiah(totalAmount);
    }
    if (floatingTotalDisplay) {
      floatingTotalDisplay.innerHTML = `${formatRupiah(totalAmount)} <span class="text-[11px] font-normal text-neutral-400">/ 30 hari</span>`;
    }
  }

  packageCards.forEach((card) => {
    card.addEventListener("click", () => {
      const nominal = Number(card.dataset.nominal);
      if (customNominalWrap) customNominalWrap.classList.add("hidden");
      updateSelection(nominal, false);
    });
  });

  // Toggle Custom Nominal
  btnToggleCustom?.addEventListener("click", () => {
    if (!customNominalWrap) return;
    const isHidden = customNominalWrap.classList.contains("hidden");
    customNominalWrap.classList.toggle("hidden", !isHidden);
    if (isHidden && inputCustomNominal) {
      inputCustomNominal.focus();
    }
  });

  // Custom Input Handler
  inputCustomNominal?.addEventListener("input", (e) => {
    const raw = (e.target as HTMLInputElement).value.replace(/\D/g, "");
    const num = Number(raw) || 0;
    (e.target as HTMLInputElement).value = num > 0 ? num.toLocaleString("id-ID") : "";

    if (num >= 1000) {
      updateSelection(num, true);
      if (customTotalPreview) {
        customTotalPreview.textContent = `Total 30 hari: ${formatRupiah(num * commitmentDays)}`;
      }
    } else {
      if (customTotalPreview) {
        customTotalPreview.textContent = "Minimal nominal Rp1.000 / hari";
      }
    }
  });

  // Payment Selection Modal
  const openModal = () => {
    (window as any).openPaymentModal?.();
  };
  btnOpenPayment?.addEventListener("click", openModal);
  selectedPaymentCard?.addEventListener("click", openModal);

  window.addEventListener("payment:selected", (e: Event) => {
    const { id, name, image } = (e as CustomEvent).detail;
    selectedPaymentId = String(id);
    if (selectedPaymentName) selectedPaymentName.textContent = name;
    if (selectedPaymentImg && image) {
      selectedPaymentImg.src = image;
      selectedPaymentImg.classList.remove("hidden");
    }
  });

  // FAQ Accordion
  const faqItems = document.querySelectorAll(".faq-item");
  faqItems.forEach((item) => {
    const header = item.querySelector(".faq-header");
    const body = item.querySelector(".faq-body");
    const icon = item.querySelector(".faq-icon");

    header?.addEventListener("click", () => {
      const isOpen = !body?.classList.contains("hidden");

      // Close other faqs
      faqItems.forEach((other) => {
        other.querySelector(".faq-body")?.classList.add("hidden");
        other.querySelector(".faq-icon")?.classList.remove("rotate-180");
      });

      if (!isOpen) {
        body?.classList.remove("hidden");
        icon?.classList.add("rotate-180");
      }
    });
  });

  // Form Submission
  btnSubmit?.addEventListener("click", async () => {
    if (isSubmitting) return;

    const name = donorNameInput?.value.trim() ?? "";
    const rawPhone = donorPhoneInput?.value.trim() ?? "";
    const phone = rawPhone.startsWith("0") ? rawPhone : rawPhone ? `0${rawPhone}` : "";
    const email = donorEmailInput?.value.trim() ?? "";
    const atasNama = donorAtasNamaInput?.value.trim() ?? "";
    const doa = donorDoaInput?.value.trim() ?? "";

    if (!name || !phone) {
      showToast("Nama lengkap dan nomor WhatsApp wajib diisi", "error");
      donorNameInput?.focus();
      return;
    }

    if (phone.length < 9) {
      showToast("Nomor WhatsApp tidak valid", "error");
      donorPhoneInput?.focus();
      return;
    }

    if (selectedNominal < 1000) {
      showToast("Minimal sedekah Rp1.000 per hari", "error");
      return;
    }

    if (!selectedPaymentId) {
      showToast("Silakan pilih metode pembayaran terlebih dahulu", "error");
      openModal();
      return;
    }

    isSubmitting = true;
    btnSubmit.disabled = true;
    btnSubmit.innerHTML = `
      <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Memproses Pendaftaran...</span>
    `;

    const reffCode = getIncomingReffCode();
    const incomingLeads = getIncomingLeads();

    const payload: Record<string, unknown> = {
      program_id: Number(programId),
      range_type: "daily",
      range: "1",
      time: "05:00",
      nominal: selectedNominal,
      commitment: commitmentDays,
      type: "commitment",
      payment_method_id: Number(selectedPaymentId),
      status: "Pending",
      name,
      phone,
      ...(email ? { email } : {}),
      ...(atasNama ? { atas_nama: atasNama } : {}),
      ...(doa ? { doa } : {}),
      ...(reffCode ? { reff_code: reffCode } : {}),
      ...(incomingLeads ? { leads: incomingLeads } : {}),
    };

    try {
      const res = await fetch(`/api/rutin/store`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data?.message ?? "Gagal memproses donasi rutin");
      }

      const invoice = data?.data?.invoice;
      if (invoice) {
        window.location.href = `/invoice/${invoice}`;
      } else {
        showToast("Pendaftaran berhasil dicatat", "success");
        window.location.href = "/donasi-saya";
      }
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : "Terjadi kesalahan, silakan coba lagi";
      showToast(msg, "error");
      isSubmitting = false;
      btnSubmit.disabled = false;
      btnSubmit.innerHTML = `
        <span>Gabung Jaga Nyala Sekarang</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      `;
    }
  });

  // Initial State Setup
  updateSelection(5000, false);
</script>
