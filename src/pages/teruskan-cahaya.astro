---
export const prerender = false;

import MainLayout from "@/layouts/MainLayout.astro";
import PaymentMethodModal from "@/components/ui/PaymentMethod.astro";
import { getServerToken } from "@/lib/auth";
import {
  getUserProfile,
  getPaymentMethodFilter,
  getCampaignSetUp,
} from "@/lib/FetchData";

const token = getServerToken(Astro.cookies);

const [account, pmData, programSetup] = await Promise.all([
  token ? getUserProfile(token) : Promise.resolve(null),
  getPaymentMethodFilter({ status: "true" }),
  getCampaignSetUp("rutin"),
]);

const programId = (programSetup?.value ?? "3") as string;
const isAuth = !!account;
const userName = account?.name ?? "";
const userPhone = account?.phone ?? "";
const userEmail = account?.email ?? "";
const walletBal = account?.dompet_kebaikan?.saldo ?? 0;

const paymentMethods: any[] = Array.isArray(pmData) ? pmData : [];

// Pilih default payment method (prioritaskan BSI atau QRIS jika ada)
const defaultPayment =
  paymentMethods.find((m: any) =>
    m.name?.toLowerCase().includes("syariah") ||
    m.name?.toLowerCase().includes("bsi")
  ) ??
  paymentMethods.find((m: any) =>
    m.name?.toLowerCase().includes("qris")
  ) ??
  paymentMethods[0] ?? {
    id: 2,
    name: "Bank Syariah Indonesia (BSI)",
    image_url: "https://cdn.beramalbersama.com/bank_refferences/tmpphp0_z_gs_gt.jpeg",
    type: "bank",
  };

const routinePackages = [
  {
    nominal: 1000,
    dailyText: "Rp1.000 / hari",
    monthlyText: "Rp30.000 / 30 hari",
    days: 30,
    total: 30000,
    isPopular: false,
  },
  {
    nominal: 2000,
    dailyText: "Rp2.000 / hari",
    monthlyText: "Rp60.000 / 30 hari",
    days: 30,
    total: 60000,
    isPopular: false,
  },
  {
    nominal: 3000,
    dailyText: "Rp3.000 / hari",
    monthlyText: "Rp90.000 / 30 hari",
    days: 30,
    total: 90000,
    isPopular: false,
  },
  {
    nominal: 5000,
    dailyText: "Rp5.000 / hari",
    monthlyText: "Rp150.000 / 30 hari",
    days: 30,
    total: 150000,
    isPopular: true,
  },
  {
    nominal: 10000,
    dailyText: "Rp10.000 / hari",
    monthlyText: "Rp300.000 / 30 hari",
    days: 30,
    total: 300000,
    isPopular: false,
  },
];

const faqs = [
  {
    q: "Kapan kajian bersama UAS dan bagaimana mengikutinya?",
    a: "Kajian berlangsung setiap Selasa malam pukul 20.00 WIB melalui Zoom. Link akses dikirimkan ke grup komunitas paling lambat Selasa sore. Jika kamu bergabung Selasa siang, kamu tetap langsung mendapat link kajian malam itu.",
  },
  {
    q: "Apakah semua pertanyaan pasti dijawab UAS?",
    a: "Member berkesempatan bertanya langsung saat sesi kajian berlangsung. Karena waktu kajian terbatas, pertanyaan diprioritaskan dan disesuaikan selama sesi berlangsung agar manfaatnya merata.",
  },
  {
    q: "Bagaimana cara menyelesaikan pembayaran?",
    a: "Setelah mengisi form data di atas dan menekan tombol konfirmasi, kamu akan langsung diarahkan ke halaman invoice resmi yang mencantumkan detail pembayaran via Bank Syariah Indonesia (BSI), QRIS, atau metode pembayaran pilihanmu. Konfirmasi otomatis langsung terhubung.",
  },
  {
    q: "Apa saja metode pembayarannya?",
    a: "Tersedia transfer Bank Syariah Indonesia (BSI), Bank BCA, Mandiri, BRI, QRIS resmi yang bisa dipindai dari semua aplikasi m-banking dan e-wallet (GoPay, OVO, ShopeePay, DANA), serta Saku Kebaikan.",
  },
  {
    q: "Apakah saya akan ditagih otomatis setiap bulan?",
    a: "Tidak ada potongan otomatis tanpa konfirmasi dari rekeningmu. Setiap paket sedekah rutin ini berlaku 30 hari (1 bulan). Menjelang periode berikutnya, pengingat dikirim via WhatsApp/Email dan kamu bebas memutuskan untuk melanjutkan atau berhenti.",
  },
  {
    q: "Apakah saya wajib belajar ngaji?",
    a: "Tidak wajib. Belajar ngaji adalah fasilitas dan benefit tambahan khusus bagi member yang berminat mendalami bacaan Qur'an, baik secara privat maupun berjamaah online.",
  },
  {
    q: "Untuk apa donasi saya digunakan?",
    a: "Donasi rutinmu disalurkan untuk menjaga ekosistem dakwah Al-Qur'an: apresiasi operasional guru ngaji kampung pedalaman, beasiswa santri penghafal Al-Qur'an, penyediaan mushaf layak, dan pemberdayaan rumah Qur'an di pelosok nusantara.",
  },
];
---

<MainLayout
  title="Teruskan Cahaya | Beramalbersama.com"
  description="Meneruskan cahaya Alquran melalui kebaikan dan kepedulian untuk sesama."
>
  <!-- Top Navigation Bar -->
  <header class="fixed top-0 left-0 right-0 z-40 pointer-events-none">
    <div class="container mx-auto max-w-[480px] pointer-events-auto backdrop-blur-md bg-white/90 border-b border-neutral-200/80 transition-all duration-300 px-4 h-[65px] flex items-center justify-between shadow-xs">
      <a href="/" class="flex items-center gap-2 group" aria-label="Kembali ke beranda">
        <img
          src="/assets/logo/logo-long-custom.png"
          alt="Beramal Bersama"
          class="h-9 w-auto object-contain"
        />
      </a>

      <div class="flex items-center gap-2">
        <a
          href="#form-gabung"
          class="inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-full bg-secondary-500 text-white shadow-xs hover:bg-secondary-600 active:scale-95 transition-all"
        >
          <span>Gabung</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Container -->
  <div
    id="jaga-nyala-page"
    data-program-id={programId}
    data-wallet={walletBal}
    data-is-auth={String(isAuth)}
    class="min-h-screen bg-neutral-100 text-neutral-800 pt-[65px] pb-28"
  >
    <main class="container mx-auto max-w-[480px] bg-white min-h-screen shadow-xs overflow-hidden">
      <!-- ── 1. Hero Section ─────────────────────────────────────────── -->
      <section class="relative w-full aspect-16/10 sm:aspect-16/9 overflow-hidden bg-neutral-900">
        <img
          src="/assets/landingpage/hero/hero-2.avif"
          alt="Santri dan Guru Ngaji"
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-linear-to-t from-neutral-950/40 via-transparent to-transparent"></div>
      </section>

      <!-- ── 2. Sub-Hero CTA Section ──────────────────────────────────── -->
      <section class="px-5 py-6 bg-white border-b border-neutral-100 text-center space-y-4">
        <h2 class="text-xl font-bold text-neutral-900 leading-snug">
          Jaga Guru Ngaji Mulai Rp1.000 Sehari, dan Ikut Kajian Live Bersama UAS
        </h2>

        <p class="text-xs text-neutral-600 leading-relaxed max-w-md mx-auto">
          Gabung komunitas Jaga Nyala untuk ikut menjaga guru ngaji kampung, da’i pedalaman, dan santri penghafal. Sebagai member, kamu juga ikut kajian bersama Ustadz Abdul Somad lewat Zoom setiap pekan.
        </p>

        <div>
          <a
            href="#form-gabung"
            class="inline-flex items-center justify-center gap-2 w-full max-w-sm py-3.5 px-6 rounded-xl bg-secondary-500 hover:bg-secondary-600 text-white font-bold text-sm shadow-md shadow-secondary-500/20 active:scale-98 transition-all"
          >
            <span>Gabung — mulai Rp1.000/hari</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <!-- 3 Trust Badges -->
        <div class="flex items-center justify-center flex-wrap gap-x-3 gap-y-1.5 pt-1 text-[11px] text-neutral-500 font-medium">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Tanpa potongan otomatis
          </span>
          <span class="text-neutral-300">•</span>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Rekening resmi
          </span>
          <span class="text-neutral-300">•</span>
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-primary-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            Berlaku 1 bulan
          </span>
        </div>
      </section>

      <!-- ── 3. Benefit: Kajian Live Bersama UAS ──────────────────────── -->
      <section class="px-5 py-6 bg-neutral-50/70 border-b border-neutral-100 space-y-4">
        <div class="text-center space-y-1.5">
          <span class="text-xs font-bold uppercase tracking-wider text-primary-700">Benefit Member</span>
          <h3 class="text-lg font-bold text-neutral-900 leading-snug">
            Kajian Live Bersama UAS Setiap Selasa Malam
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Punya pertanyaan agama yang selama ini mengganjal? Member berkesempatan bertanya langsung kepada Ustadz Abdul Somad saat kajian berlangsung.
          </p>
        </div>

        <!-- 3 Pills Info -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <div class="bg-white p-3 rounded-xl border border-neutral-200/80 flex sm:flex-col items-center sm:items-start gap-2.5 shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-50 text-primary-700 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-800">Setiap Selasa Malam</p>
              <p class="text-[11px] text-neutral-500">Pukul 20.00 WIB</p>
            </div>
          </div>

          <div class="bg-white p-3 rounded-xl border border-neutral-200/80 flex sm:flex-col items-center sm:items-start gap-2.5 shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-50 text-primary-700 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-800">Via Zoom Meeting</p>
              <p class="text-[11px] text-neutral-500">Link ke grup komunitas</p>
            </div>
          </div>

          <div class="bg-white p-3 rounded-xl border border-neutral-200/80 flex sm:flex-col items-center sm:items-start gap-2.5 shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-50 text-primary-700 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-neutral-800">Tanya Langsung</p>
              <p class="text-[11px] text-neutral-500">Saat kajian berlangsung</p>
            </div>
          </div>
        </div>

        <!-- Video / Session Card Preview -->
        <div class="relative rounded-2xl overflow-hidden border border-neutral-200/90 shadow-sm bg-neutral-900 group">
          <img
            src="/assets/home/tema-ustman.jpeg"
            alt="Kajian Live Zoom Bersama UAS"
            class="w-full h-52 object-cover opacity-85 group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-linear-to-t from-neutral-950/90 via-neutral-950/25 to-neutral-950/10"></div>

          <!-- Live Badge -->
          <div class="absolute top-3 left-3 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-600/90 text-white text-[10px] font-bold uppercase tracking-wider shadow-xs">
            <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
            <span>Kajian Interaktif UAS</span>
          </div>

          <!-- Play Button Overlay -->
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-12 h-12 rounded-full bg-secondary-500 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
              <svg class="w-5 h-5 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-3.5 text-left bg-linear-to-t from-neutral-950/90 via-neutral-950/60 to-transparent">
            <p class="text-xs font-bold text-white line-clamp-1">Cuplikan member bertanya langsung kepada UAS lewat Zoom</p>
            <p class="text-[11px] text-neutral-300 mt-0.5">Bergabung Selasa siang pun tetap langsung menerima link kajian malam itu.</p>
          </div>
        </div>
      </section>

      <!-- ── 4. Yang Kamu Dapatkan sebagai Member ─────────────────────── -->
      <section class="px-5 py-6 bg-white border-b border-neutral-100 space-y-4">
        <div class="text-center space-y-1">
          <h3 class="text-lg font-bold text-neutral-900">Yang Kamu Dapatkan sebagai Member</h3>
          <p class="text-xs text-neutral-500 leading-relaxed">
            Komunitas ini bukan hanya soal donasi, tapi juga tempat untuk bertumbuh bersama Al-Qur’an.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Card 1 -->
          <div class="p-3.5 rounded-xl border border-neutral-200/80 bg-neutral-50/50 hover:border-primary-300 hover:bg-primary-50/20 transition-all shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 100-6 3 3 0 000 6z" />
              </svg>
            </div>
            <h4 class="text-xs font-bold text-neutral-900 mb-1">Kajian Mingguan UAS</h4>
            <p class="text-[11px] text-neutral-600 leading-relaxed">
              Setiap Selasa pukul 20.00 WIB via Zoom, dengan kesempatan bertanya langsung mengenai masalah agama.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="p-3.5 rounded-xl border border-neutral-200/80 bg-neutral-50/50 hover:border-primary-300 hover:bg-primary-50/20 transition-all shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
            </div>
            <h4 class="text-xs font-bold text-neutral-900 mb-1">Grup Komunitas</h4>
            <p class="text-[11px] text-neutral-600 leading-relaxed">
              Grup WhatsApp untuk info kajian, pengingat amalan harian, dan saling menguatkan sesama member pecinta Al-Qur'an.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="p-3.5 rounded-xl border border-neutral-200/80 bg-neutral-50/50 hover:border-primary-300 hover:bg-primary-50/20 transition-all shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h4 class="text-xs font-bold text-neutral-900 mb-1">Belajar Ngaji (Opsional)</h4>
            <p class="text-[11px] text-neutral-600 leading-relaxed">
              Bagi yang berminat, tersedia bimbingan belajar tahsin & tajwid secara privat maupun online bersama asatidz.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="p-3.5 rounded-xl border border-neutral-200/80 bg-neutral-50/50 hover:border-primary-300 hover:bg-primary-50/20 transition-all shadow-xs">
            <div class="w-8 h-8 rounded-lg bg-primary-100 text-primary-700 flex items-center justify-center mb-2.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h4 class="text-xs font-bold text-neutral-900 mb-1">Amal Jariyah Terarah</h4>
            <p class="text-[11px] text-neutral-600 leading-relaxed">
              Donasimu disalurkan teratur untuk mengapresiasi guru ngaji pelosok, santri, dan kelangsungan dakwah Al-Qur'an.
            </p>
          </div>
        </div>
      </section>

      <!-- ── 5. FORM GABUNG KOMUNITAS JAGA NYALA (Sedekah Rutin 30 Hari) ── -->
      <section id="form-gabung" class="px-5 py-6 bg-primary-50/40 border-b border-primary-100/60 scroll-mt-20 space-y-5">
        <div class="text-center space-y-1">
          <h3 class="text-xl font-bold text-neutral-900 leading-snug">
            Gabung Komunitas Jaga Nyala
          </h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Pilih paket yang sesuai untukmu. Setelah form dikirim, kamu akan diarahkan ke halaman pembayaran resmi.
          </p>
        </div>

        <!-- Rutin Packages Selection -->
        <div class="space-y-2.5">
          <label class="block text-xs font-bold text-neutral-700">
            Pilih Paket Sedekah Rutin Harian (30 Hari)
          </label>

          <div class="grid grid-cols-1 gap-2.5" id="package-list">
            {routinePackages.map((pkg) => (
              <div
                class={`package-card relative p-3.5 rounded-xl border cursor-pointer transition-all duration-200 flex items-center justify-between ${
                  pkg.isPopular
                    ? "border-primary-500 bg-white ring-2 ring-primary-500/20 shadow-xs"
                    : "border-neutral-200 bg-white hover:border-primary-300"
                }`}
                data-nominal={pkg.nominal}
                data-days={pkg.days}
                data-total={pkg.total}
              >
                {pkg.isPopular && (
                  <span class="absolute -top-2.5 right-3 px-2 py-0.5 rounded-full bg-secondary-500 text-white text-[10px] font-bold shadow-xs">
                    Nominal Favorit
                  </span>
                )}
                <div class="flex items-center gap-3">
                  <div class="radio-indicator w-4 h-4 rounded-full border-2 border-neutral-300 flex items-center justify-center transition-colors">
                    <span class="radio-dot w-2 h-2 rounded-full bg-primary-600 hidden"></span>
                  </div>
                  <div>
                    <p class="text-sm font-bold text-neutral-900 leading-tight">
                      {pkg.dailyText}
                    </p>
                    <p class="text-xs font-semibold text-primary-700 mt-0.5">
                      Total: {pkg.monthlyText}
                    </p>
                  </div>
                </div>

                <div class="text-right">
                  <span class="text-[11px] font-medium text-neutral-400 bg-neutral-100 px-2 py-1 rounded-md">
                    30 Hari
                  </span>
                </div>
              </div>
            ))}
          </div>

          <!-- Custom Nominal Option -->
          <div class="pt-1">
            <button
              id="btn-toggle-custom"
              type="button"
              class="text-xs text-primary-700 hover:text-primary-800 font-semibold underline underline-offset-2 flex items-center gap-1 cursor-pointer"
            >
              <span>Atau masukkan nominal lainnya</span>
            </button>

            <div id="custom-nominal-wrap" class="hidden mt-2.5 p-3 rounded-xl bg-white border border-neutral-200 shadow-xs space-y-2">
              <label for="input-custom-nominal" class="block text-xs font-semibold text-neutral-600">
                Nominal Sedekah per Hari (Minimal Rp1.000)
              </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-neutral-400">Rp</span>
                <input
                  type="text"
                  id="input-custom-nominal"
                  inputmode="numeric"
                  placeholder="Contoh: 15.000"
                  class="w-full pl-9 pr-3 py-2.5 text-sm font-semibold rounded-lg border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
                />
              </div>
              <p id="custom-total-preview" class="text-xs text-primary-700 font-semibold">
                Total 30 hari: Rp0
              </p>
            </div>
          </div>

          <!-- Detail Jadwal Info -->
