---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import BottomNav from "@/components/layouts/BottomNav.astro";
import { getServerToken } from "@/lib/auth";
import { Image } from "astro:assets";

const isAuthenticated = getServerToken(Astro.cookies) !== null;

const donationStatuses = [
  {
    label: "Menunggu Pembayaran",
    link: '/donasi-saya/status?status=menunggu-pembayaran',
    total: 3,
    image: "/images/icons/icon-tracking/1. Pembayaran I.png",
  },
  {
    label: "Menunggu Salur",
    link: '/donasi-saya/status?status=menunggu-pembayaran',
    total: 0,
    image: "/images/icons/icon-tracking/2. Menunggu salur I.png",
  },
  {
    label: "Proses Salur",
    link: '/donasi-saya/status?status=menunggu-pembayaran',
    total: 0,
    image: "/images/icons/icon-tracking/3. proses salur I.png",
  },
  {
    label: "Selesai Salur",
    link: '/donasi-saya/status?status=menunggu-pembayaran',
    total: 7,
    image: "/images/icons/icon-tracking/4. Selesai salur I.png",
  },
];

---

<MainLayout
  title="Riwayat Donasi"
  description="Riwayat donasi yang pernah anda donasikan"
>
  <Header  />

  <div
    id="riwayat-page"
    data-api-url={import.meta.env.ASTRO_API_URL}
    class="container min-h-screen pb-24 bg-gray-50"
  >

    <!-- ── Hero Banner ───────────────────────────────────────────────────────── -->
    <div class="relative overflow-hidden">

      <!-- Gradient Background -->
      
      <div class="relative bg-gradient-to-tl from-primary-200 to-primary-400 px-5 py-9 overflow-hidden pt-18">
        <!-- Dekorasi lingkaran background -->
        <div class="absolute -top-8 -right-8 w-40 h-40 bg-primary-300/30 rounded-full"></div>
        <div class="absolute -bottom-6 right-10 w-24 h-24 bg-primary-400/20 rounded-full"></div>

        <!-- Content -->
        <div class="relative z-10 w-11/12">

          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full mb-3 shadow-sm">
            <!-- Clock icon -->
            <svg class="w-3 h-3 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-[10px] font-semibold text-gray-700 tracking-wide">
              RIWAYAT DONASI
            </span>
          </div>

          <!-- Title -->
          <h2 class="text-[18px] font-bold text-gray-800 leading-tight mb-2">
            Jejak Kebaikanmu<br />
            <span class="text-primary-600">Tercatat dengan Indah</span>
          </h2>

          <!-- Description -->
          <p class="text-[13px] text-gray-700/80 leading-relaxed mb-4 font-medium">
            Setiap donasi yang kamu berikan adalah catatan pahala yang tak terhapuskan
          </p>

          <!-- CTA Button — hanya tampil jika sudah login (server-side) -->
          {isAuthenticated && (
            <a
              href="/donasi"
              class="inline-flex mb-4 items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-md shadow-orange-200 active:scale-95"
            >
              <span>Donasi Lagi</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          )}

          <!-- CTA login prompt — hanya tampil jika belum login -->
          {!isAuthenticated && (
            <a
              href="/auth/login"
              class="inline-flex items-center gap-2 border border-primary-500 text-primary-600 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-primary-50 transition-all active:scale-95"
            >
              <span>Masuk untuk Melihat</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          )}
        </div>
      </div>



<!-- Status Donasi -->
<div class="px-4 -mt-6 relative z-20 mb-5">
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
    
    <div class="grid grid-cols-4 gap-3">
      {donationStatuses.map((status) => (
        <div
          class="flex flex-col items-center text-center p-2 group"
        >
          {/* Icon Wrapper */}
          <div
            class={`
              w-12 h-12 rounded-2xl cursor-pointer flex items-center justify-center mb-2 shadow-sm bg-gradient-to-br from-primary-50 to-primary-100
            `}
          >
            {/* image */}
            <div class="w-5 h-5 overflow-hidden group-hover:scale-105 transition-transform duration-200">
                <Image src={status.image} alt={status.label} width={20} height={20} />
            </div>
          </div>

          {/* Label */}
          <p class="text-[11px] leading-tight text-gray-500 font-medium">
            {status.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</div>
    </div>

    <!-- ── Calendar / Filter ─────────────────────────────────────────────────── -->
    <div class="px-4 mb-4">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

        <!-- Header filter -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
          <div class="flex items-center gap-2">
            <span class="w-1 h-5 bg-primary-500 rounded-full"></span>
            <span class="text-sm font-semibold text-gray-700">Filter Periode</span>
          </div>
          <button
            id="btn-reset-filter"
            class="hidden text-[11px] text-primary-500 font-medium hover:underline"
          >
            Reset
          </button>
        </div>

        <div class="p-4">

          <!-- Month-year navigation -->
          <div class="flex items-center justify-between mb-4">
            <button
              id="btn-prev-month"
              class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors"
              aria-label="Bulan sebelumnya"
            >
              <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
              </svg>
            </button>

            <button id="btn-month-label" class="text-sm font-semibold text-gray-700 px-3 py-1 rounded-lg hover:bg-gray-100 transition-colors">
              <!-- diisi JS -->
            </button>

            <button
              id="btn-next-month"
              class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors"
              aria-label="Bulan berikutnya"
            >
              <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>

          <!-- Day labels -->
          <div class="grid grid-cols-7 mb-1">
            {["Min","Sen","Sel","Rab","Kam","Jum","Sab"].map((d) => (
              <div class="text-center text-[10px] font-semibold text-gray-400 py-1">{d}</div>
            ))}
          </div>

          <!-- Calendar grid — diisi JS -->
          <div id="calendar-grid" class="grid grid-cols-7 gap-y-1"></div>

        </div>

        <!-- Status filter tabs -->
        <div class="flex gap-2 px-4 pb-4 overflow-x-auto scrollbar-hide">
          {[
            { value: "", label: "Semua" },
            { value: "success", label: "Berhasil" },
            { value: "pending", label: "Pending" },
            { value: "failed", label: "Gagal" },
          ].map((tab) => (
            <button
              data-status={tab.value}
              class="status-tab shrink-0 text-xs font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-gray-500 hover:border-primary-400 hover:text-primary-600 transition-all"
            >
              {tab.label}
            </button>
          ))}
        </div>

      </div>
    </div>

    <!-- ── List Riwayat Donasi ────────────────────────────────────────────────── -->
    <div class="mt-2 px-4 space-y-3">

      <!-- Section Header -->
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
          <div class="flex items-center gap-2">
            <span class="w-1 h-5 bg-primary-500 rounded-full"></span>
            <span class="text-sm font-semibold text-gray-700">Riwayat Donasi Saya</span>
          </div>
          <span id="riwayat-date-label" class="text-[11px] text-gray-400 font-medium"></span>
        </div>

        <!-- State: belum login -->
        {!isAuthenticated && (
          <div class="flex flex-col items-center py-10 text-center px-4">
            <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mb-3">
              <svg class="w-7 h-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-gray-700">Masuk untuk melihat riwayat donasi</p>
            <p class="text-xs text-gray-400 mt-1 mb-4">Lacak setiap kebaikan yang telah kamu lakukan</p>
            <a
              href="/auth/login"
              class="inline-flex items-center gap-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all"
            >
              Masuk Sekarang
            </a>
          </div>
        )}

        <!-- State: sudah login — list di-render client-side -->
        {isAuthenticated && (
          <div>
            <!-- Skeleton loading -->
            <div id="riwayat-skeleton" class="divide-y divide-gray-50">
              {[1, 2, 3, 4].map(() => (
                <div class="px-4 py-4 flex items-center gap-3">
                  <div class="w-[120px] h-[70px] bg-gray-200 rounded-xl animate-pulse shrink-0"></div>
                  <div class="flex-1 space-y-2">
                    <div class="h-3.5 bg-gray-200 rounded w-3/4 animate-pulse"></div>
                    <div class="h-3 bg-gray-200 rounded w-1/2 animate-pulse"></div>
                    <div class="h-3 bg-gray-200 rounded w-1/3 animate-pulse"></div>
                  </div>
                  <div class="h-5 bg-gray-200 rounded-full w-16 animate-pulse shrink-0"></div>
                </div>
              ))}
            </div>

            <!-- List container -->
            <div id="riwayat-list" class="hidden divide-y divide-gray-50"></div>

            <!-- Empty state -->
            <div id="riwayat-empty" class="hidden flex-col items-center py-10 text-center px-4">
              <div class="w-14 h-14 bg-primary-50 rounded-full flex items-center justify-center mb-3">
                <svg class="w-7 h-7 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
              </div>
              <p class="text-sm font-medium text-gray-700">Belum ada riwayat donasi</p>
              <p class="text-xs text-gray-400 mt-1 mb-4">Yuk mulai berdonasi dan tinggalkan jejak kebaikan</p>
              <a
                href="/donasi"
                class="inline-flex items-center gap-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all"
              >
                Mulai Donasi
              </a>
            </div>

            <!-- Error state -->
            <div id="riwayat-error" class="hidden flex-col items-center py-10 text-center px-4">
              <p class="text-sm font-medium text-gray-700">Gagal memuat data</p>
              <p class="text-xs text-gray-400 mt-1">Periksa koneksi dan coba lagi</p>
              <button
                id="btn-retry"
                class="mt-4 text-xs font-semibold text-primary-500 border border-primary-300 px-4 py-2 rounded-xl hover:bg-primary-50 transition-colors"
              >
                Coba Lagi
              </button>
            </div>
          </div>
        )}
      </div>

      <!-- Load more -->
      <div id="riwayat-loadmore" class="hidden pb-2">
        <button
          id="btn-loadmore"
          data-page="2"
          class="w-full border border-primary-400 text-primary-600 text-sm font-semibold py-2.5 rounded-xl hover:bg-primary-50 transition-colors"
        >
          Lihat lebih banyak
        </button>
      </div>

    </div>
  </div>

  <BottomNav active="donasiku" />
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";
  import { formatRupiah } from "@/lib/formatter";
  import { getToken } from "@/lib/auth";

  const page    = document.getElementById("riwayat-page") as HTMLElement;
  const API_URL = page?.dataset.apiUrl ?? "";

  // ── Calendar state ─────────────────────────────────────────────────────────
  const today      = new Date();
  let activeYear   = today.getFullYear();
  let activeMonth  = today.getMonth(); // 0-indexed
  let selectedDate = "";               // "YYYY-MM-DD" atau "" (semua)
  let activeStatus = "";               // "" | "success" | "pending" | "failed"

  const MONTHS_ID = [
    "Januari","Februari","Maret","April","Mei","Juni",
    "Juli","Agustus","September","Oktober","November","Desember",
  ];

  // ── DOM refs ───────────────────────────────────────────────────────────────
  const skeleton   = document.getElementById("riwayat-skeleton")   as HTMLElement;
  const list       = document.getElementById("riwayat-list")       as HTMLElement;
  const empty      = document.getElementById("riwayat-empty")      as HTMLElement;
  const errorEl    = document.getElementById("riwayat-error")      as HTMLElement;
  const loadmore   = document.getElementById("riwayat-loadmore")   as HTMLElement;
  const btnMore    = document.getElementById("btn-loadmore")        as HTMLButtonElement;
  const btnRetry   = document.getElementById("btn-retry")           as HTMLButtonElement;
  const dateLabel  = document.getElementById("riwayat-date-label") as HTMLElement;
  const btnReset   = document.getElementById("btn-reset-filter")    as HTMLButtonElement;
  const monthLabel = document.getElementById("btn-month-label")    as HTMLButtonElement;
  const calGrid    = document.getElementById("calendar-grid")      as HTMLElement;

  // Stats
  const statCount  = document.getElementById("stat-total-count")  as HTMLElement;
  const statAmount = document.getElementById("stat-total-amount") as HTMLElement;
  const statMonth  = document.getElementById("stat-this-month")   as HTMLElement;

  // Keluar lebih awal jika belum login (skeleton tidak ada)
  if (!skeleton) {
    // user belum login — tidak perlu JS lebih lanjut
  } else {
    const token = getToken();

    // ── Helpers ──────────────────────────────────────────────────────────────

    function pad(n: number) {
      return String(n).padStart(2, "0");
    }

    function toYMD(y: number, m: number, d: number) {
      return `${y}-${pad(m + 1)}-${pad(d)}`;
    }

    function showEmpty() {
      empty.classList.remove("hidden");
      empty.classList.add("flex");
    }

    function showError() {
      errorEl.classList.remove("hidden");
      errorEl.classList.add("flex");
    }

    function hideStates() {
      [empty, errorEl].forEach((el) => {
        el.classList.add("hidden");
        el.classList.remove("flex");
      });
    }

    function updateDateLabel() {
      if (selectedDate) {
        const [y, m, d] = selectedDate.split("-");
        dateLabel.textContent = `${d} ${MONTHS_ID[parseInt(m) - 1]} ${y}`;
        btnReset.classList.remove("hidden");
      } else {
        dateLabel.textContent = `${MONTHS_ID[activeMonth]} ${activeYear}`;
        btnReset.classList.add("hidden");
      }
    }

    // ── Status badge ──────────────────────────────────────────────────────────

    function statusBadge(status: string): string {
      const map: Record<string, string> = {
        success : "bg-green-50 text-green-600",
        pending : "bg-yellow-50 text-yellow-600",
        failed  : "bg-red-50 text-red-500",
        canceled: "bg-gray-100 text-gray-400",
      };
      const labelMap: Record<string, string> = {
        success : "Berhasil",
        pending : "Pending",
        failed  : "Gagal",
        canceled: "Dibatalkan",
      };
      const cls   = map[status]      ?? "bg-gray-100 text-gray-400";
      const label = labelMap[status] ?? status;
      return `<span class="inline-block text-[10px] px-2 py-0.5 rounded-full font-medium ${cls}">${label}</span>`;
    }

    // ── Render item ───────────────────────────────────────────────────────────

    function renderItem(item: any): string {
      const image = item.image_url
        ? `<img
             src="${item.image_url}"
             alt="${item.judul ?? ""}"
             class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
             loading="lazy"
           />`
        : `<div class="flex items-center justify-center w-full h-full bg-gray-100">
             <svg class="w-5 h-5 text-primary-400 fill-current" viewBox="0 0 24 24">
               <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
             </svg>
           </div>`;

      const rawDate  = item.time ?? "";
      const dateObj  = rawDate ? new Date(rawDate) : null;
      const dateStr  = dateObj
        ? `${dateObj.getDate()} ${MONTHS_ID[dateObj.getMonth()]} ${dateObj.getFullYear()}`
        : "-";
      const timeStr  = dateObj
        ? `${pad(dateObj.getHours())}:${pad(dateObj.getMinutes())}`
        : "";

      return `
        <a
          href="/invoice/${item.invoice}"
          class="group flex flex-row items-stretch bg-white rounded border border-gray-100
                 overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200 w-full"
        >
          <!-- Image -->
          <div class="relative flex-shrink-0 w-[120px] h-[70px] m-3 rounded-md overflow-hidden bg-gray-100">
            ${image}
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-between flex-1 min-w-0 py-3 pr-3 pl-1">

            <!-- Title -->
            <p class="text-[13px] font-semibold text-gray-800 leading-snug line-clamp-2 mb-1 group-hover:text-primary-600 transition-colors duration-150">
              ${item.judul ?? "-"}
            </p>

            <!-- Date -->
            <p class="text-[11px] text-gray-400 mb-2">
              ${dateStr}${timeStr ? " · " + timeStr : ""}
            </p>

            <!-- Bottom Section -->
            <div class="flex justify-between items-end">

              <!-- Nominal -->
              <div>
                <p class="text-[10px] text-gray-400 mb-0.5 leading-none">Nominal</p>
                <p class="text-[13px] font-semibold text-primary-600 leading-none">
                  ${formatRupiah(item.nominal_donasi ?? 0)}
                </p>
              </div>

              <!-- Status -->
              ${statusBadge(item.payment_status ?? "")}

            </div>
          </div>
        </a>
      `;
    }

    // ── Fetch stats ───────────────────────────────────────────────────────────

    async function fetchStats() {
      try {
        const headers: Record<string, string> = { Accept: "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const res  = await fetch(`${API_URL}/dashboard/riwayat/stats`, { headers });
        if (!res.ok) return;
        const json = await res.json();

        if (statCount)  statCount.textContent  = String(json?.data?.total_count  ?? "-");
        if (statAmount) statAmount.textContent = json?.data?.total_amount
          ? formatRupiah(json.data.total_amount)
          : "-";
        if (statMonth)  statMonth.textContent  = json?.data?.this_month_count
          ? String(json.data.this_month_count) + "x"
          : "-";
      } catch {
        // stats gagal — tidak perlu alert
      }
    }

    // ── Fetch list ────────────────────────────────────────────────────────────

    async function fetchList(pg = 1, append = false) {
      try {
        hideStates();
        if (!append) {
          skeleton.classList.remove("hidden");
          list.classList.add("hidden");
          list.innerHTML = "";
          loadmore.classList.add("hidden");
        }

        const headers: Record<string, string> = { Accept: "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const params = new URLSearchParams({ page: String(pg) });
        if (selectedDate)  params.set("date",   selectedDate);
        else {
          params.set("month", pad(activeMonth + 1));
          params.set("year",  String(activeYear));
        }
        if (activeStatus) params.set("status", activeStatus);

        const res  = await fetch(`${API_URL}/dashboard/my-donation?${params}`, { headers });
        const json = await res.json();

        if (!res.ok) throw new Error(json?.message ?? "Gagal memuat data");

        const items: any[]     = json?.data ?? [];
        const hasMore: boolean = (json?.meta?.current_page ?? 1) < (json?.meta?.last_page ?? 1);

        skeleton.classList.add("hidden");

        if (items.length === 0 && !append) {
          showEmpty();
          return;
        }

        list.classList.remove("hidden");
        if (!append) list.innerHTML = "";
        list.insertAdjacentHTML("beforeend", items.map(renderItem).join(""));

        if (hasMore) {
          loadmore.classList.remove("hidden");
          btnMore.dataset.page = String(pg + 1);
        } else {
          loadmore.classList.add("hidden");
        }
      } catch (err: any) {
        skeleton.classList.add("hidden");
        if (!append) showError();
        showToast(err.message ?? "Gagal memuat riwayat donasi", "error");
      }
    }

    // ── Calendar ──────────────────────────────────────────────────────────────

    function renderCalendar() {
      if (!calGrid || !monthLabel) return;

      monthLabel.textContent = `${MONTHS_ID[activeMonth]} ${activeYear}`;

      const firstDay    = new Date(activeYear, activeMonth, 1).getDay(); // 0=Sun
      const daysInMonth = new Date(activeYear, activeMonth + 1, 0).getDate();

      let html = "";

      // empty cells before first day
      for (let i = 0; i < firstDay; i++) {
        html += `<div></div>`;
      }

      for (let d = 1; d <= daysInMonth; d++) {
        const ymd         = toYMD(activeYear, activeMonth, d);
        const isToday     = ymd === toYMD(today.getFullYear(), today.getMonth(), today.getDate());
        const isSelected  = ymd === selectedDate;
        const isFuture    = new Date(activeYear, activeMonth, d) > today;

        let cls = "w-8 h-8 mx-auto flex items-center justify-center rounded-full text-[12px] font-medium transition-colors ";

        if (isSelected) {
          cls += "bg-primary-500 text-white shadow-sm";
        } else if (isToday) {
          cls += "bg-primary-100 text-primary-700 font-semibold";
        } else if (isFuture) {
          cls += "text-gray-300 cursor-not-allowed";
        } else {
          cls += "text-gray-600 hover:bg-primary-50 hover:text-primary-600 cursor-pointer";
        }

        html += `
          <div class="py-0.5">
            <button
              data-date="${ymd}"
              class="${cls}"
              ${isFuture ? "disabled" : ""}
              aria-label="${d} ${MONTHS_ID[activeMonth]} ${activeYear}"
            >${d}</button>
          </div>`;
      }

      calGrid.innerHTML = html;

      // attach click events
      calGrid.querySelectorAll<HTMLButtonElement>("button[data-date]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const d = btn.dataset.date ?? "";
          if (selectedDate === d) {
            selectedDate = "";     // toggle off
          } else {
            selectedDate = d;
          }
          renderCalendar();
          updateDateLabel();
          fetchList();
        });
      });
    }

    // ── Status tabs ───────────────────────────────────────────────────────────

    function updateStatusTabs() {
      document.querySelectorAll<HTMLButtonElement>(".status-tab").forEach((tab) => {
        const val = tab.dataset.status ?? "";
        if (val === activeStatus) {
          tab.classList.add("bg-primary-500", "text-white", "border-primary-500");
          tab.classList.remove("text-gray-500", "border-gray-200");
        } else {
          tab.classList.remove("bg-primary-500", "text-white", "border-primary-500");
          tab.classList.add("text-gray-500", "border-gray-200");
        }
      });
    }

    document.querySelectorAll<HTMLButtonElement>(".status-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        activeStatus = tab.dataset.status ?? "";
        updateStatusTabs();
        fetchList();
      });
    });

    // ── Month navigation ──────────────────────────────────────────────────────

    document.getElementById("btn-prev-month")?.addEventListener("click", () => {
      if (activeMonth === 0) { activeMonth = 11; activeYear--; }
      else activeMonth--;
      selectedDate = "";
      renderCalendar();
      updateDateLabel();
      fetchList();
    });

    document.getElementById("btn-next-month")?.addEventListener("click", () => {
      // Tidak boleh melewati bulan ini
      if (activeYear === today.getFullYear() && activeMonth === today.getMonth()) return;
      if (activeMonth === 11) { activeMonth = 0; activeYear++; }
      else activeMonth++;
      selectedDate = "";
      renderCalendar();
      updateDateLabel();
      fetchList();
    });

    // ── Reset filter ──────────────────────────────────────────────────────────

    btnReset?.addEventListener("click", () => {
      selectedDate = "";
      renderCalendar();
      updateDateLabel();
      fetchList();
    });

    // ── Retry ─────────────────────────────────────────────────────────────────

    btnRetry?.addEventListener("click", () => fetchList());

    // ── Load more ─────────────────────────────────────────────────────────────

    btnMore?.addEventListener("click", async () => {
      const nextPage = Number(btnMore.dataset.page ?? 2);
      btnMore.textContent = "Memuat...";
      btnMore.disabled    = true;
      await fetchList(nextPage, true);
      btnMore.textContent = "Lihat lebih banyak";
      btnMore.disabled    = false;
    });

    // ── Init ──────────────────────────────────────────────────────────────────

    document.addEventListener("DOMContentLoaded", () => {
      renderCalendar();
      updateDateLabel();
      updateStatusTabs();
      fetchStats();
      fetchList();
    });
  }
</script>