---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import BottomNav from "@/components/layouts/BottomNav.astro";
import { getServerToken } from "@/lib/auth";
import { Image } from "astro:assets";
import KalenderDonasi from "@/components/sections/donasi-saya/KalenderDonasi.astro";

const isAuthenticated = getServerToken(Astro.cookies) !== null;

const donationStatuses = [
  {
    label: "Menunggu Pembayaran",
    link: "/donasi-saya/riwayat-donasi?posisi=menunggu-pembayaran",
    total: 234,
    image: "/images/icons/icon-tracking/1. Pembayaran I.png",
  },
  {
    label: "Menunggu Salur",
    link: "/donasi-saya/riwayat-donasi?posisi=menunggu-salur",
    total: 0,
    image: "/images/icons/icon-tracking/2. Menunggu salur I.png",
  },
  {
    label: "Proses Salur",
    link: "/donasi-saya/riwayat-donasi?posisi=proses",
    total: 0,
    image: "/images/icons/icon-tracking/3. proses salur I.png",
  },
  {
    label: "Selesai Salur",
    link: "/donasi-saya/riwayat-donasi?posisi=selesai",
    total: 7,
    image: "/images/icons/icon-tracking/4. Selesai salur I.png",
  },
];
---

<MainLayout
  title="Donasi Saya"
  description="Riwayat donasi yang pernah anda donasikan"
>
  <Header />

  <div
    id="donasi-saya-page"
    data-api-url={import.meta.env.PUBLIC_API_URL}
    class="container min-h-screen pb-24 bg-gray-50"
  >
    <!-- ── Hero Banner ───────────────────────────────────────────────────────── -->
    <div class="relative overflow-hidden">
      <!-- Gradient Background -->
      <div
        class="relative bg-gradient-to-tl from-primary-200 to-primary-400 px-5 py-9 overflow-hidden pt-18"
      >
        <!-- Dekorasi lingkaran background -->
        <div
          class="absolute -top-8 -right-8 w-40 h-40 bg-primary-300/30 rounded-full"
        >
        </div>
        <div
          class="absolute -bottom-6 right-10 w-24 h-24 bg-primary-400/20 rounded-full"
        >
        </div>

        <!-- Content -->
        <div class="relative z-10 w-11/12">
          <!-- Badge -->
          <div
            class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full mb-3 shadow-sm"
          >
            <svg
              class="w-3 h-3 text-primary-500"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-[10px] font-semibold text-gray-700 tracking-wide">
              DONASI SAYA
            </span>
          </div>

          <!-- Title -->
          <h2 class="text-[18px] font-bold text-gray-800 leading-tight mb-2">
            Jejak Kebaikanmu<br />
            <span class="text-primary-600">Tercatat dengan Indah</span>
          </h2>

          <!-- Description -->
          <p
            class="text-[13px] text-gray-700/80 leading-relaxed mb-4 font-medium"
          >
            Setiap donasi yang kamu berikan adalah catatan pahala yang tak
            terhapuskan
          </p>

          <!-- CTA Button — hanya tampil jika sudah login -->
          {
            isAuthenticated && (
              <a
                href="/donasi"
                class="inline-flex mb-4 items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all shadow-md shadow-orange-200 active:scale-95"
              >
                <span>Donasi Lagi</span>
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            )
          }

          <!-- CTA login prompt — hanya tampil jika belum login -->
          {
            !isAuthenticated && (
              <a
                href={`/auth/login?from=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
                class="inline-flex items-center gap-2 border border-primary-500 text-primary-600 text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-primary-50 transition-all active:scale-95"
              >
                <span>Masuk untuk Melihat</span>
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>
            )
          }
        </div>
      </div>

      <!-- Status Donasi -->
      <div class="px-4 -mt-6 relative z-20 mb-5">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
          <!-- Link ke riwayat lengkap -->
          <div class="px-4 pb-4">
            <a
              href="/donasi-saya/riwayat-donasi"
              class="flex items-center justify-end gap-1.5 w-full text-primary-600 text-xs hover:underline"
            >
              <span>Lihat Semua Riwayat</span>
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
          <div class="grid grid-cols-4 gap-3">
            {
              donationStatuses.map((status) => (
                <a
                  href={status.link}
                  class="flex flex-col items-center text-center p-2 group relative"
                >
                  {/* Icon Wrapper */}
                  <div class="w-12 h-12 rounded-2xl cursor-pointer flex items-center justify-center mb-2 shadow-sm bg-gradient-to-br from-primary-50 to-primary-100">
                    <div class="overflow-hidden group-hover:scale-105 transition-transform duration-200">
                      <Image
                        src={status.image}
                        alt={status.label}
                        width={22}
                        height={22}
                      />
                    </div>
                  </div>

                  {/* total badge */}
                  {status.total > 0 && (
                    <div
                      class="
                      absolute top-0 right-0 md:right-3
                      flex items-center justify-center
                      min-w-5 h-5 px-1
                      rounded-full
                      bg-gradient-to-tl from-secondary-300 to-secondary-400
                      text-[10px] font-semibold text-white
                      shadow-sm border border-white
                    "
                    >
                      {status.total}
                    </div>
                  )}

                  {/* Label */}
                  <p class="text-[11px] leading-tight text-gray-500 font-medium">
                    {status.label}
                  </p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <KalenderDonasi />
  </div>

  <BottomNav active="donasiku" />
</MainLayout>

<script>
  import { getToken } from "@/lib/auth";

  const page = document.getElementById("donasi-saya-page") as HTMLElement;
  const API_URL = page?.dataset.apiUrl ?? "";

  const today = new Date();
  let activeYear = today.getFullYear();
  let activeMonth = today.getMonth();
  let donationDates = new Set<string>();

  const MONTHS_ID = [
    "Januari",
    "Februari",
    "Maret",
    "April",
    "Mei",
    "Juni",
    "Juli",
    "Agustus",
    "September",
    "Oktober",
    "November",
    "Desember",
  ];

  const monthLabel = document.getElementById("btn-month-label") as HTMLElement;
  const calGrid = document.getElementById("calendar-grid") as HTMLElement;

  function pad(n: number) {
    return String(n).padStart(2, "0");
  }

  function toYMD(y: number, m: number, d: number) {
    return `${y}-${pad(m + 1)}-${pad(d)}`;
  }

  // ── Calendar rendering ────────────────────────────────────────────────────

  function renderCalendar() {
    if (!calGrid || !monthLabel) return;

    monthLabel.textContent = `${MONTHS_ID[activeMonth]} ${activeYear}`;

    const firstDay = new Date(activeYear, activeMonth, 1).getDay();
    const daysInMonth = new Date(activeYear, activeMonth + 1, 0).getDate();

    let html = "";

    for (let i = 0; i < firstDay; i++) {
      html += `<div></div>`;
    }

    for (let d = 1; d <= daysInMonth; d++) {
      const ymd = toYMD(activeYear, activeMonth, d);
      const isToday =
        ymd === toYMD(today.getFullYear(), today.getMonth(), today.getDate());
      const isFuture = new Date(activeYear, activeMonth, d) > today;
      const hasDonation = donationDates.has(ymd);

      let numCls =
        "w-8 h-8 mx-auto flex items-center justify-center rounded-full text-[12px] font-medium ";
      if (isToday) numCls += "bg-primary-100 text-primary-700 font-semibold";
      else if (isFuture) numCls += "text-gray-300";
      else numCls += "text-gray-600";

      html += `
        <div class="py-0.5 flex flex-col items-center">
          <div class="${numCls}">${d}</div>
          <div class="w-1.5 h-1.5 mt-0.5 rounded-full ${hasDonation ? "bg-green-400" : ""}"></div>
        </div>`;
    }

    calGrid.innerHTML = html;
  }

  // ── Fetch tanggal donasi sukses ───────────────────────────────────────────

  async function fetchDonationDates() {
    const token = getToken();
    if (!token) {
      renderCalendar();
      return;
    }

    try {
      const headers: Record<string, string> = {
        Accept: "application/json",
        Authorization: `Bearer ${token}`,
      };

      const params = new URLSearchParams({
        month: pad(activeMonth + 1),
        year: String(activeYear),
        status: "success",
        per_page: "100",
      });

      // const res = await fetch(`${API_URL}/dashboard/my-donation?${params}`, {
      //   headers,
      // });
      // if (!res.ok) throw new Error();

      // const json = await res.json();
      // const items: any[] = json?.data ?? [];

      // donationDates = new Set(
      //   items
      //     .map((item: any) => {
      //       const d = new Date(item.time ?? "");
      //       return isNaN(d.getTime())
      //         ? ""
      //         : toYMD(d.getFullYear(), d.getMonth(), d.getDate());
      //     })
      //     .filter(Boolean),
      // );
    } catch {
      // donationDates = new Set();
    }

    renderCalendar();
  }

  // ── Month navigation ──────────────────────────────────────────────────────

  document.getElementById("btn-prev-month")?.addEventListener("click", () => {
    if (activeMonth === 0) {
      activeMonth = 11;
      activeYear--;
    } else activeMonth--;
    fetchDonationDates();
  });

  document.getElementById("btn-next-month")?.addEventListener("click", () => {
    if (activeYear === today.getFullYear() && activeMonth === today.getMonth())
      return;
    if (activeMonth === 11) {
      activeMonth = 0;
      activeYear++;
    } else activeMonth++;
    fetchDonationDates();
  });

  // ── Init ──────────────────────────────────────────────────────────────────
  // Astro scripts run as deferred modules — DOMContentLoaded sudah fired, panggil langsung
  fetchDonationDates();
</script>
