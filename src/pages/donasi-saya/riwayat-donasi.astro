---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import BottomNav from "@/components/layouts/BottomNav.astro";
import { getServerToken } from "@/lib/auth";

const isAuthenticated = getServerToken(Astro.cookies) !== null;

// Untuk 3 tab pertama, `value` adalah nilai query param `status` yang
// dikirim ke /my-donation (enum resmi: Paid | Canceled | Pending).
// Untuk 2 tab terakhir (Proses Salur / Selesai Salur), /my-salur tidak
// punya query param maupun pagination — semua data langsung dikembalikan
// sekaligus, jadi pemisahan "proses" vs "selesai" dilakukan di frontend.
const statusTabs = [
  { value: "",             label: "Semua" },
  { value: "Pending",      label: "Menunggu Pembayaran" },
  { value: "Paid",         label: "Menunggu Salur" },
  { value: "proses-salur", label: "Proses Salur" },
  { value: "success",      label: "Selesai Salur" },
];
---

<MainLayout title="Riwayat Donasi" description="Riwayat donasi saya">
  <Header type="notshare" text="Riwayat Donasi Saya" />

  <div
    id="riwayat-page"
    data-api-url={import.meta.env.PUBLIC_API_URL}
    class="container min-h-screen pb-24 pt-16 bg-gray-50"
  >

    <!-- ── Status Filter Tabs ────────────────────────────────────────────────── -->
    <div class="px-4 pt-4 pb-2">
      <div class="flex gap-2 overflow-x-auto scrollbar-hide pb-1">
        {statusTabs.map((tab) => (
          <button
            data-status={tab.value}
            class="status-tab shrink-0 text-xs font-semibold px-4 py-1.5 rounded-full border border-gray-200 text-gray-500 hover:border-primary-400 hover:text-primary-600 transition-all whitespace-nowrap"
          >
            {tab.label}
          </button>
        ))}
      </div>
    </div>

    <!-- ── List Riwayat ──────────────────────────────────────────────────────── -->
    <div class="mt-2 px-4 space-y-3">
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">

        <!-- Section header -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
          <div class="flex items-center gap-2">
            <span id="list-title" class="text-sm font-semibold text-gray-700">Semua Riwayat</span>
          </div>
        </div>

        <!-- State: belum login -->
        {!isAuthenticated && (
          <div class="flex flex-col items-center py-10 text-center px-4">
            <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mb-3">
              <svg class="w-7 h-7 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <p class="text-sm font-medium text-gray-700">Masuk untuk melihat riwayat donasi</p>
            <p class="text-xs text-gray-400 mt-1 mb-4">Lacak setiap kebaikan yang telah kamu lakukan</p>
            <a
              href={`/auth/login?from=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
              class="inline-flex items-center gap-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all"
            >
              Masuk Sekarang
            </a>
          </div>
        )}

        <!-- State: sudah login -->
        {isAuthenticated && (
          <div>
            <!-- Skeleton loading -->
            <div id="riwayat-skeleton" class="divide-y divide-gray-50">
              {[1, 2, 3, 4].map(() => (
                <div class="px-4 py-4 flex items-center gap-3">
                  <div class="w-[120px] h-[70px] bg-gray-200 rounded-xl animate-pulse shrink-0"></div>
                  <div class="flex-1 space-y-2">
                    <div class="h-3.5 bg-gray-200 rounded w-3/4 animate-pulse"></div>
                    <div class="h-3 bg-gray-200 rounded w-1/2 animate-pulse"></div>
                    <div class="h-3 bg-gray-200 rounded w-1/3 animate-pulse"></div>
                  </div>
                  <div class="h-5 bg-gray-200 rounded-full w-20 animate-pulse shrink-0"></div>
                </div>
              ))}
            </div>

            <!-- List container -->
            <div id="riwayat-list" class="hidden divide-y divide-gray-50"></div>

            <!-- Empty state -->
            <div id="riwayat-empty" class="hidden flex-col items-center py-10 text-center px-4">
              <div class="w-14 h-14 bg-primary-50 rounded-full flex items-center justify-center mb-3">
                <svg class="w-7 h-7 text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
              </div>
              <p class="text-sm font-medium text-gray-700">Belum ada riwayat donasi</p>
              <p class="text-xs text-gray-400 mt-1 mb-4">Yuk mulai berdonasi dan tinggalkan jejak kebaikan</p>
              <a
                href="/donasi"
                class="inline-flex items-center gap-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-5 py-2.5 rounded-xl transition-all"
              >
                Mulai Donasi
              </a>
            </div>

            <!-- Error state -->
            <div id="riwayat-error" class="hidden flex-col items-center py-10 text-center px-4">
              <p class="text-sm font-medium text-gray-700">Gagal memuat data</p>
              <p class="text-xs text-gray-400 mt-1">Periksa koneksi dan coba lagi</p>
              <button
                id="btn-retry"
                class="mt-4 text-xs font-semibold text-primary-500 border border-primary-300 px-4 py-2 rounded-xl hover:bg-primary-50 transition-colors"
              >
                Coba Lagi
              </button>
            </div>
          </div>
        )}
      </div>

      <!-- Load more -->
      <div id="riwayat-loadmore" class="hidden pb-2">
        <button
          id="btn-loadmore"
          data-page="2"
          class="w-full border border-primary-400 text-primary-600 text-sm font-semibold py-2.5 rounded-xl hover:bg-primary-50 transition-colors"
        >
          Lihat lebih banyak
        </button>
      </div>
    </div>

  </div>

  <BottomNav active="donasiku" />
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";
  import { formatRupiah } from "@/lib/formatter";
  import { getToken } from "@/lib/auth";

  const page    = document.getElementById("riwayat-page") as HTMLElement;
  const API_URL = page?.dataset.apiUrl ?? "";
  const token   = getToken();

  let activeStatus = "";

  const MONTHS_ID = [
    "Januari","Februari","Maret","April","Mei","Juni",
    "Juli","Agustus","September","Oktober","November","Desember",
  ];

  const STATUS_LABELS: Record<string, string> = {
    "":              "Semua Riwayat",
    "Pending":       "Menunggu Pembayaran",
    "Paid":          "Menunggu Salur",
    "proses-salur":  "Proses Salur",
    "success":       "Selesai Salur",
  };

  // Tab-tab ini dilayani oleh /dashboard/donatur/my-donation.
  const DONATION_STATUSES = ["", "Pending", "Paid"];
  // Tab-tab ini dilayani oleh /dashboard/donatur/my-salur.
  const SALUR_STATUSES = ["proses-salur", "success"];

  const PAGE_SIZE = 10;

  // ── DOM refs ───────────────────────────────────────────────────────────────

  const skeleton  = document.getElementById("riwayat-skeleton") as HTMLElement;
  const list      = document.getElementById("riwayat-list")     as HTMLElement;
  const empty     = document.getElementById("riwayat-empty")    as HTMLElement;
  const errorEl   = document.getElementById("riwayat-error")    as HTMLElement;
  const loadmore  = document.getElementById("riwayat-loadmore") as HTMLElement;
  const btnMore   = document.getElementById("btn-loadmore")      as HTMLButtonElement;
  const btnRetry  = document.getElementById("btn-retry")         as HTMLButtonElement;
  const listTitle = document.getElementById("list-title")       as HTMLElement;

  if (!skeleton) {
    // user belum login — tidak perlu JS lebih lanjut
  } else {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function showEmpty() {
      empty.classList.remove("hidden");
      empty.classList.add("flex");
    }

    function showError() {
      errorEl.classList.remove("hidden");
      errorEl.classList.add("flex");
    }

    function hideStates() {
      [empty, errorEl].forEach((el) => {
        el.classList.add("hidden");
        el.classList.remove("flex");
      });
    }

    function updateListTitle() {
      if (listTitle) {
        listTitle.textContent = STATUS_LABELS[activeStatus] ?? "Riwayat Donasi";
      }
    }

    function badgeHtml(cls: string, label: string) {
      return `<span class="inline-block text-[10px] px-2 py-0.5 rounded-full font-medium ${cls}">${label}</span>`;
    }

    // ── Status badge ──────────────────────────────────────────────────────────

    // Untuk item dari /my-donation: badge dibaca dari field status item itu
    // sendiri (Paid | Canceled | Pending). "Paid" ditampilkan sebagai
    // "Menunggu Salur" karena di sistem ini status Paid berarti dana sudah
    // masuk tapi belum diproses penyaluran.
    function donationBadge(rawStatus: string): string {
      const key = (rawStatus || "").toLowerCase();
      const map: Record<string, { cls: string; label: string }> = {
        paid:     { cls: "bg-blue-50 text-blue-600",     label: "Menunggu Salur" },
        pending:  { cls: "bg-yellow-50 text-yellow-600", label: "Menunggu Pembayaran" },
        canceled: { cls: "bg-gray-100 text-gray-400",    label: "Dibatalkan" },
      };
      const entry = map[key] ?? { cls: "bg-gray-100 text-gray-400", label: rawStatus || "-" };
      return badgeHtml(entry.cls, entry.label);
    }

    // Untuk item dari /my-salur: badge mengikuti tab yang sedang aktif,
    // karena item yang dirender di sini sudah difilter di frontend supaya
    // sesuai tab (lihat classifySalurStage di bawah).
    function salurBadge(status: string): string {
      const map: Record<string, { cls: string; label: string }> = {
        "proses-salur": { cls: "bg-purple-50 text-purple-600", label: "Proses Salur" },
        "success":      { cls: "bg-green-50 text-green-600",   label: "Selesai Salur" },
      };
      const entry = map[status] ?? { cls: "bg-gray-100 text-gray-400", label: status };
      return badgeHtml(entry.cls, entry.label);
    }

    // /my-salur mengembalikan semua data sekaligus (proses + selesai
    // dicampur), tanpa field yang terdokumentasi untuk membedakan
    // keduanya. Fungsi ini menebak dari beberapa nama field yang umum
    // dipakai (status / salur_status / stage / tahap) dan mencocokkan
    // kata kuncinya. SESUAIKAN daftar field & kata kunci ini begitu tahu
    // field asli dari backend — ini titik satu-satunya yang perlu diubah.
    function classifySalurStage(item: any): "proses-salur" | "success" | "unknown" {
      const candidates = [item.status, item.salur_status, item.stage, item.tahap, item.progress]
        .filter((v): v is string => typeof v === "string")
        .join(" ")
        .toLowerCase();

      if (candidates.includes("selesai")) {
        return "success";
      }
      if (candidates.includes("pending")) {
        return "proses-salur";
      }
      return "unknown";
    }

    // ── Render item ───────────────────────────────────────────────────────────

    function renderItem(item: any, source: "donation" | "salur"): string {
      const image = item.image_url
        ? `<img
             src="${item.image_url}"
             alt="${item.judul ?? ""}"
             class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
             loading="lazy"
           />`
        : `<div class="flex items-center justify-center w-full h-full bg-gray-100">
             <svg class="w-5 h-5 text-primary-400 fill-current" viewBox="0 0 24 24">
               <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
             </svg>
           </div>`;

      const rawDate = item.date ?? "";
      const dateObj = rawDate ? new Date(rawDate) : null;
      const dateStr = dateObj
        ? `${dateObj.getDate()} ${MONTHS_ID[dateObj.getMonth()]} ${dateObj.getFullYear()}`
        : "-";

      // `date` cuma berisi tanggal (tanpa jam), jam sebenarnya ada di field
      // `time` — walau tanggalnya sendiri di `time` adalah placeholder
      // "0000-01-01", jadi ambil jam:menit-nya langsung dari string, jangan
      // di-parse sebagai Date (dulu ini yang bikin jam selalu tampil 00:00).
      const timeStr =
        typeof item.time === "string" && item.time.includes("T")
          ? item.time.split("T")[1]?.slice(0, 5) ?? ""
          : "";

      const rawStatus = item.payment_status ?? item.status ?? "";
      const badge = source === "salur" ? salurBadge(activeStatus) : donationBadge(rawStatus);

      return `
        <a
          href="/invoice/${item.invoice}"
          class="group flex flex-row items-stretch bg-white rounded border border-gray-100
                 overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200 w-full"
        >
          <!-- Image -->
          <div class="relative flex-shrink-0 w-[120px] h-[70px] m-3 rounded-md overflow-hidden bg-gray-100">
            ${image}
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-between flex-1 min-w-0 py-3 pr-3 pl-1">

            <!-- Title -->
            <p class="text-[13px] font-semibold text-gray-800 leading-snug truncate mb-1 group-hover:text-primary-600 transition-colors duration-150">
              ${item.judul ?? "-"}
            </p>

            <!-- Date -->
            <p class="text-[11px] text-gray-400 mb-2">
              ${dateStr}${timeStr ? " · " + timeStr : ""}
            </p>

            <!-- Bottom Section -->
            <div class="flex justify-between items-end">
              <!-- Nominal -->
              <div>
                <p class="text-[13px] font-semibold text-primary-600 leading-none">
                  ${formatRupiah(item.nominal_donasi ?? 0)}
                </p>
              </div>
              <!-- Status -->
              ${badge}
            </div>
          </div>
        </a>
      `;
    }

    // ── Fetch: /my-salur (tanpa param, tanpa pagination, di-cache) ─────────────

    // Data hanya diambil sekali dari network; pindah tab antara "Proses
    // Salur" dan "Selesai Salur" cukup memfilter ulang cache ini, tidak
    // perlu request baru.
    let salurCache: any[] | null = null;

    async function fetchSalurData(): Promise<any[]> {
      if (salurCache) return salurCache;

      const headers: Record<string, string> = { Accept: "application/json" };
      if (token) headers["Authorization"] = `Bearer ${token}`;

      const res  = await fetch(`${API_URL}/dashboard/donatur/my-salur`, { headers });
      const json = await res.json();
      if (!res.ok) throw new Error(json?.message ?? "Gagal memuat data");

      const container = json?.data;
      const items: any[] = Array.isArray(container?.data)
        ? container.data
        : Array.isArray(container)
          ? container
          : [];

      salurCache = items;
      return items;
    }

    // ── Fetch list ────────────────────────────────────────────────────────────

    async function fetchList(pg = 1, append = false) {
      try {
        hideStates();
        if (!append) {
          skeleton.classList.remove("hidden");
          list.classList.add("hidden");
          list.innerHTML = "";
          loadmore.classList.add("hidden");
        }

        const isSalur = SALUR_STATUSES.includes(activeStatus);

        // ── /my-salur: semua data langsung, filter di frontend ────────────────
        if (isSalur) {
          const allSalur = await fetchSalurData();
          const filtered = allSalur.filter((item) => classifySalurStage(item) === activeStatus);

          skeleton.classList.add("hidden");

          if (filtered.length === 0) {
            showEmpty();
            return;
          }

          list.classList.remove("hidden");
          list.innerHTML = filtered.map((item) => renderItem(item, "salur")).join("");
          // /my-salur tidak dipaginasi — semua data yang relevan sudah tampil.
          loadmore.classList.add("hidden");
          return;
        }

        // ── /my-donation: dipaginasi, pakai mode=pagination + load more ───────
        const headers: Record<string, string> = { Accept: "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const params = new URLSearchParams({
          page: String(pg),
          limit: String(PAGE_SIZE),
          mode: "pagination",
        });
        if (activeStatus) params.set("status", activeStatus);

        const res  = await fetch(`${API_URL}/dashboard/donatur/my-donation?${params}`, { headers });
        const json = await res.json();

        if (!res.ok) throw new Error(json?.message ?? "Gagal memuat data");

        // Bentuk respons (mode=pagination):
        //   { data: { data: [...], pagination: { current_page, last_page, ... } }, status }
        const container = json?.data;
        const items: any[] = Array.isArray(container?.data)
          ? container.data
          : Array.isArray(container)
            ? container
            : [];

        const meta = container?.pagination ?? json?.pagination ?? json?.meta ?? null;
        const hasMore = meta ? Number(meta.current_page) < Number(meta.last_page) : false;

        skeleton.classList.add("hidden");

        if (items.length === 0 && !append) {
          showEmpty();
          return;
        }

        list.classList.remove("hidden");
        list.insertAdjacentHTML(
          "beforeend",
          items.map((item) => renderItem(item, "donation")).join(""),
        );

        if (hasMore) {
          loadmore.classList.remove("hidden");
          btnMore.dataset.page = String(pg + 1);
        } else {
          loadmore.classList.add("hidden");
        }
      } catch (err: any) {
        skeleton.classList.add("hidden");
        if (!append) showError();
        showToast(err.message ?? "Gagal memuat riwayat donasi", "error");
      }
    }

    // ── Status tabs ───────────────────────────────────────────────────────────

    function updateStatusTabs() {
      document.querySelectorAll<HTMLButtonElement>(".status-tab").forEach((tab) => {
        const val = tab.dataset.status ?? "";
        if (val === activeStatus) {
          tab.classList.add("bg-primary-500", "text-white", "border-primary-500");
          tab.classList.remove("text-gray-500", "border-gray-200");
        } else {
          tab.classList.remove("bg-primary-500", "text-white", "border-primary-500");
          tab.classList.add("text-gray-500", "border-gray-200");
        }
      });
    }

    document.querySelectorAll<HTMLButtonElement>(".status-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        activeStatus = tab.dataset.status ?? "";
        updateStatusTabs();
        updateListTitle();
        fetchList();
      });
    });

    // ── Retry / Load more ─────────────────────────────────────────────────────

    btnRetry?.addEventListener("click", () => fetchList());

    btnMore?.addEventListener("click", async () => {
      const nextPage = Number(btnMore.dataset.page ?? 2);
      btnMore.textContent = "Memuat...";
      btnMore.disabled    = true;
      await fetchList(nextPage, true);
      btnMore.textContent = "Lihat lebih banyak";
      btnMore.disabled    = false;
    });

    // ── Init: baca status dari URL param ──────────────────────────────────────
    // Astro scripts run as deferred modules — DOMContentLoaded sudah fired, panggil langsung
    const urlStatus = new URLSearchParams(window.location.search).get("status") ?? "";
    const validStatuses = [...DONATION_STATUSES, ...SALUR_STATUSES];
    activeStatus = validStatuses.includes(urlStatus) ? urlStatus : "";

    updateStatusTabs();
    updateListTitle();
    fetchList();
  }
</script>