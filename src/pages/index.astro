---
import MainLayout from "@/layouts/MainLayout.astro";

// ============================================
// DATA — pindahkan ke file terpisah nanti
// ============================================

const heroSlides = [
  {
    title: "Bersama Wujudkan Kebaikan Tanpa Batas",
    subtitle: "Program Donasi & Kemanusiaan",
    description:
      "Salurkan donasi Anda melalui platform terpercaya untuk membantu sesama, membangun pendidikan, dan menyebarkan kebermanfaatan.",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=1600&q=80",
  },
];

const quickDonations = [
  {
    icon: "💰",
    title: "Zakat",
    description:
      "Tunaikan kewajiban zakat Anda dengan mudah dan tepat sasaran.",
    href: "/zakat",
  },
  {
    icon: "🤲",
    title: "Infaq",
    description: "Berbagi rezeki untuk program kebaikan dan kemanusiaan.",
    href: "/infaq",
  },
  {
    icon: "💝",
    title: "Sedekah",
    description: "Sedekah jariyah yang pahalanya terus mengalir.",
    href: "/sedekah",
  },
  {
    icon: "🕌",
    title: "Wakaf",
    description: "Investasi akhirat melalui wakaf produktif & sosial.",
    href: "/wakaf",
  },
];

const stats = [
  { value: "12.500+", label: "Donatur Aktif" },
  { value: "Rp 8,4M", label: "Dana Tersalurkan" },
  { value: "150+", label: "Program Berjalan" },
  { value: "34", label: "Provinsi Terjangkau" },
];

const campaigns = [
  {
    image:
      "https://images.unsplash.com/photo-1497486751825-1233686d5d80?w=800&q=80",
    category: "Pendidikan",
    title: "Beasiswa Anak Yatim Penghafal Al-Qur'an",
    collected: 87500000,
    target: 150000000,
    days: 23,
    donors: 412,
  },
  {
    image:
      "https://images.unsplash.com/photo-1469571486292-0ba58a3f068b?w=800&q=80",
    category: "Kemanusiaan",
    title: "Bantuan Pangan Untuk Saudara Kita di Palestina",
    collected: 245000000,
    target: 300000000,
    days: 12,
    donors: 1287,
  },
  {
    image:
      "https://images.unsplash.com/photo-1518176258769-f227c798150e?w=800&q=80",
    category: "Pembangunan",
    title: "Renovasi Masjid & Pesantren di Pedalaman",
    collected: 56300000,
    target: 200000000,
    days: 45,
    donors: 198,
  },
];

const programs = [
  {
    icon: "📚",
    title: "Pendidikan",
    desc: "Beasiswa, fasilitas sekolah, dan program literasi Qur'an.",
  },
  {
    icon: "🏥",
    title: "Kesehatan",
    desc: "Layanan kesehatan gratis, ambulans, dan bantuan medis.",
  },
  {
    icon: "🌾",
    title: "Pemberdayaan",
    desc: "Pemberdayaan ekonomi dhuafa dan pelatihan kemandirian.",
  },
  {
    icon: "🕊️",
    title: "Dakwah",
    desc: "Kaderisasi da'i, syiar Islam, dan pengiriman muballigh.",
  },
  {
    icon: "⛑️",
    title: "Kemanusiaan",
    desc: "Tanggap darurat bencana dan bantuan kemanusiaan.",
  },
  {
    icon: "🌍",
    title: "Sosial",
    desc: "Santunan yatim, dhuafa, lansia, dan komunitas marginal.",
  },
];

const articles = [
  {
    image:
      "https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=600&q=80",
    category: "Cerita Donatur",
    date: "10 Mei 2026",
    title: "Kisah Ibu Aminah: Dari Penerima Manfaat Menjadi Donatur",
    excerpt:
      "Perjalanan inspiratif seorang ibu yang dulunya menerima bantuan, kini aktif berbagi untuk sesama.",
  },
  {
    image:
      "https://images.unsplash.com/photo-1559027615-cd4628902d4a?w=600&q=80",
    category: "Laporan Program",
    date: "5 Mei 2026",
    title: "Distribusi Paket Ramadhan ke 12.000 Keluarga di 24 Provinsi",
    excerpt:
      "Laporan transparan kegiatan distribusi paket Ramadhan tahun ini yang menjangkau pelosok nusantara.",
  },
  {
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&q=80",
    category: "Edukasi",
    date: "28 April 2026",
    title: "5 Keutamaan Sedekah di Bulan-bulan Mulia",
    excerpt:
      "Kajian singkat tentang fadhilah sedekah berdasarkan dalil Al-Qur'an dan hadits shahih.",
  },
];

const partners = [
  "Kemenag RI",
  "BAZNAS",
  "Forum Zakat",
  "Dompet Dhuafa",
  "ACT",
  "Rumah Zakat",
];

// Helper format rupiah
const rupiah = (n: number) =>
  new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(n);
---

<MainLayout title="Beranda — Platform Donasi Online" description="">
  {
    /* ============================================
      HERO SECTION
      ============================================ */
  }
  <section class="relative overflow-hidden bg-primary-700">
    <div class="absolute inset-0">
      <img
        src={heroSlides[0].image}
        alt="Hero"
        class="h-full w-full object-cover opacity-30"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-primary-700 via-primary-700/80 to-primary-700/40"
      >
      </div>
    </div>

    <div
      class="relative mx-auto flex min-h-[560px] max-w-7xl flex-col justify-center px-6 py-20 lg:px-12"
    >
      <span
        class="mb-4 inline-block w-fit rounded-full bg-secondary-500/90 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-white"
      >
        {heroSlides[0].subtitle}
      </span>
      <h1
        class="max-w-3xl text-4xl font-bold leading-tight text-white md:text-5xl lg:text-6xl"
      >
        {heroSlides[0].title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-primary-50/90">
        {heroSlides[0].description}
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/donasi"
          class="rounded-full bg-secondary-500 px-8 py-4 font-semibold text-white shadow-lg shadow-secondary-700/30 transition hover:bg-secondary-600"
        >
          Donasi Sekarang
        </a>
        <a
          href="/program"
          class="rounded-full border-2 border-white/70 bg-white/10 px-8 py-4 font-semibold text-white backdrop-blur transition hover:bg-white/20"
        >
          Lihat Program
        </a>
      </div>

      {/* Hero stat strip */}
      <div
        class="mt-16 grid max-w-3xl grid-cols-2 gap-6 border-t border-white/20 pt-8 md:grid-cols-4"
      >
        {
          stats.map((s) => (
            <div>
              <div class="text-2xl font-bold text-white md:text-3xl">
                {s.value}
              </div>
              <div class="text-sm text-primary-50/80">{s.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================
      QUICK DONATION (Zakat/Infaq/Sedekah/Wakaf)
      ============================================ */
  }
  <section class="relative -mt-12 px-6 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div
        class="grid grid-cols-2 gap-4 rounded-2xl bg-white p-6 shadow-xl shadow-primary-700/10 ring-1 ring-primary-50 md:grid-cols-4 md:p-8"
      >
        {
          quickDonations.map((item) => (
            <a
              href={item.href}
              class="group rounded-xl p-4 transition hover:bg-primary-50"
            >
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-2xl transition group-hover:bg-primary-200">
                {item.icon}
              </div>
              <h3 class="text-lg font-bold text-primary-700">{item.title}</h3>
              <p class="mt-1 text-sm leading-snug text-primary-700/60">
                {item.description}
              </p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-secondary-600 group-hover:text-secondary-700">
                Salurkan
                <svg
                  class="h-4 w-4 transition group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================
      ABOUT SECTION
      ============================================ */
  }
  <section class="bg-primary-50/40 px-6 py-24 lg:px-12">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
      <div class="relative">
        <img
          src="https://images.unsplash.com/photo-1593113598332-cd288d649433?w=800&q=80"
          alt="Tentang Kami"
          class="rounded-3xl shadow-2xl shadow-primary-700/20"
        />
        <div
          class="absolute -bottom-6 -right-6 hidden rounded-2xl bg-secondary-500 p-6 text-white shadow-xl md:block"
        >
          <div class="text-4xl font-bold">15+</div>
          <div class="text-sm uppercase tracking-wider">Tahun Berkhidmat</div>
        </div>
      </div>

      <div>
        <span
          class="text-sm font-semibold uppercase tracking-widest text-secondary-600"
        >
          Tentang Kami
        </span>
        <h2 class="mt-3 text-3xl font-bold text-primary-700 md:text-4xl">
          Lembaga Filantropi Islam Terpercaya & Transparan
        </h2>
        <p class="mt-5 leading-relaxed text-primary-700/70">
          Kami adalah lembaga amil zakat nasional yang fokus pada pengelolaan
          dana umat secara profesional, transparan, dan tepat sasaran. Sejak
          berdiri, kami telah membantu ratusan ribu mustahik di seluruh
          Indonesia.
        </p>

        <ul class="mt-6 space-y-3">
          {
            [
              "Resmi terdaftar di Kementerian Agama RI",
              "Laporan keuangan diaudit akuntan publik",
              "Tersebar di 34 provinsi di Indonesia",
              "Pendampingan program berkelanjutan",
            ].map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary-500 text-white">
                  <svg
                    class="h-3 w-3"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </span>
                <span class="text-primary-700/80">{item}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/tentang-kami"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary-600 px-6 py-3 font-semibold text-white transition hover:bg-primary-700"
        >
          Selengkapnya Tentang Kami
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {
    /* ============================================
      FEATURED CAMPAIGNS
      ============================================ */
  }
  <section class="px-6 py-24 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <span
            class="text-sm font-semibold uppercase tracking-widest text-secondary-600"
          >
            Galang Dana
          </span>
          <h2 class="mt-3 text-3xl font-bold text-primary-700 md:text-4xl">
            Program Donasi Pilihan Untukmu
          </h2>
          <p class="mt-3 text-primary-700/60">
            Pilih program yang sesuai dengan kepedulianmu. Setiap rupiahmu
            insyaAllah membawa perubahan nyata.
          </p>
        </div>
        <a
          href="/campaign"
          class="rounded-full border-2 border-primary-600 px-6 py-3 font-semibold text-primary-600 transition hover:bg-primary-600 hover:text-white"
        >
          Lihat Semua Program
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          campaigns.map((c) => {
            const percent = Math.min(
              100,
              Math.round((c.collected / c.target) * 100),
            );
            return (
              <article class="group overflow-hidden rounded-2xl bg-white shadow-lg shadow-primary-700/5 ring-1 ring-primary-50 transition hover:shadow-2xl hover:shadow-primary-700/10">
                <div class="relative overflow-hidden">
                  <img
                    src={c.image}
                    alt={c.title}
                    class="h-56 w-full object-cover transition duration-500 group-hover:scale-110"
                  />
                  <span class="absolute left-4 top-4 rounded-full bg-secondary-500 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white">
                    {c.category}
                  </span>
                </div>

                <div class="p-6">
                  <h3 class="line-clamp-2 min-h-[3.5rem] text-lg font-bold leading-snug text-primary-700 transition group-hover:text-primary-600">
                    {c.title}
                  </h3>

                  {/* Progress bar */}
                  <div class="mt-5">
                    <div class="h-2 w-full overflow-hidden rounded-full bg-primary-100">
                      <div
                        class="h-full rounded-full bg-gradient-to-r from-secondary-500 to-secondary-600"
                        style={`width: ${percent}%`}
                      />
                    </div>
                    <div class="mt-3 flex items-baseline justify-between">
                      <div>
                        <div class="text-xs text-primary-700/60">Terkumpul</div>
                        <div class="font-bold text-primary-700">
                          {rupiah(c.collected)}
                        </div>
                      </div>
                      <div class="text-right">
                        <div class="text-xs text-primary-700/60">
                          dari {rupiah(c.target)}
                        </div>
                        <div class="font-bold text-secondary-600">
                          {percent}%
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="mt-5 flex items-center justify-between border-t border-primary-50 pt-4 text-sm text-primary-700/70">
                    <span class="flex items-center gap-1.5">
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87M16 3.13a4 4 0 010 7.75M12 7a4 4 0 100 8 4 4 0 000-8z"
                        />
                      </svg>
                      {c.donors} donatur
                    </span>
                    <span class="flex items-center gap-1.5">
                      <svg
                        class="h-4 w-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      {c.days} hari lagi
                    </span>
                  </div>

                  <a
                    href="#"
                    class="mt-5 block rounded-full bg-primary-600 py-3 text-center font-semibold text-white transition hover:bg-primary-700"
                  >
                    Donasi Sekarang
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  {
    /* ============================================
      PROGRAMS GRID
      ============================================ */
  }
  <section
    class="relative overflow-hidden bg-primary-700 px-6 py-24 text-white lg:px-12"
  >
    <div
      class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-secondary-500/20 blur-3xl"
    >
    </div>
    <div
      class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-primary-500/30 blur-3xl"
    >
    </div>

    <div class="relative mx-auto max-w-7xl">
      <div class="text-center">
        <span
          class="text-sm font-semibold uppercase tracking-widest text-secondary-500"
        >
          Pilar Program
        </span>
        <h2 class="mt-3 text-3xl font-bold md:text-4xl">
          Enam Pilar Kebermanfaatan
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-primary-50/80">
          Setiap donasi kami salurkan melalui enam pilar program yang saling
          melengkapi untuk membangun umat yang berdaya.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          programs.map((p) => (
            <div class="group rounded-2xl bg-white/5 p-7 ring-1 ring-white/10 backdrop-blur transition hover:bg-white/10 hover:ring-secondary-500/50">
              <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-secondary-500 text-3xl shadow-lg shadow-secondary-700/30">
                {p.icon}
              </div>
              <h3 class="text-xl font-bold">{p.title}</h3>
              <p class="mt-2 text-primary-50/70">{p.desc}</p>
              <a
                href="#"
                class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-secondary-500 transition group-hover:gap-2"
              >
                Pelajari lebih lanjut
                <svg
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"
                  />
                </svg>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================
      CTA BANNER
      ============================================ */
  }
  <section class="px-6 py-24 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div
        class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-secondary-500 to-secondary-700 px-8 py-16 text-center text-white md:px-16 md:py-20"
      >
        <div
          class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10"
        >
        </div>
        <div
          class="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-white/10"
        >
        </div>

        <div class="relative">
          <h2
            class="mx-auto max-w-2xl text-3xl font-bold leading-tight md:text-4xl"
          >
            "Perumpamaan orang yang menafkahkan hartanya di jalan Allah seperti
            sebutir biji yang menumbuhkan tujuh tangkai..."
          </h2>
          <p class="mt-4 text-white/80">— QS. Al-Baqarah: 261</p>
          <a
            href="/donasi"
            class="mt-10 inline-block rounded-full bg-white px-10 py-4 font-semibold text-secondary-600 shadow-xl transition hover:bg-primary-50"
          >
            Tunaikan Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  {
    /* ============================================
      LATEST ARTICLES / NEWS
      ============================================ */
  }
  <section class="bg-primary-50/40 px-6 py-24 lg:px-12">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <span
            class="text-sm font-semibold uppercase tracking-widest text-secondary-600"
          >
            Kabar Terbaru
          </span>
          <h2 class="mt-3 text-3xl font-bold text-primary-700 md:text-4xl">
            Artikel & Laporan Program
          </h2>
        </div>
        <a
          href="/artikel"
          class="font-semibold text-primary-600 hover:text-primary-700"
        >
          Semua artikel →
        </a>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          articles.map((a) => (
            <article class="group overflow-hidden rounded-2xl bg-white shadow-md shadow-primary-700/5 transition hover:shadow-xl hover:shadow-primary-700/10">
              <div class="overflow-hidden">
                <img
                  src={a.image}
                  alt={a.title}
                  class="h-52 w-full object-cover transition duration-500 group-hover:scale-110"
                />
              </div>
              <div class="p-6">
                <div class="flex items-center gap-3 text-xs">
                  <span class="rounded-full bg-primary-100 px-3 py-1 font-semibold text-primary-700">
                    {a.category}
                  </span>
                  <span class="text-primary-700/50">{a.date}</span>
                </div>
                <h3 class="mt-4 line-clamp-2 text-lg font-bold leading-snug text-primary-700 transition group-hover:text-primary-600">
                  {a.title}
                </h3>
                <p class="mt-2 line-clamp-2 text-sm text-primary-700/60">
                  {a.excerpt}
                </p>
                <a
                  href="#"
                  class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-secondary-600 hover:text-secondary-700"
                >
                  Baca selengkapnya →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================
      PARTNERS
      ============================================ */
  }
  <section class="px-6 py-20 lg:px-12">
    <div class="mx-auto max-w-7xl text-center">
      <span
        class="text-sm font-semibold uppercase tracking-widest text-secondary-600"
      >
        Mitra Kami
      </span>
      <h2 class="mt-3 text-2xl font-bold text-primary-700 md:text-3xl">
        Dipercaya Oleh Lembaga Terkemuka
      </h2>

      <div
        class="mt-10 grid grid-cols-2 items-center gap-8 md:grid-cols-3 lg:grid-cols-6"
      >
        {
          partners.map((p) => (
            <div class="flex h-20 items-center justify-center rounded-xl bg-primary-50/60 px-4 font-bold text-primary-700/60 ring-1 ring-primary-100 transition hover:bg-primary-50 hover:text-primary-700">
              {p}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================
      NEWSLETTER
      ============================================ */
  }
  <section class="px-6 pb-24 lg:px-12">
    <div class="mx-auto max-w-5xl">
      <div
        class="rounded-3xl bg-primary-700 px-8 py-12 text-center md:px-16 md:py-16"
      >
