---
import Header from "@/components/sections/landing-page/Header.astro";
import Hero from "@/components/sections/landing-page/Hero.astro";
import SiapaKami from "@/components/sections/landing-page/SiapaKami.astro";
import ProgramKami from "@/components/sections/landing-page/ProgramKami.astro";
import ReasonToServe from "@/components/sections/landing-page/ReasonToServe.astro";
import FocusArea from "@/components/sections/landing-page/FocusArea.astro";
import KnowledgeHub from "@/components/sections/landing-page/KnowledgeHub.astro";
import Footer from "@/components/sections/landing-page/Footer.astro";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout
  title="Beramalbersama — Platform Donasi Online Terpercaya"
  description="Beramalbersama adalah platform donasi online terpercaya yang menghubungkan dermawan dengan penerima manfaat secara transparan, amanah, dan terverifikasi. Bersama kita wujudkan perubahan nyata."
>
  <Header />
  <main>
    <Hero />
    <SiapaKami />
    <ProgramKami />
    <!-- <ReasonToServe />
    <FocusArea /> -->
    <KnowledgeHub />
  </main>
  <Footer />
</MainLayout>

<script>
  // Global scroll reveal observer — runs once across all sections
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );

  document.querySelectorAll("[data-reveal]").forEach((el, i) => {
    if (!(el as HTMLElement).style.transitionDelay) {
      (el as HTMLElement).style.transitionDelay = `${i * 0.01}s`;
    }
    observer.observe(el);
  });

  // Expose globally so component scripts can reuse
  (window as any).__revealObserver = observer;
</script>
