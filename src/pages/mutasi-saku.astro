---
// src/pages/saku-berbagi/mutasi.astro
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import { formatRupiah, timeAgoFormat } from "@/lib/formatter";
import { getServerToken } from "@/lib/auth";
import { getMyWallet } from "@/lib/FetchData";
import ShowJsonData from "@/components/ui/ShowJsonData.astro";

export const prerender = false;

interface WalletHistory {
  id: string;
  type: "debit" | "top_up" | string;
  amount: string | number;
  created_at: string;
}

interface Wallet {
  saldo: string | number;
  history: WalletHistory[];
}

const token = getServerToken(Astro.cookies);
if (!token) return Astro.redirect("/login");

const API_URL = import.meta.env.PUBLIC_API_URL;

const wallet = await getMyWallet(token);
const saldo = Number(wallet?.saldo ?? 0);
const history = wallet?.history ?? [];

const getLabel = (type: string) => (type === "top_up" ? "Isi Saldo" : "Donasi");
---

<MainLayout
  title="Aktivitas Saku Berbagi"
  description="Riwayat aktivitas saldo Saku Berbagi"
>
  <Header type="title" text="Aktivitas Saku Berbagi" />

  <main class="">
    <div
      class="container min-h-screen bg-neutral-50 px-2.5 py-4 space-y-4 pt-16 pb-8"
    >
      <!-- Saldo Card -->
      <div
        class="bg-gradient-to-br from-primary-500 to-primary-400 rounded-lg shadow-sm p-5 text-white"
      >
        <p
          class="text-xs text-primary-100 font-medium uppercase tracking-widest mb-1"
        >
          Total Saldo Sekarang
        </p>
        <p class="font-bold tracking-tight">{formatRupiah(saldo)}</p>
      </div>

      <!-- History -->
      {
        history.length === 0 ? (
          <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-8 flex flex-col items-center text-center">
            <div class="w-14 h-14 rounded-full bg-primary-50 text-primary-500 flex items-center justify-center mb-3">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-7 h-7"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3"
                />
              </svg>
            </div>
            <p class="font-semibold text-sm text-gray-900 mb-1">
              Belum ada aktivitas
            </p>
            <p class="text-xs text-gray-500 mb-5 max-w-xs">
              Top up sekarang untuk mengisi Saku Berbagimu
            </p>

            <a
              href="/wallet"
              class="bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white text-sm font-semibold px-6 py-2.5 rounded-xl transition-all duration-150"
            >
              Top Up
            </a>
          </div>
        ) : (
          <div>
            <p class="text-xs font-semibold text-gray-500 mb-3">
              RIWAYAT TRANSAKSI
            </p>
            <div class="bg-white rounded-lg border border-gray-100 shadow-sm overflow-hidden">
              <ul class="divide-y divide-gray-100">
                {history.map((item: any) => {
                  const isTopUp = item.type === "top_up";
                  const amountNum = Number(item.amount) || 0;
                  return (
                    <li class="flex items-center gap-3 px-4 py-3">
                      <div
                        class:list={[
                          "w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0",
                          isTopUp
                            ? "bg-primary-50 text-primary-500"
                            : "bg-orange-50 text-orange-500",
                        ]}
                      >
                        {isTopUp ? (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M21 12a2.25 2.25 0 0 0-2.25-2.25H15a3 3 0 1 1-6 0H5.25A2.25 2.25 0 0 0 3 12m18 0v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 9m18 0V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v3"
                            />
                          </svg>
                        ) : (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-5 h-5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
                            />
                          </svg>
                        )}
                      </div>
                      <div class="flex-1 min-w-0">
                        <p class="text-sm font-semibold text-gray-900">
                          {getLabel(item.type)}
                        </p>
                        <p class="text-[11px] text-gray-500">
                          {timeAgoFormat(item.created_at)}
                        </p>
                      </div>
                      <p
                        class:list={[
                          "text-sm font-semibold flex-shrink-0",
                          isTopUp ? "text-primary-500" : "text-orange-500",
                        ]}
                      >
                        {isTopUp ? "+" : "−"} {formatRupiah(amountNum)}
                      </p>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        )
      }
    </div>
  </main>
</MainLayout>
