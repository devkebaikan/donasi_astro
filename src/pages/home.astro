---
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import Footer from "@/components/layouts/Footer.astro";
import BottomNav from "@/components/layouts/BottomNav.astro";
import HeroSection from "@/components/sections/home/HeroSection.astro";
import MenuSection from "@/components/sections/home/MenuSection.astro";
import ProgramSection from "@/components/sections/home/ProgramSection.astro";
import ProgramListSection from "@/components/sections/home/ProgramListSection.astro";
import ProjectListSection from "@/components/sections/home/ProjectListSection.astro";
import SliderBanner from "@/components/sections/home/SliderBanner.astro";
import { storageImg, bannerHref } from "@/lib/home";
import { getHomeData } from "@/lib/FetchData";
import DonorNotifSection from "@/components/sections/home/DonorNotifSection.astro";

// import FloatingInstallPrompt from "@/components/ui/FloatingInstallPrompt.astro";

const homeData = await getHomeData();

const mainBanner = homeData?.main_banner;

const mainBannerSrc = homeData?.second_banner?.image_url
  ? storageImg(homeData.second_banner.image_url, "home-banner")
  : null;
const mainBannerHref = homeData?.second_banner
  ? bannerHref(homeData.second_banner.link)
  : "#";

const secondBannerSrc = homeData?.third_banner?.image_url
  ? storageImg(homeData.third_banner.image_url, "home-banner")
  : null;
const secondBannerHref = homeData?.third_banner
  ? bannerHref(homeData.third_banner.link)
  : "#";
---

<MainLayout
  title="Beranda"
  description="Beramalbersama.com — platform donasi online terpercaya. Salurkan infaq, sedekah, zakat, dan qurban ke seluruh penjuru Indonesia dengan mudah dan transparan."
  type="website"
>
  <Header />
  <main class="container pb-16">
    <HeroSection
      mainBanner={mainBanner}
      bannerSlides={homeData?.banner_slides ?? []}
    />
    <MenuSection />

    {
      mainBannerSrc && (
        <a href={mainBannerHref}>
          <img
            src={mainBannerSrc}
            alt={homeData?.main_banner?.name ?? "Banner Beramalbersama"}
            width="480"
            height="160"
            class="w-full h-auto mb-3"
            loading="lazy"
            decoding="async"
          />
        </a>
      )
    }

    <!-- <ShowJsonData data={homeData} /> -->
    <ProgramSection programs={homeData?.program_list ?? []} />

    {
      secondBannerSrc && (
        <a href={secondBannerHref}>
          <img
            src={secondBannerSrc}
            alt={homeData?.second_banner?.name ?? "Banner Beramalbersama"}
            width="480"
            height="160"
            class="w-full h-auto mb-3"
            loading="lazy"
            decoding="async"
          />
        </a>
      )
    }

    <ProjectListSection projectList={homeData?.project_list ?? []} />

    <SliderBanner bannerSlides={homeData?.banner_slides ?? []} />

    <ProgramListSection
      programs={homeData?.program_list ?? []}
      categories={homeData?.program_category ?? []}
    />

    <DonorNotifSection />

    <Footer />
  </main>

  <!-- Floating PWA Install Prompt (5 detik) -->
  <!-- <FloatingInstallPrompt /> -->

  <BottomNav active="home" />
</MainLayout>
