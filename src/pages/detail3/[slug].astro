---
export const prerender = false;

import Banner from "@/components/sections/donasi/Banner.astro";
import ProfileMitra from "@/components/sections/donasi/ProfileMitra.astro";
import TabSection from "@/components/sections/donasi/TabSection.astro";
import StickyDonateBar from "@/components/sections/donasi/StickyDonateBar.astro";
import {
  getCampaignByLink,
  getDonorsByLink,
} from "@/lib/FetchData";
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import BoxGuaratee from "@/components/sections/donasi/BoxGuaratee.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/");
}

const projectId = Astro.url.searchParams.get("project");

const [dataDetailCampaign, dataDonors] = await Promise.all([
  getCampaignByLink(slug),
  getDonorsByLink(slug),
]);

const detailCampaign = dataDetailCampaign?.data ?? {};
const donors = dataDonors?.data ?? [];

if (!detailCampaign || Object.keys(detailCampaign).length === 0) {
  return Astro.redirect("/404");
}

const type = detailCampaign?.tipe?.name ?? "DONASI";
const isRutin = detailCampaign?.is_rutin === true;
const isActive = detailCampaign?.status === "PUBLISH";

// SEO
const campaignTitle = detailCampaign?.title ?? "Detail Donasi";
const campaignImage = detailCampaign?.image ?? null;

const campaignJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Beranda",
          item: Astro.url.origin + "/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Donasi",
          item: Astro.url.origin + "/donasi",
        },
        {
          "@type": "ListItem",
          position: 3,
          name: campaignTitle,
          item: Astro.url.href,
        },
      ],
    },
    {
      "@type": "DonateAction",
      name: `Donasi — ${campaignTitle}`,
      url: Astro.url.href,
      recipient: {
        "@type": "Organization",
        name: detailCampaign?.mitra?.name ?? "Beramalbersama.com",
      },
    },
  ],
});
---

<MainLayout
  title={campaignTitle}
  description={detailCampaign?.short_description ??
    "Detail kampanye donasi di Beramalbersama.com"}
  image={campaignImage ?? undefined}
  imageAlt={campaignTitle}
  type="article"
  publishedTime={detailCampaign?.created_at}
  modifiedTime={detailCampaign?.updated_at}
  robots={isActive ? "index, follow" : "noindex, follow"}
>
  <Header
    type="title"
    text={detailCampaign ? detailCampaign.title : "Detail Donasi"}
    link="/home"
  />

  <script is:inline type="application/ld+json" set:html={campaignJsonLd} />

  <div
    id="detail3-page"
    data-slug={slug}
    data-program-id={detailCampaign?.id}
    data-project-id={projectId ?? ""}
    class="bg-white min-h-screen container"
  >
    <div class="mx-auto mb-24 max-w-120">
      <Banner
        link={slug}
        detailCampaign={detailCampaign}
        donors={donors}
        projectId={projectId ? Number(projectId) : null}
      />

      <BoxGuaratee />

      <ProfileMitra
        programLink={detailCampaign?.link}
        programId={detailCampaign?.id}
        projekSalur={detailCampaign?.last_two_projects}
      />
      <TabSection slug={slug} detailCampaign={detailCampaign} />
    </div>

    <!-- Sticky Bottom Bar: Klik Donasi Sekarang mengarahkan ke halaman pilihan nominal -->
    <StickyDonateBar
      isRutin={isRutin}
      link={slug}
      isActive={isActive}
      type={type}
      idButton="btn-donasi-detail3"
    />
  </div>
</MainLayout>

<script>
  const page = document.getElementById("detail3-page");
  if (page) {
    const slug = page.getAttribute("data-slug");
    const programId = page.getAttribute("data-program-id");
    const projectId = page.getAttribute("data-project-id");

    const btnDonasi = document.getElementById("btn-donasi-detail3");
    btnDonasi?.addEventListener("click", () => {
      const active = btnDonasi.getAttribute("data-active") === "true";
      if (!active) return;

      const params = new URLSearchParams();
      if (programId) params.set("id", programId);
      if (projectId) params.set("project", projectId);
      params.set("from", "detail3");

      window.location.assign(`/donasi/nominal/${slug}?${params.toString()}`);
    });
  }
</script>

