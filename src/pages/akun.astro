---
export const prerender = false;

import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const { isAuthenticated } = Astro.locals.auth;
const API_URL = import.meta.env.PUBLIC_API_URL;

const personalMenus = [
  { href: "/profil",       label: "Ubah Data Akun",         icon: "user",        color: "primary"    },
  { href: "/donasi-saya",  label: "Donasi Saya",            icon: "archive",     color: "emerald" },
  { href: "/donasi-rutin", label: "Rutin Saya",             icon: "calendar",    color: "violet"  },
  { href: "/mutasi-saku",  label: "Aktivitas Saku Berbagi", icon: "transaction", color: "amber"   },
];

const generalMenus = [
  { href: "/tentang-salur", label: "Tentang Kami",       icon: "info", color: "blue",  external: false  },
  { href: "/syarat-ketentuan",                  label: "Syarat & Ketentuan", icon: "file", color: "slate", external: false },
];

const iconPaths: Record<string, string> = {
  user:        "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  archive:     "M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4",
  calendar:    "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  transaction: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
  info:        "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  file:        "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
};
---

<MainLayout title="Akun Saya" description="Kelola profil dan aktivitas akun kamu.">
  <Header type="title" text="Akun" />

  <div
    id="akun-page"
    data-api-url={API_URL}
    class="container bg-neutral-50 min-h-screen pb-28"
  >

    <!-- ── Belum login ──────────────────────────────────────────────────────── -->
    {!isAuthenticated && (
      <div class="px-4 pt-5 space-y-3">
        <div class="bg-white rounded-2xl shadow-sm p-8 flex flex-col items-center text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center mb-5 shadow-lg shadow-primary-200">
            <svg class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="text-base font-bold text-gray-900 mb-1.5">Masuk ke Akunmu</h3>
          <p class="text-sm text-gray-400 leading-relaxed mb-7 max-w-[220px]">
            Kelola donasi, pantau program, dan akses Saku Berbagi kamu
          </p>
          <a
            href="/auth/login"
            class="w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white text-sm font-semibold py-3.5 rounded-xl transition-all shadow-sm shadow-primary-200 text-center block"
          >
            Masuk Sekarang
          </a>
          <p class="text-xs text-gray-400 mt-4">
            Belum punya akun?&nbsp;
            <a href="/auth/register" class="text-primary-500 font-semibold">Daftar disini</a>
          </p>
        </div>

        <!-- General menu untuk guest -->
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-50">
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-widest">Umum</span>
          </div>
          <div class="divide-y divide-gray-50">
            {generalMenus.map((menu) => (
              <a
                href={menu.href}
                target={menu.external ? "_blank" : undefined}
                rel={menu.external ? "noopener noreferrer" : undefined}
                class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors group"
              >
                <div class={`w-9 h-9 rounded-xl flex items-center justify-center bg-${menu.color}-50 shrink-0`}>
                  <svg class={`w-4 h-4 text-${menu.color}-500`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                  </svg>
                </div>
                <span class="flex-1 text-sm font-medium text-gray-700">{menu.label}</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- ── Sudah login ──────────────────────────────────────────────────────── -->
    {isAuthenticated && (
      <>
        <!-- Profile Header dengan gradient -->
        <div class="relative bg-gradient-to-br from-primary-600 via-primary-500 to-emerald-500 px-4 pt-20 pb-16 overflow-hidden">
          <!-- Decorative circles -->
          <div class="absolute -top-6 -right-6 w-32 h-32 bg-white/5 rounded-full pointer-events-none"></div>
          <div class="absolute top-12 -right-2 w-16 h-16 bg-white/5 rounded-full pointer-events-none"></div>

          <!-- Edit button -->
          <a
            href="/profil"
            class="absolute top-20 right-4 w-8 h-8 bg-white/15 hover:bg-white/25 active:bg-white/30 rounded-full flex items-center justify-center transition-colors z-10"
            title="Edit Profil"
          >
            <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </a>

          <div class="flex items-center gap-3.5">
            <!-- Avatar: img (hidden until data loaded) -->
            <div
              id="user-avatar-img-wrap"
              class="hidden w-[54px] h-[54px] rounded-full overflow-hidden border-2 border-white/40 shrink-0 shadow-md"
            >
              <img id="user-avatar-img" src="" alt="" class="w-full h-full object-cover" />
            </div>

            <!-- Avatar: initials (default, replaced when data loaded) -->
            <div
              id="user-avatar-initials"
              class="w-[54px] h-[54px] rounded-full bg-white/20 border-2 border-white/30 flex items-center justify-center text-base font-bold text-white shrink-0 shadow-md"
            >
              <span id="user-initials-text">
                <!-- skeleton -->
                <span class="block w-6 h-3 bg-white/30 rounded animate-pulse"></span>
              </span>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <p id="user-name" class="text-[15px] font-bold text-white truncate leading-snug">
                <span class="inline-block w-28 h-4 bg-white/20 rounded animate-pulse align-middle"></span>
              </p>
              <p id="user-phone" class="hidden text-xs text-white/80 truncate mt-1"></p>
              <p id="user-email" class="hidden text-xs text-white/80 truncate mt-0.5"></p>
            </div>
          </div>
        </div>

        <!-- Cards area (wallet card overlaps the gradient header) -->
        <div class="-mt-9 px-4 space-y-3 relative">

          <!-- Wallet Card -->
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden z-50">
            <div class="flex items-center gap-3 px-4 py-4">
              <div class="w-10 h-10 bg-secondary-50 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-secondary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-[11px] text-gray-400 leading-none mb-1">Saku Berbagi</p>
                <p id="wallet-saldo" class="text-sm font-bold text-gray-900 leading-none">
                  <span class="inline-block w-24 h-[18px] bg-gray-100 rounded animate-pulse align-middle"></span>
                </p>
              </div>
              <div class="flex gap-2 shrink-0">
                <a
                  href="/mutasi-saku"
                  class="text-xs text-gray-500 bg-gray-100 hover:bg-gray-200 font-semibold px-3 py-2 rounded-lg transition-colors whitespace-nowrap"
                >
                  Riwayat
                </a>
                <a
                  href="/top-up"
                  class="text-xs text-primary-700 bg-primary-50 hover:bg-primary-100 font-semibold px-3 py-2 rounded-lg transition-colors whitespace-nowrap"
                >
                  Top Up
                </a>
              </div>
            </div>
          </div>

          <!-- Personal Menu -->
          <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-50">
              <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-widest">Menu Pribadi</span>
            </div>
            <div class="divide-y divide-gray-50">
              {personalMenus.map((menu) => (
                <a
                  href={menu.href}
                  class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors group"
                >
                  <div class={`w-9 h-9 rounded-xl flex items-center justify-center bg-${menu.color}-50 shrink-0`}>
                    <svg class={`w-4 h-4 text-${menu.color}-600`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                    </svg>
                  </div>
                  <span class="flex-1 text-sm font-medium text-gray-700 group-hover:text-gray-900 transition-colors">{menu.label}</span>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>

          <!-- General Menu -->
          <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-50">
              <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-widest">Umum</span>
            </div>
            <div class="divide-y divide-gray-50">
              {generalMenus.map((menu) => (
                <a
                  href={menu.href}
                  target={menu.external ? "_blank" : undefined}
                  rel={menu.external ? "noopener noreferrer" : undefined}
                  class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors group"
                >
                  <div class={`w-9 h-9 rounded-xl flex items-center justify-center bg-${menu.color}-50 shrink-0`}>
                    <svg class={`w-4 h-4 text-${menu.color}-500`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                    </svg>
                  </div>
                  <span class="flex-1 text-sm font-medium text-gray-700 group-hover:text-gray-900 transition-colors">{menu.label}</span>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>

          <!-- Logout Button -->
          <button
            id="btn-logout"
            type="button"
            class="w-full flex items-center gap-3 px-4 py-3.5 bg-white rounded-2xl shadow-sm hover:bg-red-50 active:bg-red-100 transition-colors group"
          >
            <div class="w-9 h-9 bg-red-50 rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
            </div>
            <span class="flex-1 text-left text-sm font-medium text-red-500 group-hover:text-red-600 transition-colors">Keluar dari Akun</span>
            <svg class="w-4 h-4 text-red-300 group-hover:text-red-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

        </div>
      </>
    )}
  </div>

  <!-- ── Logout Confirmation Modal ───────────────────────────────────────── -->
  <div id="logout-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4">
    <div id="logout-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-[380px] overflow-hidden">
      <div class="flex flex-col items-center px-6 pt-8 pb-2 text-center">
        <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center mb-4">
          <svg class="w-7 h-7 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-900">Keluar Akun?</h3>
        <p class="text-sm text-gray-400 mt-1.5 mb-1">Kamu perlu masuk kembali untuk mengakses fitur akun.</p>
      </div>
      <div class="flex gap-2.5 px-6 py-5">
        <button
          id="btn-logout-cancel"
          type="button"
          class="flex-1 border border-gray-200 text-gray-600 text-sm font-semibold py-3 rounded-xl hover:bg-gray-50 active:bg-gray-100 transition-colors"
        >
          Batal
        </button>
        <button
          id="btn-logout-confirm"
          type="button"
          class="flex-1 bg-red-500 hover:bg-red-600 active:scale-[0.98] text-white text-sm font-semibold py-3 rounded-xl transition-all"
        >
          Ya, Keluar
        </button>
      </div>
    </div>
  </div>

  <BottomNav active="akun" />
</MainLayout>

<script>
  import { getToken, isLoggedIn, bearerHeaders, removeToken } from "@/lib/auth";
  import { showToast } from "@/lib/toast";

  (() => {
    const page    = document.getElementById("akun-page") as HTMLElement;
    const API_URL = page?.dataset.apiUrl ?? "";

    // ── Logout modal ─────────────────────────────────────────────────────────
    const modal      = document.getElementById("logout-modal")!;
    const backdrop   = document.getElementById("logout-backdrop")!;
    const btnLogout  = document.getElementById("btn-logout") as HTMLButtonElement | null;
    const btnCancel  = document.getElementById("btn-logout-cancel") as HTMLButtonElement;
    const btnConfirm = document.getElementById("btn-logout-confirm") as HTMLButtonElement;

    function openModal()  { modal.classList.remove("hidden"); }
    function closeModal() { modal.classList.add("hidden"); }

    btnLogout?.addEventListener("click", openModal);
    btnCancel?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    btnConfirm?.addEventListener("click", async () => {
      btnConfirm.disabled = true;
      btnConfirm.textContent = "Keluar...";

      try {
        await fetch(`${API_URL}/logout`, {
          method: "POST",
          credentials: "include",
        }).catch(() => {});

        removeToken();
        localStorage.removeItem("user_profile");
        localStorage.removeItem("saldo");

        showToast("Berhasil keluar", "success");
        window.location.href = "/home";
      } catch {
        showToast("Gagal keluar, coba lagi", "error");
        btnConfirm.disabled = false;
        btnConfirm.textContent = "Ya, Keluar";
      }
    });

    // ── Hanya lanjut jika user terautentikasi di client ───────────────────────
    const token = getToken();
    if (!isLoggedIn() || !token) return;

    // ── Elemen DOM profil ────────────────────────────────────────────────────
    const avatarImgWrap   = document.getElementById("user-avatar-img-wrap");
    const avatarImg       = document.getElementById("user-avatar-img") as HTMLImageElement | null;
    const avatarInitials  = document.getElementById("user-avatar-initials");
    const initialsText    = document.getElementById("user-initials-text");
    const nameEl          = document.getElementById("user-name");
    const phoneEl         = document.getElementById("user-phone");
    const emailEl         = document.getElementById("user-email");
    const saldoEl         = document.getElementById("wallet-saldo");

    function getInitials(name: string): string {
      return name.trim().split(/\s+/).slice(0, 2).map(w => w[0]?.toUpperCase() ?? "").join("");
    }

    function renderProfile(p: { name?: string; phone?: string; email?: string; img?: string }) {
      // Name
      if (nameEl) nameEl.textContent = p.name || "Hamba Allah";

      // Avatar
      if (p.img && avatarImgWrap && avatarImg) {
        avatarImg.src = p.img;
        avatarImg.alt = p.name || "";
        avatarImgWrap.classList.remove("hidden");
        avatarInitials?.classList.add("hidden");
      } else if (initialsText) {
        initialsText.textContent = getInitials(p.name || "HA");
      }

      // Phone
      if (p.phone && phoneEl) {
        phoneEl.textContent = p.phone;
        phoneEl.classList.remove("hidden");
      }

      // Email
      if (p.email && emailEl) {
        emailEl.textContent = p.email;
        emailEl.classList.remove("hidden");
      }
    }

    function renderSaldo(saldo: number) {
      if (saldoEl) saldoEl.textContent = `Rp ${saldo.toLocaleString("id-ID")}`;
    }

    // ── Tampilkan cache dulu (near-instant) ──────────────────────────────────
    try {
      const cachedProfile = localStorage.getItem("user_profile");
      if (cachedProfile) renderProfile(JSON.parse(cachedProfile));

      const cachedSaldo = localStorage.getItem("saldo");
      if (cachedSaldo) renderSaldo(Number(cachedSaldo));
    } catch {
      // abaikan parse error
    }

    // ── Fetch data terbaru dari API ──────────────────────────────────────────
    async function fetchUserData() {
      try {
        const res = await fetch(`${API_URL}/dashboard/my-account`, {
          headers: bearerHeaders(token!),
        });

        if (res.status === 401) {
          removeToken();
          localStorage.removeItem("user_profile");
          localStorage.removeItem("saldo");
          window.location.href = "/auth/login?from=/akun";
          return;
        }

        if (!res.ok) return;

        const json = await res.json();
        const data = json?.data ?? {};

        // Update & cache profil
        const profile = { name: data.name, phone: data.phone, email: data.email, img: data.img };
        renderProfile(profile);
        localStorage.setItem("user_profile", JSON.stringify(profile));

        // Update & cache saldo
        const saldo = Number(data.dompet_kebaikan?.saldo ?? 0);
        renderSaldo(saldo);
        localStorage.setItem("saldo", String(saldo));

      } catch {
        // tetap tampilkan cache
      }
    }

    fetchUserData();
  })();
</script>
