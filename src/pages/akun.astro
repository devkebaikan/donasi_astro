---
export const prerender = false;

import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const { isAuthenticated } = Astro.locals.auth;

const personalMenus = [
  { href: "/me",            label: "Ubah Data Akun",         icon: "user"        },
  { href: "/donasi-saya",   label: "Donasi Saya",            icon: "archive"     },
  { href: "/donasi-rutin",  label: "Rutin Saya",             icon: "calendar"    },
  { href: "/mutasi-saku",   label: "Aktivitas Saku Kebaikan", icon: "transaction" },
];

const generalMenus = [
  { href: "/tentang-salur",     label: "Tentang Kami",       icon: "info", external: false },
  { href: "/syarat-ketentuan",  label: "Syarat & Ketentuan", icon: "file", external: false },
];

const iconPaths: Record<string, string> = {
  user:        "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  archive:     "M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4",
  calendar:    "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  transaction: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
  info:        "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  file:        "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
  logout:      "M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1",
};
---

<MainLayout title="Akun Saya" description="Kelola profil dan aktivitas akun kamu.">
  <Header type="notshare" text="Akun" />

  <div
    id="akun-page"
    class="container bg-neutral-50 min-h-screen pb-28"
  >
    <!-- ── Belum login ──────────────────────────────────────────────────────── -->
    {!isAuthenticated && (
      <div class="px-4 pt-6 space-y-3">
        <div class="bg-white rounded-2xl border border-gray-100 p-8 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full border border-primary-200 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-gray-900 mb-1.5 tracking-tight">Masuk ke Akunmu</h3>
          <p class="text-sm text-gray-400 leading-relaxed mb-7 max-w-[220px]">
            Kelola donasi, pantau program, dan akses Saku Kebaikan kamu
          </p>
          <a
            href={`/auth/login?from=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
            class="w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-semibold py-4 rounded-full transition-all duration-150 mt-2"
          >
            Masuk Sekarang
          </a>
          <p class="text-xs text-gray-400 mt-4">
            Belum punya akun?&nbsp;
            <a href="/auth/register" class="text-primary-600 font-semibold">Daftar disini</a>
          </p>
        </div>

        <!-- General menu untuk guest -->
        <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-50">
            <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.15em]">Umum</span>
          </div>
          <div class="divide-y divide-gray-50">
            {generalMenus.map((menu) => (
              <a
                href={menu.href}
                target={menu.external ? "_blank" : undefined}
                rel={menu.external ? "noopener noreferrer" : undefined}
                class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors group"
              >
                <svg class="w-[18px] h-[18px] text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                </svg>
                <span class="flex-1 text-sm text-gray-700">{menu.label}</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}

    <!-- ── Sudah login ──────────────────────────────────────────────────────── -->
    {isAuthenticated && (
      <>
        <!-- Identity strip -->
        <div class="relative bg-primary-500 px-4 pt-16 pb-9">
          <a
            href="/me"
            class="absolute top-16 right-4 w-8 h-8 flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/10 transition-colors"
            title="Edit Profil"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </a>

          <div class="flex items-center gap-3.5">
            <!-- Avatar: img (hidden until data loaded) -->
            <div
              id="user-avatar-img-wrap"
              class="hidden w-12 h-12 rounded-full overflow-hidden ring-2 ring-white/25 shrink-0"
            >
              <img id="user-avatar-img" src="" alt="" class="w-full h-full object-cover" />
            </div>

            <!-- Avatar: initials (default, replaced when data loaded) -->
            <div
              id="user-avatar-initials"
              class="w-12 h-12 rounded-full bg-white/10 ring-2 ring-white/25 flex items-center justify-center text-sm font-semibold text-white shrink-0"
            >
              <span id="user-initials-text">
                <span class="block w-5 h-2.5 bg-white/25 rounded animate-pulse"></span>
              </span>
            </div>

            <!-- Info -->
            <div class="flex-1 min-w-0">
              <p id="user-name" class="text-[15px] font-semibold text-white truncate tracking-tight leading-snug">
                <span class="inline-block w-28 h-4 bg-white/15 rounded animate-pulse align-middle"></span>
              </p>
              <p id="user-phone" class="hidden text-xs text-white/65 truncate mt-1"></p>
              <p id="user-email" class="hidden text-xs text-white/65 truncate mt-0.5"></p>
            </div>
          </div>
        </div>

        <!-- Cards area (wallet card overlaps the identity strip) -->
        <div class="-mt-5 px-4 space-y-3 relative">

          <!-- Wallet Card — styled like a passbook, its own signature moment -->
          <div class="relative bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="flex items-start justify-between px-5 pt-4 pb-3">
              <div>
                <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-[0.2em]">Saku Kebaikan</p>
                <p id="wallet-saldo" class="mt-1.5 text-xl font-bold text-gray-900 tabular-nums tracking-tight">
                  <span class="inline-block w-24 h-[22px] bg-gray-100 rounded animate-pulse align-middle"></span>
                </p>
              </div>
              <div class="w-9 h-9 rounded-full bg-primary-50 flex items-center justify-center shrink-0">
                <img src="/assets/icons/wallet.png" alt="Saku berbagi" />
              </div>
            </div>

            <!-- perforated divider -->
            <div class="relative border-t border-dashed border-gray-200">
              <span class="absolute -left-2 -top-2 w-4 h-4 rounded-full bg-neutral-50"></span>
              <span class="absolute -right-2 -top-2 w-4 h-4 rounded-full bg-neutral-50"></span>
            </div>

            <div class="flex divide-x divide-gray-100">
              <a
                href="/mutasi-saku"
                class="flex-1 text-center py-3 text-xs font-semibold text-gray-500 hover:bg-gray-50 transition-colors"
              >
                Riwayat
              </a>
              <a
                href="/top-up"
                class="flex-1 text-center py-3 text-xs font-semibold text-primary-700 hover:bg-primary-50/60 transition-colors"
              >
                Top Up
              </a>
            </div>
          </div>

          <!-- Personal Menu -->
          <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-50">
              <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-[0.15em]">Menu Pribadi</span>
            </div>
            <div class="divide-y divide-gray-50">
              {personalMenus.map((menu) => (
                <a
                  href={menu.href}
                  class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors group"
                >
                  <svg class="w-[18px] h-[18px] text-gray-400 group-hover:text-primary-600 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                  </svg>
                  <span class="flex-1 text-sm text-gray-700 group-hover:text-gray-900 transition-colors">{menu.label}</span>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>

          <section
            class="bg-white rounded-2xl border border-gray-100 p-4"
            aria-labelledby="web-push-heading"
          >
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-full bg-primary-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <h2 id="web-push-heading" class="text-sm font-semibold text-gray-900">Notifikasi di perangkat ini</h2>
                <p id="web-push-status" class="text-xs text-gray-500 leading-relaxed mt-1" aria-live="polite">
                  Memeriksa dukungan notifikasi...
                </p>
                <button
                  id="web-push-toggle"
                  type="button"
                  disabled
                  class="mt-3 px-4 py-2 rounded-full bg-primary-500 hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed text-white text-xs font-semibold transition-colors"
                >
                  Memeriksa...
                </button>
              </div>
            </div>
          </section>

          <!-- General Menu + Logout, grouped together -->
          <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-50">
              <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-[0.15em]">Umum</span>
            </div>
            <div class="divide-y divide-gray-50">
              {generalMenus.map((menu) => (
                <a
                  href={menu.href}
                  target={menu.external ? "_blank" : undefined}
                  rel={menu.external ? "noopener noreferrer" : undefined}
                  class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 active:bg-gray-100 transition-colors group"
                >
                  <svg class="w-[18px] h-[18px] text-gray-400 group-hover:text-primary-600 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                  </svg>
                  <span class="flex-1 text-sm text-gray-700 group-hover:text-gray-900 transition-colors">{menu.label}</span>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}

              <button
                id="btn-logout"
                type="button"
                class="w-full flex items-center gap-3 px-4 py-3.5 hover:bg-red-50/60 active:bg-red-50 transition-colors group"
              >
                <svg class="w-[18px] h-[18px] text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths.logout}/>
                </svg>
                <span class="flex-1 text-left text-sm font-medium text-red-500">Keluar dari Akun</span>
              </button>
            </div>
          </div>

        </div>
      </>
    )}
  </div>

  <!-- ── Logout Confirmation Modal ───────────────────────────────────────── -->
  <div
    id="logout-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
  >
    <div
      id="logout-backdrop"
      class="absolute inset-0 bg-black/40"
    ></div>

    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-[380px] overflow-hidden">
      <div class="flex flex-col items-center px-6 pt-8 pb-2 text-center">
        <div class="w-12 h-12 rounded-full border border-red-100 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
            <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths.logout}/>
          </svg>
        </div>

        <h3 class="text-base font-semibold text-gray-900 tracking-tight">Keluar Akun?</h3>

        <p class="text-sm text-gray-400 mt-1.5 mb-1">
          Kamu perlu masuk kembali untuk mengakses fitur akun.
        </p>
      </div>

      <div class="flex gap-2.5 px-6 py-5">
        <button
          id="btn-logout-cancel"
          type="button"
          class="flex-1 border border-gray-200 text-gray-600 text-sm font-semibold py-3 rounded-xl hover:bg-gray-50 active:bg-gray-100 transition-colors"
        >
          Batal
        </button>

        <button
          id="btn-logout-confirm"
          type="button"
          class="flex-1 bg-red-500 hover:bg-red-600 active:scale-[0.99] text-white text-sm font-semibold py-3 rounded-xl transition-all"
        >
          Ya, Keluar
        </button>
      </div>
    </div>
  </div>

  <BottomNav active="akun" />
</MainLayout>

<script>
  import { getToken, isLoggedIn, bearerHeaders, removeToken } from "@/lib/auth";
  import { showToast } from "@/lib/toast";

  (() => {

    // ── Logout modal ─────────────────────────────────────────────────────────
    const modal      = document.getElementById("logout-modal")!;
    const backdrop   = document.getElementById("logout-backdrop")!;
    const btnLogout  = document.getElementById("btn-logout") as HTMLButtonElement | null;
    const btnCancel  = document.getElementById("btn-logout-cancel") as HTMLButtonElement;
    const btnConfirm = document.getElementById("btn-logout-confirm") as HTMLButtonElement;

    function openModal()  { modal.classList.remove("hidden"); }
    function closeModal() { modal.classList.add("hidden"); }

    btnLogout?.addEventListener("click", openModal);
    btnCancel?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    btnConfirm?.addEventListener("click", async () => {
      btnConfirm.disabled = true;
      btnConfirm.textContent = "Keluar...";

      try {
        await fetch(`/api/logout`, {
          method: "POST",
          credentials: "include",
        }).catch(() => {});

        removeToken();
        localStorage.removeItem("user_profile");
        localStorage.removeItem("saldo");
        localStorage.removeItem("user_reff_code");
        localStorage.removeItem("save_reff_code");

        window.location.href = "/home";
      } catch {
        showToast("Gagal keluar, coba lagi", "error");
        btnConfirm.disabled = false;
        btnConfirm.textContent = "Ya, Keluar";
      }
    });

    // ── Hanya lanjut jika user terautentikasi di client ───────────────────────
    const token = getToken();
    if (!token || !isLoggedIn()) return;
    const authHeaders = bearerHeaders(token);

    const pushButton = document.getElementById("web-push-toggle") as HTMLButtonElement | null;
    const pushStatus = document.getElementById("web-push-status");
    let pushEnabled = false;

    function setPushStatus(message: string, isError = false) {
      if (!pushStatus) return;
      pushStatus.textContent = message;
      pushStatus.classList.toggle("text-red-600", isError);
      pushStatus.classList.toggle("text-gray-500", !isError);
    }

    function supportsWebPush(): boolean {
      return (
        "serviceWorker" in navigator &&
        "PushManager" in window &&
        "Notification" in window
      );
    }

    async function syncPushStatus() {
      if (!pushButton) return;
      if (!supportsWebPush()) {
        setPushStatus("Browser ini belum mendukung notifikasi web.");
        pushButton.textContent = "Tidak didukung";
        pushButton.disabled = true;
        return;
      }

      try {
        const registration = await navigator.serviceWorker.getRegistration("/");
        const subscription = await registration?.pushManager.getSubscription();
        pushEnabled = Boolean(subscription);
        pushButton.textContent = pushEnabled
          ? "Matikan notifikasi"
          : "Aktifkan notifikasi";
        pushButton.disabled =
          !pushEnabled && Notification.permission === "denied";

        if (pushEnabled) {
          setPushStatus("Notifikasi aktif di perangkat ini.");
        } else if (Notification.permission === "denied") {
          setPushStatus(
            "Izin notifikasi situs ini diblokir. Pengaturan macOS saja belum cukup; izinkan notifikasi di pengaturan situs browser, lalu muat ulang.",
          );
        } else {
          setPushStatus("Aktifkan untuk menerima kabar donasi di perangkat ini.");
        }
      } catch {
        setPushStatus("Status notifikasi tidak dapat diperiksa.", true);
        pushButton.textContent = "Coba lagi";
        pushButton.disabled = false;
      }
    }

    async function requestPushApi(
      method: "GET" | "POST" | "DELETE",
      body?: unknown,
    ): Promise<Record<string, unknown> | null> {
      const response = await fetch("/api/notifications/web-push/" +
        (method === "GET" ? "config" : "subscriptions"), {
        method,
        headers: {
          ...authHeaders,
          ...(body ? { "Content-Type": "application/json" } : {}),
        },
        ...(body ? { body: JSON.stringify(body) } : {}),
      });

      if (!response.ok) {
        let message = "Permintaan notifikasi gagal.";
        try {
          const errorBody = await response.json();
          if (typeof errorBody?.message === "string") {
            message = errorBody.message;
          }
        } catch {
          // Keep the explicit fallback for non-JSON backend responses.
        }
        throw new Error(message);
      }

      if (response.status === 204) return null;
      return response.json();
    }

    function decodeVapidPublicKey(publicKey: string): ArrayBuffer {
      const base64 = publicKey.replace(/-/g, "+").replace(/_/g, "/");
      const padded = base64.padEnd(Math.ceil(base64.length / 4) * 4, "=");
      const raw = atob(padded);
      const buffer = new ArrayBuffer(raw.length);
      const key = new Uint8Array(buffer);
      for (let index = 0; index < raw.length; index += 1) {
        key[index] = raw.charCodeAt(index);
      }
      return buffer;
    }

    pushButton?.addEventListener("click", async () => {
      if (!supportsWebPush()) return;
      pushButton.disabled = true;
      setPushStatus(
        pushEnabled ? "Menonaktifkan notifikasi..." : "Mengaktifkan notifikasi...",
      );

      try {
        if (!pushEnabled && Notification.permission === "default") {
          const permission = await Notification.requestPermission();
          if (permission !== "granted") {
            throw new Error("Izin notifikasi belum diberikan.");
          }
        }

        const registration = await navigator.serviceWorker.register("/sw.js");
        const subscription = await registration.pushManager.getSubscription();

        if (pushEnabled && subscription) {
          await requestPushApi("DELETE", { endpoint: subscription.endpoint });
          await subscription.unsubscribe();
          showToast("Notifikasi berhasil dimatikan", "success");
        } else {
          if (Notification.permission === "denied") {
            throw new Error(
              "Izin notifikasi situs ini diblokir. Pengaturan macOS saja belum cukup; izinkan notifikasi di pengaturan situs browser, lalu muat ulang.",
            );
          }
          if (Notification.permission !== "granted") {
            throw new Error("Izin notifikasi belum diberikan.");
          }

          let activeSubscription = subscription;
          if (!activeSubscription) {
            const config = await requestPushApi("GET");
            const publicKey = config?.public_key;
            if (typeof publicKey !== "string" || !publicKey) {
              throw new Error("Konfigurasi notifikasi dari server tidak valid.");
            }
            activeSubscription = await registration.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: decodeVapidPublicKey(publicKey),
            });
          }

          await requestPushApi("POST", activeSubscription.toJSON());
          showToast("Notifikasi berhasil diaktifkan", "success");
        }

        await syncPushStatus();
      } catch (error) {
        const message =
          error instanceof Error ? error.message : "Terjadi kesalahan.";
        setPushStatus(message, true);
        pushButton.textContent = pushEnabled
          ? "Matikan notifikasi"
          : "Aktifkan notifikasi";
        pushButton.disabled =
          !pushEnabled && Notification.permission === "denied";
      }
    });

    void syncPushStatus();

    // ── Elemen DOM profil ────────────────────────────────────────────────────
    const avatarImgWrap   = document.getElementById("user-avatar-img-wrap");
    const avatarImg       = document.getElementById("user-avatar-img") as HTMLImageElement | null;
    const avatarInitials  = document.getElementById("user-avatar-initials");
    const initialsText    = document.getElementById("user-initials-text");
    const nameEl          = document.getElementById("user-name");
    const phoneEl         = document.getElementById("user-phone");
    const emailEl         = document.getElementById("user-email");
    const saldoEl         = document.getElementById("wallet-saldo");

    function getInitials(name: string): string {
      return name.trim().split(/\s+/).slice(0, 2).map(w => w[0]?.toUpperCase() ?? "").join("");
    }

    function renderProfile(p: { name?: string; phone?: string; email?: string; img?: string }) {
      // Name
      if (nameEl) nameEl.textContent = p.name || "Hamba Allah";

      // Avatar
      if (p.img && avatarImgWrap && avatarImg) {
        avatarImg.src = p.img;
        avatarImg.alt = p.name || "";
        avatarImgWrap.classList.remove("hidden");
        avatarInitials?.classList.add("hidden");
      } else if (initialsText) {
        initialsText.textContent = getInitials(p.name || "HA");
      }

      // Phone
      if (p.phone && phoneEl) {
        phoneEl.textContent = `${p.phone}`;
        phoneEl.classList.remove("hidden");
      }

      // Email
      if (p.email && emailEl) {
        emailEl.textContent = p.email;
        emailEl.classList.remove("hidden");
      }
    }

    function renderSaldo(saldo: number) {
      if (saldoEl) saldoEl.textContent = `Rp ${saldo.toLocaleString("id-ID")}`;
    }

    // ── Tampilkan cache dulu (near-instant) ──────────────────────────────────
    try {
      const cachedProfile = localStorage.getItem("user_profile");
      if (cachedProfile) renderProfile(JSON.parse(cachedProfile));

      const cachedSaldo = localStorage.getItem("saldo");
      if (cachedSaldo) renderSaldo(Number(cachedSaldo));
    } catch {
      // abaikan parse error
    }

    // ── Fetch data terbaru dari API ──────────────────────────────────────────
    async function fetchUserData() {
      try {
        const res = await fetch(`/api/dashboard/donatur/my-account`, {
          headers: bearerHeaders(token!),
        });

        if (res.status === 401) {
          removeToken();
          localStorage.removeItem("user_profile");
          localStorage.removeItem("saldo");
          localStorage.removeItem("user_reff_code");
          localStorage.removeItem("save_reff_code");
          const from = encodeURIComponent(window.location.pathname + window.location.search);
          window.location.href = `/auth/login?from=${from}`;
          return;
        }

        if (!res.ok) return;

        const json = await res.json();
        const data = json?.data ?? {}

        // Update & cache profil
        const profile = { name: data.name, phone: data.phone, email: data.email, img: data.img };
        renderProfile(profile);
        localStorage.setItem("user_profile", JSON.stringify(profile));

        // Update & cache user reff_code
        if (data.reff_code) {
          localStorage.setItem("user_reff_code", data.reff_code.trim());
        }

        // Update & cache saldo
        const saldo = Number(data.dompet_kebaikan?.saldo ?? 0);
        renderSaldo(saldo);
        localStorage.setItem("saldo", String(saldo));

      } catch {
        // tetap tampilkan cache
      }
    }

    fetchUserData();
  })();
</script>