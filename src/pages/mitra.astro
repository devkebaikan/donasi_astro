---
import Header from "@/components/sections/landing-page/Header.astro";
import Footer from "@/components/sections/landing-page/Footer.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const partners = [
  {
    name: "Rumah Zakat",
    type: "Lembaga Zakat",
    desc: "Mitra penyaluran program zakat dan infak untuk dhuafa di seluruh Indonesia.",
    logo: "🏠",
  },
  {
    name: "Dompet Dhuafa",
    type: "LSM Sosial",
    desc: "Kolaborasi program kesehatan dan pemberdayaan ekonomi keluarga miskin.",
    logo: "💛",
  },
  {
    name: "Yayasan Peduli Anak",
    type: "Lembaga Pendidikan",
    desc: "Program beasiswa dan perlindungan anak jalanan di 15 kota.",
    logo: "👶",
  },
  {
    name: "Aksi Cepat Tanggap",
    type: "Tanggap Darurat",
    desc: "Mitra respon cepat bencana alam dan krisis kemanusiaan.",
    logo: "🆘",
  },
  {
    name: "Yayasan Kesehatan Rakyat",
    type: "Kesehatan",
    desc: "Layanan kesehatan gratis dan gizi anak di daerah 3T.",
    logo: "🏥",
  },
  {
    name: "Komunitas Petani Nusantara",
    type: "Pemberdayaan",
    desc: "Program sumur bor dan irigasi untuk petani di kawasan kering.",
    logo: "🌾",
  },
];
---

<MainLayout
  title="Mitra & Akreditasi — Beramalbersama"
  description="Beramalbersama bermitra dengan lembaga terpercaya dan terakreditasi untuk memastikan setiap donasi tersalurkan secara profesional dan amanah."
>
  <Header />
  <main>
    <!-- Lembaga Mitra -->
    <section class="py-20 bg-white">
      <div class="container-custom">
        <div class="text-center mb-12" data-reveal>
          <span class="section-label">Lembaga Mitra</span>
          <h2
            class="font-display text-3xl md:text-4xl font-semibold text-primary-900 mt-2"
          >
            Bersama Kami Melayani
          </h2>
          <p
            class="mt-3 text-primary-700/80 text-sm md:text-base max-w-xl mx-auto"
          >
            Beramalbersama bermitra dengan organisasi-organisasi sosial yang
            telah terbukti kiprahnya di lapangan.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            partners.map((p, i) => (
              <div
                class="bg-cream rounded-2xl p-6 border border-primary-100 hover:border-primary-300 hover:shadow-card transition-all duration-300 flex gap-4"
                data-reveal
                style={`transition-delay:${i * 0.07}s`}
              >
                <div class="text-4xl shrink-0">{p.logo}</div>
                <div>
                  <span class="text-xs font-semibold text-primary-600 uppercase tracking-wider">
                    {p.type}
                  </span>
                  <h3 class="font-display text-lg font-semibold text-primary-900 mt-0.5 mb-2">
                    {p.name}
                  </h3>
                  <p class="text-sm text-primary-700/80 leading-relaxed">
                    {p.desc}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("revealed");
          observer.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1 },
  );
  document
    .querySelectorAll("[data-reveal]")
    .forEach((el) => observer.observe(el));
</script>
