---
import MainLayout from "@/layouts/MainLayout.astro";
import Header from "@/components/layouts/Header.astro";
import { Image } from "astro:assets";
import CampaignList from "@/components/ui/CampaignList.astro";

export const prerender = true;

const theme = {
  name: "Ramadan Berbagi Kebaikan",
  period: { start: "1 Maret 2025", end: "30 April 2025" },
  description:
    "Bersama kita wujudkan Ramadan penuh keberkahan bagi saudara-saudara kita yang membutuhkan. Setiap donasi yang kamu salurkan menjadi ladang pahala yang terus mengalir.",
  image: "/images/banner/banner-qurban.avif",
  totalTerkumpul: "248.500.000",
  totalDonatur: "12.840",
  totalProgram: "24",
};

const projects = [
  {
    title: "Sedekah Makanan Berbuka untuk Korban Banjir Aceh",
    image: "/images/banner/banner-qurban.avif",
    terkumpul: "2.500.000",
    target: "5.000.000",
    pct: 50,
    donatur: 328,
    hari: "12 hari lagi",
    lembaga: "Rumah Yatim Sumatera Utara",
  },
  {
    title: "Bangun Masjid Sumatera untuk Korban Banjir",
    image: "/images/banner/banner-qurban.avif",
    terkumpul: "5.000.000",
    target: "10.000.000",
    pct: 50,
    donatur: 512,
    hari: "18 hari lagi",
    lembaga: "Rumah Zakat DIY",
  },
  {
    title: "Bantu Pulihkan Masjid Terdampak Banjir Sumatra",
    image: "/images/banner/banner-qurban.avif",
    terkumpul: "148.100.000",
    target: "200.000.000",
    pct: 74,
    donatur: 2140,
    hari: "5 hari lagi",
    lembaga: "Rumah Initiative Jawa Tengah",
  },
  {
    title: "Bantu Bangun Masjid Tersapu Banjir dan Longsor",
    image: "/images/banner/banner-qurban.avif",
    terkumpul: "24.800.000",
    target: "50.000.000",
    pct: 49,
    donatur: 780,
    hari: "21 hari lagi",
    lembaga: "Sahabat Yatim",
  },
];

const programs = [
  {
    link: "/campaign/1",
    title: "Bantu Renovasi Masjid Al-Ikhlas",
    image: "/images/thumbnail/Artboard2-ezgif.com-jpg-to-webp-converter.webp",
    mitra: {
      name: "Yayasan Al-Ikhlas",
    },
    category: {
      name: "Renovasi",
    },
    progress_achieved: 75,
    nominal_achieved: 7500000,
    time_target: 10,
  },
  {
    link: "/campaign/2",
    title: "Dukung Pendidikan Anak Yatim Piatu",
    image: "/images/thumbnail/Artboard21-ezgif.com-jpg-to-webp-converter.webp",
    mitra: {
      name: "Yayasan Peduli Anak",
    },
    category: {
      name: "Pendidikan",
    },
    progress_achieved: 60,
    nominal_achieved: 6000000,
    time_target: 20,
  },
  {
    link: "/campaign/3",
    title: "Bantu Pembangunan Sumur Wakaf",
    image: "/images/thumbnail/Artboard22-ezgif.com-jpg-to-webp-converter.webp",
    mitra: {
      name: "Yayasan Air Bersih",
    },
    category: {
      name: "Wakaf",
    },
    progress_achieved: 90,
    nominal_achieved: 9000000,
    time_target: 5,
  },
];

const reports = [
  {
    title: "Laporan Penyaluran Minggu ke-1: 1.200 Paket Sahur Terdistribusi",
    tanggal: "7 Maret 2025",
    status: "Salur",
    image: "/images/banner/banner-qurban.avif",
    ringkasan:
      "Alhamdulillah, 1.200 paket sahur berhasil didistribusikan kepada pengungsi banjir di 5 titik lokasi di Aceh.",
  },
  {
    title: "Update: Pembangunan Masjid At-Taqwa Dimulai",
    tanggal: "14 Maret 2025",
    status: "Open",
    image: "/images/banner/banner-qurban.avif",
    ringkasan:
      "Fondasi masjid At-Taqwa telah selesai dikerjakan. Target rampung sebelum akhir Ramadan.",
  },
  {
    title: "Laporan Penyaluran Minggu ke-2: 850 Buka Puasa Bersama",
    tanggal: "14 Maret 2025",
    status: "Open",
    image: "/images/banner/banner-qurban.avif",
    ringkasan:
      "850 anak yatim dan dhuafa mendapatkan makan buka puasa dari program Ramadan Berbagi Kebaikan.",
  },
  {
    title: "Testimoni: Ibu Sari, Penerima Manfaat dari Pelosok Aceh",
    tanggal: "20 Maret 2025",
    status: "Open",
    image: "/images/banner/banner-qurban.avif",
    ringkasan:
      '"Kami tidak menyangka ada yang peduli sampai ke sini. Terima kasih atas bantuan makanan buka puasanya."',
  },
];
---

<MainLayout
  title="Tema ... | Beramalbersama.com"
  description="Salurkan kebaikanmu melalui event Ramadan Berbagi Kebaikan. Bergabung sebagai donatur atau relawan dan jadilah bagian dari perubahan nyata."
  type="website"
>
  <Header type="title" text="Tema ..." />

  <main class="container min-h-screen pb-16 bg-gray-50">
    <!-- ── Hero Banner ────────────────────────────────────────────────────── -->
    <div class="relative overflow-hidden">
      <!-- Gambar tema -->
      <div class="relative w-full aspect-[16/9] overflow-hidden">
        <Image
          width={320}
          height={240}
          src={theme.image}
          alt={theme.name}
          class="object-cover w-full h-full"
          loading="eager"
        />
        <!-- Overlay gelap bawah -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"
        >
        </div>

        <!-- Teks tema di atas gambar -->
        <div class="absolute bottom-4 left-4 right-4">
          <h1
            class="text-[20px] font-bold text-white leading-tight mb-1 drop-shadow-md"
          >
            {theme.name}
          </h1>
          <!-- Periode -->
          <div
            class="inline-flex items-center gap-1.5 bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full"
          >
            <svg
              class="w-3 h-3 text-white"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            <span class="text-[11px] text-white font-medium">
              {theme.period.start} – {theme.period.end}
            </span>
          </div>
        </div>
      </div>

      <!-- Deskripsi tema -->
      <div class="bg-white px-4 pt-4 pb-5">
        <p class="text-[13px] text-gray-600 leading-relaxed">
          {theme.description}
        </p>
      </div>

      <!-- Stats bar -->
      <div class="mx-4 -mt-1 mb-4 relative z-10">
        <div
          class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden"
        >
          <div class="grid grid-cols-3 divide-x divide-gray-100">
            <div class="py-3 text-center">
              <p class="text-[11px] text-gray-400 mb-0.5">Terkumpul</p>
              <p class="text-[13px] font-bold text-primary-600 leading-tight">
                Rp {theme.totalTerkumpul}
              </p>
            </div>
            <div class="py-3 text-center">
              <p class="text-[11px] text-gray-400 mb-0.5">Donatur</p>
              <p class="text-[13px] font-bold text-gray-800 leading-tight">
                {theme.totalDonatur}
              </p>
            </div>
            <div class="py-3 text-center">
              <p class="text-[11px] text-gray-400 mb-0.5">Program</p>
              <p class="text-[13px] font-bold text-gray-800 leading-tight">
                {theme.totalProgram}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Proyek Unggulan dari Tema ──────────────────────────────────────── -->
    <div class="mb-4 px-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-1 h-5 bg-secondary-500 rounded-full"></span>
          <span class="text-[14px] font-bold text-gray-800">Urgent</span>
        </div>
        <!-- <a
          href="/donasi"
          class="text-[12px] font-semibold text-primary-600 hover:text-primary-700"
        >
          Lihat semua →
        </a> -->
      </div>

      <div class="flex gap-3 overflow-x-auto pb-1 snap-x scrollbar-hide">
        {
          projects.map((p) => (
            <a
              href={`/`}
              class="shrink-0 w-[200px] snap-start bg-white rounded-xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col"
            >
              <div class="relative">
                <Image
                  src={p.image}
                  alt={p.title}
                  width="200"
                  height="110"
                  class="object-contain"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute top-2 left-2 text-[9px] font-bold bg-primary-500 text-white px-2 py-0.5 rounded-full leading-none">
                  {p.lembaga.split(" ").slice(0, 2).join(" ")}
                </span>
              </div>
              <div class="p-3 flex flex-col flex-1">
                <p class="text-[11px] font-semibold text-gray-800 line-clamp-2 min-h-[34px] leading-relaxed mb-2 flex-1">
                  {p.title}
                </p>
                <div class="w-full h-1 bg-gray-100 rounded-full overflow-hidden mb-1.5">
                  <div
                    class="h-full bg-gradient-to-r from-primary-400 to-primary-600 rounded-full"
                    style={`width:${p.pct}%`}
                  />
                </div>
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10px] font-bold text-primary-600">
                    Rp {p.terkumpul}
                  </span>
                  <span class="text-[10px] text-gray-400">{p.pct}%</span>
                </div>
                <p class="text-[10px] text-gray-400">
                  {p.hari} · {p.donatur} donatur
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <!-- ── Tab: Program & Update ──────────────────────────────────────────── -->
    <div class="mb-4 bg-white">
      <!-- Tab Nav -->
      <div class="flex border-b border-gray-100">
        <button
          id="tab-program-btn"
          data-tab="program"
          class="flex-1 py-3 text-[13px] font-semibold text-primary-600 border-b-2 border-primary-500 transition-all duration-200"
        >
          Program
        </button>
        <button
          id="tab-update-btn"
          data-tab="update"
          class="flex-1 py-3 text-[13px] font-medium text-gray-400 border-b-2 border-transparent transition-all duration-200"
        >
          Update / Laporan
        </button>
      </div>

      <!-- Tab 1: Program -->
      <div id="tab-program" class="px-4 pt-4 pb-5 space-y-3">
        {
          programs.map((campaign) => (
            <CampaignList
              link={`/donasi/`}
              title={campaign.title}
              image={campaign.image}
              mitra={campaign.mitra.name}
              category={campaign.category.name}
              progress_achieved={campaign.progress_achieved}
              collected_amount={campaign.nominal_achieved}
              days_left={campaign.time_target}
            />
          ))
        }

        <a
          href="/donasi"
          class="block w-full text-center border border-primary-400 text-primary-600 text-[13px] font-semibold py-2.5 rounded-xl hover:bg-primary-50 transition-colors"
        >
          Lihat Semua Program
        </a>
      </div>

      <!-- Tab 2: Update/Laporan -->
      <div id="tab-update" class="hidden px-4 pt-4 pb-5 space-y-3">
        {
          reports.map((r) => (
            <div class="flex gap-3 bg-white border border-gray-100 rounded-xl overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200 cursor-pointer">
              <div class="shrink-0 w-36 overflow-hidden bg-gray-100 m-2.5 rounded-lg">
                <Image
                  src={r.image}
                  alt={r.title}
                  width="90"
                  height="90"
                  class="object-cover w-full"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex-1 py-3 pr-3 min-w-0">
                <div class="flex items-center gap-1.5 mb-1">
                  <span
                    class={`text-[9px] font-bold px-2 py-0.5 rounded-full leading-none bg-secondary-100 text-secondary-600`}
                  >
                    {r.status}
                  </span>
                  <span class="text-[10px] text-gray-400">{r.tanggal}</span>
                </div>
                <p class="text-[12px] font-semibold text-gray-800 leading-snug line-clamp-2 mb-1">
                  {r.title}
                </p>
                <p class="text-[11px] text-gray-400 truncate leading-relaxed">
                  {r.ringkasan}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ── CTA Bawah ──────────────────────────────────────────────────────── -->
    <div class="mx-4 mb-4">
      <a
        href="/donasi"
        class="flex items-center justify-between bg-gradient-to-r from-primary-500 to-teal-500 text-white px-5 py-4 rounded-2xl shadow-md hover:shadow-lg active:scale-[0.99] transition-all duration-150"
      >
        <div>
          <p class="text-[14px] font-bold leading-tight mb-0.5">
            Donasi Sekarang
          </p>
          <p class="text-[11px] text-white/80">Pilih program dari tema ini</p>
        </div>
        <div
          class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center shrink-0"
        >
          <svg
            class="text-sm opacity-70 w-6 h-6"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
      </a>
    </div>
  </main>
</MainLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Tab switch ────────────────────────────────────────────────────────
    const programTab = document.getElementById("tab-program");
    const updateTab = document.getElementById("tab-update");
    const programBtn = document.getElementById("tab-program-btn");
    const updateBtn = document.getElementById("tab-update-btn");

    function switchTab(tab: string) {
      if (!programTab || !updateTab || !programBtn || !updateBtn) return;

      const isProgram = tab === "program";

      programTab.classList.toggle("hidden", !isProgram);
      updateTab.classList.toggle("hidden", isProgram);

      programBtn.classList.toggle("text-primary-600", isProgram);
      programBtn.classList.toggle("border-primary-500", isProgram);
      programBtn.classList.toggle("font-semibold", isProgram);
      programBtn.classList.toggle("text-gray-400", !isProgram);
      programBtn.classList.toggle("border-transparent", !isProgram);

      updateBtn.classList.toggle("text-primary-600", !isProgram);
      updateBtn.classList.toggle("border-primary-500", !isProgram);
      updateBtn.classList.toggle("font-semibold", !isProgram);
      updateBtn.classList.toggle("text-gray-400", isProgram);
      updateBtn.classList.toggle("border-transparent", isProgram);
    }

    programBtn?.addEventListener("click", () => switchTab("program"));
    updateBtn?.addEventListener("click", () => switchTab("update"));

    // ── FAQ accordion ─────────────────────────────────────────────────────
    document
      .querySelectorAll<HTMLButtonElement>(".faq-toggle")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const parent = btn.closest<HTMLElement>("[data-faq]");
          const body = parent?.querySelector<HTMLElement>(".faq-body");
          const icon = btn.querySelector<HTMLElement>(".faq-icon");
          const isOpen = body ? !body.classList.contains("hidden") : false;

          document
            .querySelectorAll<HTMLElement>(".faq-body")
            .forEach((b) => b.classList.add("hidden"));
          document
            .querySelectorAll<HTMLElement>(".faq-icon")
            .forEach((ic) => (ic.style.transform = "rotate(0deg)"));

          if (!isOpen && body) {
            body.classList.remove("hidden");
            if (icon) icon.style.transform = "rotate(180deg)";
          }
        });
      });
  });
</script>
