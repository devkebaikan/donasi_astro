---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const baseUrl = import.meta.env.ASTRO_API_URL;
---

<MainLayout
  title="Atur Password"
  description="Buat password untuk mengamankan akun Anda."
>
  <Header type="notshare" text="Atur Password" link="/auth/login-otp" />

  <div
    data-base-url="{baseUrl}"
    class="min-h-screen bg-linear-to-br from-slate-50 to-primary-100"
  >
    <div class="container space-y-3">
      <!-- Heading -->
      <div
        class="bg-white rounded-2xl shadow-sm overflow-hidden px-4 py-5 mt-[64px]"
      >
        <h1 class="text-xl font-bold text-gray-800 mb-1">Buat Password Baru</h1>
        <p class="text-xs text-gray-400 leading-relaxed">
          Password digunakan untuk masuk ke akun
          <span id="display-phone" class="font-semibold text-gray-600"></span>
        </p>
      </div>

      <!-- Error Banner -->
      <div
        id="setpass-error"
        class="hidden flex items-center gap-2 bg-red-50 border border-red-200 text-red-600 text-xs rounded-xl px-3 py-2.5"
      >
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
            clip-rule="evenodd"></path>
        </svg>
        <span id="setpass-error-text">Terjadi kesalahan</span>
      </div>

      <!-- Form Card -->
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
          <span class="w-1 h-5 bg-teal-500 rounded-full"></span>
          <span class="text-sm font-semibold text-gray-700">Keamanan Akun</span>
        </div>

        <div class="px-4 py-5 space-y-4">
          <!-- Password -->
          <div class="space-y-1.5">
            <label
              for="input-password"
              class="block text-xs font-medium text-gray-600"
            >
              Password <span class="text-red-400">*</span>
            </label>
            <div class="relative">
              <input
                id="input-password"
                type="password"
                placeholder="Masukkan password"
                autocomplete="new-password"
                class="w-full px-4 py-3 bg-gray-100 border border-transparent rounded-xl text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-teal-400 focus:bg-white transition-colors pr-11"
              />
              <button
                type="button"
                id="toggle-password"
                aria-label="Tampilkan password"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
              >
                <!-- Eye icon (default: tampil saat password tersembunyi) -->
                <svg
                  id="eye-icon"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  ></path>
                </svg>
                <!-- Eye-off icon (tampil saat password terlihat) -->
                <svg
                  id="eye-off-icon"
                  class="w-5 h-5 hidden"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                  ></path>
                </svg>
              </button>
            </div>
            <!-- Password strength indicator -->
            <div id="strength-bar-wrapper" class="hidden pt-1 space-y-1">
              <div class="flex gap-1">
                <div
                  id="bar-1"
                  class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"
                >
                </div>
                <div
                  id="bar-2"
                  class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"
                >
                </div>
                <div
                  id="bar-3"
                  class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"
                >
                </div>
              </div>
              <p id="strength-label" class="text-[11px] text-gray-400"></p>
            </div>
          </div>

          <!-- Konfirmasi Password -->
          <div class="space-y-1.5">
            <label
              for="input-password-confirm"
              class="block text-xs font-medium text-gray-600"
            >
              Konfirmasi Password <span class="text-red-400">*</span>
            </label>
            <div class="relative">
              <input
                id="input-password-confirm"
                type="password"
                placeholder="Ulangi password"
                autocomplete="new-password"
                class="w-full px-4 py-3 bg-gray-100 border border-transparent rounded-xl text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-teal-400 focus:bg-white transition-colors pr-11"
              />
              <!-- Match indicator -->
              <span
                id="match-icon"
                class="absolute right-3 top-1/2 -translate-y-1/2 hidden"
                aria-hidden="true"></span>
            </div>
            <p id="match-hint" class="hidden text-[11px] text-red-400">
              Password tidak cocok
            </p>
          </div>

          <!-- Syarat password -->
          <ul class="space-y-1 text-[11px] text-gray-400">
            <li id="rule-length" class="flex items-center gap-1.5">
              <span
                class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-300 shrink-0"
              ></span>
              Minimal 6 karakter
            </li>
          </ul>

          <!-- Tombol Submit -->
          <button
            id="btn-setpass"
            type="button"
            class="w-full bg-teal-500 hover:bg-teal-600 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-semibold py-3.5 rounded-xl transition-all duration-150"
          >
            Selanjutnya
          </button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";

  // Baca baseUrl dari data attribute (di luar DOMContentLoaded)
  const baseUrl = (document.querySelector("[data-base-url]") as HTMLElement)
    ?.dataset.baseUrl;

  document.addEventListener("DOMContentLoaded", () => {
    // ── Elemen ──────────────────────────────────────────────────────────────
    const btnSetpass = document.getElementById(
      "btn-setpass",
    ) as HTMLButtonElement;
    const inputPassword = document.getElementById(
      "input-password",
    ) as HTMLInputElement;
    const inputConfirm = document.getElementById(
      "input-password-confirm",
    ) as HTMLInputElement;
    const toggleBtn = document.getElementById(
      "toggle-password",
    ) as HTMLButtonElement;
    const eyeIcon = document.getElementById("eye-icon") as HTMLElement;
    const eyeOffIcon = document.getElementById("eye-off-icon") as HTMLElement;
    const errorBox = document.getElementById("setpass-error") as HTMLElement;
    const errorText = document.getElementById(
      "setpass-error-text",
    ) as HTMLElement;
    const displayPhone = document.getElementById(
      "display-phone",
    ) as HTMLElement;
    const matchIcon = document.getElementById("match-icon") as HTMLElement;
    const matchHint = document.getElementById("match-hint") as HTMLElement;

    // ── Baca phone & guard auth ─────────────────────────────────────────────
    const getCookie = (name: string) =>
      document.cookie
        .split("; ")
        .find((r) => r.startsWith(`${name}=`))
        ?.split("=")[1];

    // Redirect jika sudah login
    const authToken = getCookie("authToken");
    if (authToken) {
      window.location.href = "/";
      return;
    }

    // Redirect jika tidak ada phone cookie
    const phone = getCookie("authphone");
    const decodedPhone = phone ? decodeURIComponent(phone) : "";
    if (!decodedPhone) {
      window.location.href = "/auth/forgot-password";
      return;
    }

    displayPhone.textContent = decodedPhone;

    // ── Helpers ─────────────────────────────────────────────────────────────
    function showError(msg: string) {
      errorText.textContent = msg;
      errorBox.classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function hideError() {
      errorBox.classList.add("hidden");
    }

    function setLoading(state: boolean) {
      btnSetpass.disabled = state;
      btnSetpass.textContent = state ? "Memproses..." : "Selanjutnya";
    }

    // ── Toggle visibility (berlaku untuk kedua input) ────────────────────────
    let passwordVisible = false;

    toggleBtn.addEventListener("click", () => {
      passwordVisible = !passwordVisible;
      const type = passwordVisible ? "text" : "password";
      inputPassword.type = type;
      inputConfirm.type = type;
      eyeIcon.classList.toggle("hidden", passwordVisible);
      eyeOffIcon.classList.toggle("hidden", !passwordVisible);
    });

    // ── Match indicator ─────────────────────────────────────────────────────
    function validateMatch() {
      const pass = inputPassword.value;
      const confirm = inputConfirm.value;

      if (!confirm) {
        matchIcon.classList.add("hidden");
        matchHint.classList.add("hidden");
        inputConfirm.classList.remove("border-red-300", "border-teal-400");
        return;
      }

      const isMatch = pass === confirm;

      matchIcon.classList.remove("hidden");
      matchIcon.textContent = isMatch ? "✓" : "✗";
      matchIcon.className = `absolute right-3 top-1/2 -translate-y-1/2 text-sm font-bold ${isMatch ? "text-teal-500" : "text-red-400"}`;

      matchHint.classList.toggle("hidden", isMatch);
      inputConfirm.classList.toggle("border-teal-400", isMatch);
      inputConfirm.classList.toggle("border-red-300", !isMatch);
    }

    inputConfirm.addEventListener("input", validateMatch);

    // ── Submit ──────────────────────────────────────────────────────────────
    btnSetpass.addEventListener("click", async () => {
      hideError();

      const password = inputPassword.value;
      const passwordKonfirmasi = inputConfirm.value;

      if (!password || !passwordKonfirmasi) {
        showToast("Harap isi semua field password", "error");
        return;
      }

      if (password.length < 6) {
        showToast("Password harus memiliki minimal 6 karakter", "error");
        return;
      }

      if (password !== passwordKonfirmasi) {
        showToast("Password dan konfirmasi password tidak cocok", "error");
        return;
      }

      setLoading(true);

      try {
        const res = await fetch(`${baseUrl}/set-password`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            phone: decodedPhone,
            password,
            password_confirmation: passwordKonfirmasi,
          }),
        });

        const json = await res.json();
        if (!res.ok)
          throw new Error(json?.message ?? "Gagal mengatur password");

        // Hapus cookie authphone
        document.cookie =
          "authphone=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

        showToast("Password berhasil diatur!", "success");
        window.location.href = "/auth/login";
      } catch (err: any) {
        showError(err.message ?? "Terjadi kesalahan, coba lagi");
      } finally {
        setLoading(false);
      }
    });
  });
</script>
