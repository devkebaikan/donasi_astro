---
import { formatRupiah, getInitialName, timeAgoFormat } from "@/lib/formatter";

interface Props {
  donors: any;
  programSlug?: string;
}

const { donors, programSlug = "infaq" } = Astro.props;

const donorList: any[] = Array.isArray(donors)
  ? donors
  : Array.isArray(donors?.data)
    ? donors.data
    : [];

const total: number = donors?.meta?.total ?? donorList.length;
---

<div id="tab-donatur" class="hidden py-3 space-y-3">
  <div class="bg-white rounded-lg shadow-sm p-4 md:p-6">
    <div class="flex items-end justify-between mb-6">
      <div class="flex items-center gap-3">
        <div
          class="px-4 py-1.5 rounded-full bg-linear-to-r from-primary-100 to-white border border-primary-300 text-primary-700 font-semibold text-sm shadow-sm"
        >
          Donatur
        </div>
        {
          total >= 1 && (
            <span class="inline-flex items-center justify-center min-w-[28px] h-7 px-2 rounded-full bg-primary-600 text-white text-xs font-medium shadow">
              {total}
            </span>
          )
        }
      </div>
    </div>

    <div class="donate-body-content pb-0">
      {
        donorList.length > 0 ? (
          donorList.map((d: any) => {
            const likeCount = d.liked ?? 0;
            const donorName = d.name || "Hamba Allah";
            const rutinBadge =
              d.source === "RUTIN" ? (
                <a
                  href={`/donasi-rutin/program/${programSlug}`}
                  class="flex-shrink-0 w-7 h-7"
                  title="Donasi Rutin"
                >
                  <img
                    src="/img/icons/menu/6. Donasi rutin.webp"
                    alt="Donasi Rutin"
                    class="w-full h-full object-contain"
                    width="28"
                    height="28"
                  />
                </a>
              ) : null;

            return (
              <div
                class="bg-white rounded-lg p-4 mb-3 shadow-sm border border-gray-100"
                data-donor-id={d.id}
              >
                <div class="flex items-start gap-3 mb-3">
                  <div class="w-10 h-10 rounded-full bg-primary-100 flex items-center justify-center shrink-0">
                    <span class="text-sm font-bold text-primary-700">
                      {getInitialName(donorName)}
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <h4 class="font-semibold text-gray-900 text-base truncate">
                        {donorName}
                      </h4>
                      {rutinBadge}
                    </div>
                    <p class="text-xs text-gray-600">
                      {timeAgoFormat(d.date || d.created_at)} Via {d.bank_name || "-"}
                    </p>
                  </div>
                  <div class="flex-shrink-0">
                    <p class="font-bold text-primary-600">
                      {formatRupiah(d.nominal_donasi || 0)}
                    </p>
                  </div>
                </div>

                {d.doa && (
                  <div class="bg-gray-50 rounded-lg p-4 mt-3">
                    <p class="text-gray-700 text-sm leading-relaxed mb-3">
                      {d.doa}
                    </p>
                    <div class="flex justify-between items-center pt-3 border-t border-gray-200">
                      <div class="text-sm text-gray-600">
                        <span class="like-count" data-count={likeCount}>
                          {likeCount === 0 ? (
                            "Yuk aminkan doa saudara kita"
                          ) : (
                            <>
                              <strong class="text-primary-600">{likeCount}</strong>{" "}
                              orang mengaminkan doa ini
                            </>
                          )}
                        </span>
                      </div>
                      <button
                        type="button"
                        class="like-button flex items-center gap-2 px-4 py-2 rounded-lg border-2 border-primary-500 text-primary-500 font-semibold text-sm transition-all duration-300 hover:bg-primary-100 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
                        data-donor-id={d.id}
                      >
                        <svg
                          class="w-4 h-4 heart-icon"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        <span class="button-text">Aamiin</span>
                      </button>
                    </div>
                  </div>
                )}
              </div>
            );
          })
        ) : (
          <div class="text-center py-12">
            <div class="flex flex-col items-center gap-4">
              <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center">
                <svg
                  class="w-10 h-10 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                  />
                </svg>
              </div>
              <div>
                <h5 class="text-gray-700 mb-1 font-medium">Belum ada Donatur</h5>
                <p class="text-sm text-gray-500">
                  Jadilah donatur pertama untuk program ini
                </p>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  function initDonaturTabLikes(): void {
    const tab = document.getElementById("tab-donatur");
    if (!tab) return;

    const buttons = tab.querySelectorAll<HTMLButtonElement>(".like-button");
    buttons.forEach((btn) => {
      const donorId = btn.getAttribute("data-donor-id");
      if (!donorId) return;

      if (localStorage.getItem(`liked_${donorId}`) === "true") {
        btn.classList.remove(
          "border-primary-500",
          "text-primary-500",
          "hover:bg-primary-100",
        );
        btn.classList.add("bg-primary-500", "text-white");
        btn.disabled = true;
        btn.querySelector(".heart-icon")?.classList.add("text-white");
      }

      btn.addEventListener("click", async function () {
        if (this.disabled) return;
        const id = this.getAttribute("data-donor-id")!;
        const card = this.closest("[data-donor-id]");
        const countSpan = card?.querySelector<HTMLElement>(".like-count");
        const cur = parseInt(countSpan?.dataset.count ?? "0");
        const next = cur + 1;

        if (countSpan) {
          countSpan.dataset.count = String(next);
          countSpan.innerHTML = `<strong class="text-primary-600">${next}</strong> orang mengaminkan doa ini`;
        }

        this.classList.remove(
          "border-primary-500",
          "text-primary-500",
          "hover:bg-primary-100",
        );
        this.classList.add("bg-primary-500", "text-white");
        this.disabled = true;
        this.querySelector(".heart-icon")?.classList.add("text-white");
        localStorage.setItem(`liked_${id}`, "true");

        try {
          await fetch(`/api/amin/${id}/like`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id }),
          });
        } catch {
          if (countSpan) {
            countSpan.dataset.count = String(cur);
            countSpan.innerHTML =
              cur === 0
                ? "Yuk aminkan doa saudara kita"
                : `<strong class="text-primary-600">${cur}</strong> orang mengaminkan doa ini`;
          }
          this.classList.add(
            "border-primary-500",
            "text-primary-500",
            "hover:bg-primary-100",
          );
          this.classList.remove("bg-primary-500", "text-white");
          this.disabled = false;
          this.querySelector(".heart-icon")?.classList.remove("text-white");
          localStorage.removeItem(`liked_${id}`);
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDonaturTabLikes);
  } else {
    initDonaturTabLikes();
  }
  document.addEventListener("astro:page-load", initDonaturTabLikes);
</script>
