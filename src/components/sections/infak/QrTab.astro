---
interface Props {
  qr: any;
}

const qr = {
  image_url: "/assets/infak/qris-beramal.avif",
  name: "QR Code Infaq",
};
---

<div id="tab-qr" class="hidden py-3 flex flex-col items-center">
  {
    qr ? (
      <div class="bg-white rounded border border-gray-100 shadow-sm p-6 flex flex-col items-center gap-5 w-full">
        <div class="flex items-center gap-2.5 self-start">
          <p class="text-sm font-bold text-gray-800">Scan untuk Berinfak</p>
        </div>

        <div class="bg-slate-50 rounded-lg overflow-hidden border border-slate-100">
          <img
            src={qr.image_url}
            alt={qr.name ?? "QR Code Infaq"}
            loading="lazy"
            class="object-contain w-full"
          />
        </div>

        <div class="text-center space-y-1.5">
          <p class="text-sm font-semibold text-gray-700">
            {qr.name ?? "QR Infaq"}
          </p>
          <p class="text-xs text-gray-400 leading-relaxed max-w-[240px]">
            Buka aplikasi m-banking atau dompet digital, lalu scan QR di atas
          </p>
        </div>
      </div>
    ) : (
      <div class="bg-white rounded border border-gray-100 shadow-sm p-12 flex flex-col items-center gap-3 w-full">
        <div class="w-16 h-16 rounded-2xl bg-gray-100 flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="text-gray-300"
          >
            <rect x="3" y="3" width="7" height="7" />
            <rect x="14" y="3" width="7" height="7" />
            <rect x="14" y="14" width="7" height="7" />
            <rect x="3" y="14" width="7" height="7" />
          </svg>
        </div>
        <p class="text-sm text-gray-400 text-center">QR Code belum tersedia</p>
      </div>
    )
  }
</div>
