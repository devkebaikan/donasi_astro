---
import { formatRupiah } from "@/lib/formatter";
import PaymentMethodModal from "@/components/ui/PaymentMethod.astro";

interface Props {
  paymentMethods: any[];
  walletBalance: number;
  isAuthenticated?: boolean;
  isLocked?: boolean;
  defaultHour?: string;
  defaultMinute?: string;
  defaultRangeType?: string;
  lockedDay?: string | false;
}

const {
  paymentMethods,
  walletBalance,
  isAuthenticated = true,
  isLocked = false,
  defaultHour = "08",
  defaultMinute = "00",
  defaultRangeType = "daily",
  lockedDay = false,
} = Astro.props;

const hours = Array.from({ length: 24 }, (_, i) => String(i).padStart(2, "0"));
const minutes = Array.from({ length: 60 }, (_, i) =>
  String(i).padStart(2, "0"),
);
const dayOptions = Array.from({ length: 100 }, (_, i) => String(i + 1));
const monthDays = Array.from({ length: 28 }, (_, i) => String(i + 1));
const weeklyDays = [
  "Senin",
  "Selasa",
  "Rabu",
  "Kamis",
  "Jumat",
  "Sabtu",
  "Minggu",
];
const nominalOptions = [5000, 10000, 25000, 50000, 100000, 250000];
const hourlyIntervals = Array.from({ length: 23 }, (_, i) => String(i + 1));
---

<!-- Nominal -->
<div class="bg-white rounded border border-gray-100 shadow-sm p-4">
  <p class="text-sm font-semibold text-gray-500 mb-3">Nominal donasi</p>

  <div class="relative">
    <span
      class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 text-sm font-semibold pointer-events-none"
    >
      Rp
    </span>
    <input
      id="nominal-input"
      type="number"
      inputmode="numeric"
      min="1000"
      placeholder="Masukkan nominal lainnya"
      class="w-full pl-10 pr-4 py-3 rounded-lg border border-gray-200 text-sm font-semibold text-gray-800 placeholder:text-gray-300 placeholder:font-normal focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
    />
  </div>
  <p class="text-xs text-gray-400 mt-2">Minimal donasi Rp1.000</p>

  <div class="grid grid-cols-3 gap-2 mt-3">
    {
      nominalOptions.map((n) => (
        <button
          type="button"
          class="nominal-chip text-sm py-2 px-1 rounded-lg border border-gray-200 text-gray-500 font-semibold transition-all duration-150"
          data-value={n}
        >
          {formatRupiah(n)}
        </button>
      ))
    }
  </div>
</div>

<!-- Metode Pembayaran -->
<div class="bg-white rounded border border-gray-100 shadow-sm p-4">
  <p class="text-sm font-semibold text-gray-500 mb-0.5">Metode pembayaran</p>
  <p class="text-xs text-gray-400 mb-3 leading-relaxed">
    Donasi rutin dipotong otomatis dari Saku Berbagi setiap periodenya
  </p>

  <div class={`grid grid-cols-2 gap-2 mb-3`}>
    <button
      id="btn-langsung"
      type="button"
      class="py-2.5 rounded-lg bg-primary-100 text-primary-700 text-xs font-semibold transition-all duration-150"
    >
      Bayar Langsung
    </button>

    <button
      id="btn-saku"
      type="button"
      class="py-2.5 rounded-lg bg-white text-gray-400 text-xs font-semibold transition-all duration-150"
    >
      Saku Berbagi
    </button>
  </div>

  {
    isAuthenticated ? (
      <div
        id="saku-info"
        class="items-center justify-between bg-gray-50 rounded-lg px-4 py-3 hidden"
      >
        <span class="text-sm text-gray-500">Saldo Saku Berbagi</span>
        <span id="wallet-display" class="text-sm font-bold text-primary-600">
          {formatRupiah(walletBalance)}
        </span>
      </div>
    ) : (
      <div
        id="guest-saku-login-note"
        class="text-xs text-start rounded-lg px-4 py-2.5 bg-red-50 mt-3 h-auto flex-col hidden"
      >
        <p class="text-sm font-semibold text-gray-800 ">
          Login untuk menggunakan Saku Kebaikan
        </p>

        <p class="text-xs text-gray-600">
          Silakan login terlebih dahulu untuk melanjutkan.
        </p>
        <a
          href={`/auth/login?from=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
          class="px-4 py-2.5 rounded-lg bg-secondary-500 text-white font-semibold mt-4 w-fit"
        >
          Login sekarang
        </a>
      </div>
    )
  }

  <div id="payment-picker" class="">
    <button
      id="open-payment-modal"
      type="button"
      class="w-full flex items-center justify-between border border-gray-200 rounded-lg px-4 py-3 hover:border-primary-400 hover:bg-primary-50 transition-all duration-150"
    >
      <div class="flex items-center gap-3">
        <img
          id="payment-img"
          src=""
          alt=""
          width="64"
          height="32"
          class="h-8 w-auto hidden object-contain"
        />
        <span id="payment-name" class="text-sm text-gray-400">
          Pilih metode pembayaran
        </span>
      </div>
      <span
        class="text-xs text-white font-semibold border bg-primary-400 rounded-lg px-3 py-1 shrink-0"
      >
        Pilih
      </span>
    </button>
  </div>

  <p
    id="note-saku"
    class="text-xs text-start rounded-lg px-4 py-2.5 bg-primary-50 text-primary-600 mt-3"
  >
    Donasi akan otomatis diproses menggunakan saldo Saku Berbagi Anda
  </p>
  <p
    id="note-commitment"
    class="text-xs text-start rounded-lg px-4 py-2.5 bg-primary-50 text-primary-600 mt-3 hidden"
  >
    Bayar sekali sekarang dan nikmati donasi rutin yang berjalan otomatis
  </p>
  <div
    id="note-insufficient"
    class="text-xs text-start rounded-lg px-4 py-2.5 bg-red-50 mt-3 h-auto flex-col hidden"
  >
    <p class="text-sm font-semibold">Saldo Saku Berbagi tidak mencukupi</p>
    <p>Silakan top up terlebih dahulu</p>
    <a
      href="/top-up"
      class="px-4 py-2.5 rounded-lg bg-secondary-500 text-white font-semibold mt-4 w-fit"
      >Top up sekarang</a
    >
  </div>
</div>

{
  !isAuthenticated && (
    <div class="bg-white rounded border border-gray-100 shadow-sm p-4 space-y-3">
      <p class="text-sm font-semibold text-gray-500">Data donatur</p>

      <div class="flex items-center gap-3">
        <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">
          Nama lengkap
        </span>
        <input
          id="guest-name-input"
          type="text"
          placeholder="Masukkan nama lengkap"
          class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
        />
      </div>

      <div class="flex items-center gap-3">
        <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">
          Nomor telepon
        </span>
        <input
          id="guest-phone-input"
          type="tel"
          inputmode="numeric"
          placeholder="08xxxxxxxxxx"
          class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
        />
      </div>
    </div>
  )
}

<!-- Jadwal -->
<div class="bg-white rounded border border-gray-100 shadow-sm p-4 space-y-3">
  <p class="text-sm font-semibold text-gray-500">Jadwal donasi</p>

  <!-- Lama donasi — commitment only -->
  <div id="commitment-row" class="">
    <div class="flex items-start gap-3">
      <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight pt-2">
        Lama donasi
      </span>
      <div class="flex-1 space-y-2">
        <div class="grid grid-cols-4 gap-2">
          <button
            type="button"
            class="commitment-chip text-xs py-2 px-1 rounded-lg border border-primary-500 bg-primary-500 text-white font-semibold transition-all duration-150"
            data-value="3"
          >
            3x
          </button>
          <button
            type="button"
            class="commitment-chip text-xs py-2 px-1 rounded-lg border border-gray-200 text-gray-600 font-semibold transition-all duration-150"
            data-value="5"
          >
            5x
          </button>
          <button
            type="button"
            class="commitment-chip text-xs py-2 px-1 rounded-lg border border-gray-200 text-gray-600 font-semibold transition-all duration-150"
            data-value="10"
          >
            10x
          </button>
          <button
            type="button"
            id="commitment-custom-trigger"
            class="text-xs py-2 px-1 rounded-lg border border-gray-200 text-gray-600 font-semibold transition-all duration-150"
          >
            Lainnya
          </button>
        </div>

        <div id="commitment-custom-row" class="hidden">
          <input
            id="commitment-custom-input"
            type="number"
            min="1"
            max="100"
            placeholder="Tulis sendiri (mis. 12 kali)"
            class="w-full border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
          />
        </div>

        <select
          id="commitment-select"
          class="hidden"
          aria-hidden="true"
          tabindex="-1"
        >
          {dayOptions.map((d) => <option value={d}>{d} kali</option>)}
        </select>
      </div>
    </div>
  </div>

  <!-- Frekuensi -->
  <div class="flex items-center gap-3">
    <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">
      Donasi setiap
    </span>
    <select
      id="range-type-select"
      disabled={isLocked}
      class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-primary-400 disabled:bg-gray-50 disabled:text-gray-400 transition-all"
    >
      <option value="daily" selected={defaultRangeType === "daily"}
        >Harian</option
      >
      <option value="weekly" selected={defaultRangeType === "weekly"}
        >Mingguan</option
      >
      <option value="monthly" selected={defaultRangeType === "monthly"}
        >Bulanan</option
      >
      <option value="hourly">Per Jam</option>
    </select>
  </div>

  <!-- Hari (weekly) -->
  <div id="weekly-row" class={defaultRangeType === "weekly" ? "" : "hidden"}>
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight"
        >Hari</span
      >
      <select
        id="range-day-select"
        disabled={!!lockedDay}
        class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-primary-400 disabled:bg-gray-50 disabled:text-gray-400 transition-all"
      >
        {
          weeklyDays.map((d) => (
            <option value={d} selected={lockedDay === d}>
              {d}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <!-- Tanggal (monthly) -->
  <div id="monthly-row" class="hidden">
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">
        Tanggal
      </span>
      <select
        id="range-date-select"
        class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all"
      >
        {monthDays.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
  </div>

  <!-- Per Jam (hourly) -->
  <div id="hourly-row" class="hidden">
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">
        Setiap satu jam
      </span>
      <select
        id="hour-interval-select"
        class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-primary-400 transition-all"
      >
        {hourlyIntervals.map((h) => <option value={h}>{h} jam</option>)}
      </select>
    </div>
  </div>

  <!-- Pukul -->
  <div class="flex items-center gap-3">
    <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">Pukul</span
    >
    <div class="flex-1 flex items-center gap-2">
      <select
        id="hour-select"
        disabled={isLocked}
        class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-primary-400 disabled:bg-gray-50 disabled:text-gray-400 transition-all"
      >
        {
          hours.map((h) => (
            <option value={h} selected={h === defaultHour}>
              {h}
            </option>
          ))
        }
      </select>
      <span class="text-gray-300 font-bold text-lg">:</span>
      <select
        id="minute-select"
        disabled
        class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-400 bg-gray-50"
      >
        {
          minutes.map((m) => (
            <option value={m} selected={m === defaultMinute}>
              {m}
            </option>
          ))
        }
      </select>
    </div>
  </div>

  <!-- Atas nama orang lain -->
  <div class="flex items-center gap-3">
    <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight">
      Atas nama orang lain
    </span>
    <input
      id="atas-nama-input"
      type="text"
      placeholder="Opsional"
      class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all"
    />
  </div>

  <!-- Doa -->
  <div class="flex items-start gap-3">
    <span class="text-sm text-gray-500 w-2/5 shrink-0 leading-tight pt-2.5">
      Doa
    </span>
    <textarea
      id="doa-input"
      rows="3"
      placeholder="Tuliskan doa Anda... (opsional)"
      class="flex-1 border border-gray-200 rounded-lg py-2.5 px-3 text-sm text-gray-700 placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent transition-all resize-none"
    ></textarea>
  </div>

  <p
    id="schedule-note"
    class="text-xs text-center rounded-lg px-4 py-2.5 bg-amber-50 text-amber-700"
  >
    Sistem akan memproses donasi rutin Anda secara otomatis sesuai jadwal
  </p>
</div>

<!-- Bottom bar fixed -->
<div
  class="fixed container -bottom-5 left-0 right-0 z-30 bg-white border-t border-gray-100 px-4 pt-4 pb-6"
>
  <div class="flex justify-between gap-4">
    <div
      id="text-total"
      class="w-1/2 border-b border-neutral-400 px-4 font-semibold py-3.5 text-sm"
    >
      Total : -
    </div>
    <button
      id="btn-submit"
      type="button"
      class="w-1/2 bg-secondary-500 hover:bg-secondary-600 active:scale-[0.98] text-white font-semibold py-3.5 rounded-lg transition-all duration-150 text-sm disabled:opacity-60 disabled:cursor-not-allowed"
    >
      Konfirmasi
    </button>
  </div>
</div>

<!-- Payment Modal -->
<PaymentMethodModal
  paymentMethods={paymentMethods}
  showWallet={false}
  defaultWallet={false}
/>

<script>
  import { showToast } from "@/lib/toast";
  import { getToken } from "@/lib/auth";
  import { formatRupiah } from "@/lib/formatter";

  const page = document.getElementById("rutin-page") as HTMLElement;
  if (!page) throw new Error("rutin-page not found");

  const API_URL = page.dataset.apiUrl ?? "";
  const programId = page.dataset.programId ?? "";
  const walletBal = Number(page.dataset.wallet ?? 0);
  const isAuth = page.dataset.isAuth === "true";
  const token = getToken();

  let nominal = 0;
  let isCommitment = true;
  let paymentMethodId = "";
  let paymentSelected = false;
  let isProcessing = false;

  const DAY_MAP: Record<string, string> = {
    Senin: "Monday",
    Selasa: "Tuesday",
    Rabu: "Wednesday",
    Kamis: "Thursday",
    Jumat: "Friday",
    Sabtu: "Saturday",
    Minggu: "Sunday",
  };

  const nominalInput = document.getElementById(
    "nominal-input",
  ) as HTMLInputElement;
  const btnSaku = document.getElementById(
    "btn-saku",
  ) as HTMLButtonElement | null;
  const btnLangsung = document.getElementById(
    "btn-langsung",
  ) as HTMLButtonElement;
  const sakuInfo = document.getElementById("saku-info") as HTMLElement;
  const paymentPicker = document.getElementById(
    "payment-picker",
  ) as HTMLElement;
  const noteSaku = document.getElementById("note-saku") as HTMLElement;
  const noteCommitment = document.getElementById(
    "note-commitment",
  ) as HTMLElement;
  const guestSakuLoginNote = document.getElementById(
    "guest-saku-login-note",
  ) as HTMLElement | null;
  const noteInsufficient = document.getElementById(
    "note-insufficient",
  ) as HTMLElement;
  const commitmentRow = document.getElementById(
    "commitment-row",
  ) as HTMLElement;
  const commitmentSelect = document.getElementById(
    "commitment-select",
  ) as HTMLSelectElement;
  const commitmentCustomTrigger = document.getElementById(
    "commitment-custom-trigger",
  ) as HTMLButtonElement;
  const commitmentCustomRow = document.getElementById(
    "commitment-custom-row",
  ) as HTMLElement;
  const commitmentCustomInput = document.getElementById(
    "commitment-custom-input",
  ) as HTMLInputElement;
  const rangeTypeSelect = document.getElementById(
    "range-type-select",
  ) as HTMLSelectElement;
  const weeklyRow = document.getElementById("weekly-row") as HTMLElement;
  const monthlyRow = document.getElementById("monthly-row") as HTMLElement;
  const hourlyRow = document.getElementById("hourly-row") as HTMLElement;
  const atasNamaInput = document.getElementById(
    "atas-nama-input",
  ) as HTMLInputElement;
  const doaInput = document.getElementById("doa-input") as HTMLTextAreaElement;
  const hourSelect = document.getElementById(
    "hour-select",
  ) as HTMLSelectElement;
  const minuteSelect = document.getElementById(
    "minute-select",
  ) as HTMLSelectElement;
  const scheduleNote = document.getElementById("schedule-note") as HTMLElement;
  const btnSubmit = document.getElementById("btn-submit") as HTMLButtonElement;
  const textTotal = document.getElementById("text-total") as HTMLElement;
  const paymentImg = document.getElementById("payment-img") as HTMLImageElement;
  const paymentNameEl = document.getElementById("payment-name") as HTMLElement;
  const openModalBtn = document.getElementById(
    "open-payment-modal",
  ) as HTMLButtonElement;
  const guestNameInput = document.getElementById(
    "guest-name-input",
  ) as HTMLInputElement | null;
  const guestPhoneInput = document.getElementById(
    "guest-phone-input",
  ) as HTMLInputElement | null;

  function syncNotes() {
    const isInsufficient = !isCommitment && nominal > walletBal && nominal > 0;
    const showLoginPrompt = !isAuth && !isCommitment;

    noteSaku.classList.toggle(
      "hidden",
      !isAuth || isCommitment || isInsufficient || showLoginPrompt,
    );
    noteCommitment.classList.toggle("hidden", !isCommitment);

    noteInsufficient.classList.toggle(
      "hidden",
      !isAuth || !isInsufficient || showLoginPrompt,
    );
    noteInsufficient.classList.toggle(
      "flex",
      isAuth && isInsufficient && !showLoginPrompt,
    );

    if (guestSakuLoginNote) {
      guestSakuLoginNote.classList.toggle("hidden", !showLoginPrompt);
      guestSakuLoginNote.classList.toggle("flex", showLoginPrompt);
    }
  }

  function syncSubmitLabel() {
    if (isProcessing) {
      btnSubmit.textContent = "Memproses...";
      return;
    }
    btnSubmit.textContent = "Konfirmasi";
    if (nominal <= 0) {
      textTotal.textContent = "Total : -";
      return;
    }
    if (isCommitment) {
      const total = nominal * Number(commitmentSelect.value);
      textTotal.textContent = `Total : ${formatRupiah(total)}`;
    } else {
      textTotal.textContent = `Total : ${formatRupiah(nominal)}`;
    }
  }

  function syncScheduleNote() {
    scheduleNote.textContent = isCommitment
      ? "Sistem akan memproses donasi rutin Anda secara otomatis sesuai jadwal"
      : "Donasi rutin akan aktif selama saldo Saku Berbagi Anda mencukupi";
  }

  function setChipActive(activeBtn: HTMLButtonElement | null) {
    document
      .querySelectorAll<HTMLButtonElement>(".nominal-chip")
      .forEach((b) => {
        const isActive = b === activeBtn;
        b.classList.toggle("border-primary-500", isActive);
        b.classList.toggle("bg-primary-500", isActive);
        b.classList.toggle("text-white", isActive);
        b.classList.toggle("border-gray-200", !isActive);
        b.classList.toggle("text-gray-500", !isActive);
        b.classList.toggle("bg-white", !isActive);
      });
  }

  function getCommitmentValue(): number {
    const value = Number(commitmentSelect.value);
    return Number.isFinite(value) && value > 0 ? value : 1;
  }

  function setCommitmentChipActive(activeBtn: HTMLButtonElement | null) {
    document
      .querySelectorAll<HTMLButtonElement>(".commitment-chip")
      .forEach((b) => {
        const isActive = b === activeBtn;
        b.classList.toggle("border-primary-500", isActive);
        b.classList.toggle("bg-primary-500", isActive);
        b.classList.toggle("text-white", isActive);
        b.classList.toggle("border-gray-200", !isActive);
        b.classList.toggle("bg-white", !isActive);
        b.classList.toggle("text-gray-600", !isActive);
      });
  }

  document
    .querySelectorAll<HTMLButtonElement>(".nominal-chip")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        nominal = Number(btn.dataset.value);
        nominalInput.value = String(nominal);
        setChipActive(btn);
        syncNotes();
        syncSubmitLabel();
      });
    });

  nominalInput.addEventListener("input", () => {
    nominal = Number(nominalInput.value) || 0;
    setChipActive(null);
    syncNotes();
    syncSubmitLabel();
  });

  document
    .querySelectorAll<HTMLButtonElement>(".commitment-chip")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const value = Number(btn.dataset.value);
        if (!value) return;
        commitmentSelect.value = String(value);
        commitmentCustomRow.classList.add("hidden");
        commitmentCustomInput.value = "";
        setCommitmentChipActive(btn);
        syncSubmitLabel();
      });
    });

  commitmentCustomTrigger?.addEventListener("click", () => {
    commitmentCustomRow.classList.remove("hidden");
    setCommitmentChipActive(null);
    commitmentCustomInput.focus();
    syncSubmitLabel();
  });

  commitmentCustomInput?.addEventListener("input", () => {
    const customValue = Number(commitmentCustomInput.value);
    if (!Number.isFinite(customValue) || customValue <= 0) return;
    commitmentSelect.value = String(customValue);
    setCommitmentChipActive(null);
    syncSubmitLabel();
  });

  function setPaymentMode(commitment: boolean) {
    isCommitment = commitment;

    if (btnSaku) {
      btnSaku.classList.toggle("border-primary-500", !commitment);
      btnSaku.classList.toggle("bg-primary-100", !commitment);
      btnSaku.classList.toggle("text-primary-700", !commitment);
      btnSaku.classList.toggle("border-gray-200", commitment);
      btnSaku.classList.toggle("bg-white", commitment);
      btnSaku.classList.toggle("text-gray-400", commitment);
    }

    btnLangsung.classList.toggle("border-primary-500", commitment);
    btnLangsung.classList.toggle("bg-primary-100", commitment);
    btnLangsung.classList.toggle("text-primary-700", commitment);
    btnLangsung.classList.toggle("border-gray-200", !commitment);
    btnLangsung.classList.toggle("bg-white", !commitment);
    btnLangsung.classList.toggle("text-gray-400", !commitment);

    sakuInfo?.classList.toggle("hidden", commitment || !isAuth);
    sakuInfo?.classList.toggle("flex", !commitment && isAuth);
    paymentPicker.classList.toggle("hidden", !commitment);
    commitmentRow.classList.toggle("hidden", !commitment);

    if (commitment) {
      paymentSelected = false;
      paymentMethodId = "";
      paymentImg.src = "";
      paymentImg.classList.add("hidden");
      paymentNameEl.textContent = "Pilih metode pembayaran";
    }

    syncNotes();
    syncSubmitLabel();
    syncScheduleNote();
  }

  btnSaku?.addEventListener("click", () => setPaymentMode(false));
  btnLangsung.addEventListener("click", () => setPaymentMode(true));

  rangeTypeSelect?.addEventListener("change", () => {
    const v = rangeTypeSelect.value;
    weeklyRow.classList.toggle("hidden", v !== "weekly");
    monthlyRow.classList.toggle("hidden", v !== "monthly");
    hourlyRow.classList.toggle("hidden", v !== "hourly");
  });

  commitmentSelect?.addEventListener("change", syncSubmitLabel);

  openModalBtn?.addEventListener("click", () => {
    (window as any).openPaymentModal?.();
  });

  window.addEventListener("payment:selected", (e: Event) => {
    const { id, name, image } = (e as CustomEvent).detail;
    paymentMethodId = String(id);
    paymentSelected = true;
    paymentImg.src = image ?? "";
    paymentImg.classList.toggle("hidden", !image);
    paymentNameEl.textContent = name ?? "Pilih metode pembayaran";
  });

  btnSubmit.addEventListener("click", async () => {
    if (isProcessing) return;

    const guestName = guestNameInput?.value.trim() ?? "";
    const rawGuestPhone = guestPhoneInput?.value.trim() ?? "";
    const guestPhone = rawGuestPhone.startsWith("0")
      ? rawGuestPhone
      : rawGuestPhone
        ? `0${rawGuestPhone}`
        : "";

    if (!isAuth && (!guestName || !guestPhone)) {
      showToast("Nama dan nomor telepon wajib diisi", "error");
      return;
    }

    if (!isAuth && !isCommitment) {
      showToast("Silakan login untuk menggunakan Saku Kebaikan", "error");
      return;
    }

    if (nominal < 1000) {
      showToast("Minimal donasi Rp1.000", "error");
      return;
    }
    if (!isCommitment && nominal > walletBal) {
      showToast("Saldo Saku Berbagi tidak mencukupi", "error");
      return;
    }
    if (isCommitment && !paymentSelected) {
      showToast("Pilih metode pembayaran terlebih dahulu", "error");
      return;
    }

    isProcessing = true;
    btnSubmit.disabled = true;
    btnSubmit.textContent = "Memproses...";

    const time = `${hourSelect.value}:${minuteSelect.value}`;
    const range_type = rangeTypeSelect.value;

    const range =
      range_type === "weekly"
        ? (DAY_MAP[
            (document.getElementById("range-day-select") as HTMLSelectElement)
              ?.value
          ] ?? "Friday")
        : range_type === "monthly"
          ? ((document.getElementById("range-date-select") as HTMLSelectElement)
              ?.value ?? "1")
          : range_type === "hourly"
            ? ((
                document.getElementById(
                  "hour-interval-select",
                ) as HTMLSelectElement
              )?.value ?? "1")
            : "1";

    const atasNama = atasNamaInput?.value.trim();
    const doa = doaInput?.value.trim();

    const payload: Record<string, unknown> = {
      program_id: Number(programId),
      range_type,
      range,
      time,
      nominal,
      status: "Pending",
      ...(!isAuth ? { name: guestName, phone: guestPhone } : {}),
      ...(atasNama ? { atas_nama: atasNama } : {}),
      ...(doa ? { doa } : {}),
    };

    if (!isCommitment) {
      payload.dompet_kebaikan_store = walletBal;
      payload.payment_method_id = 3000;
      payload.type = "default";
    } else {
      payload.payment_method_id = Number(paymentMethodId);
      payload.commitment = getCommitmentValue();
      payload.type = "commitment";
    }

    try {
      const res = await fetch(`${API_URL}/rutin/store`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok)
        throw new Error(data?.message ?? "Gagal membuat donasi rutin");

      window.location.href = `/invoice/${data?.data?.invoice}`;
    } catch (err: unknown) {
      const msg =
        err instanceof Error ? err.message : "Terjadi kesalahan, coba lagi";
      showToast(msg, "error");
      isProcessing = false;
      btnSubmit.disabled = false;
      syncSubmitLabel();
    }
  });

  commitmentSelect.value = "3";
  syncNotes();
  syncSubmitLabel();
  syncScheduleNote();
</script>
