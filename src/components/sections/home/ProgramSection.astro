---
import type { Program } from "@/lib/home";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { fmt } from "@/lib/formatter";

interface Props {
  programs: Program[];
}

const { programs } = Astro.props;
---

<section class="mb-3 py-4 bg-white">
  <SectionTitle
    title="#BarenganJadiRingan"
    description="Pilih program yang sesuai dengan niat baikmu, dan mari wujudkan perubahan bersama."
  />

  <div
    id="program-scroll"
    class="flex gap-3 items-center overflow-x-auto px-4 h-70 md:h-80 snap-x"
    style="background-image: url('/images/jumat-berkah.jpg'); background-size: cover; background-position: center;"
  >
    <!-- spacer kiri agar slide pertama tidak menempel ke tepi -->
    <div class="shrink-0 w-32 md:w-48"></div>

    {
      programs.map((p, i) => {
        const pct = Math.min(
          Math.round(Number(p.progress_achieved) || 0),
          100,
        );
        return (
          <a
            href={`/donasi/${p.link}`}
            class="shrink-0 w-47.5 h-fit snap-start bg-white rounded-xl overflow-hidden border border-neutral-100 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col"
          >
            <div class="relative">
              <img
                src={p.image}
                alt={p.title}
                width="190"
                height="110"
                class="w-full h-26.25 object-cover"
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
              />
              {p.category?.name && (
                <span class="absolute top-2 right-2 text-[9px] font-bold bg-secondary-500 text-white px-2 py-0.5 rounded-full leading-none">
                  {p.category.name}
                </span>
              )}
            </div>
            <div class="p-3 flex flex-col flex-1">
              <p class="text-[11px] font-semibold text-neutral-700 line-clamp-2 min-h-9 leading-relaxed mb-2 flex-1">
                {p.title}
              </p>
              <div class="w-full h-1 bg-neutral-100 rounded-full overflow-hidden mb-1.5">
                <div
                  class="h-full bg-linear-to-r from-primary-400 to-primary-600 rounded-full"
                  style={`width:${pct}%`}
                />
              </div>
              <div class="flex items-center justify-between mb-2.5">
                <span class="text-[10px] font-bold text-primary-600">
                  Rp {fmt(Number(p.nominal_achieved))}
                </span>
                <span class="text-[10px] text-neutral-400">
                  {pct}% · {p.remaining_days ?? "∞"}
                </span>
              </div>
            </div>
          </a>
        );
      })
    }
  </div>
</section>

<script>
  (() => {
    const scrollEl = document.getElementById(
      "program-scroll",
    ) as HTMLElement | null;
    if (!scrollEl) return;

    scrollEl.addEventListener("scroll", () => {
      const opacity = Math.max(0, 1.5 - scrollEl.scrollLeft / 100);
      scrollEl.style.backgroundColor = `rgba(255,255,255,${1 - opacity})`;
      scrollEl.style.backgroundBlendMode = "lighten";
    });
  })();
</script>
