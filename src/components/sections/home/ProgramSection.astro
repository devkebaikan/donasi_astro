---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { getCampaignRamadhan } from "@/lib/FetchData";
import { fmt } from "@/lib/formatter";
import { Image } from "astro:assets";

const data = await getCampaignRamadhan();
const campaigns = data?.data ?? [];

---
<section
  id="program-section"
  class="mb-3 py-4 bg-white"
 
>
  <SectionTitle
    title="#BarenganJadiRingan"
    description="Pilih program yang sesuai dengan niat baikmu, dan mari wujudkan perubahan bersama."
  />

  <div id="program-scroll" class="flex gap-3 items-center overflow-x-auto px-4 h-[280px] md:h-[320px] snap-x "
   style="background-image: url('/images/jumat-berkah.jpg'); background-size: cover; background-position: center;">
    <!-- spacer kiri biar awal agak ke kanan -->
  <div class="shrink-0 w-32 md:w-48"></div>
  {campaigns.map((p : any, i : any) => {
  const pct = Math.min(Math.round(p.progress_achieved), 100);

  return (
    <a
      href={`/donasi/${p.link}`}
      class="shrink-0 w-[190px] h-fit snap-start bg-white rounded-xl overflow-hidden border border-neutral-100 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col"
    >
      <!-- Thumbnail -->
      <div class="relative">
        <Image
          src={p.image}
          alt={p.title}
          width="190"
          height="110"
          class="w-full h-[105px] object-cover"
          loading={i < 2 ? 'eager' : 'lazy'}
          decoding="async"
        />
       

        <!-- Optional: tipe badge -->
        {p.tipe?.name && (
          <span class="absolute top-2 right-2 text-[9px] font-bold bg-secondary-500 text-white px-2 py-0.5 rounded-full leading-none">
            {p.category?.name}
          </span>
        )}
      </div>

      <!-- Content -->
      <div class="p-3 flex flex-col flex-1">
        <p class="text-[11px] font-semibold text-neutral-700 line-clamp-2 leading-relaxed mb-2 flex-1">
          {p.title}
        </p>

        <!-- Progress bar -->
        <div class="w-full h-1 bg-neutral-100 rounded-full overflow-hidden mb-1.5">
          <div
            class="h-full bg-linear-to-r from-primary-400 to-primary-600 rounded-full"
            style={`width:${pct}%`}
          />
        </div>

        <!-- Info -->
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-[10px] font-bold text-primary-600">
            Rp {fmt(p.nominal_achieved)}
          </span>

          <span class="text-[10px] text-neutral-400">
            {pct}% · {p.remaining_days}
          </span>
        </div>

        <!-- Button -->
        <button
          class="hidden md:inline w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] text-white text-[11px] font-semibold py-1.5 rounded-lg transition-all duration-150"
          aria-label={`Donasi untuk ${p.title}`}
        >
          Donasi Sekarang
        </button>
      </div>
    </a>
  );
})}
  </div>
</section>

<script>
  const scrollEl = document.getElementById("program-scroll");

  if (scrollEl) {
    scrollEl.addEventListener("scroll", () => {
      const progress = scrollEl.scrollLeft;

      // semakin ke kanan → semakin hilang
      const opacity = Math.max(0, 1.5 - progress / 100);

      scrollEl.style.backgroundColor = `rgba(255,255,255,${1 - opacity})`;
      scrollEl.style.backgroundBlendMode = "lighten";
    });
  }
</script>