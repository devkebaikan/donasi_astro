---
import type { Program, ProgramCategory } from "@/lib/home";
import { storageImg } from "@/lib/home";
import CampaignList from "@/components/ui/CampaignList.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";

interface Props {
  programs: Program[];
  categories: ProgramCategory[];
}

const { programs, categories } = Astro.props;

const activeCategories = categories.filter((c) => c.is_active === "1");
---

<section class="pt-4 pb-8 bg-white space-y-2 px-2">
  <SectionTitle title="Pilih Program Favoritmu" />

  <!-- Category icons -->
  {
    activeCategories.length > 0 && (
      <div class="h-32 flex gap-2.5 overflow-x-auto py-2 scrollbar-none">
        {activeCategories.map((cat) => {
          const imgSrc =
            cat.image_url && /^https?:\/\//.test(cat.image_url)
              ? cat.image_url
              : storageImg(cat.image || cat.image_url, "kategori");
          return (
            <a
              href={`/donasi?kategori=${cat.slug}`}
              class="flex flex-col items-center gap-1 w-18 shrink-0"
            >
              <div class="w-18 h-18 rounded-full border border-gray-300 hover:border-secondary-500 transition-colors duration-200 overflow-hidden">
                <img
                  src={imgSrc}
                  alt={cat.name}
                  width="72"
                  height="72"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="text-xs text-neutral-500 text-center leading-tight line-clamp-2 w-full">
                {cat.name}
              </p>
            </a>
          );
        })}
      </div>
    )
  }

  <!-- Campaign list -->
  {
    programs.map((p) => (
      <CampaignList
        link={`/donasi/${p.link}`}
        title={p.title}
        image={p.image}
        mitra={p.mitra?.name ?? ""}
        category={p.category?.name ?? ""}
        progress_achieved={Number(p.progress_achieved) || 0}
        collected_amount={Number(p.nominal_achieved) || 0}
        days_left={p.time_target}
      />
    ))
  }

  <a
    href="/donasi"
    class="mx-auto px-4 py-2 text-xs md:text-sm bg-linear-to-b rounded-md from-secondary-400 to-secondary-500 text-white font-medium hover:from-secondary-500 hover:to-secondary-600 transition-colors duration-200 block w-max"
  >
    Lihat program lainnya
  </a>
</section>
