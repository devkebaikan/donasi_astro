---

<!-- Program List -->
<section class="pt-4 pb-8 bg-white space-y-2 px-2">
  <SectionTitle title="Pilih Program Favoritmu" />

  <div class="h-32 flex gap-2.5 space-x-4 overflow-x-auto py-2">
    {
      kategori.map((kategori) => (
        <div class="flex flex-col items-center gap-1 w-18">
          <div class="flex-shrink-0 w-18 h-18 rounded-full border border-gray-300 hover:border-secondary-500 transition-colors duration-200">
            <Image
              src={kategori.image}
              alt={kategori.name}
              width={80}
              height={60}
              class="w-full h-full object-cover"
            />
          </div>
          <p class="text-xs md:text-sm text-neutral-500">{kategori.name}</p>
        </div>
      ))
    }
  </div>

  {
    campaign.map((campaign) => (
      <CampaignList
        link={`/donasi/${campaign.link}`}
        title={campaign.title}
        image={campaign.image}
        mitra={campaign.mitra.name}
        category={campaign.category.name}
        progress_achieved={campaign.progress_achieved}
        collected_amount={campaign.nominal_achieved}
        days_left={campaign.time_target}
      />
    ))
  }

  <a
    href="/donasi"
    class="mx-auto px-4 py-2 text-xs md:text-sm bg-linear-to-b rounded-md from-secondary-400 to-secondary-500 text-white font-medium hover:from-secondary-500 hover:to-secondary-600 transition-colors duration-200 block w-max"
  >
    Lihat program lainnya</a
  >
</section>
