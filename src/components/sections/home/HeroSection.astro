---
import { Image } from "astro:assets";

const banners = [
  {
    src: "/images/banner/banner-qurban.avif",
    alt: "Qurban Pelosok Nusantara",
    href: "/donasi/qurban",
  },
  {
    src: "/images/ramadhan/ramadhan-1.webp",
    alt: "Program Sedekah Rutin",
    href: "/donasi-rutin",
  },
];
---

<section class="bg-white">
  <!-- Banner Slider -->
  <div class="relative overflow-hidden">
    <div
      id="banner-track"
      class="flex will-change-transform"
      style="transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);"
    >
      {
        banners.map((banner, i) => (
          <a href={banner.href} class="w-full shrink-0 block">
            <Image
              src={banner.src}
              alt={banner.alt}
              width="480"
              height="240"
              class="w-full h-auto block"
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              decoding={i === 0 ? "sync" : "async"}
            />
          </a>
        ))
      }
    </div>

    <!-- Dot indicators -->
    <div
      class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-10 pointer-events-none"
    >
      {
        banners.map((_, i) => (
          <span
            class="banner-dot block h-1.5 rounded-full bg-white transition-all duration-300"
            data-index={i}
            style={
              i === 0
                ? "width: 1rem; opacity: 1;"
                : "width: 0.375rem; opacity: 0.45;"
            }
          />
        ))
      }
    </div>
  </div>

  <!-- Wallet / Saldo Card -->
  <div
    id="data-wallet"
    data-api-url={import.meta.env.ASTRO_API_URL}
    class="relative -mt-5 mx-4 pb-3 z-10"
  >
    <div
      class="bg-white rounded-xl px-4 py-3 flex items-center gap-3 shadow-md border border-neutral-100"
    >
      <div
        class="w-9 h-9 rounded-full bg-primary-50 flex items-center justify-center shrink-0"
      >
        <svg
          class="w-5 h-5 text-primary-600"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"
          ></path>
        </svg>
      </div>

      <!-- Saldo info: ditampilkan/disembunyikan oleh script -->
      <div class="flex-1 min-w-0">
        <p class="text-[11px] text-neutral-400 leading-none mb-0.5">
          Saldo Kebaikan
        </p>
        <p id="saldo-wrapper" class="text-sm font-bold text-neutral-700 hidden">
          Rp <span id="saldo-display">0</span>
        </p>
        <p id="saldo-guest" class="text-sm font-medium text-neutral-400">
          *******
        </p>
      </div>

      <!-- Tombol: skeleton dulu, diganti script setelah tahu status login -->
      <div id="wallet-action" class="shrink-0">
        <div class="w-16 h-8 bg-neutral-100 rounded-lg animate-pulse"></div>
      </div>
    </div>
  </div>
  <!-- <ShowJsonData data={donors} /> -->
</section>

<script>
  import { getToken, isLoggedIn, bearerHeaders } from "@/lib/auth";

  (() => {
    const track = document.getElementById("banner-track") as HTMLElement | null;
    const dots = document.querySelectorAll<HTMLElement>(".banner-dot");
    const wallet = document.getElementById("data-wallet") as HTMLElement | null;
    const walletAction = document.getElementById(
      "wallet-action",
    ) as HTMLElement | null;
    const saldoWrapper = document.getElementById(
      "saldo-wrapper",
    ) as HTMLElement | null;
    const saldoDisplay = document.getElementById(
      "saldo-display",
    ) as HTMLElement | null;
    const saldoGuest = document.getElementById(
      "saldo-guest",
    ) as HTMLElement | null;

    const API_URL = wallet?.dataset.apiUrl ?? "";

    // ── Banner slider ─────────────────────────────────────────────────────────
    const total = dots.length;
    if (track && total >= 2) {
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function slideTo(idx: number) {
        current = ((idx % total) + total) % total;
        track!.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => {
          d.style.width = i === current ? "1rem" : "0.375rem";
          d.style.opacity = i === current ? "1" : "0.45";
        });
      }

      function startTimer() {
        timer = setInterval(() => slideTo(current + 1), 3800);
      }

      slideTo(0);
      startTimer();

      let startX = 0;
      track.addEventListener(
        "touchstart",
        (e) => {
          startX = e.touches[0].clientX;
        },
        { passive: true },
      );
      track.addEventListener(
        "touchend",
        (e) => {
          const diff = startX - e.changedTouches[0].clientX;
          if (Math.abs(diff) > 40) {
            clearInterval(timer);
            slideTo(diff > 0 ? current + 1 : current - 1);
            startTimer();
          }
        },
        { passive: true },
      );
    }

    // ── Wallet card ───────────────────────────────────────────────────────────
    const loggedIn = isLoggedIn();
    const token = getToken();

    // Render tombol yang tepat
    if (walletAction) {
      walletAction.innerHTML = loggedIn
        ? `<a href="/top-up" class="shrink-0 bg-primary-500 hover:bg-primary-600 active:scale-95 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-all duration-150">Top Up</a>`
        : `<a href="/auth/login" class="shrink-0 bg-primary-500 hover:bg-primary-600 active:scale-95 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-all duration-150">Masuk</a>`;
    }

    if (!loggedIn || !token) {
      // Tampilkan teks guest, sembunyikan saldo
      saldoGuest?.classList.remove("hidden");
      saldoWrapper?.classList.add("hidden");
      return;
    }

    // User login: tampilkan saldo
    saldoGuest?.classList.add("hidden");
    saldoWrapper?.classList.remove("hidden");

    // Tampilkan cache dulu agar tidak blank
    const cached = localStorage.getItem("saldo");
    if (saldoDisplay && cached) {
      saldoDisplay.textContent = Number(cached).toLocaleString("id-ID");
    }

    // Fetch saldo terbaru
    async function fetchSaldo() {
      try {
        const res = await fetch(`${API_URL}/dashboard/my-account`, {
          headers: bearerHeaders(token!),
        });

        if (!res.ok) throw new Error("Gagal fetch saldo");

        const data = await res.json();
        const saldo = Number(data?.data?.dompet_kebaikan.saldo ?? 0);

        if (saldoDisplay) {
          saldoDisplay.textContent = saldo.toLocaleString("id-ID");
        }

        localStorage.setItem("saldo", String(saldo));
      } catch {
        // Tetap tampilkan cache jika ada
      }
    }

    fetchSaldo();
  })();
</script>
