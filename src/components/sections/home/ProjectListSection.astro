---
import type { ProjectItem } from "@/lib/home";
import { stripHtml } from "@/lib/home";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import { formatDate } from "@/lib/formatter";

interface Props {
  projectList: ProjectItem[];
}

const { projectList } = Astro.props;

function activityLabel(item: ProjectItem): string {
  if (item.activity === "selesai") return "Selesai";
  if (item.activity === "berjalan") return "Proses";
  return item.reason ?? item.status ?? "";
}
---

<section class="mb-3 py-4 bg-white space-y-2 px-2">
  <SectionTitle
    title="#BarenganTebarBahagia"
    description="Satu niat baik hari ini, jadi alasan senyum mereka sepanjang hari."
  />

  {
    projectList.map((r) => {
      const summary = stripHtml(r.description).slice(0, 120);
      const date = r.excecution_time ? formatDate(r.excecution_time) : "";
      const label = activityLabel(r);

      return (
        <div class="flex gap-3 bg-white border border-gray-100 rounded-xl overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200 cursor-pointer">
          <div class="shrink-0 w-36 overflow-hidden bg-gray-100 m-2.5 rounded-lg">
            <img
              src={r.image}
              alt={r.title}
              width="90"
              height="90"
              class="object-cover w-full h-full"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex-1 py-3 pr-3 min-w-0">
            <div class="flex items-center gap-1.5 mb-1">
              <span class="text-[9px] font-bold px-2 py-0.5 rounded-full leading-none bg-secondary-100 text-secondary-600">
                {label}
              </span>
              <span class="text-[10px] text-gray-400">{date}</span>
            </div>
            <p class="text-[12px] font-semibold text-gray-800 leading-snug line-clamp-2 mb-1">
              {r.title}
            </p>
            <p class="text-[11px] text-gray-400 truncate leading-relaxed">
              {summary}
            </p>
          </div>
        </div>
      );
    })
  }
</section>
