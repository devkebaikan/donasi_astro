---

---

<section id="install-app" class="py-16 bg-cream">
  <div class="container-custom">
    <div
      class="relative overflow-hidden rounded-3xl bg-linear-to-br from-primary-800 via-primary-700 to-primary-600 px-6 md:px-12 py-12 md:py-14"
      data-reveal
    >
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern
              id="app-grid"
              width="28"
              height="28"
              patternUnits="userSpaceOnUse"
            >
              <circle cx="2" cy="2" r="1.5" fill="white"></circle>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#app-grid)"></rect>
        </svg>
      </div>
      <div
        class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-primary-300/20 blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-20 -left-16 w-72 h-72 rounded-full bg-primary-200/20 blur-3xl pointer-events-none"
      >
      </div>

      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div class="text-white text-center md:text-left" data-reveal="left">
          <h3
            class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-4"
          >
            Kebaikan di Ujung Jari,
            <br class="hidden md:block" />
            Kapan Saja & Di Mana Saja
          </h3>
          <p
            class="text-white/80 text-sm md:text-base leading-relaxed mb-7 max-w-xl"
          >
            Install aplikasi Beramalbersama untuk donasi lebih cepat, pantau
            penyaluran secara real-time, dan bangun kebiasaan berbagi setiap
            hari.
          </p>

          <div
            class="flex flex-wrap items-center justify-center md:justify-start gap-3"
          >
            <a
              href="/aplikasi"
              class="block rounded-lg overflow-hidden ring-1 ring-white/20 hover:opacity-90 transition-opacity"
            >
              <img
                src="/images/app/googleplay.jpg"
                alt="Unduh di Google Play"
                class="h-12 md:h-14"
                loading="lazy"
              />
            </a>
            <a
              href="/aplikasi"
              class="block rounded-lg overflow-hidden ring-1 ring-white/20 hover:opacity-90 transition-opacity"
            >
              <img
                src="/images/app/appstore.jpg"
                alt="Unduh di App Store"
                class="h-12 md:h-14"
                loading="lazy"
              />
            </a>
          </div>

          <a
            href="/aplikasi"
            class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-primary-100 hover:text-white transition-colors"
          >
            Lihat detail aplikasi
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>

        <div
          class="relative flex justify-center md:justify-end"
          data-reveal="right"
        >
          <img
            src="/images/app/home-rumah-zakat-app.png"
            alt="Tampilan aplikasi Beramalbersama"
            class="w-56 md:w-72 h-auto drop-shadow-2xl"
            loading="lazy"
          />

          <div
            class="absolute top-6 -left-1 md:left-auto md:-right-6 rounded-2xl border border-white/30 bg-white/90 px-4 py-3 text-primary-800 shadow-card animate-float"
          >
            <p class="text-xs font-semibold">⭐ 4.9/5 Rating</p>
            <p class="text-[11px] text-primary-600">Dari pengguna aktif</p>
          </div>

          <!-- <div
            class="absolute bottom-6 -right-1 md:-left-8 rounded-2xl border border-white/20 bg-primary-50 px-4 py-3 text-primary-800 shadow-card animate-float"
            style="animation-delay: 1.1s;"
          >
            <p class="font-display text-lg font-bold leading-none">500rb+</p>
            <p class="text-[11px] text-primary-600 mt-1">Total unduhan</p>
          </div> -->
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 },
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
    window.__revealObserver!.observe(el);
  });
</script>
