---
const hubItems = [
  {
    title: "Cerita",
    subtitle: "Inspirasi",
    description: "Kisah nyata penerima manfaat yang mengubah sudut pandangmu",
    image: "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=500&h=600&fit=crop",
    href: "/story",
  },
  {
    title: "Program",
    subtitle: "Pilihan",
    description: "Temukan program donasi yang paling sesuai dengan niatmu",
    image: "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=500&h=600&fit=crop",
    href: "/donasi",
    illustration: "paper-planes",
  },
  {
    title: "Laporan",
    subtitle: "Transparansi",
    description: "Pantau bagaimana donasimu dikelola secara terbuka",
    image: "https://images.unsplash.com/photo-1593113598332-cd288d649433?w=500&h=600&fit=crop",
    href: "/tentang",
    illustration: "book",
  },
];
---

<section id="knowledge" class="py-20 bg-white">
  <div class="container-custom">
    <!-- Heading -->
    <div class="text-center max-w-3xl mx-auto mb-12" data-reveal>
      <span class="section-label">Lebih Dekat dengan Kami</span>
      <h2
        class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-primary-900 leading-tight mt-2 mb-4"
      >
        Ilmu & Inspirasi untuk
        <br class="hidden md:block" />
        Mendorong Aksi Nyata
      </h2>
      <p class="text-primary-700/80 text-sm md:text-base leading-relaxed">
        Data, kisah, dan pengalaman komunitas yang menginspirasimu untuk
        berbuat lebih — karena kebaikan dimulai dari pemahaman.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {hubItems.map((item, i) => (
        <a
          href={item.href}
          class="relative aspect-[3/4] rounded-3xl overflow-hidden shadow-card hover:shadow-xl transition-all duration-200 hover:-translate-y-1.5 group bg-primary-100"
          data-reveal
          style={`transition-delay:${i * 0.1}s`}
        >
          <!-- Background image -->
          <img
            src={item.image}
            alt={item.title}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-600"
            loading="lazy"
          />
          <!-- Tinted overlay -->
          <div class="absolute inset-0 bg-linear-to-b from-primary-200/50 via-primary-300/30 to-primary-800/85 mix-blend-multiply"></div>
          <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-primary-900/60"></div>

          <!-- Decorative icon -->
          {item.illustration === "paper-planes" && (
            <div class="absolute top-6 right-6 text-white/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
              </svg>
            </div>
          )}
          {item.illustration === "book" && (
            <div class="absolute top-6 right-6 text-white/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1z"/>
              </svg>
            </div>
          )}

          <!-- Content at bottom -->
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="text-primary-200 text-xs mb-1">{item.description}</p>
            <div class="flex items-end justify-between">
              <h3 class="font-display text-3xl md:text-4xl font-bold text-white drop-shadow-lg leading-tight">
                {item.title}
                <br />
                <span class="text-primary-200">{item.subtitle}</span>
              </h3>
              <div class="w-11 h-11 rounded-full bg-white flex items-center justify-center shrink-0 group-hover:bg-primary-50 transition-colors shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary-800 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 }
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
    window.__revealObserver!.observe(el);
  });
</script>
