---
// CTA Dukung Kami — Beramalbersama
---

<section id="engage" class="py-16">
  <div class="container-custom">
    <div
      class="relative rounded-3xl overflow-hidden bg-linear-to-br from-primary-800 via-primary-700 to-primary-600 px-6 md:px-14 py-14 md:py-18"
      data-reveal
    >
      <!-- Background pattern dots -->
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.5" fill="white" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#dots)" />
        </svg>
      </div>
      <!-- Blob glow -->
      <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-primary-400/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -left-20 w-72 h-72 rounded-full bg-primary-300/20 blur-3xl pointer-events-none"></div>

      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <!-- Left: Image -->
        <div class="relative" data-reveal="left">
          <div class="aspect-square max-w-xs mx-auto rounded-2xl overflow-hidden shadow-2xl ring-4 ring-white/20">
            <img
              src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=500&h=500&fit=crop"
              alt="Penerima manfaat"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Floating stat -->
          <div class="absolute -bottom-4 -right-2 md:right-4 bg-white rounded-2xl px-4 py-3 shadow-card animate-float">
            <p class="text-xs font-semibold text-primary-700">Sudah tersalurkan</p>
            <p class="font-display text-xl font-bold text-primary-900">Rp 10 Miliar+</p>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="text-white text-center md:text-left" data-reveal="right">
          <span class="inline-block text-sm font-medium underline underline-offset-4 decoration-white/50 mb-3">
            Dukung Kami
          </span>
          <h2
            class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-4"
          >
            Jadikan Hidupmu
            <br />
            Lebih Bermakna.
          </h2>
          <p class="text-white/75 text-sm md:text-base leading-relaxed mb-8">
            Setiap rupiah yang kamu titipkan kepada kami adalah amanah yang kami
            jaga dengan sepenuh hati — transparan, tepat sasaran, dan penuh
            pertanggungjawaban.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
            <a
              href="/donasi"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-primary-800 rounded-full font-semibold hover:bg-primary-50 transition-colors group shadow-sm"
            >
              <span>Mulai Berdonasi</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transition-transform group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="/mitra"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border-2 border-white/40 text-white rounded-full font-medium hover:bg-white/10 transition-colors"
            >
              Jadi Mitra
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 }
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
    window.__revealObserver!.observe(el);
  });
</script>
