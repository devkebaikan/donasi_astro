---
// Hero section — Beramalbersama landing page
---

<section id="home" class="relative pt-10 pb-20 overflow-hidden bg-white">
  <!-- Soft background blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -top-20 -right-20 w-96 h-96 rounded-full bg-primary-100/60 blur-3xl"
    >
    </div>
    <div
      class="absolute top-40 -left-24 w-72 h-72 rounded-full bg-primary-50/80 blur-3xl"
    >
    </div>
  </div>

  <div class="container-custom relative">
    <!-- Heading -->
    <div class="text-center max-w-4xl mx-auto mb-10" data-reveal>
      <span class="section-label">Platform Donasi</span>
      <h1
        class="font-display text-4xl md:text-5xl lg:text-6xl font-semibold text-primary-900 leading-tight mt-2"
      >
        Setiap Kebaikan
        <span class="relative inline-block">
          <span class="relative z-10 text-primary-600">Mengubah</span>
          <span
            class="absolute bottom-1 left-0 w-full h-3 bg-primary-100 rounded-full -z-0"
          ></span>
        </span>
        Satu Kehidupan
      </h1>
    </div>

    <!-- Image Collage Area -->
    <div
      class="mx-0 md:mx-24 h-fit flex flex-col md:flex-row gap-16 md:gap-4"
      data-reveal="scale"
    >
      <div class="relative">
        <!-- Left image -->
        <div
          class="mt-0 md:mt-32 w-full md:w-[500px] h-[320px] md:h-[340px] rounded-2xl overflow-hidden shadow-card"
        >
          <img
            src="/images/banner/banner-qurban.avif"
            alt="Program Beramalbersama"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
        </div>

        <!-- Floating badge: donatur -->
        <div
          class="absolute mt-2 md:top-4 right-0 bg-primary-700 text-white rounded-xl px-5 py-3.5 shadow-card max-w-[200px] flex items-center gap-2"
        >
          <p class="text-sm md:text-lg leading-snug font-medium text-end">
            100+ program aktif
          </p>
          <a href="/donasi" class="flex justify-end">
            <div
              class="w-fit p-2 rounded-full border border-white/30 bg-white/20 text-white text-xs font-semibold mt-1 hover:bg-white/30 transition-colors flex items-center gap-1 group"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </div>
          </a>
        </div>
        <!-- Floating badge: program -->
        <div
          class="absolute -bottom-12 left-0 md:-left-8 bg-primary-50 rounded-2xl px-4 py-3 shadow-card max-w-[250px] border border-primary-100 animate-float"
          style="animation-delay: 2s;"
        >
          <p class="text-xs font-semibold text-primary-700">
            Sudah tersalurkan
          </p>
          <p class="font-display text-xl font-bold text-primary-900">
            Rp 10 Miliar+
          </p>
        </div>
      </div>

      <!-- Right image -->
      <div class="relative mt-16 md:mt-0">
        <div
          class="w-full md:w-[500px] h-[320px] md:h-[340px] rounded-2xl overflow-hidden shadow-card"
        >
          <img
            src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=700&h=560&fit=crop"
            alt="Penerima Manfaat"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
        </div>

        <!-- Floating quote: penerima -->
        <div
          class="absolute -top-2 right-[4%] md:right-[6%] bg-white rounded-2xl px-4 py-3 shadow-card max-w-[230px] border border-primary-100 animate-float"
          style="animation-delay: 1.2s;"
        >
          <div class="flex items-start gap-2">
            <span class="text-primary-400 text-2xl leading-none font-display"
              >"</span
            >
            <p class="text-xs md:text-sm text-primary-900 italic leading-snug">
              Alhamdulillah, bantuan datang tepat saat kami butuhkan
            </p>
          </div>
        </div>

        <!-- Floating badge: transparansi -->
        <div
          class="absolute -bottom-3 md:bottom-16 right-3 bg-primary-50 rounded-2xl px-4 py-3 shadow-card max-w-[200px] border border-primary-100 animate-float"
          style="animation-delay: 1.6s;"
        >
          <p
            class="text-xs md:text-sm font-semibold text-primary-900 leading-snug"
          >
            ✅ 100% Transparan & Amanah
          </p>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10"
      data-reveal
    >
      <a href="/donasi" class="btn-primary group">
        <span>Lihat Semua Program</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <a href="/story" class="btn-outline group text-sm">
        <span>Cerita Inspirasi</span>
      </a>
    </div>
  </div>
</section>

<script>
  declare global {
    interface Window {
      __revealObserver?: IntersectionObserver;
    }
  }

  // Scroll reveal observer (shared, only runs once)
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 },
    );
  }
  document.querySelectorAll("[data-reveal]").forEach((el, i) => {
    (el as HTMLElement).style.transitionDelay = `${i * 0.08}s`;
    window.__revealObserver!.observe(el);
  });
</script>
