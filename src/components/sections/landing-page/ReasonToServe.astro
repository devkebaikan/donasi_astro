---
// Mengapa Kami Melayani — Beramalbersama
---

<section class="py-20 bg-white">
  <div class="container-custom">
    <!-- Heading -->
    <div class="text-center max-w-3xl mx-auto mb-14" data-reveal>
      <span class="section-label">Mengapa Kami Hadir</span>
      <h2
        class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-primary-900 leading-tight mt-2 mb-4"
      >
        Setiap Cerita Mendorong Kami untuk
        <br class="hidden md:block" />
        Terus Bergerak & Berbuat Lebih
      </h2>
      <p class="text-primary-700/80 text-sm md:text-base leading-relaxed">
        Dari piring kosong hingga rumah yang aman, dari ketidakpastian menuju harapan —
        <br class="hidden md:block" />
        setiap penderitaan manusia menjadi bahan bakar semangat kami.
      </p>
    </div>

    <!-- Stats Grid -->
    <div
      class="relative max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-center"
    >
      <!-- Left: Anak Yatim -->
      <div class="relative" data-reveal="left">
        <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-card">
          <img
            src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=400&h=500&fit=crop"
            alt="Anak yatim"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-900/40 to-transparent"></div>
        </div>
        <div
          class="absolute -bottom-5 -left-2 md:-left-5 bg-white rounded-2xl px-4 py-3 shadow-card border border-primary-100"
        >
          <p class="font-display text-2xl md:text-3xl font-bold text-primary-800">4,5 Juta</p>
          <p class="text-xs text-primary-600 mt-0.5">Anak Yatim di Indonesia</p>
        </div>
      </div>

      <!-- Center: Fakir Miskin (largest) -->
      <div class="relative md:scale-105 z-10" data-reveal>
        <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-card">
          <img
            src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=500&h=700&fit=crop"
            alt="Keluarga tidak mampu"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-900/40 to-transparent"></div>
        </div>
        <div
          class="absolute -top-5 left-1/2 -translate-x-1/2 bg-primary-600 text-white rounded-2xl px-4 py-3 shadow-card whitespace-nowrap"
        >
          <p class="font-display text-2xl md:text-3xl font-bold">25 Juta</p>
          <p class="text-xs text-primary-100 text-center mt-0.5">Warga Miskin Ekstrem</p>
        </div>
        <div
          class="absolute -bottom-5 left-1/2 -translate-x-1/2 bg-white rounded-2xl px-4 py-3 shadow-card border border-primary-100 whitespace-nowrap"
        >
          <p class="font-display text-2xl md:text-3xl font-bold text-primary-800">8,5 Juta</p>
          <p class="text-xs text-primary-600 text-center mt-0.5">Anak Kurang Gizi</p>
        </div>
      </div>

      <!-- Right: Dhuafa -->
      <div class="relative" data-reveal="right">
        <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-card">
          <img
            src="https://images.unsplash.com/photo-1593113598332-cd288d649433?w=400&h=500&fit=crop"
            alt="Keluarga dhuafa"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-900/40 to-transparent"></div>
        </div>
        <div
          class="absolute -top-5 -right-2 md:-right-5 bg-white rounded-2xl px-4 py-3 shadow-card border border-primary-100"
        >
          <p class="font-display text-2xl md:text-3xl font-bold text-primary-800">12 Juta</p>
          <p class="text-xs text-primary-600 mt-0.5">Keluarga Dhuafa</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 }
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
    window.__revealObserver!.observe(el);
  });
</script>
