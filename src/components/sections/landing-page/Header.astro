---
const pathname = Astro.url.pathname;

const navItems = [
  { name: "Beranda", href: "/" },
  { name: "Cerita", href: "/story" },
  { name: "Mitra", href: "/mitra" },
  { name: "Tentang", href: "/tentang" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header
  class="sticky px-4 md:px-8 top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-primary-100"
>
  <div class="container-custom">
    <div class="flex items-center justify-between h-18">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <img
          src="/images/logo-akber-green.webp"
          alt="Beramalbersama"
          class="w-fit h-9 object-contain"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-7">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`text-sm font-medium transition-colors relative group ${
                isActive(item.href)
                  ? "text-primary-700"
                  : "text-neutral-700 hover:text-primary-700"
              }`}
            >
              {item.name}
              <span
                class={`absolute -bottom-1 left-0 h-0.5 bg-primary-500 rounded-full transition-all duration-300 ${
                  isActive(item.href) ? "w-full" : "w-0 group-hover:w-full"
                }`}
              />
            </a>
          ))
        }
      </nav>

      <!-- CTA Button -->
      <div class="flex items-center gap-3">
        <a
          href="/donasi"
          class="hidden sm:inline-flex btn-primary text-sm py-2 px-5 rounded-full"
        >
          Donasi Sekarang
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-primary-800 rounded-lg hover:bg-primary-50 transition-colors"
          aria-label="Buka menu"
        >
          <svg
            id="icon-open"
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="lg:hidden hidden pb-5 border-t border-primary-100 pt-4"
    >
      <nav class="flex flex-col gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`text-sm font-medium py-2.5 px-3 rounded-lg transition-colors ${
                isActive(item.href)
                  ? "text-primary-700 bg-primary-50"
                  : "text-neutral-700 hover:text-primary-700 hover:bg-primary-50"
              }`}
            >
              {item.name}
            </a>
          ))
        }
        <a
          href="/donasi"
          class="mt-3 w-full bg-primary-600 hover:bg-primary-700 px-4 py-3 text-white rounded-full text-sm text-center font-medium transition-colors"
        >
          Donasi Sekarang
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden", !isHidden);
    iconClose?.classList.toggle("hidden", isHidden ?? true);
  });
</script>
