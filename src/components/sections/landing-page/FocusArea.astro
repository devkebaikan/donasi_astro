---
const focusAreas = [
  {
    title: "Relawan & Jaringan Kolaborasi",
    description:
      "Relawan, komunitas, dan mitra bergerak bersama membangun dampak yang lebih luas dan berkelanjutan.",
    icon: "🤝",
    image:
      "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=600&h=400&fit=crop",
  },
  {
    title: "Jaringan Penggerak Kebaikan",
    description:
      "Menghubungkan donatur, tim, relawan, dan pengelola manfaat dalam satu ekosistem kebaikan yang aktif.",
    icon: "🌐",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&h=400&fit=crop",
  },
  {
    title: "Teknologi & Inovasi",
    description:
      "Kami menghadirkan fitur layanan dan inovasi digital agar proses beramal lebih mudah, cepat, dan tepat.",
    icon: "💡",
    image:
      "https://images.unsplash.com/photo-1593113598332-cd288d649433?w=600&h=400&fit=crop",
  },
  {
    title: "Kecepatan, Ketepatan & Tracking",
    description:
      "Setiap program dipantau dengan alur kerja yang terukur agar laporan, penyaluran, dan dampak dapat dilihat secara transparan.",
    icon: "📍",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=600&h=400&fit=crop",
  },
];
---

<section class="py-20 bg-cream">
  <div class="container-custom">
    <!-- Heading -->
    <div class="text-center max-w-3xl mx-auto mb-14" data-reveal>
      <span class="section-label">Area Fokus Kami</span>
      <h2
        class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-primary-900 leading-tight mt-2 mb-4"
      >
        Bagaimana Kami Bekerja
      </h2>
      <p class="text-primary-700/80 text-sm md:text-base leading-relaxed">
        Kami percaya, dengan mengkolaborasikan setiap potensi, kita bisa
        menggerakkan dan mewujudkan ekosistem kebaikan yang lebih baik.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {
        focusAreas.map((area, i) => (
          <article
            class="bg-white rounded-2xl overflow-hidden shadow-card hover:shadow-lg transition-all duration-300 hover:-translate-y-1 group"
            data-reveal={i % 2 === 0 ? "left" : "right"}
          >
            <div class="aspect-video overflow-hidden relative">
              <img
                src={area.image}
                alt={area.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-primary-900/30 to-transparent" />
              <span class="absolute bottom-3 left-4 text-3xl">{area.icon}</span>
            </div>
            <div class="p-6">
              <h3 class="font-display text-lg md:text-xl font-semibold text-primary-900 mb-2">
                {area.title}
              </h3>
              <p class="text-sm text-primary-700/80 leading-relaxed">
                {area.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 },
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
    window.__revealObserver!.observe(el);
  });
</script>
