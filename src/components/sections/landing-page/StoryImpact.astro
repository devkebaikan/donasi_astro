---
const impactStories = [
  {
    name: "Sumber Air Bersih",
    location: "Program Infrastruktur Manfaat",
    quote:
      "Setiap langkah kebaikan menghadirkan akses air bersih untuk keluarga yang sebelumnya kesulitan memenuhi kebutuhan harian.",
    image:
      "https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?w=700&h=500&fit=crop",
    stats: [
      { value: "3.200+", label: "Penerima manfaat" },
      { value: "120", label: "Titik distribusi" },
    ],
  },
  {
    name: "Makanan",
    location: "Program Pangan Berkelanjutan",
    quote:
      "Kolaborasi donatur, tim, dan relawan memastikan bantuan pangan tersalurkan lebih cepat dan tepat sasaran.",
    image:
      "https://images.unsplash.com/photo-1593113598332-cd288d649433?w=700&h=500&fit=crop",
    stats: [
      { value: "1.480+", label: "Paket pangan tersalur" },
      { value: "86%", label: "Tepat sasaran" },
    ],
  },
  {
    name: "Project Kemanfaatan",
    location: "Kolaborasi Donatur · Tim · Relawan",
    quote:
      "Dari aksi kecil yang konsisten, lahir dampak besar yang bisa dilihat langsung lewat data, cerita, dan pelaporan berkala.",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=700&h=500&fit=crop",
    stats: [
      { value: "24 Jam", label: "Respon awal penyaluran" },
      { value: "9.700+", label: "Keluarga terbantu" },
    ],
  },
];
---

<section id="story-impact" class="py-20 bg-white">
  <div class="container-custom">
    <div class="text-center max-w-3xl mx-auto mb-12" data-reveal>
      <span class="section-label">Story Impact</span>
      <p class="text-primary-700/80 text-sm md:text-base leading-relaxed">
        Setiap langkah menggerakkan ribuan kebaikan. Dampak nyata kami hadir
        melalui cerita lapangan, visual program, dan angka yang terukur.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {
        impactStories.map((story, i) => (
          <article
            class="rounded-3xl overflow-hidden border border-primary-100 bg-cream shadow-card hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
            data-reveal
            style={`transition-delay:${i * 0.08}s`}
          >
            <div class="relative aspect-4/3 overflow-hidden">
              <img
                src={story.image}
                alt={`Cerita dampak ${story.name}`}
                class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-linear-to-t from-primary-900/55 via-primary-900/10 to-transparent" />
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <p class="font-display text-lg font-semibold leading-tight">
                  {story.name}
                </p>
                <p class="text-xs text-primary-100/90 mt-0.5">
                  {story.location}
                </p>
              </div>
            </div>

            <div class="p-6">
              <p class="text-sm text-primary-700/85 leading-relaxed italic">
                “{story.quote}”
              </p>

              <div class="mt-5 grid grid-cols-2 gap-3">
                {story.stats.map((stat) => (
                  <div class="rounded-xl bg-white border border-primary-100 px-3 py-3">
                    <p class="font-display text-lg font-bold text-primary-800 leading-none">
                      {stat.value}
                    </p>
                    <p class="text-[11px] text-primary-600 mt-1 leading-snug">
                      {stat.label}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="text-center mt-10" data-reveal>
      <a
        href="/story"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary-700 text-white hover:bg-primary-800 transition-colors font-medium"
      >
        Lihat Impact
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 },
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el) => {
    window.__revealObserver!.observe(el);
  });
</script>
