---
const quickLinks = [
  { name: "Tentang kami", href: "/tentang" },
  { name: "Download", href: "/aplikasi" },
  { name: "Rekening", href: "/rekening" },
  { name: "Menjadi Relawan", href: "/kontak" },
];

const infoLinks = [
  { name: "Cerita", href: "/story" },
  { name: "Berita", href: "/event-salur" },
  { name: "Laporan", href: "/tentang-salur" },
  { name: "Syarat dan ketentuan", href: "/syarat-ketentuan" },
];
---

<footer id="contact" class="bg-primary-900 text-white relative overflow-hidden">
  <!-- Top wave decoration -->
  <div
    class="absolute top-0 left-0 right-0 h-1 bg-linear-to-r from-primary-400 via-primary-300 to-primary-400 opacity-40"
  >
  </div>

  <div class="container-custom py-14 md:py-18">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-12">
      <!-- Logo & Description -->
      <div class="md:col-span-1">
        <a href="/" class="inline-block mb-5">
          <img
            src="/images/logo-akber-green.webp"
            alt="Beramalbersama"
            class="h-9 w-auto brightness-200 saturate-0"
          />
        </a>
        <p class="text-sm text-primary-200/80 leading-relaxed mb-5">
          <span class="font-semibold text-white">Menggerakkan Kebaikan</span>
          <br />
          beramalbersama.com adalah laman infaq sedekah online. Dikelola dan diberdayakan
          oleh Yayasan Sahabat Beramal Bersama sebagai Mitra Pengelola Zakat Dompet
          Dhuafa.
        </p>
        <!-- Social Icons -->
        <div class="flex gap-3">
          {
            [
              {
                label: "Facebook",
                href: "#",
                path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
              },
              {
                label: "Instagram",
                href: "#",
                path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z",
              },
              {
                label: "YouTube",
                href: "#",
                path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
              },
            ].map((s) => (
              <a
                href={s.href}
                aria-label={s.label}
                class="w-9 h-9 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d={s.path} />
                </svg>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-display text-base font-semibold mb-4 text-white">
          Tautan Cepat
        </h4>
        <ul class="space-y-2.5">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-primary-200/75 hover:text-white transition-colors flex items-center gap-2 group"
                >
                  <span class="w-1 h-1 rounded-full bg-primary-400 group-hover:bg-primary-300 transition-colors" />
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Info Links -->
      <div>
        <h4 class="font-display text-base font-semibold mb-4 text-white">
          Sekilas
        </h4>
        <ul class="space-y-2.5">
          {
            infoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-primary-200/75 hover:text-white transition-colors flex items-center gap-2 group"
                >
                  <span class="w-1 h-1 rounded-full bg-primary-400 group-hover:bg-primary-300 transition-colors" />
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-display text-base font-semibold mb-4 text-white">
          Kontak Kami
        </h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-primary-300 shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-sm text-primary-200/75 leading-snug">
              Indonesia
            </span>
          </li>
          <li class="flex items-start gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-primary-300 shrink-0 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href="mailto:konten@beramalbersama.com"
              class="text-sm text-primary-200/75 hover:text-white transition-colors"
            >
              konten@beramalbersama.com
            </a>
          </li>
        </ul>

        <p class="text-[11px] text-primary-200/70 leading-relaxed mt-5">
          Dana yang didonasikan melalui Rumah Zakat dimiliki secara penuh dan
          bukan bersumber dari dana yang tidak halal dan bukan untuk tujuan
          pencucian uang (money laundry), termasuk terorisme maupun tindak
          kejahatan lainnya.
        </p>

        <!-- Trust badge -->
        <!-- <div class="mt-6 flex items-center gap-2 bg-white/5 rounded-xl px-3 py-2.5 border border-white/10">
          <span class="text-lg">🔒</span>
          <p class="text-xs text-primary-200/80 leading-snug">Donasi aman &<br />terverifikasi</p>
        </div> -->
      </div>
    </div>

    <!-- Divider + Copyright -->
    <div
      class="border-t border-white/10 mt-12 pt-6 flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-primary-200/50"
    >
      <p>© 2026 Beramalbersama.com — Hak cipta dilindungi.</p>
      <p>Sosial media</p>
    </div>
  </div>
</footer>
