---
// Siapa Kami — Beramalbersama

const valueBackgrounds = [
  {
    id: "kolaborasi",
    label: "Kolaborasi",
    image:
      "https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?w=1400&h=900&fit=crop",
  },
  {
    id: "inovasi-kebaikan",
    label: "Inovasi Kebaikan",
    image:
      "https://images.unsplash.com/photo-1469571486292-b53601020c0d?w=1400&h=900&fit=crop",
  },
  {
    id: "pemberdayaan",
    label: "Pemberdayaan",
    image:
      "https://images.unsplash.com/photo-1522075469751-3a6694fb2f61?w=1400&h=900&fit=crop",
  },
  {
    id: "kemanfaatan",
    label: "Kemanfaatan",
    image:
      "https://images.unsplash.com/photo-1559027615-cd4628902d4a?w=1400&h=900&fit=crop",
  },
  {
    id: "generasi-lebih-baik",
    label: "Generasi Lebih Baik",
    image:
      "https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=1400&h=900&fit=crop",
  },
];
---

<section id="about" class="py-14">
  <div class="container-custom">
    <div
      class="relative rounded-3xl overflow-hidden h-120 md:h-170"
      data-reveal="scale"
    >
      <!-- Background Image -->
      <div class="absolute inset-0">
        {
          valueBackgrounds.map((item, index) => (
            <img
              src={item.image}
              alt={`Nilai ${item.label} Beramalbersama`}
              class={`about-bg absolute inset-0 w-full h-full object-cover ${index === 0 ? "is-active" : ""}`}
              data-bg-id={item.id}
              loading={index === 0 ? "eager" : "lazy"}
            />
          ))
        }
      </div>
      <!-- Overlay gradient -->
      <div
        class="absolute inset-0 bg-linear-to-b from-primary-900/20 via-primary-900/40 to-primary-900/80"
      >
      </div>

      <!-- Content -->
      <div
        class="relative h-full flex flex-col items-center justify-between py-12 md:py-16 px-6 text-center text-white"
      >
        <!-- Top Content -->
        <div class="max-w-4xl" data-reveal>
          <span
            class="inline-block font-medium underline underline-offset-4 decoration-white/60 mb-4 text-sm"
          >
            Kita Apa & Ngapain
          </span>
          <h2
            class="font-display text-2xl md:text-4xl lg:text-5xl font-semibold leading-tight"
          >
            <button
              class="about-value-link is-active"
              data-bg-target="kolaborasi"
              type="button"
            >
              Kolaborasi
            </button>,
            <button
              class="about-value-link"
              data-bg-target="inovasi-kebaikan"
              type="button"
            >
              Inovasi Kebaikan
            </button>,
            <button
              class="about-value-link"
              data-bg-target="pemberdayaan"
              type="button"
            >
              Pemberdayaan
            </button>
            <br />
            <button
              class="about-value-link"
              data-bg-target="kemanfaatan"
              type="button"
            >
              Kemanfaatan
            </button>
            &
            <button
              class="about-value-link"
              data-bg-target="generasi-lebih-baik"
              type="button"
            >
              Generasi Lebih Baik
            </button>
          </h2>
          <p
            class="mt-4 text-white/80 text-sm md:text-base hidden md:inline-block leading-relaxed max-w-2xl mx-auto"
          >
            Kami percaya, dengan mengkolaborasikan setiap potensi, kita bisa
            menggerakkan ekosistem kebaikan yang lebih baik. Dari individu,
            komunitas, hingga mitra — bersama mewujudkan kemanfaatan tak
            terbatas.
          </p>
        </div>

        <!-- Bottom Content -->
        <div class="flex flex-col items-center gap-4" data-reveal>
          <span class="font-medium text-white/70 text-sm">Kami Adalah</span>
          <h3
            class="font-display text-xl md:text-5xl lg:text-6xl font-bold text-primary-300"
          >
            Beramalbersama.com
          </h3>
          <a
            href="/tentang"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary-800 rounded-full font-medium hover:bg-primary-50 transition-colors mt-2 group"
          >
            <span>Mari Bergerak Beramalbersama</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.__revealObserver) {
    window.__revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("revealed");
            window.__revealObserver!.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1 },
    );
  }
  document.querySelectorAll("[data-reveal]:not(.revealed)").forEach((el, i) => {
    if (!(el as HTMLElement).style.transitionDelay) {
      (el as HTMLElement).style.transitionDelay = `${i * 0.08}s`;
    }
    window.__revealObserver!.observe(el);
  });

  const aboutSection = document.querySelector("#about");

  if (aboutSection) {
    const backgrounds = Array.from(
      aboutSection.querySelectorAll(".about-bg"),
    ) as HTMLImageElement[];
    const valueLinks = Array.from(
      aboutSection.querySelectorAll(".about-value-link"),
    ) as HTMLButtonElement[];

    const activateBackground = (targetId: string) => {
      backgrounds.forEach((img) => {
        img.classList.toggle("is-active", img.dataset.bgId === targetId);
      });

      valueLinks.forEach((link) => {
        link.classList.toggle("is-active", link.dataset.bgTarget === targetId);
      });
    };

    valueLinks.forEach((link) => {
      const targetId = link.dataset.bgTarget;
      if (!targetId) return;

      link.addEventListener("mouseenter", () => activateBackground(targetId));
      link.addEventListener("focus", () => activateBackground(targetId));
      link.addEventListener("click", () => activateBackground(targetId));
    });
  }
</script>

<style>
  .about-bg {
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 600ms ease,
      transform 900ms ease;
  }

  .about-bg.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .about-value-link {
    position: relative;
    display: inline-block;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color 220ms ease;
  }

  .about-value-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 2px;
    background: currentColor;
    opacity: 0.7;
    transform: scaleX(0);
    transform-origin: right;
    transition:
      transform 500ms ease,
      opacity 200ms ease;
  }

  .about-value-link:hover,
  .about-value-link:focus-visible,
  .about-value-link.is-active {
    color: #fff;
    outline: none;
  }

  .about-value-link:hover::after,
  .about-value-link:focus-visible::after,
  .about-value-link.is-active::after {
    opacity: 1;
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
