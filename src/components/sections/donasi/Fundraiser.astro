---
import TitleBorder from '@/components/ui/TitleBorder.astro';
import { formatRupiah, getInitialName } from '@/lib/formatter';
import { Image } from 'astro:assets';


interface Props {
  programLink: string;
  fundraiser: {
    total: number;
    data: Array<{
      id: string;
      name: string;
      total_donatur: number;
      total_donasi: number;
    }>;
  };
}

const { programLink, fundraiser } = Astro.props;

const hasFundraisers = fundraiser?.data && fundraiser.data.length > 0;
---

<div class="space-y-3">
  <!-- Fundraiser List -->
  <div class="bg-white rounded-lg shadow-sm overflow-hidden" id="donateFr">
    <div class="p-4 md:p-6">
      <!-- Header -->
      <div class="flex items-center justify-between mb-6">
        <TitleBorder title="Fundraiser" amount={fundraiser?.total || 0} />
        <!-- <a
          id="semua-fundraiser"
          href={`/donasi/donors/${programLink}`}
          class="flex items-center gap-1 text-primary-600 hover:text-primary-700 font-medium transition-colors text-sm md:text-base"
        >
          <span
          class="text-green text-sm flex gap-1 items-center hover:underline hover:text-primary-700 transition-colors group"
        >
          Lihat Semua
         
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
          </svg>
        </span>
        </a> -->
        
      </div>

      <!-- Content -->
      <div class="space-y-3">
        {hasFundraisers ? (
          fundraiser.data.map((fundraiser) => (
            <div 
              class="flex items-start gap-3 p-4 rounded-lg bg-gradient-to-br from-gray-50 to-white border border-gray-100 hover:border-primary-200 transition-all duration-300 hover:shadow-md"
            >
              <!-- Avatar -->
              <div class="w-14 h-14 flex-shrink-0 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center shadow-md">
                <span class="text-white text-lg font-bold">
                  {getInitialName(fundraiser.name)}
                </span>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <h4 class="text-lg md:text-xl font-semibold text-gray-900 mb-1 truncate">
                  {fundraiser.name}
                </h4>
                <p class="text-sm text-gray-600 mb-2">
                  Mengajak <strong class="text-gray-900">{fundraiser.total_donatur} orang</strong> berinfak
                </p>
                <div class="flex items-center gap-2">
                  <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"/>
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/>
                  </svg>
                  <h6 class="text-lg font-bold text-primary-600">
                    {formatRupiah(fundraiser.total_donasi)}
                  </h6>
                </div>
              </div>
            </div>
          ))
        ) : (
          <!-- Empty State -->
          <div class="text-center py-12">
            <div class="flex flex-col items-center gap-4">
              <div class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center">
                <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              </div>
              <div>
                <h5 class="text-lg font-semibold text-gray-700 mb-1">Belum ada Fundraiser</h5>
                <p class="text-sm text-gray-500">Jadilah fundraiser pertama untuk program ini</p>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Banner Jadi Fundraiser -->
  <a 
    href="https://aksiberbagi.com/login" 
    class="block rounded-lg shadow-md overflow-hidden "
  >
    <Image
    width={120}
    height={80}
      src="/images/banner/JadiFundraiser.webp"
      alt="Jadi Fundraiser"
      class="w-full h-auto"
      width="400"
      height="400"
    />
  </a>
</div>