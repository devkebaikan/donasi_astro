---
import { formatCompactNumber, formatRupiah } from "@/lib/formatter";
import settings from "@/config/settings.json";

interface Props {
  nominalOptions: any[];
  programId: string | number | undefined;
  programLink: string | undefined;
  projectId?: number | null;
  title?: string;
  totalCollected?: number;
  totalDonors?: number;
  minAmount?: number;
}

const {
  nominalOptions,
  programId,
  programLink,
  projectId,
  title,
  totalCollected = 0,
  totalDonors = 0,
  minAmount = settings.donation.minAmount,
} = Astro.props;
---

<section
  id="nominal-input"
  data-program-id={programId}
  data-program-link={programLink}
  data-project-id={projectId}
  data-min-amount={minAmount}
  class="bg-white shadow-sm p-4 md:p-6 my-4 md:my-6"
>
  <div class="border p-4 rounded-lg border-neutral-300 relative pt-12">
    {
      title && (
        <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4">{title}</h2>
      )
    }

    <div class="flex rounded-lg overflow-hidden mb-4 absolute -top-4 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-sm">
      <button
        type="button"
        data-tab="patungan"
        data-active="true"
        class="ni-tab-btn flex-1 py-2.5 bg-secondary-500 text-sm font-semibold transition-colors text-white"
      >
        Pilih Nominal
      </button>
    </div>

    <div class="space-y-4">
      <p class="text-gray-800 text-sm">
        <span class="text-primary-500 font-bold text-lg">
          {formatRupiah(totalCollected)}
        </span>
        {" "}terkumpul dari{" "}
        <span class="font-bold text-lg">{totalDonors}</span> donatur
      </p>

      <div>
        <label class="block text-sm text-gray-900 mb-2">
          Masukan Nominal Transaksi <span class="text-red-500">*</span>
        </label>

        {
          nominalOptions && nominalOptions.length > 0 && (
            <div class="grid grid-cols-3 gap-3 mb-3">
              {nominalOptions.map((amount: any, index: number) => (
                <button
                  type="button"
                  data-value={amount.nominal}
                  class="ni-preset-btn group relative border border-neutral-200
                     hover:border-primary-500 rounded-md p-2
                     transition-all duration-300 hover:shadow cursor-pointer"
                >
                  {index === 1 && (
                    <span
                      class="absolute -top-2 -right-2
                         bg-linear-to-r from-secondary-400 to-secondary-500
                         text-white text-[8px] font-semibold px-2 py-1
                         rounded-t-full rounded-br-full"
                    >
                      Favorit
                    </span>
                  )}
                  <span class="block text-sm font-bold text-amount">
                    {formatCompactNumber(amount.nominal)}
                  </span>
                </button>
              ))}
            </div>
          )
        }

        <div class="flex rounded-lg border border-neutral-300 overflow-hidden">
          <div class="flex items-center px-4 font-bold text-lg text-gray-900">
            Rp
          </div>
          <input
            id="ni-donation-amount"
            type="text"
            inputmode="numeric"
            placeholder="0"
            class="flex-1 min-w-0 px-4 py-2 text-right font-bold text-xl text-neutral-700 focus:outline-none"
          />
        </div>
        <p class="text-center text-xs text-gray-500 mt-2">
          Minimal transaksi {formatRupiah(minAmount)}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { formatRupiah } from "@/lib/formatter";
  import { showToast } from "@/lib/toast";

  function initNominalInput() {
    const section = document.getElementById("nominal-input");
    if (!section) return;

    const input = document.getElementById(
      "ni-donation-amount",
    ) as HTMLInputElement | null;
    const presetBtns =
      section.querySelectorAll<HTMLButtonElement>(".ni-preset-btn");

    const minAmount = Number(section.getAttribute("data-min-amount") ?? 0);

    function parseNumber(value: string) {
      return Number(value.replace(/\D/g, "")) || 0;
    }

    function setActivePreset(selectedAmount: number) {
      presetBtns.forEach((btn) => {
        const btnValue = Number(btn.getAttribute("data-value") ?? 0);
        const isMatch = btnValue === selectedAmount && selectedAmount > 0;
        if (isMatch) {
          btn.classList.add("bg-primary-500", "text-white");
          btn.classList.remove("border-neutral-200");
          btn.classList.add("border-primary-500");
        } else {
          btn.classList.remove("bg-primary-500", "text-white");
          btn.classList.remove("border-primary-500");
          btn.classList.add("border-neutral-200");
        }
      });
    }

    presetBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const value = btn.getAttribute("data-value");
        if (!value || !input) return;
        const numValue = Number(value);
        input.value = formatRupiah(numValue, { withSymbol: false });
        setActivePreset(numValue);
      });
    });

    input?.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      const raw = parseNumber(target.value);
      target.value = raw ? formatRupiah(raw, { withSymbol: false }) : "";
      setActivePreset(raw);
    });

    function handleDonate() {
      const amount = input ? parseNumber(input.value) : 0;
      if (!amount || amount < minAmount) {
        showToast(
          !amount
            ? "Silakan pilih atau isi nominal terlebih dahulu"
            : `Minimal donasi ${formatRupiah(minAmount)}`,
          "error",
        );
        section?.scrollIntoView({ behavior: "smooth", block: "center" });
        input?.focus();
        return;
      }

      const projectId = section?.getAttribute("data-project-id");

      localStorage.setItem(
        "nominal_donation",
        JSON.stringify({ amount, updatedAt: Date.now(), projectId }),
      );

      const programId = section?.getAttribute("data-program-id");
      const programLink = section?.getAttribute("data-program-link");

      const params = new URLSearchParams();
      if (programId) params.set("id", programId);
      if (projectId) params.set("project", projectId);
      params.set("from", "detail2");

      window.location.assign(`/donasi/form/${programLink}/?${params.toString()}`);
    }

    document.removeEventListener("donate:open", handleDonate);
    document.addEventListener("donate:open", handleDonate);
  }

  initNominalInput();
  document.addEventListener("astro:page-load", initNominalInput);
</script>
