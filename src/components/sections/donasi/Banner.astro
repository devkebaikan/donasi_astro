---
import { Image } from "astro:assets";
import DonorNotif from "./DonorNotif.astro";
import { capitalizeFirstLetter, formatRupiah } from "@/lib/formatter";

interface Props {
  detailCampaign: any;
  link: string;
  donors: any;
}

const { detailCampaign, link, donors } = Astro.props;

// Computed values
const type = capitalizeFirstLetter(detailCampaign?.type || "");
const availableFunds =
  (detailCampaign?.nominal_achieved || 0) - (detailCampaign?.nominal_used || 0);
const distributedFunds = Math.max(
  detailCampaign?.nominal_used || 0,
  detailCampaign?.nominal_by_news || 0,
);
const totalBeneficiaries = Math.max(
  detailCampaign?.total_beneficiery || 0,
  detailCampaign?.beneficiery_by_news || 0,
);
const progressPercent = Math.min(detailCampaign?.progress_achieved || 0, 100);
---

<section class="bg-white">
  <!-- Hero Image Section -->
  <div class="relative max-w-120">
    <Image
      width={320}
      height={240}
      alt={detailCampaign?.title || "Donasi Image"}
      src={detailCampaign?.image ?? "/images/banner-bio.webp"}
      class="w-full max-h-[500px] object-cover"
    />

    <!-- Donor Notification -->
    <div
      class="absolute bottom-[100px] w-full flex items-center justify-center"
    >
      <DonorNotif donatur={donors} />
    </div>

    <!-- Mitra Info Card -->
    <a
      href={`/mitra/${detailCampaign?.mitra?.id}`}
      class="flex items-center gap-4 py-3 px-4 relative hover:bg-primary-50/50 transition-colors duration-200 group"
    >
      <div
        class="w-16 h-16 rounded-full bg-white border-1 border-neutral-100 group-hover:border-primary-500 overflow-hidden"
      >
        <img
          width={80}
          height={60}
          src={detailCampaign?.mitra?.image}
          alt={detailCampaign?.mitra?.name || "Mitra"}
          class="object-cover w-full h-full"
        />
      </div>

      <div class="flex-1 min-w-0">
        <div class="font-semibold text-gray-900 truncate">
          {detailCampaign?.mitra?.name}
        </div>
        <div
          class="flex items-center gap-2 text-xs text-cyan-600 bg-cyan-50 font-medium px-3 py-1 rounded-full w-fit mt-1"
        >
          Verified
          <img
            width="16"
            height="16"
            src="/images/icons/verif/Verifikasi II.png"
            alt="Verified badge"
            class="w-4 h-4"
          />
        </div>
      </div>

      <svg
        class="w-5 h-5 text-gray-400 group-hover:text-primary-500 group-hover:translate-x-1 transition-all"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>

  <!-- Campaign Details -->
  <div class="p-4 md:p-6 border-b border-neutral-200">
    <!-- Title -->
    <h1 class="text-lg md:text-xl font-bold text-gray-900 mb-4 leading-tight">
      {detailCampaign?.title}
    </h1>

    <!-- last proyek program -->
    <a
      href={`/donasi/last-project/${link}`}
      class="flex items-center gap-2 mb-5 bg-primary-50 border border-primary-100 rounded-lg px-3 py-2.5 hover:bg-primary-100 transition-colors group"
    >
      <svg
        class="w-4 h-4 text-primary-500 flex-shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="text-xs text-gray-500 flex-shrink-0"
        >Lihat proyek terakhir</span
      >
      <svg
        class="w-3.5 h-3.5 text-primary-400 group-hover:text-primary-600 flex-shrink-0 transition-all"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
          clip-rule="evenodd"></path>
      </svg>
    </a>

    <!-- Available Funds -->
    <div class="flex justify-between items-start mb-3">
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <span>Dana Tersedia</span>
          <svg
            class="w-3.5 h-3.5 text-gray-400 cursor-help tooltip-trigger"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="text-lg md:text-xl font-bold text-primary-600">
          {formatRupiah(availableFunds)}
        </div>
      </div>

      <button
        id="toggle-detail"
        class="flex items-center gap-2 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors"
      >
        <span class="toggle-text">Lihat Semua</span>
        <svg
          class="w-4 h-4 toggle-icon"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>

    <!-- Progress Bar -->
    <div class="w-full bg-gray-200 rounded-full h-1.5 mb-3 overflow-hidden">
      <div
        class="bg-gradient-to-r from-primary-400 to-primary-500 h-full rounded-full transition-all duration-500"
        style={`width: ${progressPercent}%`}
        role="progressbar"
        aria-valuenow={progressPercent}
        aria-valuemin="0"
        aria-valuemax="100"
      >
      </div>
    </div>

    <!-- Stats -->
    <div
      class="flex justify-between items-center text-sm md:text-base text-gray-700 mb-4"
    >
      <div class="flex items-center gap-2">
        <svg
          class="w-4 h-4 text-primary-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
            clip-rule="evenodd"></path>
        </svg>
        <span class="font-semibold">{detailCampaign?.total_donors || 0}</span>
        <span>donatur</span>
      </div>
      <div>
        <span class="font-semibold">{detailCampaign?.remaining_days || 0}</span>
        <span> hari Lagi</span>
      </div>
    </div>

    <!-- Detailed Information -->
    <div
      id="detail-info"
      class="hidden bg-gradient-to-br from-primary-50 to-emerald-50 rounded-xl p-4 mb-4 border border-primary-100 animate-in"
    >
      <h4 class="text-primary-700 text-sm font-semibold mb-3">
        Informasi Lainnya
      </h4>
      <div class="grid grid-cols-2 gap-4">
        <!-- Left Column -->
        <div class="space-y-3">
          <div>
            <p class="text-xs text-gray-600 mb-1">Target {type}</p>
            <h5 class="font-semibold text-gray-900">
              {formatRupiah(detailCampaign?.nominal_target || 0)}
            </h5>
          </div>
          <div>
            <p class="text-xs text-gray-600 mb-1">{type} Terkumpul</p>
            <h5 class="font-semibold text-gray-900">
              {formatRupiah(detailCampaign?.nominal_achieved || 0)}
            </h5>
          </div>
        </div>

        <!-- Right Column -->
        <div class="space-y-3">
          <div>
            <p class="text-xs text-gray-600 mb-1">{type} Tersalur</p>
            <h5 class="font-semibold text-gray-900">
              {formatRupiah(distributedFunds)}
            </h5>
          </div>
          <div>
            <p class="text-xs text-gray-600 mb-1">Penerima Manfaat</p>
            <h5 class="font-semibold text-gray-900">
              {totalBeneficiaries}
            </h5>
          </div>
        </div>
      </div>
    </div>

    <!-- Donate Buttons -->
    <!-- {
      active ? (
        <Fragment>
          <button
            id="btn-donate"
            data-program-id={detailCampaign?.id}
            data-program-link={detailCampaign?.link}
            class="mb-3 w-full bg-secondary-500 hover:from-secondary-500 hover:to-secondary-600 text-white font-bold text-base md:text-lg py-3.5 rounded-md shadow hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 animate-pulse-scale"
          >
            DONASI SEKARANG
          </button>
        </Fragment>
      ) : (
        <button
          disabled
          class="w-full bg-gray-300 text-gray-500 font-bold text-lg py-3.5 rounded-xl cursor-not-allowed"
        >
          {type} Belum Dibuka
        </button>
      )
    } -->
  </div>
</section>

<script>
  // Toggle detail information
  const toggleBtn = document.getElementById("toggle-detail");
  const detailInfo = document.getElementById("detail-info");
  const toggleText = toggleBtn?.querySelector(".toggle-text");
  const toggleIcon = toggleBtn?.querySelector(".toggle-icon");

  toggleBtn?.addEventListener("click", () => {
    const isHidden = detailInfo?.classList.contains("hidden");

    if (isHidden) {
      detailInfo?.classList.remove("hidden");
      if (toggleText) toggleText.textContent = "Tutup";
      toggleIcon?.classList.add("rotate-180");
    } else {
      detailInfo?.classList.add("hidden");
      if (toggleText) toggleText.textContent = "Lihat Semua";
      toggleIcon?.classList.remove("rotate-180");
    }
  });

  // Handle donate button click
  const donateBtn = document.getElementById("btn-donate");
  if (donateBtn) {
    donateBtn.addEventListener("click", () => {
      const programId = donateBtn.getAttribute("data-program-id");
      const programLink = donateBtn.getAttribute("data-program-link");

      if (programId && programLink) {
        // Store form data
        // localStorage.setItem(
        //   "formData",
        //   JSON.stringify({
        //     type: "donation",
        //     program_type: "infaq",
        //     items: [programId],
        //   }),
        // );

        // Navigate
        window.location.assign(`/donasi/form/${programLink}/?id=${programId}`);
      }
    });
  }

  // Handle chat admin button
  const chatBtn = document.getElementById("btn-chat-admin");
  if (chatBtn) {
    chatBtn.addEventListener("click", () => {
      const phoneNumber = "6281319964703";
      const message = encodeURIComponent(
        "Assalamu'alaikum, saya ingin bertanya tentang program donasi",
      );
      window.open(`https://wa.me/${phoneNumber}?text=${message}`, "_blank");
    });
  }

  // Simple tooltip
  const tooltipTriggers = document.querySelectorAll(".tooltip-trigger");
  tooltipTriggers.forEach((trigger) => {
    const tooltip = document.createElement("div");
    tooltip.className = "tooltip-popup";
    tooltip.textContent = trigger.getAttribute("data-tooltip") || "";
    document.body.appendChild(tooltip);

    trigger.addEventListener("mouseenter", (e) => {
      const rect = (e.target as HTMLElement).getBoundingClientRect();
      tooltip.style.left = `${rect.right + 8}px`;
      tooltip.style.top = `${rect.top}px`;
      tooltip.classList.add("show");
    });

    trigger.addEventListener("mouseleave", () => {
      tooltip.classList.remove("show");
    });
  });
</script>
