---
import { Image } from "astro:assets";
import DonorNotif from "./DonorNotif.astro";
import { capitalizeFirstLetter, formatRupiah } from "@/lib/formatter";

interface Props {
  detailCampaign: any;
  link: string;
  donors: any;
}

const { detailCampaign, link, donors } = Astro.props;

// Computed values
const type = capitalizeFirstLetter(detailCampaign?.type || "");
const availableFunds =
  (detailCampaign?.nominal_achieved || 0) - (detailCampaign?.nominal_used || 0);
const distributedFunds = Math.max(
  detailCampaign?.nominal_used || 0,
  detailCampaign?.nominal_by_news || 0,
);
const totalBeneficiaries = Math.max(
  detailCampaign?.total_beneficiery || 0,
  detailCampaign?.beneficiery_by_news || 0,
);
const progressPercent = Math.min(detailCampaign?.progress_achieved || 0, 100);
---

<section class="bg-white">
  <!-- Hero Image Section -->
  <div class="relative max-w-120">
    <div class="relative">
      <Image
        width={320}
        height={240}
        alt={detailCampaign?.title || "Donasi Image"}
        src={detailCampaign?.image ?? "/images/banner-bio.webp"}
        class="w-full max-h-[500px] object-cover"
      />
      <!-- <Image
        width={320}
        height={240}
        alt={detailCampaign?.title || "Donasi Image"}
        src={"/images/banner-bio.webp"}
        class="w-full max-h-[500px] object-cover"
      /> -->

      <!-- Gradient Bottom -->
      <!-- <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-primary-200/70 via-primary-200/60 to-transparent"
      >
      </div> -->

      <!-- Donor Notification -->
      <div
        class="absolute bottom-[30px] w-full flex items-center justify-center"
      >
        <DonorNotif donatur={donors} />
      </div>
    </div>

    <!-- last proyek program -->
    <a
      href={`/donasi/last-project/${link}`}
      class="group flex items-center justify-between bg-primary-700 px-4 py-4 transition-colors hover:bg-primary-700"
    >
      <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-gray-100">
          Project Salur terdekat lokasi
        </div>

        <p
          class="font-medium text-white text-sm md:text-base truncate max-w-[200px]"
        >
          {detailCampaign.mitra.name}
        </p>
      </div>

      <span class="btn-white-mobile transition-all group-hover:translate-x-0.5">
        Selengkapnya <svg
          class="h-3.5 w-3.5 text-primary-400 transition-all group-hover:text-primary-500"
          fill="currentColor"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
          ></path>
        </svg>
      </span>
    </a>

    <!-- Mitra Info Card -->
    <a
      href={`/mitra/${detailCampaign?.mitra?.id}`}
      class="flex items-center gap-4 py-3 px-4 relative hover:bg-primary-50/50 transition-colors duration-200 group"
    >
      <div
        class="w-16 h-16 rounded-full bg-white border-1 border-neutral-100 group-hover:border-primary-500 overflow-hidden"
      >
        <img
          width={80}
          height={60}
          src={detailCampaign?.mitra?.image}
          alt={detailCampaign?.mitra?.name || "Mitra"}
          class="object-cover w-full h-full"
        />
      </div>

      <div class="flex-1 min-w-0">
        <div class="font-semibold text-gray-900 truncate text-sm">
          {detailCampaign?.mitra?.name}
        </div>
        <div
          class="flex items-center gap-2 text-[10px] text-cyan-600 bg-cyan-50 font-medium px-3 py-1 rounded-full w-fit mt-1"
        >
          Verified
          <img
            width="10"
            height="10"
            src="/images/icons/verif/Verifikasi II.png"
            alt="Verified badge"
            class="w-3 h-3"
          />
        </div>
      </div>

      <svg
        class="w-5 h-5 text-gray-400 group-hover:text-primary-500 group-hover:translate-x-1 transition-all"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          fill-rule="evenodd"
          d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>

  <!-- Campaign Details -->
  <div class="p-4 md:p-6 border-b border-neutral-200">
    <!-- Title -->
    <h1 class="text-lg md:text-xl font-bold text-gray-900 mb-4 leading-tight">
      {detailCampaign?.title}
    </h1>

    <!-- Available Funds -->
    <div class="flex justify-between items-center mb-3">
      <div class="space-y-1">
        <div class="flex items-center gap-1.5 text-sm text-gray-600">
          <span>Donasi Tersedia</span>
          <svg
            class="w-3.5 h-3.5 text-gray-400 cursor-help tooltip-trigger"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
        <div class="text-lg md:text-xl font-bold text-secondary-500">
          {formatRupiah(availableFunds)}
        </div>
      </div>

      <button
        id="toggle-detail"
        class="flex items-center gap-1 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors flex-shrink-0"
      >
        <span class="toggle-text">Lihat Semua</span>
        <svg
          class="w-4 h-4 toggle-icon transition-transform duration-200"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>

    <!-- Detailed Information -->
    <div id="detail-info" class="hidden my-4 animate-in">
      <div class="mb-3">
        <p class="text-sm text-gray-600 mb-1">Donasi Terkumpul</p>
        <h5 class="text-lg md:text-xl font-bold text-primary-600 leading-tight">
          {formatRupiah(detailCampaign?.nominal_achieved || 0)}
          <span class="text-sm text-gray-500 font-normal"> dari target </span>
          <span class="text-gray-800 text-sm md:text-base font-bold">
            {formatRupiah(detailCampaign?.nominal_target || 0)}</span
          >
        </h5>
      </div>

      <!-- Progress Bar -->
      <div class="w-full bg-gray-200 rounded-full h-2 mb-4 overflow-hidden">
        <div
          class="bg-gradient-to-r from-primary-400 to-primary-500 h-full rounded-full transition-all duration-500"
          style={`width: ${progressPercent}%`}
          role="progressbar"
          aria-valuenow={progressPercent}
          aria-valuemin="0"
          aria-valuemax="100"
        >
        </div>
      </div>

      <!-- Stats -->
      <div class="flex justify-between items-center text-sm text-gray-700 mb-4">
        <div class="flex items-center gap-1.5">
          <svg
            class="w-4.5 h-4.5 text-primary-400"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 01-1.162-.682 22.045 22.045 0 01-2.582-1.9C4.045 12.733 2 10.352 2 7.5 2 5.015 3.98 3 6.5 3c1.472 0 2.786.68 3.5 1.68A4.006 4.006 0 0113.5 3C16.02 3 18 5.015 18 7.5c0 2.852-2.044 5.234-3.885 6.82a22.049 22.049 0 01-3.744 2.582l-.019.01-.005.003h-.002a.739.739 0 01-.69.001l-.002-.001z"
            ></path>
          </svg>
          <span class="font-semibold text-gray-900"
            >{detailCampaign?.total_donors || 0}</span
          >
          <span class="text-gray-500">Donasi</span>
        </div>
        <a
          href={`/donasi/report/${link}`}
          class="flex items-center gap-1.5 text-primary-600 hover:text-primary-700 font-medium transition-colors"
        >
          <svg
            class="w-4.5 h-4.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3M3.75 6h16.5a1.5 1.5 0 011.5 1.5v9a1.5 1.5 0 01-1.5 1.5H3.75a1.5 1.5 0 01-1.5-1.5v-9a1.5 1.5 0 011.5-1.5z"
            ></path>
          </svg>
          <span>Rincian penggunaan dana</span>
          <svg
            class="w-3.5 h-3.5 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
    <!-- Info Box -->
    <div
      class="flex items-start gap-3 bg-primary-50 border border-primary-100 rounded-xl p-3.5"
    >
      <svg
        class="w-4 h-4 text-primary-500 flex-shrink-0 mt-0.5"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M18 3a1 1 0 00-1.447-.894L8.763 6H5a3 3 0 000 6h.28l1.771 5.316A1 1 0 008 18h1a1 1 0 001-1v-4.382l6.553 3.276A1 1 0 0018 15V3z"
        ></path>
      </svg>
      <p class="text-[10px] md:text-xs text-gray-700 leading-relaxed">
        Alhamdulillah, Infaq sebesar <span class="font-semibold text-gray-900">
          {formatRupiah(distributedFunds)}</span
        > telah tersalurkan untuk <span class="font-semibold text-gray-900"
          >{totalBeneficiaries}</span
        > penerima manfaat. Semakin banyak donasi yang tersedia, semakin besar bantuan
        yang bisa disalurkan oleh program ini.
      </p>
    </div>

    <!-- Donate Buttons -->
    <!-- {
      active ? (
        <Fragment>
          <button
            id="btn-donate"
            data-program-id={detailCampaign?.id}
            data-program-link={detailCampaign?.link}
            class="mb-3 w-full bg-secondary-500 hover:from-secondary-500 hover:to-secondary-600 text-white font-bold text-base md:text-lg py-3.5 rounded-md shadow hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 animate-pulse-scale"
          >
            DONASI SEKARANG
          </button>
        </Fragment>
      ) : (
        <button
          disabled
          class="w-full bg-gray-300 text-gray-500 font-bold text-lg py-3.5 rounded-xl cursor-not-allowed"
        >
          {type} Belum Dibuka
        </button>
      )
    } -->
  </div>
</section>

<script>
  // Toggle detail information
  const toggleBtn = document.getElementById("toggle-detail");
  const detailInfo = document.getElementById("detail-info");
  const toggleText = toggleBtn?.querySelector(".toggle-text");
  const toggleIcon = toggleBtn?.querySelector(".toggle-icon");

  toggleBtn?.addEventListener("click", () => {
    const isHidden = detailInfo?.classList.contains("hidden");

    if (isHidden) {
      detailInfo?.classList.remove("hidden");
      if (toggleText) toggleText.textContent = "Sembunyikan";
      toggleIcon?.classList.add("rotate-180");
    } else {
      detailInfo?.classList.add("hidden");
      if (toggleText) toggleText.textContent = "Lihat Semua";
      toggleIcon?.classList.remove("rotate-180");
    }
  });

  // Handle donate button click
  const donateBtn = document.getElementById("btn-donate");
  if (donateBtn) {
    donateBtn.addEventListener("click", () => {
      const programId = donateBtn.getAttribute("data-program-id");
      const programLink = donateBtn.getAttribute("data-program-link");

      if (programId && programLink) {
        // Store form data
        // localStorage.setItem(
        //   "formData",
        //   JSON.stringify({
        //     type: "donation",
        //     program_type: "infaq",
        //     items: [programId],
        //   }),
        // );

        // Navigate
        window.location.assign(`/donasi/form/${programLink}/?id=${programId}`);
      }
    });
  }

  // Handle chat admin button
  const chatBtn = document.getElementById("btn-chat-admin");
  if (chatBtn) {
    chatBtn.addEventListener("click", () => {
      const phoneNumber = "6281319964703";
      const message = encodeURIComponent(
        "Assalamu'alaikum, saya ingin bertanya tentang program donasi",
      );
      window.open(`https://wa.me/${phoneNumber}?text=${message}`, "_blank");
    });
  }

  // Simple tooltip
  const tooltipTriggers = document.querySelectorAll(".tooltip-trigger");
  tooltipTriggers.forEach((trigger) => {
    const tooltip = document.createElement("div");
    tooltip.className = "tooltip-popup";
    tooltip.textContent = trigger.getAttribute("data-tooltip") || "";
    document.body.appendChild(tooltip);

    trigger.addEventListener("mouseenter", (e) => {
      const rect = (e.target as HTMLElement).getBoundingClientRect();
      tooltip.style.left = `${rect.right + 8}px`;
      tooltip.style.top = `${rect.top}px`;
      tooltip.classList.add("show");
    });

    trigger.addEventListener("mouseleave", () => {
      tooltip.classList.remove("show");
    });
  });
</script>
