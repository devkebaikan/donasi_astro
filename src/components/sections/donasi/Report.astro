---
import TitleBorder from "@/components/ui/TitleBorder.astro";
import { formatDate } from "@/lib/formatter";

interface Props {
  report: any;
  programLink: string;
}

const { report, programLink } = Astro.props;
const reportData = report?.data?.[0] || null;
const reportNews = report?.news?.[0] || null;
---

<div class="bg-white rounded-lg shadow-sm" id="donateActivity">
  <div class="p-4 md:p-6">
    <div class="mb-6">
      <TitleBorder  title="Laporan Penyaluran" />
    </div>

    <div class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[600px]
           bg-gradient-to-t from-white to-transparent z-10"
      >
      </div>
      <ul class="max-h-[1000px] space-y-4">
        {
          reportData ? (
            <li class="bg-primary-100/50 rounded-lg p-4 md:p-6 border border-primary-100">
              {/* <!-- Mitra Info --> */}
              <div class="flex items-start gap-3 mb-4">
                <div class="w-12 h-12 flex-shrink-0 rounded-full overflow-hidden bg-white border-2 border-primary-200">
                  <img
                    src={reportData.mitra?.[0]?.image_url}
                    alt="Mitra"
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="font-semibold text-gray-900 text-base">
                    {reportData.mitra?.[0]?.name || "Aksiberbagi"}
                  </h4>
                  <p class="text-sm text-gray-600">
                    {formatDate(reportData.date)}
                  </p>
                </div>
              </div>

              {/* <!-- Report Image (if exists) --> */}
              {(reportData.image ||
                reportData.wa_image ||
                reportData.kegiatan?.image) && (
                <div class="mb-4">
                  <img
                    src={
                      reportData.image ||
                      reportData.wa_image ||
                      reportData.kegiatan?.image
                    }
                    alt="Report Image"
                    class="w-full rounded-lg h-auto object-cover"
                  />
                </div>
              )}

              {/* <!-- Project Title --> */}
              <h6 class="font-bold text-lg text-gray-900 mb-3">
                {reportData.project?.title}
              </h6>

              {/* <!-- Description --> */}
              <div
                class="text-gray-700 leading-relaxed
                       [&_p]:mb-3 [&_p]:text-base
                       [&_strong]:font-semibold [&_strong]:text-gray-900
                       [&_a]:text-primary-600 [&_a]:underline hover:[&_a]:text-primary-700
                       [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:mb-3
                       [&_ol]:ml-6 [&_ol]:list-decimal [&_ol]:mb-3
                       [&_li]:mb-1
                       [&_img]:rounded-lg [&_img]:my-4 [&_img]:max-w-full"
                set:html={
                  reportData.kegiatan?.deskripsi || reportData.wa_caption || ""
                }
              />
            </li>
          ) : reportNews ? (
            <li class="bg-primary-100/50 rounded-lg p-4 md:p-6 border border-primary-100">
              {/* <!-- Mitra Info --> */}
              <div class="flex items-start gap-3 mb-4">
                <div class="w-12 h-12 flex-shrink-0 rounded-full overflow-hidden bg-white border-2 border-primary-200">
                  <img
                    src={reportNews.mitra?.[0]?.image_url}
                    alt="Mitra"
                    class="w-full h-full object-cover"
                    width="48"
                    height="48"
                  />
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="font-semibold text-gray-900 text-base">
                    {reportNews.mitra?.[0]?.name || "Aksiberbagi"}
                  </h4>
                  <p class="text-sm text-gray-600">
                    {formatDate(reportNews.date)}
                  </p>
                </div>
              </div>

              {/* <!-- News Title --> */}
              <h6 class="font-bold text-lg text-gray-900 mb-3">
                {reportNews.title}
              </h6>

              {/* <!-- Content --> */}
              <div
                class="text-gray-700 leading-relaxed
                       [&_p]:mb-3 [&_p]:text-base
                       [&_strong]:font-semibold [&_strong]:text-gray-900
                       [&_a]:text-primary-600 [&_a]:underline hover:[&_a]:text-primary-700
                       [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:mb-3
                       [&_ol]:ml-6 [&_ol]:list-decimal [&_ol]:mb-3
                       [&_li]:mb-1
                       [&_img]:rounded-lg [&_img]:my-4 [&_img]:max-w-full"
                set:html={reportNews.content || ""}
              />
            </li>
          ) : null
        }
      </ul>

      {
        (reportData || reportNews) && (
          <div class="pt-6 text-center z-20 relative">
            <a
              href={`/donasi/report/${programLink}/`}
              class="text-xs md:text-sm inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary-500 text-white font-semibold transition-all duration-300 hover:bg-primary-600 hover:shadow-lg hover:-translate-y-0.5"
            >
              Lihat Dampak Kebaikanmu Selengkapnya
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </div>
</div>
