---
import TitleBorder from "@/components/ui/TitleBorder.astro";

interface Props {
  story: string;
  date?: string;
}

const { story, date } = Astro.props;

// Date formatter function
function dateFormatter(dateString: string) {
  if (!dateString) return "";

  const date = new Date(dateString);
  const options: Intl.DateTimeFormatOptions = {
    day: "numeric",
    month: "long",
    year: "numeric",
  };

  return date.toLocaleDateString("id-ID", options);
}

const formattedDate = date ? dateFormatter(date) : "";
---

<div class="block w-full" id="donateStory">
  <div class="bg-white rounded-lg shadow-sm p-4 md:p-6">
    <div class="flex items-center justify-between mb-6">
      <TitleBorder title="Kenapa Perlu Membantu?" />

      {
        formattedDate && (
          <p class="hidden text-teal-500 text-sm font-medium">
            {formattedDate}
          </p>
        )
      }
    </div>

    <!-- Story Content -->
    <div class="prose overflow-hidden mb-6">
      <div
        class="text-gray-700 leading-relaxed text-base
               [&_h1]:text-gray-900 [&_h1]:font-bold [&_h1]:text-3xl [&_h1]:mt-6 [&_h1]:mb-3 [&_h1]:leading-tight
               [&_h2]:text-gray-900 [&_h2]:font-bold [&_h2]:text-2xl [&_h2]:mt-6 [&_h2]:mb-3 [&_h2]:leading-tight
               [&_h3]:text-gray-900 [&_h3]:font-bold [&_h3]:text-xl [&_h3]:mt-5 [&_h3]:mb-2 [&_h3]:leading-tight
               [&_h4]:text-gray-900 [&_h4]:font-semibold [&_h4]:text-lg [&_h4]:mt-4 [&_h4]:mb-2
               [&_h5]:text-gray-900 [&_h5]:font-semibold [&_h5]:text-base [&_h5]:mt-4 [&_h5]:mb-2
               [&_h6]:text-gray-900 [&_h6]:font-semibold [&_h6]:text-sm [&_h6]:mt-4 [&_h6]:mb-2
               [&_p]:text-gray-600 [&_p]:mb-4 [&_p]:leading-7
               [&_p:first-of-type]:text-lg
               [&_strong]:font-semibold [&_strong]:text-gray-900
               [&_em]:italic
               [&_a]:text-teal-600 [&_a]:underline [&_a]:transition-colors hover:[&_a]:text-teal-700
               [&_ul]:ml-6 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:text-gray-600
               [&_ol]:ml-6 [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:text-gray-600
               [&_li]:mb-2
               [&_blockquote]:border-l-4 [&_blockquote]:border-teal-500 [&_blockquote]:pl-4 [&_blockquote]:ml-0 [&_blockquote]:mb-4 [&_blockquote]:text-gray-600 [&_blockquote]:italic
               [&_img]:max-w-full [&_img]:h-auto [&_img]:rounded-lg [&_img]:my-6
               [&_table]:w-full [&_table]:border-collapse [&_table]:mb-4
               [&_th]:border [&_th]:border-gray-300 [&_th]:bg-gray-100 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:font-semibold [&_th]:text-gray-900
               [&_td]:border [&_td]:border-gray-300 [&_td]:px-3 [&_td]:py-2 [&_td]:text-left
               [&_code]:bg-gray-100 [&_code]:px-2 [&_code]:py-1 [&_code]:rounded [&_code]:text-sm [&_code]:text-gray-900
               [&_pre]:bg-gray-900 [&_pre]:text-gray-100 [&_pre]:p-4 [&_pre]:rounded-lg [&_pre]:overflow-x-auto [&_pre]:mb-4
               [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-inherit
               [&_hr]:border-0 [&_hr]:border-t [&_hr]:border-gray-300 [&_hr]:my-8
               [&_iframe]:max-w-full [&_iframe]:rounded-lg [&_iframe]:my-6"
        set:html={story}
      />
    </div>

    <!-- Disclaimer -->
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded">
      <p class="text-sm text-yellow-800 leading-relaxed">
        <span class="font-bold">Disclaimer:</span> Informasi, opini dan foto yang
        ada di halaman galang dana ini adalah milik dan tanggung jawab penggalang
        dana. Jika ada masalah/kecurigaan silakan{" "}
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://api.whatsapp.com/send?phone=6281319964703&text=Assalamu%27alaikum"
          class="text-yellow-900 underline hover:text-yellow-700 font-semibold transition-colors"
        >
          lapor kepada kami disini.
        </a>
      </p>
    </div>
  </div>
</div>
