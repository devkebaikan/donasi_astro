---
import { formatRupiah } from '@/lib/formatter';
import { Image } from 'astro:assets';


interface Props {
  programLink: string;
  programId?: number;
  report?: boolean;
  projekSalur?: any[];
}

const { programLink, projekSalur, programId } = Astro.props;
---

<section class="my-4 md:my-6">
  <!-- Rencana Salur -->
  {projekSalur && projekSalur.length > 0 && (
    <div class="bg-white border-y border-gray-300 p-4 md:p-6">
      {projekSalur.map((salur, index) => (
        <div class="mb-6 last:mb-0 border-b border-gray-200 pb-6 last:border-none">
          {index === 0 && (
            <div class="flex justify-between items-center mb-4">
              <h4 class="font-semibold text-sm text-gray-900">
                Rencana Salur Terdekat
              </h4>
              <a
                href={`/donasi/project/${programLink}/?id=${programId}`}
                id="salur-selengkapnya"
                class="flex items-center gap-1 text-primary-600 hover:text-primary-700 font-medium transition-colors"
              >
                <span class="text-xs">Selengkapnya</span>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
              </a>
            </div>
          )}

          <div class="flex flex-col gap-4 items-start">
            {salur.image && (
              <Image
              width={120}
              height={80}
                src={salur.image}
                alt={salur.title}
                class="w-full h-auto rounded-lg object-cover"
              />
            )}

            <div class="flex flex-col gap-3 p-1">

              <!-- Title -->
              <div class="flex items-start gap-2">
                <svg class="w-[18px] h-[18px] text-primary-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M16 2c-2.76 0-5 2.24-5 5s2.24 5 5 5s5-2.24 5-5s-2.24-5-5-5m0 8c-1.66 0-3-1.34-3-3s1.34-3 3-3s3 1.34 3 3s-1.34 3-3 3m3 6h-2c0-1.2-.75-2.28-1.87-2.7L8.97 11H1v11h6v-1.44l7 1.94l8-2.5v-1c0-1.66-1.34-3-3-3"/>
                </svg>

                 <p class="text-sm font-medium text-gray-800 leading-snug line-clamp-2">
                  {salur.title}
                </p>
              </div>

              <!-- Status & Lokasi -->
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-primary-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10 2C6.69 2 4 4.69 4 8c0 4.25 6 10 6 10s6-5.75 6-10c0-3.31-2.69-6-6-6m0 8.5A2.5 2.5 0 1 1 10 5a2.5 2.5 0 0 1 0 5.5"/>
                </svg>

                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="text-[10px] font-semibold bg-amber-100 text-amber-600 px-2 py-0.5 rounded-full">
                    Proses Penggalangan
                  </span>

                  {salur.location?.split(",")[1]?.trim() && (
                    <>
                      <span class="text-gray-300 text-xs">•</span>
                      <span class="text-xs text-gray-500">
                        {salur.location.split(",")[1].trim()}
                      </span>
                    </>
                  )}
                </div>
              </div>

              <!-- Nominal -->
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <svg class="w-[17px] h-[17px] text-primary-500 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C7 2 3 4 3 7v10c0 3 4 5 9 5s9-2 9-5V7c0-3-4-5-9-5m0 2c3.87 0 7 .9 7 3s-3.13 3-7 3s-7-.9-7-3s3.13-3 7-3m0 16c-3.87 0-7-.9-7-3v-2c1.54 1.03 4.12 1.5 7 1.5s5.46-.47 7-1.5v2c0 2.1-3.13 3-7 3z"/>
                  </svg>

                  <span class="text-xs text-gray-500">Target</span>
                </div>

                <span class="text-sm font-bold text-primary-500">
                  {formatRupiah(salur.nominal_target)}
                </span>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</section>
