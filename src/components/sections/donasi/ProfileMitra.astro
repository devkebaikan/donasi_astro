---
import { formatRupiah } from '@/lib/formatter';

interface Props {
  programLink: string;
  programId?: number;
  report?: boolean;
  projekSalur?: any[];
}

const { programLink, projekSalur, programId } = Astro.props;
---

<section class="my-4 md:my-6">
  <!-- Rencana Salur -->
  {projekSalur && projekSalur.length > 0 && (
    <div class="bg-white border-y border-gray-300 p-4 md:p-6">
      {projekSalur.map((salur, index) => (
        <div class="mb-6 last:mb-0 border-b border-gray-200 pb-6 last:border-none">
          {index === 0 && (
            <div class="flex justify-between items-end mb-4">
              <h4 class="font-semibold text-gray-600">
                Rencana Salur Terdekat
              </h4>
              <a
                href={`/donasi/project/${programLink}/?id=${programId}`}
                id="salur-selengkapnya"
                class="flex items-center gap-1 text-primary-600 hover:text-primary-700 font-medium transition-colors"
              >
                <span class="text-xs">Selengkapnya</span>
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
              </a>
            </div>
          )}

          <div class="flex flex-col gap-4 items-start">
            {salur.image && (
            <img
              src={salur.image}
              alt={salur.title}
              loading="lazy"
              decoding="async"
              class="w-full h-auto rounded-lg object-cover"
            />
            )}

            <div class="flex flex-col gap-3 p-1">

              <!-- Title -->
              <div class="flex items-start gap-2">
                <svg
                  class="w-4 h-4 text-primary-500 mt-0.5 shrink-0"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                  />
                </svg>

                <p class="text-sm font-medium text-gray-800 leading-snug line-clamp-2">
                  {salur.title}
                </p>
              </div>

              <!-- Status & Lokasi -->
              <div class="flex items-center gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1 text-[10px] font-semibold bg-amber-50 text-amber-600 border border-amber-200/60 px-2 py-0.5 rounded-full">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                  Proses Penggalangan
                </span>

                {(salur.location?.split(",")[1]?.trim() || salur.location) && (
                  <span class="inline-flex items-center gap-1 text-xs text-gray-500">
                    <svg
                      class="w-3.5 h-3.5 text-primary-500 shrink-0"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                      />
                    </svg>
                    <span>{salur.location.split(",")[1]?.trim() || salur.location}</span>
                  </span>
                )}
              </div>

              <!-- Nominal -->
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-1.5">
                  <svg
                    class="w-4 h-4 text-primary-500 shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6H2.25m0 0v8.25m0 0a.75.75 0 01.75.75h1.5m-2.25 0h19.5m0 0a.75.75 0 00.75-.75V6.75a.75.75 0 00-.75-.75H19.5m0 0a.75.75 0 01-.75-.75V4.5m0 0a60.07 60.07 0 00-15.797-2.101C2.226 2.2 1.5 2.74 1.5 3.494V4.5m18 0h-18"
                    />
                  </svg>

                  <span class="text-xs text-gray-500">Target</span>
                </div>

                <span class="text-sm font-bold text-primary-500">
                  {formatRupiah(salur.nominal_target)}
                </span>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</section>
