---
const legalitas = [
  {
    title: "AKTA PERUBAHAN",
    subtitle: "No 15 Januari 2023",
  },
  {
    title: "SK Kementrian Hukum dan HAM",
    subtitle: "AHU-0002369.AH.01.12.Tahun 2023",
  },
  {
    title: "SK Dinas Sosial Kota Surakarta",
    subtitle: "Nomor : 460/6857/ORSOS/2021",
  },
  {
    title: "SK Kementerian Sosial Republik Indonesia",
    subtitle: "No.157/HUK-PS/2022",
  },
  {
    title: "Nomor Induk Berusaha (NIB)",
    subtitle: "1309230047886",
  },
  // {
  //   title: "NPWP Beramabersama",
  //   subtitle: "Nomor Pokok Wajib Pajak",
  // },
  // {
  //   title: "Pernyataan Keabsahan Dokumen",
  //   subtitle: "Surat Pernyataan Keabsahan",
  // },
  {
    title: "SK Mitra Pengelola Zakat",
    subtitle: "Dompet Dhuafa",
    link: "https://drive.google.com/file/d/1S5t2zoEyxWpn_zUjTw3rhNB2tKXXpK-y/view?usp=sharing",
  },
];
---

<section class="p-4 md:p-6 border-b border-neutral-200">
  <div
    class="rounded-lg border border-neutral-200/90 shadow-xs overflow-hidden bg-white"
  >
    <!-- TOP / DROPDOWN HEADER: Tampilan awal yang lebih rapi, modern, dan friendly -->
    <details class="w-full group">
      <summary
        class="flex items-center justify-between px-3.5 sm:px-4 py-3 bg-cyan-50/70 hover:bg-cyan-100/60 cursor-pointer list-none select-none transition-colors text-cyan-950"
      >
        <div class="flex items-center gap-2.5">
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs sm:text-sm font-bold text-neutral-900"
                >Tentang & Legalitas Yayasan</span
              >
            </div>
            <p class="text-[11px] text-cyan-800/80 font-normal">
              Informasi profil lembaga, perizinan, dan kontak
            </p>
          </div>
        </div>

        <div class="flex items-center gap-1 text-cyan-700 shrink-0 ml-2">
          <span
            class="text-[11px] font-medium hidden sm:inline group-open:hidden"
            >Selengkapnya</span
          >
          <span
            class="text-[11px] font-medium hidden sm:inline group-not-open:hidden"
            >Tutup</span
          >
          <div
            class="w-6 h-6 rounded-full bg-cyan-100/80 flex items-center justify-center"
          >
            <svg
              class="w-3.5 h-3.5 transition-transform duration-200 group-open:rotate-180"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>
      </summary>

      <!-- ISI KONTEN TERSTRUKTUR -->
      <div
        class="p-3.5 sm:p-4.5 bg-white space-y-4 border-t border-cyan-100/70 text-xs sm:text-sm text-neutral-700"
      >
        <!-- 1. Tentang Beramalbersama -->
        <div class="space-y-1.5">
          <p class="font-bold text-neutral-900 text-xs sm:text-sm">
            Beramalbersama – Bergerak Beramal Bersama
          </p>

          <!-- Social Media Pills -->
          <div class="pt-1.5 flex flex-col items-start text-[12px]">
            <div class="text-neutral-500 font-medium">
              Kunjungi dan ikuti sosial media kami untuk mendapatkan informasi
              terbaru:
            </div>
            <div class="flex items-center gap-2 mt-1">
              <p class="w-18 text-neutral-600 font-medium">Instagram</p>
              <a
                href="https://www.instagram.com/beramalbersama"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-0.5 text-pink-700 hover:underline font-medium transition-colors"
              >
                : beramalbersama
              </a>
            </div>
            <div class="flex items-center gap-2">
              <p class="w-18 text-neutral-600 font-medium">Facebook</p>
              <a
                href="https://www.facebook.com/beramalbersamadotcom"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-0.5 text-blue-700 hover:underline font-medium transition-colors"
              >
                : beramalbersamadotcom
              </a>
            </div>
          </div>

          <p class="font-bold text-neutral-900 text-xs sm:text-sm pt-2">
            Tentang Beramalbersama.com
          </p>
          <p class="text-[12px] sm:text-xs text-neutral-600 leading-relaxed">
            Beramalbersama hadir karena kami percaya bahwa setiap orang memiliki
            kapasitas untuk berbuat baik — dan kami menyediakan jalan yang
            mudah, aman, dan transparan untuk mewujudkannya.
          </p>
        </div>

        <!-- 2. Legalitas Dokumen (Tampilan Bersih Tanpa Link Drive) -->
        <div>
          <h5
            class="text-xs font-bold text-neutral-800 uppercase tracking-wide mb-2 flex items-center gap-1.5"
          >
            Legalitas
          </h5>

          <div
            class="divide-y divide-neutral-100 border border-neutral-200/80 rounded-xl overflow-hidden bg-white"
          >
            {
              legalitas.map((item) => (
                <div class="p-2.5 sm:p-3 flex items-center justify-between gap-3 text-xs hover:bg-neutral-50/70 transition-colors">
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold text-neutral-800 truncate text-[12px] sm:text-xs">
                      {item.title}
                    </p>
                    <p class="text-[11px] sm:text-[12px] text-neutral-500 font-mono mt-0.5 truncate">
                      {item.subtitle}
                    </p>
                  </div>

                  {item.link && (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] sm:text-[12px] font-semibold text-cyan-700 hover:underline hover:text-cyan-800 transition-colors"
                    >
                      <span>Lihat Izin</span>
                      <svg
                        class="w-2.5 h-2.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- 3. Alamat Kantor -->
        <div
          class="pt-2 border-t border-neutral-100 space-y-2 text-[12px] sm:text-xs text-neutral-600"
        >
          <div class="flex items-start gap-2">
            <span class="font-semibold text-neutral-800 shrink-0"
              >Alamat Kantor</span
            >
            <span class="text-neutral-600"
              >Jl. Srikatan No. 14, Kel. Kerten, Kec Laweyan, Kota Surakarta,
              Jawa Tengah. 57143</span
            >
          </div>

          <!-- Kontak Kami -->
          <div class="pt-1 space-y-1">
            <p class="font-semibold text-neutral-800">Kontak Kami</p>
            <div class="flex flex-col items-start gap-x-4 gap-y-1">
              <div>
                <span class="text-neutral-600">Whatsapp:</span>
                <a
                  href="https://wa.me/6281381111527"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cyan-700 hover:underline font-medium ml-1"
                >
                  +62813 8111 1527
                </a>
              </div>
              <div>
                <span class="text-neutral-600">Whatsapp:</span>
                <a
                  href="https://wa.me/6281381111453"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-cyan-700 hover:underline font-medium ml-1"
                >
                  +62813 8111 1453
                </a>
              </div>
              <div>
                <span class="text-neutral-600">Email:</span>
                <a
                  href="mailto:support@beramalbersama.com"
                  class="text-cyan-700 hover:underline font-medium ml-1"
                >
                  support@beramalbersama.com
                </a>
              </div>
            </div>
          </div>

          <!-- Kritik, Saran dan Masukan -->
          <div class="pt-1">
            <span class="font-semibold text-neutral-800"
              >Kritik, Saran dan Masukan</span
            >
            <div>
              <a
                href="/kontak"
                class="text-cyan-700 hover:underline font-medium"
              >
                https://beramalbersama.com/kontak
              </a>
            </div>
          </div>
        </div>
      </div>
    </details>
  </div>

  <style is:global>
    summary::-webkit-details-marker {
      display: none;
    }
  </style>
</section>
