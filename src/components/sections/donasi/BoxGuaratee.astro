---
/**
 * BoxGuaratee.astro
 * Garansi Penyaluran 100% & Legalitas Resmi Yayasan Beramalbersama
 * Didesain ramah (friendly), mudah dibaca, simpel, dan elegan sesuai konsep desain aplikasi.
 */

const legalitas = [
  {
    title: "AKTA PERUBAHAN",
    subtitle: "No 15 Januari 2023",
    link: "https://drive.google.com/file/d/1teXLSqOkpHR6No04KL8ki3fVnmqQJIhu/view?usp=sharing",
  },
  {
    title: "SK Kementerian Hukum dan HAM",
    subtitle: "AHU-0002369.AH.01.12.Tahun 2023",
    link: "https://drive.google.com/file/d/1mYgdwIkS_pmb5UfkZsEi2RyTfi9Ft8E-/view?usp=sharing",
  },
  {
    title: "SK Dinas Sosial Kota Surakarta",
    subtitle: "Nomor : 460/6857/ORSOS/2021",
    link: "https://drive.google.com/file/d/11yAto-W1zV6h7qo2LSySSHmkdC2T55Ak/view?usp=sharing",
  },
  {
    title: "SK Kementerian Sosial Republik Indonesia",
    subtitle: "No. 157/HUK-PS/2022",
    link: "https://drive.google.com/file/d/1A6i_96k9yHZRyFQdTsPqnKwN_mQ7avMF/view?usp=sharing",
  },
  {
    title: "Nomor Induk Berusaha (NIB)",
    subtitle: "1309230047886",
    link: "https://drive.google.com/file/d/1aaCBo7ML5q4oYls0e7Ys4bNgaArF-1Nx/view?usp=sharing",
  },
  {
    title: "NPWP Beramalbersama",
    subtitle: "Nomor Pokok Wajib Pajak Yayasan",
    link: "https://drive.google.com/file/d/1oC3c5Vpu0VSmMSHdvK-satcaKTemB7d8/view?usp=sharing",
  },
  {
    title: "Pernyataan Keabsahan Dokumen",
    subtitle: "Surat Pernyataan Legalitas & Keabsahan",
    link: "https://drive.google.com/file/d/1JJAxpeWXo_u_kjczJ13O2F2yR7DnhTBi/view?usp=sharing",
  },
  {
    title: "SK Mitra Pengelola Zakat",
    subtitle: "Dompet Dhuafa",
    link: "https://drive.google.com/file/d/1S5t2zoEyxWpn_zUjTw3rhNB2tKXXpK-y/view?usp=sharing",
  },
];
---

<section class="px-4 py-2">
  <div
    class="rounded-xl border border-neutral-200/80 shadow-xs overflow-hidden bg-white"
  >
    <!-- TOP BOX: Garansi Penyaluran -->
    <div class="bg-cyan-500 text-white p-3.5 sm:p-4">
      <div class="flex items-center gap-3">
        <!-- Info Garansi -->
        <div class="flex-1 min-w-0">
          <h4
            class="font-bold text-sm sm:text-base leading-tight tracking-tight text-white flex items-center gap-1.5"
          >
            Garansi Penyaluran
          </h4>
          <p class="text-[12px] sm:text-xs text-white/90 leading-snug mt-1">
            Donatur mendapatkan laporan penyaluran maksimal 10 hari setelah
            donasi disalurkan.
          </p>
        </div>
      </div>

      <!-- Quick WhatsApp Line -->
      <div
        class="mt-2.5 pt-2.5 border-t border-white/15 flex items-center justify-between text-[12px] text-white/90"
      >
        <a
          href="https://wa.me/6285117463122"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-semibold text-white hover:text-cyan-100 transition-colors py-0.5"
        >
          <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
            <path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
            ></path>
          </svg>
          <span>WA: +62851 1746 3122</span>
        </a>
        <span class="text-[11px] text-white/90"
          >Senin - Jumat, 08.00 - 16.00</span
        >
      </div>
    </div>

    <!-- ACCORDION DETAILS: Legalitas & Profil Yayasan -->
    <details class="w-full group">
      <summary
        class="flex items-center justify-between px-3.5 py-2.5 bg-cyan-50/80 hover:bg-cyan-100/70 cursor-pointer list-none select-none transition-colors border-t border-cyan-100 text-cyan-900"
      >
        <div class="flex items-center gap-2 text-xs sm:text-sm font-semibold">
          <span>Tentang & Legalitas Yayasan</span>
          <span class="text-[12px] font-normal text-cyan-700 hidden sm:inline"
            >(klik selengkapnya)</span
          >
        </div>

        <div class="flex items-center gap-1 text-cyan-700">
          <svg
            class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </summary>

      <!-- ISI KONTEN TERSTRUKTUR -->
      <div
        class="p-3.5 sm:p-4.5 bg-white space-y-4 border-t border-neutral-100 text-xs sm:text-sm text-neutral-700"
      >
        <!-- 1. Tentang Beramalbersama -->
        <div class="space-y-1.5">
          <p class="font-bold text-neutral-900 text-xs sm:text-sm">
            Beramalbersama – Bergerak Beramal Bersama
          </p>

          <!-- Social Media Pills -->
          <div class="pt-1.5 flex flex-col items-start text-[12px]">
            <div class="text-neutral-500 font-medium">
              Kunjungi dan ikuti sosial media kami untuk mendapatkan informasi
              terbaru :
            </div>
            <div class="flex items-center gap-2 mt-1">
              <p class="w-18 text-neutral-600 font-medium">Instagram</p>
              <a
                href="https://www.instagram.com/beramalbersama"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-0.5 text-pink-700 hover:underline font-medium transition-colors"
              >
                @beramalbersama
              </a>
            </div>
            <div class="flex items-center gap-2">
              <p class="w-18 text-neutral-600 font-medium">Facebook</p>
              <a
                href="https://www.facebook.com/beramalbersamadotcom"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-0.5 text-blue-700 hover:underline font-medium transition-colors"
              >
                beramalbersamadotcom
              </a>
            </div>
          </div>

          <p class="font-bold text-neutral-900 text-xs sm:text-sm pt-2">
            Tentang Beramalbersama.com
          </p>
          <p class="text-[12px] sm:text-xs text-neutral-600 leading-relaxed">
            Beramalbersama hadir karena kami percaya bahwa setiap orang memiliki
            kapasitas untuk berbuat baik — dan kami menyediakan jalan yang
            mudah, aman, dan transparan untuk mewujudkannya.
          </p>
        </div>

        <!-- 2. Legalitas Dokumen (List Rapi & Jelas) -->
        <div>
          <h5
            class="text-xs font-bold text-neutral-800 uppercase tracking-wide mb-2 flex items-center gap-1.5"
          >
            Legalitas Resmi Yayasan
          </h5>

          <div
            class="divide-y divide-neutral-100 border border-neutral-200/80 rounded-xl overflow-hidden bg-white"
          >
            {
              legalitas.map((item) => (
                <div class="p-2.5 sm:p-3 flex items-center justify-between gap-3 text-xs hover:bg-neutral-50/70 transition-colors">
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold text-neutral-800 truncate text-[12px] sm:text-xs">
                      {item.title}
                    </p>
                    <p class="text-[11px] sm:text-[12px] text-neutral-500 font-mono mt-0.5 truncate">
                      {item.subtitle}
                    </p>
                  </div>

                  {item.link ? (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[11px] sm:text-[12px] font-semibold text-cyan-700 hover:underline hover:text-cyan-800 transition-colors"
                    >
                      <span>Lihat Izin</span>
                      <svg
                        class="w-2.5 h-2.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  ) : (
                    <span class="shrink-0 px-2 py-0.5 rounded text-[11px] font-semibold text-emerald-700 bg-emerald-50">
                      Terdaftar
                    </span>
                  )}
                </div>
              ))
            }
          </div>
        </div>

        <!-- 3. Alamat & Kontak Kami -->
        <div
          class="pt-2 border-t border-neutral-100 space-y-2 text-[12px] sm:text-xs text-neutral-600"
        >
          <div class="flex items-start gap-2">
            <span class="font-semibold text-neutral-800 shrink-0"
              >Alamat Kantor:</span
            >
            <span class="text-neutral-600"
              >Jl. Srikatan No. 14, Kel. Kerten, Kec. Laweyan, Kota Surakarta,
              Jawa Tengah. 57143</span
            >
          </div>

          <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 pt-0.5">
            <div>
              <span class="font-semibold text-neutral-800">Whatsapp:</span>
              <a
                href="https://wa.me/6285117463122"
                target="_blank"
                rel="noopener noreferrer"
                class="text-cyan-600 hover:underline font-medium ml-1"
              >
                +62851 1746 3122
              </a>
            </div>
            <div>
              <span class="font-semibold text-neutral-800">Email:</span>
              <a
                href="mailto:support@beramalbersama.com"
                class="text-cyan-600 hover:underline font-medium ml-1"
              >
                support@beramalbersama.com
              </a>
            </div>
          </div>

          <div class="pt-0.5">
            <span class="font-semibold text-neutral-800"
              >Kritik, Saran dan Masukan:</span
            >
            <a
              href="/kontak"
              class="text-cyan-600 hover:underline font-medium ml-1"
            >
              https://beramalbersama.com/kontak
            </a>
          </div>
        </div>
      </div>
    </details>
  </div>
</section>

<style is:global>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
