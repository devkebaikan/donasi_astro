---
interface Props {
  active?: "home" | "program" | "donasiku" | "rutin" | "akun";
}
const { active = "home" } = Astro.props;

const items = [
  {
    id: "home",
    href: "/home",
    label: "Beranda",
    imgActive: "/assets/nav/home-active.png",
    imgInactive: "/assets/nav/home-inactive.png",
  },
  {
    id: "program",
    href: "/donasi",
    label: "Program",
    imgActive: "/assets/nav/program-active.png",
    imgInactive: "/assets/nav/program-inactive.png",
  },
  {
    id: "donasiku",
    href: "/donasi-saya",
    label: "Donasiku",
    imgActive: "/assets/nav/donasiku-active.png",
    imgInactive: "/assets/nav/donasiku-inactive.png",
  },
  {
    id: "rutin",
    href: "/donasi-rutin",
    label: "Rutin",
    imgActive: "/assets/nav/rutin-active.png",
    imgInactive: "/assets/nav/rutin-inactive.png",
  },
  {
    id: "akun",
    href: "/akun",
    label: "Akun",
    imgActive: "/assets/nav/user-active.png",
    imgInactive: "/assets/nav/user-inactive.png",
  },
] as const;
---

<nav
  class="fixed container bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-t border-neutral-200"
  style="box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.05);"
>
  <div class="container">
    <div class="grid grid-cols-5 h-[62px]">
      {
        items.map((item) => {
          const on = item.id === active;
          return (
            <a
              href={item.href}
              class={`group relative flex flex-col items-center justify-center gap-1 transition-all duration-200 ease-out select-none active:scale-90 ${
                on
                  ? "text-primary-500 font-semibold"
                  : "text-neutral-400 hover:text-neutral-600"
              }`}
              aria-current={on ? "page" : undefined}
            >
              <div class="relative flex items-center justify-center">
                <img
                  src={on ? item.imgActive : item.imgInactive}
                  alt={item.label}
                  class={`w-4.5 h-4.5 object-contain transition-all duration-200 ease-out ${
                    on
                      ? "scale-110 -translate-y-0.5 drop-shadow-[0_2px_6px_rgba(4,157,199,0.2)]"
                      : "opacity-80 group-hover:opacity-100 group-hover:scale-110 group-hover:-translate-y-0.5"
                  }`}
                  width="20"
                  height="20"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span
                class={`text-[10px] leading-none transition-all duration-200 ${
                  on ? "font-semibold" : "font-normal"
                }`}
              >
                {item.label}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</nav>
