---
interface Props {
  title: string;
  amount?: number;
}

const { title, amount = 0 } = Astro.props;
---

<div class="flex items-start justify-between gap-3">
  <!-- Title -->
  <div class="flex items-center gap-3">
    <div
      class="px-4 py-1.5 rounded-full bg-gradient-to-r from-[var(--primary-100)] to-white border border-[var(--primary-300)] text-[var(--primary-700)] font-semibold text-sm md:text-base shadow-sm"
    >
      {title}
    </div>

    {
      amount >= 1 && (
        <span class="inline-flex items-center justify-center min-w-[28px] h-7 px-2 rounded-full bg-[var(--primary-600)] text-white text-xs font-medium shadow">
          {amount}
        </span>
      )
    }
  </div>
</div>
