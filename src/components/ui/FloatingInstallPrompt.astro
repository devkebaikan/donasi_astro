---
// FloatingInstallPrompt.astro - Komponen Ajakan Install / Buka PWA Melayang untuk Mobile
---

<div
  id="floating-install-prompt"
  class="fixed bottom-20 left-1/2 -translate-x-1/2 w-[92%] max-w-[440px] z-50 pointer-events-none transition-all duration-500 ease-out opacity-0 translate-y-6"
  style="display: none;"
>
  <div
    class="pointer-events-auto relative overflow-hidden bg-white/95 backdrop-blur-md rounded-xl p-3.5 shadow-2xl border border-primary-100 ring-1 ring-black/5 flex items-center justify-between gap-3"
  >
    <!-- Progress bar 5 detik -->
    <div
      id="install-prompt-progress"
      class="absolute bottom-0 left-0 h-1 bg-gradient-to-r from-primary-400 to-primary-600 rounded-full"
      style="width: 100%; transition: width 8s linear;"
    >
    </div>

    <!-- App Icon & Info -->
    <div class="flex items-center gap-3 min-w-0">
      <div
        class="w-11 h-11 shrink-0 rounded-xl bg-primary-50 p-1.5 border border-primary-200/60 shadow-sm flex items-center justify-center"
      >
        <img
          src="/icons/icon-192x192.png"
          alt="Beramalbersama App"
          class="w-full h-full object-contain rounded-lg"
          width="44"
          height="44"
        />
      </div>
      <div class="min-w-0">
        <h4
          id="install-prompt-title"
          class="text-xs sm:text-sm font-bold text-neutral-800 truncate"
        >
          BB Mobile
        </h4>
        <p
          id="install-prompt-desc"
          class="text-[11px] text-neutral-500 truncate"
        >
          Donasi mudah dengan aplikasi
        </p>
      </div>
    </div>

    <!-- Actions: Install / Buka App & Close -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        id="btn-install-pwa"
        type="button"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-secondary-500 active:scale-95 text-white text-xs font-semibold rounded-xl shadow-md shadow-secondary-500/20 hover:bg-secondary-600 transition-all cursor-pointer"
      >
        <!-- <svg
          id="icon-install"
          class="w-3.5 h-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
          ></path>
        </svg>
        <svg
          id="icon-open"
          class="w-3.5 h-3.5 hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
          ></path>
        </svg> -->
        <span id="btn-install-text">Install</span>
      </button>

      <button
        id="btn-close-install-prompt"
        type="button"
        class="p-1.5 text-neutral-400 hover:text-neutral-600 rounded-lg hover:bg-neutral-100 transition-colors cursor-pointer"
        aria-label="Tutup"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Petunjuk iOS / Safari Modal Kecil (Muncul jika browser iOS) -->
  <div
    id="ios-install-guide"
    class="hidden mt-2 p-3 bg-neutral-900/95 backdrop-blur-md text-white text-xs rounded-xl shadow-lg animate-fade-in"
  >
    <div class="flex items-start gap-2">
      <span class="text-base">📲</span>
      <div>
        <p class="font-medium text-[11px] leading-relaxed">
          Ketuk ikon <strong>Bagikan (Share)</strong>
          <span class="inline-block align-middle px-1">⎋ / 📤</span> di browser Anda,
          lalu pilih <strong>"Tambahkan ke Layar Utama"</strong>.
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const promptContainer = document.getElementById("floating-install-prompt");
    const installBtn = document.getElementById("btn-install-pwa");
    const btnText = document.getElementById("btn-install-text");
    const iconInstall = document.getElementById("icon-install");
    const iconOpen = document.getElementById("icon-open");
    const titleEl = document.getElementById("install-prompt-title");
    const descEl = document.getElementById("install-prompt-desc");
    const closeBtn = document.getElementById("btn-close-install-prompt");
    const progressBar = document.getElementById("install-prompt-progress");
    const iosGuide = document.getElementById("ios-install-guide");

    if (!promptContainer) return;

    // Jangan tampilkan jika sudah di dalam aplikasi PWA terpasang (Standalone Mode)
    const isStandalone =
      window.matchMedia("(display-mode: standalone)").matches ||
      window.matchMedia("(display-mode: fullscreen)").matches ||
      window.matchMedia("(display-mode: minimal-ui)").matches ||
      Boolean(window.navigator && window.navigator.standalone);

    if (isStandalone) return;

    // Cek apakah baru saja ditutup dalam sesi ini
    if (sessionStorage.getItem("pwa_prompt_closed") === "true") return;

    let deferredPrompt = null;
    let autoDismissTimer = null;
    let isAppInstalled = false;
    const DISPLAY_DURATION_MS = 8000; // Melayang selama 5 detik

    function setOpenAppMode() {
      isAppInstalled = true;
      if (btnText) btnText.textContent = "Buka App";
      if (iconInstall) iconInstall.classList.add("hidden");
      if (iconOpen) iconOpen.classList.remove("hidden");
      if (titleEl) titleEl.textContent = "Buka di Aplikasi";
      if (descEl) descEl.textContent = "Lanjutkan pengalaman di aplikasi";
    }

    // Deteksi jika aplikasi sudah terpasang di perangkat
    if ("getInstalledRelatedApps" in navigator) {
      navigator
        .getInstalledRelatedApps()
        .then((apps) => {
          if (apps && apps.length > 0) {
            setOpenAppMode();
          }
        })
        .catch(() => {});
    }

    function showPrompt() {
      promptContainer.style.display = "block";
      void promptContainer.offsetWidth; // Force CSS reflow
      promptContainer.classList.remove("opacity-0", "translate-y-6");
      promptContainer.classList.add("opacity-100", "translate-y-0");

      if (progressBar) {
        setTimeout(() => {
          progressBar.style.width = "0%";
        }, 50);
      }

      autoDismissTimer = setTimeout(() => {
        hidePrompt();
      }, DISPLAY_DURATION_MS);
    }

    function hidePrompt() {
      if (autoDismissTimer) clearTimeout(autoDismissTimer);
      promptContainer.classList.remove("opacity-100", "translate-y-0");
      promptContainer.classList.add("opacity-0", "translate-y-6");

      setTimeout(() => {
        promptContainer.style.display = "none";
      }, 500);
    }

    // Tangkap event sebelum instalasi browser (Android / Chrome)
    window.addEventListener("beforeinstallprompt", (e) => {
      e.preventDefault();
      deferredPrompt = e;
      showPrompt();
    });

    // Ketika aplikasi berhasil dipasang
    window.addEventListener("appinstalled", () => {
      deferredPrompt = null;
      setOpenAppMode();
      sessionStorage.setItem("pwa_prompt_closed", "true");
      hidePrompt();
    });

    // Deteksi iOS Safari
    const isIos =
      /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

    // Jika iOS atau event prompt belum terpanggil, tampilkan setelah jeda singkat
    if (isIos) {
      setTimeout(() => {
        showPrompt();
      }, 1200);
    } else {
      setTimeout(() => {
        if (!deferredPrompt && promptContainer.style.display === "none") {
          showPrompt();
        }
      }, 1500);
    }

    // Aksi Klik Tombol
    if (installBtn) {
      installBtn.addEventListener("click", async () => {
        // 1. Jika aplikasi sudah terinstall -> Langsung buka aplikasinya
        if (isAppInstalled) {
          window.location.href = "/home?source=pwa";
          hidePrompt();
          return;
        }

        // 2. Jika ada native install prompt -> Langsung picu popup install
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === "accepted") {
            sessionStorage.setItem("pwa_prompt_closed", "true");
            hidePrompt();
          }
          deferredPrompt = null;
          return;
        }

        // 3. Jika di iOS Safari -> Munculkan panduan praktis
        if (isIos) {
          if (iosGuide) {
            iosGuide.classList.toggle("hidden");
            if (autoDismissTimer) clearTimeout(autoDismissTimer); // Biarkan user membaca
          }
          return;
        }

        // 4. Fallback: Langsung arahkan ke URL PWA
        window.location.href = "/home?source=pwa";
      });
    }

    // Klik tombol Tutup (X)
    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        sessionStorage.setItem("pwa_prompt_closed", "true");
        hidePrompt();
      });
    }
  })();
</script>
