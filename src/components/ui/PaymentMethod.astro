---
const { paymentMethods = [] } = Astro.props;
---

<div
  id="payment-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4"
>
  <div
    class="bg-white rounded-xl max-w-[640px] w-full max-h-[85vh] sm:max-h-[80vh] overflow-hidden"
  >
    <!-- Header -->
    <div
      class="p-4 sm:p-6 border-b border-gray-200 flex justify-between items-center"
    >
      <h3 class="text-base sm:text-xl font-bold text-gray-900">
        Pilih Metode Pembayaran
      </h3>
      <button
        data-close-modal
        class="text-gray-500 hover:text-gray-700 text-lg sm:text-xl"
        aria-label="Tutup"
      >
        ✕
      </button>
    </div>

    <!-- Content -->
    <div
      class="overflow-y-auto max-h-[calc(85vh-64px)] sm:max-h-[calc(80vh-80px)] p-4 sm:p-6"
    >
      <!-- BANK TRANSFER -->
      <h2 class="py-2 sm:py-3 text-sm sm:text-lg text-gray-500">
        Transfer bank
        <span class="block text-xs sm:text-sm">
          (verifikasi manual 1x24 jam, minimal nominal Rp 10.000)
        </span>
      </h2>

      <div class="space-y-2 sm:space-y-3">
        {
          paymentMethods
            .filter((method: any) => method.type === "bank")
            .filter((method: any) => method.is_active === "1")
            .map((method: any) => (
              <button
                type="button"
                class="payment-method-item w-full flex items-center gap-3 sm:gap-4
                     p-3 sm:p-4 border-2 border-gray-200 rounded-md
                     hover:border-[var(--primary-500)]
                     hover:bg-[var(--primary-100)]
                     transition-all"
                data-id={method.id}
                data-name={method.name}
                data-image={method.image_url}
              >
                <div
                  class="overflow-hidden w-[80px] sm:w-[100px]
                       flex items-center justify-center"
                >
                  <img
                    src={method.image_url}
                    alt={method.name}
                    class="h-5 sm:h-6 w-auto object-contain"
                  />
                </div>
                <span class="flex-1 text-left text-sm sm:text-base font-medium text-gray-800">
                  {method.name}
                </span>
              </button>
            ))
        }
      </div>

      <!-- EWALLET -->
      <h2 class="mt-4 sm:mt-6 py-2 sm:py-3 text-sm sm:text-lg text-gray-500">
        Pembayaran instan
        <span class="block text-xs sm:text-sm">
          (verifikasi otomatis, minimal nominal Rp 10.000)
        </span>
      </h2>

      <div class="space-y-2 sm:space-y-3">
        {
          paymentMethods
            .filter((method: any) => method.type === "e_wallet")
            .filter((method: any) => method.is_active === "1")
            .map((method: any) => (
              <button
                type="button"
                class="payment-method-item w-full flex items-center gap-3 sm:gap-4
                     p-3 sm:p-4 border-2 border-gray-200 rounded-md
                     hover:border-[var(--primary-500)]
                     hover:bg-[var(--primary-100)]
                     transition-all"
                data-id={method.id}
                data-name={method.name}
                data-image={method.image_url}
              >
                <div
                  class="overflow-hidden w-[80px] sm:w-[100px]
                       flex items-center justify-center"
                >
                  <img
                    src={method.image_url}
                    alt={method.name}
                    class="h-5 sm:h-6 w-auto object-contain"
                  />
                </div>
                <span class="flex-1 text-left text-sm sm:text-base font-medium text-gray-800">
                  {method.name}
                </span>
              </button>
            ))
        }
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById("payment-modal");

    if (!modal) throw new Error("Payment modal element not found");

    document.querySelectorAll("[data-close-modal]").forEach((btn) => {
      btn.addEventListener("click", () => close());
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });

    function close() {
      if (!modal) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    }

    function open() {
      if (!modal) return;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
    }

    (window as any).openPaymentModal = open;

    document.querySelectorAll(".payment-method-item").forEach((item) => {
      item.addEventListener("click", () => {
        const htmlElement = item as HTMLElement;
        window.dispatchEvent(
          new CustomEvent("payment:selected", {
            detail: {
              id: Number(htmlElement.dataset.id),
              name: htmlElement.dataset.name,
              image: htmlElement.dataset.image,
            },
          }),
        );
        close();
      });
    });
  </script>
</div>
