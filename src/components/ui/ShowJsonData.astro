---
const { data } = Astro.props;

const formattedData = JSON.stringify(data, null, 2);
const elementId = `json-${Math.random().toString(36).slice(2)}`;
---

<div class="relative container">
  <button
    type="button"
    data-copy={elementId}
    class="absolute bottom-8 right-5 inline-flex items-center gap-2 rounded-lg bg-slate-700 hover:bg-slate-600 active:scale-95 transition-all px-3 py-1.5 text-xs font-medium text-white"
  >
    <span class="copy-text">Copy</span>
  </button>

  <pre
    id={elementId}
    class="bg-slate-900 text-slate-100 p-4 rounded-lg text-sm overflow-x-auto leading-relaxed">
{formattedData}
  </pre>
</div>

<script>
  document.querySelectorAll("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const targetId = button.getAttribute("data-copy");
      const target = document.getElementById(targetId as string);

      if (!target) return;

      try {
        await navigator.clipboard.writeText(target.innerText);

        const text = button.querySelector(".copy-text");

        if (text) {
          text.textContent = "Copied!";
        }

        setTimeout(() => {
          if (text) text.textContent = "Copy";
        }, 2000);
      } catch (error) {
        console.error("Failed to copy:", error);
      }
    });
  });
</script>
