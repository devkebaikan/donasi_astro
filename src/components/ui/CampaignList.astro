---
import { Image } from "astro:assets";
import { formatRupiah, getRemainingDays } from "@/lib/formatter";

const {
  link,
  title,
  image,
  mitra,
  category,
  progress_achieved,
  collected_amount,
  days_left,
} = Astro.props;

const progress = Math.min(Math.max(progress_achieved, 0), 100);
---

<a
  href={link}
  class="group flex flex-row items-stretch bg-white rounded border border-gray-100
overflow-hidden hover:border-gray-200 hover:shadow-sm transition-all duration-200
w-full"
>
  {/* Image — uses <img> because src is always a remote API URL */}
  <div
    class="relative shrink-0 w-40 md:w-45 m-2.5 rounded-lg overflow-hidden bg-gray-100"
  >
    <img
      src={image}
      alt={title}
      width="140"
      height="140"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.04]"
    />
  </div>

  {/* Content */}
  <div class="flex flex-col justify-between flex-1 min-w-0 py-3 pr-3 pl-1">
    {/* Title */}
    <h2
      class="text-[12px] md:text-[13px] truncate font-semibold text-gray-800 leading-snug line-clamp-2 mb-2 group-hover:text-primary-600 transition-colors duration-150"
    >
      {title}
    </h2>

    {/* Mitra + Category */}
    <div class="flex items-center gap-1.5 mb-2.5">
      <Image
        src="/images/icons/verif/Verifikasi II.png"
        alt="verified"
        width={12}
        height={12}
        loading="lazy"
        decoding="async"
        class="w-3 h-3 shrink-0 object-contain"
      />
      <span
        class="text-[11px] text-gray-500 font-medium truncate max-w-22.5 md:max-w-35"
        title={mitra}
      >
        {mitra}
      </span>
      <span
        class="text-[10px] font-medium bg-secondary-50 text-secondary-700 rounded-full px-2 py-0.5 truncate max-w-20 md:max-w-27.5 shrink-0"
        title={category}
      >
        {category}
      </span>
    </div>

    {/* Progress Bar */}
    <div class="w-full bg-gray-100 rounded-full h-1.25 mb-2.5 overflow-hidden">
      <div
        class="bg-primary-500 h-full rounded-full transition-[width] duration-500 ease-out"
        style={{ width: `${progress}%` }}
        role="progressbar"
        aria-valuenow={progress_achieved}
        aria-valuemin={0}
        aria-valuemax={100}
      >
      </div>
    </div>

    {/* Stats */}
    <div class="flex justify-between items-end">
      <div>
        <p class="text-[10px] text-gray-400 mb-0.5 leading-none">Terkumpul</p>
        <p
          class="text-[12px] md:text-[13px] font-semibold text-primary-700 leading-none"
        >
          {formatRupiah(collected_amount)}
        </p>
      </div>
      <div class="text-right">
        <p class="text-[10px] text-gray-400 mb-0.5 leading-none">Sisa hari</p>
        <p
          class="text-[12px] md:text-[13px] font-semibold text-gray-700 leading-none"
        >
          {getRemainingDays(days_left)}
        </p>
      </div>
    </div>
  </div>
</a>
